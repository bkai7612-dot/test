}

-- Training station layout (positions relative to the training region).
World.TrainingStations = {
	{ Id = "weights", Challenge = "weightlifting", Position = { 210, 0, 290 } },
	{ Id = "dummies", Challenge = "dummy_dps", Position = { 250, 0, 240 } },
