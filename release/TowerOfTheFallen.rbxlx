		Color = Color3.fromRGB(130, 70, 190),
	},

	Assassin = {
		Name = "Assassin",
		Description = "Fast, evasive and lethal from behind. Daggers, bleed, critical strikes and shadow movement.",
		Playstyle = "Evasive critical",
		Attributes = { Vigor = 10, Endurance = 12, Strength = 8, Dexterity = 16, Intelligence = 8, Faith = 7, Arcane = 13 },
		Loadout = {
			Weapon = "shadow_dagger",
			Offhand = nil,
			Armor = { Head = "nightstalker_head", Chest = "nightstalker_chest", Hands = "nightstalker_hands", Feet = "nightstalker_feet" },
		},
		Abilities = { "shadow_step", "venom_edge" },
		Items = { healing_draught = 2, antidote = 2 },
		Color = Color3.fromRGB(60, 60, 72),
	},

	Paladin = {
		Name = "Paladin",
		Description = "Holy warrior: solid melee with radiant strikes, protective light and limited healing.",
		Playstyle = "Melee support",
		Attributes = { Vigor = 12, Endurance = 11, Strength = 12, Dexterity = 8, Intelligence = 7, Faith = 15, Arcane = 9 },
		Loadout = {
			Weapon = "lightbound_mace",
			Offhand = "sacred_buckler",
			Armor = { Head = "lightward_head", Chest = "lightward_chest", Hands = "lightward_hands", Feet = "lightward_feet" },
		},
		Abilities = { "sacred_mend", "radiant_smite" },
		Items = { healing_draught = 1, mana_tonic = 2 },
		Color = Color3.fromRGB(220, 196, 120),
	},
}

return Classes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[--[[
	Cosmetics
	Purely visual. Nothing here touches combat numbers; CosmeticService only changes
	particles, colours, materials and name tags. Sources: Achievement, Boss, Purchase, Default.
]]

local Cosmetics = {
	-- Auras (ParticleEmitter around the character)
	aura_ember = { Name = "Ember Aura", Type = "Aura", Color = Color3.fromRGB(255, 140, 60), Source = "Boss" },
	aura_shadow = { Name = "Shadow Aura", Type = "Aura", Color = Color3.fromRGB(40, 30, 60), Source = "Boss" },
	aura_venom = { Name = "Venom Aura", Type = "Aura", Color = Color3.fromRGB(150, 255, 80), Source = "Boss" },
	aura_radiant = { Name = "Radiant Aura", Type = "Aura", Color = Color3.fromRGB(255, 240, 160), Source = "Boss" },
	aura_crown = { Name = "Crown of Ruin", Type = "Aura", Color = Color3.fromRGB(255, 60, 40), Source = "Boss" },
	aura_frost = { Name = "Frost Aura", Type = "Aura", Color = Color3.fromRGB(170, 220, 255), Source = "Achievement" },
	aura_bloodmist = { Name = "Blood Mist", Type = "Aura", Color = Color3.fromRGB(150, 20, 30), Source = "Achievement" },
	aura_starlight = { Name = "Starlight Aura", Type = "Aura", Color = Color3.fromRGB(200, 200, 255), Source = "Purchase" },
	aura_wisp = { Name = "Wisp Aura", Type = "Aura", Color = Color3.fromRGB(120, 255, 220), Source = "Purchase" },
	-- Weapon skins (colour/material override on the held weapon model)
	skin_sovereign = { Name = "Sovereign Finish", Type = "WeaponSkin", Color = Color3.fromRGB(60, 10, 10), Material = "Neon", Source = "Achievement" },
	skin_shadow = { Name = "Shadowsteel Finish", Type = "WeaponSkin", Color = Color3.fromRGB(25, 25, 30), Material = "Metal", Source = "Achievement" },
	skin_gilded = { Name = "Gilded Finish", Type = "WeaponSkin", Color = Color3.fromRGB(220, 180, 70), Material = "Foil", Source = "Purchase" },
	skin_bone = { Name = "Bone Finish", Type = "WeaponSkin", Color = Color3.fromRGB(225, 220, 200), Material = "Marble", Source = "Purchase" },
	-- Armour dyes (tint on the procedural armour pieces)
	dye_crimson = { Name = "Crimson Dye", Type = "ArmorDye", Color = Color3.fromRGB(120, 20, 30), Source = "Purchase" },
	dye_ivory = { Name = "Ivory Dye", Type = "ArmorDye", Color = Color3.fromRGB(230, 225, 210), Source = "Purchase" },
	dye_midnight = { Name = "Midnight Dye", Type = "ArmorDye", Color = Color3.fromRGB(20, 24, 40), Source = "Default" },
}

for id, c in Cosmetics do
	c.Id = id
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Enemies</string>
            <string name="Source"><![CDATA[--[[
	Enemies
	Wildlands enemies, elites, mini-bosses and boss summons.
	Tier: Low (new players), Mid, High, Elite, MiniBoss, Summon.

	Model.Style picks a procedural silhouette (see server Services/EntityModels.luau).
	Damage is the base damage that attack multipliers apply to.
]]

local Attacks = require(script.Parent.Attacks)

local Enemies = {}

local function enemy(id, def)
	def.Id = id
	def.Poise = def.Poise or 40
	def.Defense = def.Defense or 20
	def.WalkSpeed = def.WalkSpeed or 12
	def.AggroRadius = def.AggroRadius or 45
	def.Leash = def.Leash or 85
	def.RespawnTime = def.RespawnTime or 60
	Enemies[id] = def
end

-- ============================================================ Low tier
enemy("hollow_thrall", {
	Name = "Hollow Thrall", Tier = "Low", Level = 1, Health = 140, Damage = 34, Poise = 25, Defense = 10,
	WalkSpeed = 10, Xp = 30, Currency = { 12, 22 }, Loot = "thrall",
	Model = { Style = "Humanoid", Scale = 1, Color = Color3.fromRGB(110, 104, 92), Weapon = "Club" },
	Attacks = {
		Attacks.Cone({ Name = "Club Swing", Windup = 0.9, Recovery = 1.0, Damage = 1, Range = 7, Arc = 90, Parryable = true }),
		Attacks.Circle({ Name = "Lunging Smash", Windup = 1.1, Recovery = 1.2, Damage = 1.3, Radius = 4, Offset = 5, MaxRange = 9, Parryable = true }),
	},
})
enemy("rotwood_wolf", {
	Name = "Rotwood Wolf", Tier = "Low", Level = 3, Health = 120, Damage = 30, Poise = 15, Defense = 6,
	WalkSpeed = 17, Xp = 40, Currency = { 14, 26 }, Loot = "beast", AggroRadius = 55,
	Model = { Style = "Beast", Scale = 0.8, Color = Color3.fromRGB(70, 60, 50) },
	Attacks = {
