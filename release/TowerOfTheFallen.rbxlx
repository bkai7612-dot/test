          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController
	SFX through a pooled set of Sounds in SoundGroups ("SFX", "Music") whose volumes come
	from player settings. Music switches between hub / wilds / boss tracks when IDs are set.
]]

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Audio = require(ReplicatedStorage:WaitForChild("Shared").Config.Audio)

local AudioController = {}
local sfxGroup: SoundGroup, musicGroup: SoundGroup
local music: Sound
local currentTrack = ""

function AudioController.Init()
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "SFX"
	sfxGroup.Volume = 0.8
	sfxGroup.Parent = SoundService
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Volume = 0.5
	musicGroup.Parent = SoundService
	music = Instance.new("Sound")
	music.Name = "MusicTrack"
	music.Looped = true
	music.SoundGroup = musicGroup
	music.Parent = SoundService
end

function AudioController.ApplySettings(settings)
	if not settings then
		return
	end
	sfxGroup.Volume = settings.SfxVolume or 0.8
	musicGroup.Volume = settings.MusicVolume or 0.5
end

function AudioController.Play(name: string, position: Vector3?)
	local def = Audio.Sfx[name]
	if not def or def.Id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def.Id
	s.Volume = def.Volume or 0.5
	local pr = def.PitchRange or { 1, 1 }
	s.PlaybackSpeed = pr[1] + math.random() * (pr[2] - pr[1])
	s.SoundGroup = sfxGroup
	if position then
		local att = Instance.new("Attachment")
		att.WorldPosition = position
		att.Parent = workspace.Terrain
		s.Parent = att
		s.Ended:Connect(function()
			att:Destroy()
		end)
		task.delay(5, function()
			if att.Parent then
				att:Destroy()
			end
		end)
	else
		s.Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") or SoundService
		s.Ended:Connect(function()
			s:Destroy()
		end)
		task.delay(5, function()
			if s.Parent then
				s:Destroy()
			end
		end)
	end
	s:Play()
end

function AudioController.SetMusic(track: string)
	if track == currentTrack then
		return
	end
	currentTrack = track
	local id = Audio.Music[track] or ""
	music:Stop()
	if id ~= "" then
		music.SoundId = id
		music:Play()
	end
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController
	Third-person camera with target lock-on:
	  * Lock picks the entity closest to screen centre within LOCK_RANGE.
	  * Switch cycles to the next target left/right of the current one.
	  * While locked, the camera frames player + target, the character faces the target,
	    and camera collision is handled by raycasting from the focus point.
	  * Lock breaks on target death, distance or line-of-sight loss for too long.
	  * Camera recovers automatically on respawn.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local CameraController = {
	Target = nil :: Model?,
	TargetChanged = Signal.new(),
}

local LOCK_RANGE = 70
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local lostSight = 0
local reticle: BillboardGui? = nil

local function root(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function targetPart(model: Model): BasePart?
	local r = model:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return model.PrimaryPart
end

local function alive(m: Model?): boolean
	if not m or not m.Parent then
		return false
	end
	local model = m :: Model
	local hp = model:GetAttribute("Health")
	local kind = model:GetAttribute("Kind")
	return kind ~= "NPC" and (hp == nil or hp > 0) and targetPart(model) ~= nil
end

local function candidates(): { Model }
	local out = {}
	local r = root()
	if not r then
		return out
	end
	for _, m in CollectionService:GetTagged("Entity") do
		if m:IsA("Model") and alive(m) then
			local tp = targetPart(m)
			if tp and (tp.Position - r.Position).Magnitude <= LOCK_RANGE then
				table.insert(out, m)
			end
		end
	end
	-- other players in the PvP pit
	if player:GetAttribute("PvP") then
		for _, other in Players:GetPlayers() do
			if other ~= player and other:GetAttribute("PvP") and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(out, other.Character)
			end
		end
	end
	return out
end

local function setReticle(model: Model?)
	if reticle then
		reticle:Destroy()
		reticle = nil
	end
	if model then
		local tp = targetPart(model)
		if tp then
			local b = Instance.new("BillboardGui")
			b.Name = "LockReticle"
			b.Size = UDim2.fromOffset(34, 34)
			b.AlwaysOnTop = true
			b.LightInfluence = 0
			b.Adornee = tp
			local img = Instance.new("Frame")
			img.Size = UDim2.fromScale(1, 1)
			img.BackgroundTransparency = 1
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(255, 220, 140)
			stroke.Thickness = 2
			stroke.Parent = img
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = img
			local dot = Instance.new("Frame")
			dot.Size = UDim2.fromOffset(8, 8)
			dot.Position = UDim2.new(0.5, -4, 0.5, -4)
			dot.BackgroundColor3 = Color3.fromRGB(255, 220, 140)
			local c2 = corner:Clone()
			c2.Parent = dot
			dot.Parent = img
			img.Parent = b
			b.Parent = player:WaitForChild("PlayerGui")
			reticle = b
		end
	end
end

function CameraController.SetTarget(model: Model?)
	CameraController.Target = model
	lostSight = 0
	setReticle(model)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.AutoRotate = model == nil
	end
	CameraController.TargetChanged:Fire(model)
end

function CameraController.ToggleLock()
	if CameraController.Target then
		CameraController.SetTarget(nil)
		return
	end
	local best, bestScore = nil, math.huge
	local vp = camera.ViewportSize
	for _, m in candidates() do
		local tp = targetPart(m) :: BasePart
		local screen, onScreen = camera:WorldToViewportPoint(tp.Position)
		if onScreen then
			local d = (Vector2.new(screen.X, screen.Y) - vp / 2).Magnitude
			if d < bestScore then
				best, bestScore = m, d
			end
		end
	end
	if not best then
		-- nothing on screen: nearest
		local r = root()
		for _, m in candidates() do
			local d = ((targetPart(m) :: BasePart).Position - (r :: BasePart).Position).Magnitude
			if d < bestScore then
				best, bestScore = m, d
			end
		end
	end
	CameraController.SetTarget(best)
end

-- dir: +1 right, -1 left
function CameraController.Switch(dir: number)
	local cur = CameraController.Target
	if not cur then
		return
	end
	local curScreen = camera:WorldToViewportPoint((targetPart(cur) :: BasePart).Position)
	local best, bestDx = nil, math.huge
	for _, m in candidates() do
		if m ~= cur then
			local s = camera:WorldToViewportPoint((targetPart(m) :: BasePart).Position)
			local dx = (s.X - curScreen.X) * dir
			if dx > 0 and dx < bestDx then
				best, bestDx = m, dx
			end
		end
	end
	if best then
		CameraController.SetTarget(best)
	end
end

function CameraController.Init()
	player.CharacterAdded:Connect(function()
		CameraController.SetTarget(nil)
		camera.CameraType = Enum.CameraType.Custom
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and CameraController.Target and not processed then
			CameraController.Switch(if input.Position.Z > 0 then 1 else -1)
		end
	end)
	RunService:BindToRenderStep("TotfLockOn", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local target = CameraController.Target
		if not target then
			return
		end
		local r = root()
		if not alive(target) or not r then
			CameraController.SetTarget(nil)
			return
		end
		local tp = targetPart(target) :: BasePart
		local toTarget = tp.Position - r.Position
		if toTarget.Magnitude > LOCK_RANGE + 15 then
			CameraController.SetTarget(nil)
			return
		end
		-- face target (horizontal)
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		if flat.Magnitude > 0.5 and not player:GetAttribute("Dodging") then
			r.CFrame = CFrame.lookAt(r.Position, r.Position + flat)
		end
		-- frame both
		local focus = r.Position + Vector3.new(0, 3, 0)
		local back = if flat.Magnitude > 0.1 then -flat.Unit else -r.CFrame.LookVector
		local desired = focus + back * 14 + Vector3.new(0, 4.5, 0)
		rayParams.FilterDescendantsInstances = { player.Character, target }
		local hit = workspace:Raycast(focus, desired - focus, rayParams)
		if hit then
			desired = hit.Position + (focus - hit.Position).Unit * 0.8
		end
		local look = CFrame.lookAt(desired, tp.Position:Lerp(focus, 0.35))
		camera.CFrame = camera.CFrame:Lerp(look, math.clamp(dt * 12, 0, 1))
		-- line of sight
		local los = workspace:Raycast(focus, tp.Position - focus, rayParams)
		if los then
			lostSight += dt
			if lostSight > 2.5 then
				CameraController.SetTarget(nil)
			end
		else
			lostSight = 0
		end
	end)
end

-- Aim direction for ranged attacks: at the locked target, else where the camera looks.
function CameraController.AimDirection(): Vector3
	local r = root()
	if CameraController.Target and r then
		local tp = targetPart(CameraController.Target)
		if tp then
			return (tp.Position - (r.Position + Vector3.new(0, 1.5, 0))).Unit
		end
	end
	return camera.CFrame.LookVector
end

function CameraController.TargetEntityId(): number?
	local t = CameraController.Target
	return t and t:GetAttribute("EntityId") or nil
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--[[
	ClientState
	Read-only mirror of the server's profile snapshot plus helpers for calling the server.
	The client NEVER decides outcomes; it only displays state and sends requests.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local ClientState = {
	Profile = nil,
	Changed = Signal.new(),
	Party = { Members = {}, Leader = nil },
	PartyChanged = Signal.new(),
	Busy = false,
	Settings = nil,
}

local requestFn: RemoteFunction

local ERRORS = {
	NotEnoughCurrency = "Not enough embers.",
	NotEnoughMaterials = "Missing upgrade materials.",
	MaxLevel = "Already at maximum upgrade level.",
	RestAtShrine = "Rest at a kindled Ember Shrine first.",
	InCombat = "You cannot do that during combat.",
	NotAtMerchant = "Speak to a merchant to do that.",
	NotAtBlacksmith = "Speak to the blacksmith to do that.",
	NotAtGate = "Gather at the Tower Gate first.",
	Locked = "Locked: clear the previous tower floor first.",
	OnlyLeaderStarts = "Only the party leader can begin an encounter.",
	TowerBusy = "All arenas are in use; try again in a moment.",
	LimitReached = "Purchase limit reached.",
	CannotSell = "This item cannot be sold.",
	Equipped = "Unequip the item first.",
	InventoryFull = "Inventory full.",
	StackFull = "You cannot carry more of that.",
	TooFast = "Slow down.",
	Unavailable = "Not available yet.",
	NotKindled = "You have not kindled that shrine.",
	DuplicateAccessory = "You already wear that accessory.",
	NotComplete = "Objectives not yet complete.",
	TooFar = "You are too far away.",
	Busy = "You are busy.",
	InvalidCode = "That code is not valid.",
	CodeExpired = "That code has expired.",
	AlreadyRedeemed = "You have already redeemed that code.",
	CodeUsedUp = "That code has reached its use limit.",
	TooManyAttempts = "Too many attempts. Wait a minute and try again.",
	TryAgainLater = "Could not reach the server's code records. Try again shortly.",
	NotAdmin = "Admin access required.",
}

function ClientState.Init()
	requestFn = Net.func("Request")
	Net.event("Profile").OnClientEvent:Connect(function(profile)
		ClientState.Profile = profile
		ClientState.Settings = profile.Settings
		ClientState.Changed:Fire(profile)
	end)
	Net.event("Party").OnClientEvent:Connect(function(payload)
		if payload.Type == "State" then
			ClientState.Party = payload
			ClientState.PartyChanged:Fire(payload)
		end
	end)
end

function ClientState.ErrorText(err: string?): string
	return ERRORS[err or ""] or tostring(err or "Something went wrong.")
end

-- Calls a server request. Returns ok, result|error.
function ClientState.Request(name: string, payload: any): (boolean, any)
	local ok, response = pcall(function()
		return requestFn:InvokeServer(name, payload)
	end)
	if not ok or type(response) ~= "table" then
		return false, "ServerError"
	end
	if response.Ok then
		return true, response.Result
	end
	return false, response.Error
end

function ClientState.LocalPlayer(): Player
	return Players.LocalPlayer
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--[[
	CombatController
	Turns input into server intents and gives immediate local feedback:
	  * light/heavy attacks (heavy charge timed locally, clamped on the server)
	  * dodge: local dash movement for responsiveness; i-frames are granted by the server
	  * block (hold) / parry (tap) / sprint
	  * abilities, flask and quick items
	A small local action lock mirrors server timings to avoid spamming rejected requests.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local WeaponTypes = require(Shared.Config.WeaponTypes)
local Net = require(Shared.Net)

local CombatController = {}

local player = Players.LocalPlayer
local actionRemote: RemoteEvent
local CameraController, ClientState, AudioController
local lockUntil = 0
local heavyStart: number? = nil
local lastDodge = 0
local blocking = false

function CombatController.Init(deps)
	CameraController = deps.CameraController
	ClientState = deps.ClientState
	AudioController = deps.AudioController
	actionRemote = Net.event("Action")
end

local function send(payload)
	actionRemote:FireServer(payload)
end

local function canAct(): boolean
	if player:GetAttribute("Health") == 0 then
		return false
	end
	local p = ClientState.Profile
	return p ~= nil and p.Class ~= "" and os.clock() >= lockUntil
end

local function weaponType()
	local p = ClientState.Profile
	local wt = p and p.Derived and p.Derived.WeaponType or "Fist"
	return WeaponTypes[wt] or WeaponTypes.Fist, wt
end

function CombatController.Light()
	if not canAct() then
		return
	end
	local wt = weaponType()
	lockUntil = os.clock() + wt.Light.Windup + wt.Light.Recovery * 0.8
	send({ Kind = "Light", Aim = CameraController.AimDirection() })
	AudioController.Play("Swing")
end

function CombatController.HeavyBegin()
	if not canAct() then
		return
	end
	heavyStart = os.clock()
	send({ Kind = "HeavyStart" })
end

function CombatController.HeavyEnd()
	if not heavyStart then
		return
	end
	heavyStart = nil
	if not canAct() then
		return
	end
	local wt = weaponType()
	lockUntil = os.clock() + wt.Heavy.Windup + wt.Heavy.Recovery * 0.8
	-- the server measures the charge itself between HeavyStart and Heavy
	send({ Kind = "Heavy", Aim = CameraController.AimDirection() })
	AudioController.Play("HeavySwing")
end

function CombatController.IsCharging(): boolean
	return heavyStart ~= nil
end

function CombatController.Dodge()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root or hum.Health <= 0 then
		return
	end
	if os.clock() - lastDodge < GameConfig.Combat.DodgeCooldown or (player:GetAttribute("Stamina") or 0) <= 0 then
		return
	end
	lastDodge = os.clock()
	lockUntil = os.clock() + 0.35
	send({ Kind = "Dodge" })
	-- local dash (character physics are client-owned)
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = -root.CFrame.LookVector -- backstep
	end
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	local tier = ClientState.Profile and ClientState.Profile.Derived and ClientState.Profile.Derived.LoadTier or "Medium"
	local dist = GameConfig.Combat.DodgeDistance * (if tier == "Overloaded" then 0.45 elseif tier == "Heavy" then 0.8 else 1)
	local duration = 0.32
	local att = Instance.new("Attachment")
	att.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = 1e6
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.PlaneVelocity = Vector2.new(dir.X, dir.Z) * (dist / duration)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.Parent = root
	player:SetAttribute("Dodging", true)
	AudioController.Play("Dodge")
	-- visual trail
	local trail = Instance.new("ParticleEmitter")
	trail.Rate = 60
	trail.Lifetime = NumberRange.new(0.25)
	trail.Speed = NumberRange.new(0)
	trail.Size = NumberSequence.new(1.2, 0)
	trail.Transparency = NumberSequence.new(0.5, 1)
	trail.Color = ColorSequence.new(Color3.fromRGB(200, 190, 170))
	trail.Parent = att
	Debris:AddItem(att, duration + 0.3)
	Debris:AddItem(lv, duration)
	task.delay(duration, function()
		trail.Enabled = false
		player:SetAttribute("Dodging", false)
	end)
end

function CombatController.SetBlock(on: boolean)
	if on == blocking then
		return
	end
	blocking = on
	send({ Kind = "Block", On = on })
end

function CombatController.Parry()
	if not canAct() then
		return
	end
	lockUntil = os.clock() + 0.4
	send({ Kind = "Parry" })
end

function CombatController.SetSprint(on: boolean)
	send({ Kind = "Sprint", On = on })
end

function CombatController.Ability(slot: string)
	if not canAct() then
		return
	end
	send({ Kind = "Ability", Slot = slot, Aim = CameraController.AimDirection(), TargetId = CameraController.TargetEntityId() })
end

function CombatController.Flask()
	if not canAct() then
		return
	end
	lockUntil = os.clock() + GameConfig.Flask.UseTime
	send({ Kind = "Flask" })
	AudioController.Play("Drink")
end

function CombatController.UseItem(itemId: string)
	if not canAct() then
		return
	end
	send({ Kind = "Item", ItemId = itemId })
end

function CombatController.Rep()
	send({ Kind = "Rep" })
end

-- Server says we were staggered: drop local locks/charge
function CombatController.OnStaggered(duration: number)
	heavyStart = nil
	lockUntil = os.clock() + duration
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--[[
	EffectsController
	Client-only presentation:
	  * high-contrast telegraph colours (accessibility)
	  * lost-ember markers: only your own is shown, with its amount
	  * tower floor rings reflect YOUR progress; opened chests look opened
	  * regional and arena ambience (atmosphere, fog colour, music)
	  * reduced-effects mode
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local EffectsController = {}
local player = Players.LocalPlayer
local ClientState, HUD, AudioController

local HIGH_CONTRAST = {
	Parry = Color3.fromRGB(0, 210, 255),
	Block = Color3.fromRGB(255, 255, 255),
	Danger = Color3.fromRGB(255, 0, 200),
	Safe = Color3.fromRGB(0, 255, 90),
	Hazard = Color3.fromRGB(255, 140, 0),
}

-- Per-region look. The hub and training grounds are bright and welcoming; the wilds are
-- moodier but always readable (Ambient never drops low enough to hide enemies).
local REGION_ATMOSPHERE = {
	sanctuary = { Density = 0.22, Color = Color3.fromRGB(215, 205, 195), Haze = 0.8, Brightness = 3.2, Exposure = 0.45, Ambient = Color3.fromRGB(125, 120, 120), Outdoor = Color3.fromRGB(175, 170, 165) },
	training = { Density = 0.22, Color = Color3.fromRGB(215, 205, 190), Haze = 0.8, Brightness = 3.2, Exposure = 0.45, Ambient = Color3.fromRGB(125, 120, 115), Outdoor = Color3.fromRGB(175, 170, 160) },
	pvp = { Density = 0.3, Color = Color3.fromRGB(190, 160, 150), Haze = 1.2, Brightness = 2.8, Exposure = 0.3, Ambient = Color3.fromRGB(115, 105, 105), Outdoor = Color3.fromRGB(160, 150, 145) },
	forest = { Density = 0.45, Color = Color3.fromRGB(175, 190, 185), Haze = 2.2, Brightness = 2.2, Exposure = 0.2, Ambient = Color3.fromRGB(100, 108, 104), Outdoor = Color3.fromRGB(140, 150, 145) },
	village = { Density = 0.32, Color = Color3.fromRGB(190, 165, 145), Haze = 1.4, Brightness = 2.6, Exposure = 0.25, Ambient = Color3.fromRGB(110, 102, 98), Outdoor = Color3.fromRGB(155, 145, 138) },
	cemetery = { Density = 0.42, Color = Color3.fromRGB(160, 170, 195), Haze = 2, Brightness = 2.1, Exposure = 0.2, Ambient = Color3.fromRGB(98, 104, 118), Outdoor = Color3.fromRGB(135, 142, 160) },
	caves = { Density = 0.35, Color = Color3.fromRGB(110, 110, 125), Haze = 0.8, Brightness = 2, Exposure = 0.45, Ambient = Color3.fromRGB(110, 110, 125), Outdoor = Color3.fromRGB(120, 120, 135) },
	fortress = { Density = 0.32, Color = Color3.fromRGB(185, 160, 150), Haze = 1.5, Brightness = 2.5, Exposure = 0.25, Ambient = Color3.fromRGB(108, 100, 98), Outdoor = Color3.fromRGB(150, 140, 135) },
	vale = { Density = 0.3, Color = Color3.fromRGB(160, 215, 200), Haze = 1.2, Brightness = 2.8, Exposure = 0.3, Ambient = Color3.fromRGB(100, 125, 118), Outdoor = Color3.fromRGB(145, 175, 165) },
	wilds = { Density = 0.32, Color = Color3.fromRGB(190, 182, 185), Haze = 1.4, Brightness = 2.6, Exposure = 0.25, Ambient = Color3.fromRGB(108, 104, 106), Outdoor = Color3.fromRGB(155, 150, 150) },
}

local function settings()
	return ClientState.Settings or {}
end

local function recolorTelegraph(obj: Instance)
	if not obj:IsA("BasePart") then
		return
	end
	local inst = obj :: BasePart
	local kind = inst:GetAttribute("Telegraph")
	if kind and settings().HighContrastTelegraphs and HIGH_CONTRAST[kind] then
		inst.Color = HIGH_CONTRAST[kind]
		inst.Transparency = math.min(inst.Transparency, 0.4)
	end
end

local function handleMarker(obj: Instance)
	if not obj:IsA("BasePart") then
		return
	end
	local marker = obj :: BasePart
	local mine = marker:GetAttribute("OwnerUserId") == player.UserId
	if not mine then
		for _, d in marker:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			elseif d:IsA("Light") or d:IsA("ParticleEmitter") then
				d.Enabled = false
			end
		end
		marker.LocalTransparencyModifier = 1
		return
	end
	local b = Instance.new("BillboardGui")
	b.Size = UDim2.fromOffset(200, 40)
	b.StudsOffset = Vector3.new(0, 3, 0)
	b.AlwaysOnTop = true
	b.LightInfluence = 0
	b.MaxDistance = 400
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.Garamond
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 170, 90)
	l.TextStrokeTransparency = 0.3
	l.Text = ("Your lost embers (%d)"):format(tonumber(marker:GetAttribute("Amount")) or 0)
	l.Parent = b
	b.Parent = marker
end

local function refreshTower()
	local p = ClientState.Profile
	if not p then
		return
	end
	local map = workspace:FindFirstChild("Map")
	local tower = map and map:FindFirstChild("TowerOfTheFallen")
	if not tower then
		return
	end
	for _, ring in tower:GetChildren() do
		if ring.Name == "FloorRing" and ring:IsA("BasePart") then
			local floor = ring:GetAttribute("Floor")
			if floor <= p.Tower.HighestCleared then
				ring.Color = Color3.fromRGB(255, 200, 110)
			elseif floor == p.Tower.HighestCleared + 1 then
				ring.Color = Color3.fromRGB(255, 90, 40)
			else
				ring.Color = Color3.fromRGB(50, 40, 40)
			end
		end
	end
	-- the vale seal disappears for those who earned passage
	local valeFolder = map:FindFirstChild("HollowVale")
	local seal = valeFolder and valeFolder:FindFirstChild("ValeSeal")
	if seal and seal:IsA("BasePart") then
		seal.LocalTransparencyModifier = if p.Tower.HighestCleared >= 10 then 1 else 0
	end
	-- opened chests
	for _, box in CollectionService:GetTagged("Chest") do
		local opened = p.OpenedChests[box:GetAttribute("ChestId")] == true
		local light = box:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = not opened
		end
		if box:IsA("BasePart") then
			box.Color = if opened then Color3.fromRGB(70, 60, 50) else Color3.fromRGB(70, 52, 38)
		end
	end
end

local function applyAtmosphere(target)
	if not target then
		return
	end
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, TweenInfo.new(2.5), { Density = target.Density, Color = target.Color, Haze = target.Haze }):Play()
	end
	if target.Brightness then
		TweenService:Create(Lighting, TweenInfo.new(2.5), {
			Brightness = target.Brightness,
			ExposureCompensation = target.Exposure,
			Ambient = target.Ambient,
			OutdoorAmbient = target.Outdoor,
		}):Play()
	end
end

function EffectsController.ApplySettings(s)
	local reduced = s.ReducedEffects == true
	for _, e in Lighting:GetChildren() do
		if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") then
			e.Enabled = not reduced
		end
	end
	local telegraphs = workspace:FindFirstChild("Telegraphs")
	if telegraphs then
		for _, d in telegraphs:GetDescendants() do
			recolorTelegraph(d)
		end
	end
end

function EffectsController.Init(deps)
	ClientState = deps.ClientState
	HUD = deps.HUDController
	AudioController = deps.AudioController

	task.spawn(function()
		local telegraphs = workspace:WaitForChild("Telegraphs", 30)
		if telegraphs then
			telegraphs.DescendantAdded:Connect(function(d)
				task.defer(recolorTelegraph, d)
			end)
		end
	end)
	task.spawn(function()
		local markers = workspace:WaitForChild("LostEmbers", 30)
		if markers then
			for _, m in markers:GetChildren() do
				handleMarker(m)
			end
			markers.ChildAdded:Connect(function(m)
				task.defer(handleMarker, m)
			end)
		end
	end)

	ClientState.Changed:Connect(function(p)
		refreshTower()
		EffectsController.ApplySettings(p.Settings)
		AudioController.ApplySettings(p.Settings)
	end)
	CollectionService:GetInstanceAddedSignal("Chest"):Connect(function()
		task.defer(refreshTower)
	end)

	applyAtmosphere(REGION_ATMOSPHERE.sanctuary)
	local lastRegion
	player:GetAttributeChangedSignal("Region"):Connect(function()
		local region = player:GetAttribute("Region")
		if region ~= lastRegion and not player:GetAttribute("ArenaFloor") then
			lastRegion = region
			applyAtmosphere(REGION_ATMOSPHERE[region] or REGION_ATMOSPHERE.wilds)
			AudioController.SetMusic(if region == "sanctuary" or region == "training" then "Sanctuary" else "Wilds")
		end
	end)

	HUD.ArenaTheme = function(theme)
		if theme then
			-- arenas: themed fog colour, but bright enough to read every telegraph
			applyAtmosphere({ Density = 0.3, Color = theme.Fog, Haze = 1.2, Brightness = 2.6, Exposure = 0.35,
				Ambient = Color3.fromRGB(115, 110, 115), Outdoor = Color3.fromRGB(150, 145, 150) })
		else
			lastRegion = nil
			applyAtmosphere(REGION_ATMOSPHERE[player:GetAttribute("Region") or "wilds"] or REGION_ATMOSPHERE.wilds)
		end
	end
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController
	Always-on interface: vitals (health/stamina/mana/XP/level), currency, region, flask and
	ability slots with cooldowns, boss bars, banners/toasts, death screen, damage numbers,
	enemy health bars, training progress, data-safety warnings and a controls legend.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Abilities = require(Shared.Config.Abilities)
local Items = require(Shared.Config.Items)
local World = require(Shared.Config.World)
local Formulas = require(Shared.Logic.Formulas)
local Net = require(Shared.Net)

local HUDController = {}

local player = Players.LocalPlayer
local UIKit, ClientState, AudioController, CombatController, InputController
local T
local gui: ScreenGui
local bars = {}
local labels = {}
local toastList: Frame
local bannerFrame: Frame
local bossFrame: Frame
local bossBars = {}
local trainingFrame: Frame
local abilitySlots = {}
local cooldowns = {}
local healthBars = {}
local uiScale: UIScale
local warningLabel: TextLabel
local vignette: Frame
local controlsLabel: TextLabel

local REGION_NAMES = {}
for _, r in World.Regions do
	REGION_NAMES[r.Id] = r.Name
end
REGION_NAMES.wilds = "The Wildlands"

-- ===================================================================== builders
local function buildVitals()
	local panel = UIKit.new("Frame", { Name = "Vitals", BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 14), Size = UDim2.fromOffset(330, 110), Parent = gui })
	local badge = UIKit.panel({ Size = UDim2.fromOffset(52, 52), Parent = panel, BackgroundColor3 = T.Bg })
	labels.Level = UIKit.label("1", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 26, Font = T.FontBold, TextColor3 = T.Accent, Parent = badge })
	bars.Health = UIKit.bar(panel, T.Health, { Position = UDim2.fromOffset(60, 0), Size = UDim2.fromOffset(260, 20) })
	bars.Stamina = UIKit.bar(panel, T.Stamina, { Position = UDim2.fromOffset(60, 24), Size = UDim2.fromOffset(220, 14) })
	bars.Mana = UIKit.bar(panel, T.Mana, { Position = UDim2.fromOffset(60, 42), Size = UDim2.fromOffset(200, 12) })
	bars.Xp = UIKit.bar(panel, T.Xp, { Position = UDim2.fromOffset(0, 60), Size = UDim2.fromOffset(320, 6) })
	bars.Xp.Text.Visible = false
	labels.Status = UIKit.label("", { Position = UDim2.fromOffset(0, 70), Size = UDim2.fromOffset(330, 20), TextSize = 16, TextColor3 = Color3.fromRGB(160, 230, 90), Parent = panel })
	labels.Lost = UIKit.label("", { Position = UDim2.fromOffset(0, 90), Size = UDim2.fromOffset(330, 20), TextSize = 16, TextColor3 = Color3.fromRGB(255, 150, 70), Parent = panel })
end

local function buildTopRight()
	local panel = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 14), Size = UDim2.fromOffset(300, 80), Parent = gui })
	labels.Currency = UIKit.label("0 Embers", { Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 24, TextColor3 = T.Accent, Font = T.FontBold, Parent = panel })
	labels.Region = UIKit.label("", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 20, Parent = panel })
	labels.Floor = UIKit.label("", { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 16, TextColor3 = T.Muted, Parent = panel })
	warningLabel = UIKit.label("", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(560, 26), TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 18, TextColor3 = Color3.fromRGB(255, 120, 100), BackgroundTransparency = 0.3, BackgroundColor3 = Color3.fromRGB(40, 10, 10), Visible = false, Parent = gui,
	})
end

local function buildHotbar()
	local panel = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18), Size = UDim2.fromOffset(420, 70), Parent = gui })
	local flask = UIKit.panel({ Size = UDim2.fromOffset(64, 64), BackgroundColor3 = T.Bg, Parent = panel })
	UIKit.label("Flask", { Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, TextColor3 = T.Muted, Parent = flask })
	labels.Flask = UIKit.label("3/3", { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 24, Font = T.FontBold, TextColor3 = Color3.fromRGB(255, 150, 80), Parent = flask })
	for i, slot in { "Slot1", "Slot2" } do
		local box = UIKit.panel({ Position = UDim2.fromOffset(70 + (i - 1) * 132, 0), Size = UDim2.fromOffset(126, 64), BackgroundColor3 = T.Bg, Parent = panel })
		local name = UIKit.label("-", { Position = UDim2.fromOffset(6, 4), Size = UDim2.new(1, -12, 0, 36), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Parent = box })
		local key = UIKit.label(if i == 1 then "Z" else "X", { Position = UDim2.new(0, 6, 1, -22), Size = UDim2.new(1, -12, 0, 18), TextSize = 13, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Center, Parent = box })
		local cd = UIKit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = box })
		abilitySlots[slot] = { Name = name, Key = key, Cooldown = cd }
	end
	labels.Quick = UIKit.label("", { Position = UDim2.fromOffset(340, 0), Size = UDim2.fromOffset(200, 64), TextSize = 14, TextColor3 = T.Muted, Parent = panel })
end

local function buildBoss()
	bossFrame = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100), Size = UDim2.fromOffset(640, 110), Visible = false, Parent = gui })
	labels.BossPhase = UIKit.label("", { Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, TextColor3 = T.Accent, Parent = bossFrame })
end

local function buildBanner()
	bannerFrame = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(900, 130), Visible = false, Parent = gui })
	labels.BannerTitle = UIKit.label("", { Size = UDim2.new(1, 0, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 56, TextColor3 = T.Accent, TextStrokeTransparency = 0.4, Parent = bannerFrame })
	labels.BannerSub = UIKit.label("", { Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 50), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22, TextStrokeTransparency = 0.5, Parent = bannerFrame })
	toastList = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 110), Size = UDim2.fromOffset(340, 400), Parent = gui })
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top, Parent = toastList })
	vignette = UIKit.new("Frame", { BackgroundColor3 = Color3.fromRGB(160, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 0, Parent = gui })
end

local function buildTraining()
	trainingFrame = UIKit.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 40), Size = UDim2.fromOffset(420, 86), BackgroundColor3 = T.Bg, Visible = false, Parent = gui })
	UIKit.padding(trainingFrame, 8)
	labels.TrainName = UIKit.label("", { Size = UDim2.new(1, 0, 0, 24), TextSize = 22, TextColor3 = T.Accent, Parent = trainingFrame })
	labels.TrainDesc = UIKit.label("", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 30), TextSize = 15, TextColor3 = T.Muted, Parent = trainingFrame })
	labels.TrainProgress = UIKit.label("", { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 20), TextSize = 18, Parent = trainingFrame })
end

local function buildControls()
	controlsLabel = UIKit.label("", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.fromOffset(330, 150), TextSize = 14, TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Bottom, Parent = gui })
end

local function refreshControls()
	local s = ClientState.Settings
	controlsLabel.Visible = (s == nil or s.ShowControls ~= false) and not UserInputService.TouchEnabled
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		controlsLabel.Text = "R1 attack  R2 heavy  L1 block  L2 parry\nB dodge  R3 lock-on  X flask  Y/Up skills\nSelect: menu"
	else
		controlsLabel.Text = "LMB attack  R heavy (hold)  RMB block  F parry\nQ dodge  Shift sprint  T lock-on  H flask\nZ/X skills  1-3 items  Tab menu  Alt cursor"
	end
end

-- ===================================================================== messages
function HUDController.Toast(text: string, kind: string?)
	local colors = { Reward = T.Accent, Loot = Color3.fromRGB(150, 200, 255), Warning = Color3.fromRGB(255, 170, 90), Error = T.Danger, Currency = T.Accent, Xp = Color3.fromRGB(200, 200, 140), Quest = Color3.fromRGB(180, 230, 160) }
	local f = UIKit.panel({ Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.15, Parent = toastList })
	UIKit.label(text, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), TextSize = 16, TextColor3 = colors[kind or ""] or T.Text, TextTruncate = Enum.TextTruncate.AtEnd, Parent = f })
	local children = 0
	for _, c in toastList:GetChildren() do
		if c:IsA("Frame") then
			children += 1
		end
	end
	if children > 8 then
		for _, c in toastList:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	task.delay(4.5, function()
		if f.Parent then
			UIKit.tween(f, 0.4, { BackgroundTransparency = 1 })
			task.wait(0.4)
			f:Destroy()
		end
	end)
	if kind == "Reward" or kind == "Loot" then
		AudioController.Play("Reward")
	end
end

local bannerToken = 0
function HUDController.Banner(title: string, sub: string?, kind: string?)
	bannerToken += 1
	local token = bannerToken
	local death = kind == "Death"
	labels.BannerTitle.Text = title
	labels.BannerTitle.TextColor3 = if death then Color3.fromRGB(170, 20, 20) elseif kind == "Victory" then Color3.fromRGB(255, 210, 120) else T.Accent
	labels.BannerTitle.TextSize = if death then 84 else 56
	labels.BannerSub.Text = sub or ""
	bannerFrame.Visible = true
	labels.BannerTitle.TextTransparency = 1
	labels.BannerSub.TextTransparency = 1
	UIKit.tween(labels.BannerTitle, 0.6, { TextTransparency = 0 })
	UIKit.tween(labels.BannerSub, 0.9, { TextTransparency = 0 })
	if death then
		AudioController.Play("Death")
		UIKit.tween(vignette, 0.5, { BackgroundTransparency = 0.55 })
	end
	task.delay(if death then 3.6 else 3.2, function()
		if token == bannerToken then
			UIKit.tween(labels.BannerTitle, 0.6, { TextTransparency = 1 })
			UIKit.tween(labels.BannerSub, 0.6, { TextTransparency = 1 })
			UIKit.tween(vignette, 0.8, { BackgroundTransparency = 1 })
			task.wait(0.6)
			if token == bannerToken then
				bannerFrame.Visible = false
			end
		end
	end)
end

-- ===================================================================== world-space feedback
local function popText(position: Vector3, text: string, color: Color3, size: number?)
	local att = Instance.new("Attachment")
	att.WorldPosition = position + Vector3.new(math.random(-10, 10) / 10, 0, math.random(-10, 10) / 10)
	att.Parent = workspace.Terrain
	local b = Instance.new("BillboardGui")
	b.Size = UDim2.fromOffset(120, 40)
	b.AlwaysOnTop = true
	b.LightInfluence = 0
	b.Adornee = att
	local l = UIKit.label(text, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = T.FontBold, TextSize = size or 22, TextColor3 = color, TextStrokeTransparency = 0.3, Parent = b })
	b.Parent = gui
	UIKit.tween(b, 0.9, { StudsOffset = Vector3.new(0, 3, 0) })
	task.delay(0.5, function()
		UIKit.tween(l, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(att, 1)
	Debris:AddItem(b, 1)
end

local function shake(intensity: number)
	local s = ClientState.Settings
	if s and s.ScreenShake == false then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	task.spawn(function()
		for i = 1, 6 do
			hum.CameraOffset = Vector3.new(math.random(-10, 10), math.random(-10, 10), 0) / 100 * intensity * (1 - i / 6)
			task.wait(0.03)
		end
		hum.CameraOffset = Vector3.zero
	end)
end

local function flash(color: Color3, alpha: number)
	vignette.BackgroundColor3 = color
	vignette.BackgroundTransparency = alpha
	UIKit.tween(vignette, 0.35, { BackgroundTransparency = 1 })
end

local function onFx(payload)
	local s = ClientState.Settings
	local t = payload.Type
	if t == "Damage" then
		if s == nil or s.ShowDamageNumbers ~= false then
			local color = if payload.Crit then Color3.fromRGB(255, 200, 80) elseif payload.WeakPoint then Color3.fromRGB(120, 255, 220) else Color3.fromRGB(240, 235, 225)
			local text = tostring(payload.Amount)
			if payload.Crit then
				text = payload.Crit .. "! " .. text
			end
			if payload.Proc then
				text ..= " " .. payload.Proc:upper()
			end
			if payload.Countered then
				text = "COUNTERED " .. text
			end
			popText(payload.Position, text, color, if payload.Crit then 28 else 22)
		end
		AudioController.Play("Hit", payload.Position)
	elseif t == "Hurt" then
		if payload.Outcome == "Blocked" then
			AudioController.Play("Parry")
			flash(Color3.fromRGB(200, 200, 200), 0.85)
		else
			AudioController.Play("Hurt")
			flash(Color3.fromRGB(160, 0, 0), if payload.Staggered then 0.55 else 0.75)
			shake(if payload.Staggered then 2 else 1)
		end
		if payload.Staggered or payload.GuardBroken then
			CombatController.OnStaggered(if payload.GuardBroken then GameConfig.Combat.GuardBreakStun else GameConfig.Combat.StaggerDuration)
			if payload.GuardBroken then
				HUDController.Toast("Guard broken!", "Warning")
			end
		end
		for _, proc in payload.Procs or {} do
			HUDController.Toast(proc .. "!", "Warning")
		end
	elseif t == "Parry" then
		AudioController.Play("Parry", payload.Position)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 230, 150)
		p.Size = Vector3.new(1, 1, 1)
		p.Position = payload.Position + Vector3.new(0, 2, 0)
		p.Parent = workspace
		UIKit.tween(p, 0.25, { Size = Vector3.new(6, 6, 6), Transparency = 1 })
		Debris:AddItem(p, 0.3)
		popText(payload.Position + Vector3.new(0, 3, 0), "PARRY", Color3.fromRGB(255, 220, 120), 30)
	elseif t == "Dodged" then
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if r then
			popText((r :: BasePart).Position + Vector3.new(0, 3, 0), "Evaded", Color3.fromRGB(200, 220, 255), 18)
		end
	elseif t == "Heal" then
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if r then
			popText((r :: BasePart).Position + Vector3.new(0, 3, 0), "+" .. payload.Amount, Color3.fromRGB(120, 255, 120), 22)
		end
	elseif t == "AbilityCast" then
		cooldowns[payload.Ability] = { Start = os.clock(), Duration = payload.Cooldown }
	elseif t == "ActionDenied" then
		local msg = ({ NoMana = "Not enough mana", NoStamina = "Too exhausted", Cooldown = "Not ready", NoTarget = "Lock on to a target first" })[payload.Reason]
		if msg then
			HUDController.Toast(msg, "Warning")
		end
	elseif t == "Reward" then
		if payload.Position then
			popText(payload.Position + Vector3.new(0, 5, 0), ("+%d XP  +%d"):format(payload.Xp or 0, payload.Currency or 0), T.Accent, 18)
		end
	elseif t == "Buff" then
		HUDController.Toast(("%s active (%ds)"):format(payload.Buff, payload.Duration), "Reward")
	elseif t == "Dash" then
		CombatController.Dodge()
	elseif t == "AbilityFx" then
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Transparency = 0.4
		p.Color = Color3.fromRGB(255, 220, 160)
		if payload.Radius then
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.3, 1, 1)
			p.CFrame = CFrame.new(payload.Position - Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
			p.Parent = workspace
			UIKit.tween(p, 0.35, { Size = Vector3.new(0.3, payload.Radius * 2, payload.Radius * 2), Transparency = 1 })
		else
			local len = payload.Length or 10
			p.Size = Vector3.new(payload.Width or 4, 0.3, len)
			p.CFrame = CFrame.lookAt(payload.Position, payload.Position + payload.Direction) * CFrame.new(0, -2.5, -len / 2)
			p.Parent = workspace
			UIKit.tween(p, 0.35, { Transparency = 1 })
		end
		Debris:AddItem(p, 0.4)
	elseif t == "Stagger" then
		HUDController.Toast("Enemy staggered - strike now!", "Reward")
	elseif t == "Blink" then
		AudioController.Play("Dodge", payload.Position)
	end
end

-- ===================================================================== boss bar
local function renderBossBars(list)
	for id, b in bossBars do
		local still = false
		for _, info in list do
			if info.Id == id then
				still = true
			end
		end
		if not still then
			b.Frame:Destroy()
			bossBars[id] = nil
		end
	end
	for i, info in list do
		local b = bossBars[info.Id]
		if not b then
			local frame = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = bossFrame })
			local name = UIKit.label(info.Name, { Size = UDim2.new(1, 0, 0, 22), TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
			local bar = UIKit.bar(frame, Color3.fromRGB(150, 25, 25), { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 14) })
			local poise = UIKit.new("Frame", { BackgroundColor3 = Color3.fromRGB(230, 200, 120), BorderSizePixel = 0, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 3), Parent = frame })
			b = { Frame = frame, Name = name, Bar = bar, Poise = poise }
			bossBars[info.Id] = b
		end
		b.Frame.Position = UDim2.fromOffset(0, 22 + (i - 1) * 46)
		b.Bar:Set(info.Health, info.Max, false)
		b.Poise.Size = UDim2.new(math.clamp(info.Poise or 1, 0, 1), 0, 0, 3)
		b.Name.Text = info.Name .. (if info.Armor then "  [Armoured]" else "")
		if info.Health <= 0 then
			b.Name.TextColor3 = T.Muted
		end
	end
end

local function onBoss(payload)
	local t = payload.Type
	if t == "Start" then
		bossFrame.Visible = true
		labels.BossPhase.Text = ""
		renderBossBars(payload.Bosses)
		HUDController.Banner(("FLOOR %d"):format(payload.Floor), payload.Name .. " - " .. payload.Title .. "\n" .. payload.Mechanic, "Boss")
		AudioController.SetMusic("Boss")
		HUDController.ArenaTheme(payload.Theme)
	elseif t == "Update" then
		renderBossBars(payload.Bosses)
		labels.BossPhase.Text = payload.Stance or payload.Phase or ""
	elseif t == "Phase" then
		labels.BossPhase.Text = payload.Name
		HUDController.Toast(payload.Name, "Warning")
		shake(1.5)
	elseif t == "Victory" then
		HUDController.Banner(if payload.Final then "THE TOWER IS SILENT" else "GUARDIAN FELLED", payload.Name, "Victory")
		AudioController.SetMusic("Victory")
	elseif t == "Defeat" then
		bossFrame.Visible = false
	elseif t == "Removed" or t == "End" then
		bossFrame.Visible = false
		for id, b in bossBars do
			b.Frame:Destroy()
			bossBars[id] = nil
		end
		HUDController.ArenaTheme(nil)
		AudioController.SetMusic("")
	elseif t == "Ending" then
		HUDController.ShowEnding()
	end
end

HUDController.ArenaTheme = function(_theme) end -- replaced by EffectsController

function HUDController.ShowEnding()
	local f = UIKit.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(620, 360), BackgroundColor3 = T.Bg, Parent = gui })
	UIKit.padding(f, 18)
	UIKit.label("The Sovereign of Ruin has fallen.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 30, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	UIKit.label("Twenty guardians lie silent. The beacon atop the tower gutters out, and for the first time in an age the Sanctuary sees a clear dawn.\n\nThe tower remains - and so do you. Every guardian can be challenged again, every build reforged, every secret of the Wildlands still waits.\n\nThank you for playing Tower of the Fallen.",
		{ Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -100), TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	UIKit.button("Continue", function()
		f:Destroy()
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Parent = f })
end

-- ===================================================================== training
local function onTraining(payload)
	if payload.Type == "Start" then
		trainingFrame.Visible = true
		labels.TrainName.Text = payload.Name
		labels.TrainDesc.Text = payload.Description
		labels.TrainProgress.Text = ("Progress: 0 / %d"):format(payload.Goal)
		InputController.RepMode = payload.Kind == "Reps"
		HUDController.TrainingGoal = payload.Goal
		HUDController.TrainingEnds = payload.TimeLimit and (os.clock() + payload.TimeLimit) or nil
	elseif payload.Type == "Progress" then
		local extra = if payload.Failures then ("  (misses: %d)"):format(payload.Failures) else ""
		labels.TrainProgress.Text = ("Progress: %d / %d%s"):format(payload.Count, payload.Goal, extra)
	elseif payload.Type == "End" then
		trainingFrame.Visible = false
		InputController.RepMode = false
		HUDController.TrainingEnds = nil
	end
end

-- ===================================================================== entity health bars
local function attachHealthBar(inst: Instance)
	if not inst:IsA("Model") or healthBars[inst] then
		return
	end
	local model = inst :: Model
	local kind = model:GetAttribute("Kind")
	if kind == "Boss" or kind == "NPC" then
		return
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not root then
		return
	end
	local height = model:GetAttribute("Height") or 5
	local b = Instance.new("BillboardGui")
	b.Size = UDim2.fromOffset(140, 30)
	b.StudsOffset = Vector3.new(0, height * 0.6 + 1.5, 0)
	b.MaxDistance = 70
	b.LightInfluence = 0
	b.Adornee = root
	local tier = model:GetAttribute("Tier")
	local nameColor = if tier == "Elite" then Color3.fromRGB(240, 180, 90) elseif tier == "MiniBoss" then Color3.fromRGB(255, 110, 90) else T.Text
	local name = UIKit.label(("%s  Lv.%d"):format(tostring(model:GetAttribute("DisplayName") or model.Name), tonumber(model:GetAttribute("Level")) or 1), {
		Size = UDim2.new(1, 0, 0, 14), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = nameColor, TextStrokeTransparency = 0.4, Parent = b,
	})
	local bar = UIKit.bar(b, Color3.fromRGB(170, 35, 35), { Position = UDim2.fromOffset(10, 16), Size = UDim2.new(1, -20, 0, 7) })
	bar.Text.Visible = false
	local function update()
		local hp, max = model:GetAttribute("Health") or 0, model:GetAttribute("MaxHealth") or 1
		bar:Set(hp, max, false)
		b.Enabled = kind ~= "Dummy" and (hp < max or tier == "Elite" or tier == "MiniBoss")
	end
	update()
	local conn = model:GetAttributeChangedSignal("Health"):Connect(update)
	b.Parent = gui
	healthBars[model] = { Gui = b, Conn = conn, Name = name }
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			conn:Disconnect()
			b:Destroy()
			healthBars[model] = nil
		end
	end)
end

-- ===================================================================== refresh
local function refreshProfile(p)
	if not p then
		return
	end
	labels.Level.Text = tostring(p.Level)
	local need = Formulas.xpToNext(p.Level)
	bars.Xp:Set(p.Xp, if need == math.huge then 1 else need, false)
	labels.Floor.Text = ("Tower: %d / %d floors cleared"):format(p.Tower.HighestCleared, GameConfig.Tower.Floors)
	for slot, ui in abilitySlots do
		local id = p.Abilities[slot]
		ui.Name.Text = if id ~= "" and Abilities[id] then Abilities[id].Name else "-"
	end
	local quick = {}
	for i, id in { "healing_draught", "mana_tonic", "stamina_tonic" } do
		local n = p.Inventory.Stacks[id] or 0
		table.insert(quick, ("[%d] %s x%d"):format(i, Items[id].Name, n))
	end
	labels.Quick.Text = table.concat(quick, "\n")
	if uiScale then
		uiScale.Scale = math.clamp(p.Settings.TextScale or 1, 0.75, 1.5)
	end
	refreshControls()
end

function HUDController.Init(deps)
	UIKit = deps.UIKit
	ClientState = deps.ClientState
	AudioController = deps.AudioController
	CombatController = deps.CombatController
	InputController = deps.InputController
	T = UIKit.Theme
	gui = UIKit.new("ScreenGui", { Name = "TotfHUD", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	uiScale = UIKit.new("UIScale", { Parent = gui })
	buildVitals()
	buildTopRight()
	buildHotbar()
	buildBoss()
	buildBanner()
	buildTraining()
	buildControls()

	ClientState.Changed:Connect(refreshProfile)
	Net.event("Fx").OnClientEvent:Connect(onFx)
	Net.event("Boss").OnClientEvent:Connect(onBoss)
	Net.event("Training").OnClientEvent:Connect(onTraining)
	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if payload.Banner then
			HUDController.Banner(payload.Text, payload.Subtitle, payload.Kind)
		else
			HUDController.Toast(payload.Text, payload.Kind)
		end
	end)

	for _, m in CollectionService:GetTagged("Entity") do
		attachHealthBar(m)
	end
	CollectionService:GetInstanceAddedSignal("Entity"):Connect(attachHealthBar)

	RunService.Heartbeat:Connect(function()
		local hp, maxHp = player:GetAttribute("Health") or 0, player:GetAttribute("MaxHealth") or 1
		bars.Health:Set(hp, maxHp)
		bars.Stamina:Set(player:GetAttribute("Stamina") or 0, player:GetAttribute("MaxStamina") or 1)
		bars.Mana:Set(player:GetAttribute("Mana") or 0, player:GetAttribute("MaxMana") or 1)
		labels.Flask.Text = ("%d/%d"):format(player:GetAttribute("FlaskCharges") or 0, player:GetAttribute("FlaskMax") or 0)
		labels.Currency.Text = ("%d %s"):format(player:GetAttribute("Currency") or 0, GameConfig.Currency.Name)
		local region = player:GetAttribute("Region")
		labels.Region.Text = REGION_NAMES[region or ""] or ""
		if player:GetAttribute("ArenaFloor") then
			labels.Region.Text = ("Tower Floor %d"):format(player:GetAttribute("ArenaFloor"))
		end
		local status = {}
		if player:GetAttribute("Poisoned") then
			table.insert(status, "Poisoned")
		end
		if player:GetAttribute("Burning") then
			table.insert(status, "Burning")
		end
		if player:GetAttribute("Blocking") then
			table.insert(status, "Guarding")
		end
		if CombatController.IsCharging() then
			table.insert(status, "Charging...")
		end
		labels.Status.Text = table.concat(status, "  ")
		local p = ClientState.Profile
		local lost = p and p.LostCurrency
		if lost then
			local remain = lost.CreatedAt + GameConfig.Death.RecoveryExpirySeconds - os.time()
			labels.Lost.Text = ("Lost embers: %d (fade in %d:%02d)"):format(lost.Amount, math.max(0, remain) // 60, math.max(0, remain) % 60)
		else
			labels.Lost.Text = ""
		end
		-- ability cooldowns
		for slot, ui in abilitySlots do
			local id = p and p.Abilities[slot]
			local cd = id and cooldowns[id]
			local frac = 0
			if cd then
				frac = math.clamp(1 - (os.clock() - cd.Start) / cd.Duration, 0, 1)
			end
			ui.Cooldown.Size = UDim2.fromScale(1, frac)
		end
		-- data safety warnings
		if player:GetAttribute("DataUnsaved") then
			warningLabel.Visible = true
			warningLabel.Text = "Studio test mode: progress is NOT being saved (DataStore unavailable)"
		elseif player:GetAttribute("DataSaveFailing") then
			warningLabel.Visible = true
			warningLabel.Text = "Warning: saving is failing - your progress will retry automatically"
		else
			warningLabel.Visible = false
		end
		if HUDController.TrainingEnds then
			local left = math.max(0, HUDController.TrainingEnds - os.clock())
			labels.TrainDesc.Text = ("Time left: %.1fs"):format(left)
		end
	end)
	refreshControls()
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	InputController
	Binds keyboard/mouse, gamepad and touch through ContextActionService. Touch buttons are
	created by CAS and arranged around the jump button. Bindings:

	  Action        Keyboard/Mouse     Gamepad        Touch
	  Light attack  LMB                R1             Attack
	  Heavy (hold)  R                  R2             Heavy
	  Block (hold)  RMB                L1             Block
	  Parry         F                  L2             Parry
	  Dodge/roll    Q                  B              Dodge
	  Sprint        Left Shift (hold)  L3 (toggle)    Sprint (toggle)
	  Lock-on       T / MMB            R3             Lock
	  Switch target Mouse wheel        D-pad L/R      Switch
	  Ability 1/2   Z / X              Y / D-pad Up   Skill 1 / Skill 2
	  Ember Flask   H                  X              Flask
	  Quick items   1 / 2 / 3          D-pad Down     -
	  Menu          Tab / M            Select/Start   Menu
	While a weightlifting session is active, the attack input performs a rep instead.
]]

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local InputController = {
	RepMode = false,
	MenuOpen = false,
	CursorFree = false,
}

local Combat, Camera, Menu, ClientState
local sprintToggle = false
local BEGIN = Enum.UserInputState.Begin
local END = Enum.UserInputState.End

local QUICK = { "healing_draught", "mana_tonic", "stamina_tonic" }

local function bind(name: string, fn, touchTitle: string?, ...)
	ContextActionService:BindAction(name, function(_, state, input)
		if InputController.MenuOpen and name ~= "TotfMenu" then
			return Enum.ContextActionResult.Pass
		end
		fn(state, input)
		return Enum.ContextActionResult.Sink
	end, touchTitle ~= nil, ...)
	if touchTitle then
		ContextActionService:SetTitle(name, touchTitle)
	end
end

function InputController.Init(deps)
	Combat = deps.CombatController
	Camera = deps.CameraController
	Menu = deps.MenuController
	ClientState = deps.ClientState
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)

	bind("TotfLight", function(state)
		if state == BEGIN then
			if InputController.RepMode then
				Combat.Rep()
			else
				Combat.Light()
			end
		end
	end, "Attack", Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR1)
	bind("TotfHeavy", function(state)
		if state == BEGIN then
			Combat.HeavyBegin()
		elseif state == END then
			Combat.HeavyEnd()
		end
	end, "Heavy", Enum.KeyCode.R, Enum.KeyCode.ButtonR2)
	bind("TotfBlock", function(state)
		Combat.SetBlock(state == BEGIN)
	end, "Block", Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL1)
	bind("TotfParry", function(state)
		if state == BEGIN then
			Combat.Parry()
		end
	end, "Parry", Enum.KeyCode.F, Enum.KeyCode.ButtonL2)
	bind("TotfDodge", function(state)
		if state == BEGIN then
			Combat.Dodge()
		end
	end, "Dodge", Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	bind("TotfSprint", function(state, input)
		if input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonL3 then
			if state == BEGIN then
				sprintToggle = not sprintToggle
				Combat.SetSprint(sprintToggle)
			end
		else
			Combat.SetSprint(state == BEGIN)
		end
	end, "Sprint", Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	bind("TotfLock", function(state)
		if state == BEGIN then
			Camera.ToggleLock()
		end
	end, "Lock", Enum.KeyCode.T, Enum.UserInputType.MouseButton3, Enum.KeyCode.ButtonR3)
	bind("TotfSwitchL", function(state)
		if state == BEGIN then
			Camera.Switch(-1)
		end
	end, nil, Enum.KeyCode.DPadLeft)
	bind("TotfSwitchR", function(state)
		if state == BEGIN then
			Camera.Switch(1)
		end
	end, "Switch", Enum.KeyCode.DPadRight)
	bind("TotfAbility1", function(state)
		if state == BEGIN then
			Combat.Ability("Slot1")
		end
	end, "Skill 1", Enum.KeyCode.Z, Enum.KeyCode.ButtonY)
	bind("TotfAbility2", function(state)
		if state == BEGIN then
			Combat.Ability("Slot2")
		end
	end, "Skill 2", Enum.KeyCode.X, Enum.KeyCode.DPadUp)
	bind("TotfFlask", function(state)
		if state == BEGIN then
			Combat.Flask()
		end
	end, "Flask", Enum.KeyCode.H, Enum.KeyCode.ButtonX)
	bind("TotfQuick", function(state, input)
		if state ~= BEGIN then
			return
		end
		local idx = if input.KeyCode == Enum.KeyCode.One then 1 elseif input.KeyCode == Enum.KeyCode.Two then 2 elseif input.KeyCode == Enum.KeyCode.Three then 3 else 1
		Combat.UseItem(QUICK[idx])
	end, nil, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.DPadDown)
	bind("TotfMenu", function(state)
		if state == BEGIN then
			Menu.Toggle()
		end
	end, "Menu", Enum.KeyCode.Tab, Enum.KeyCode.M, Enum.KeyCode.ButtonSelect, Enum.KeyCode.ButtonStart)

	-- arrange touch buttons in an arc around the jump button
	local layout = {
		TotfLight = UDim2.new(1, -95, 1, -170),
		TotfHeavy = UDim2.new(1, -165, 1, -150),
		TotfDodge = UDim2.new(1, -200, 1, -90),
		TotfBlock = UDim2.new(1, -165, 1, -220),
		TotfParry = UDim2.new(1, -95, 1, -240),
		TotfAbility1 = UDim2.new(1, -235, 1, -200),
		TotfAbility2 = UDim2.new(1, -235, 1, -265),
		TotfFlask = UDim2.new(1, -270, 1, -140),
		TotfLock = UDim2.new(1, -95, 1, -310),
		TotfSwitchR = UDim2.new(1, -165, 1, -290),
		TotfSprint = UDim2.new(0, 30, 1, -260),
		TotfMenu = UDim2.new(0, 30, 0, 140),
	}
	for name, pos in layout do
		pcall(function()
			ContextActionService:SetPosition(name, pos)
		end)
	end

	-- combat mouse lock on desktop (frees RMB for blocking)
	RunService:BindToRenderStep("TotfMouseLock", Enum.RenderPriority.Camera.Value + 2, function()
		local settings = ClientState.Settings
		local wantLock = settings == nil or settings.MouseLock ~= false
		if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
			if wantLock and not InputController.MenuOpen and not InputController.CursorFree then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			elseif InputController.MenuOpen or InputController.CursorFree then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end
		if settings and settings.CameraSensitivity then
			UserInputService.MouseDeltaSensitivity = math.clamp(settings.CameraSensitivity, 0.2, 3)
		end
	end)
	-- hold Left Alt to free the cursor temporarily
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt then
			InputController.CursorFree = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt then
			InputController.CursorFree = false
		end
	end)
end

function InputController.SetMenuOpen(open: boolean)
	InputController.MenuOpen = open
	if open then
		Combat.SetBlock(false)
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--[[
	MenuController
	All menus: class selection, the main menu (Character, Inventory, Abilities, Quests, Map,
	Tower, Party, Achievements, Cosmetics, Settings) and NPC menus (Shop, Blacksmith,
	Quest giver, Shrine, Tutorial). Menus only display state and send requests; the server
	validates and answers every action.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared.Config
local GameConfig = require(Config.GameConfig)
local Classes = require(Config.Classes)
local Items = require(Config.Items)
local Abilities = require(Config.Abilities)
local Rarities = require(Config.Rarities)
local Quests = require(Config.Quests)
local Shops = require(Config.Shops)
local Bosses = require(Config.Bosses)
local World = require(Config.World)
local Achievements = require(Config.Achievements)
local Cosmetics = require(Config.Cosmetics)
local Products = require(Config.Products)
local WeaponTypes = require(Config.WeaponTypes)
local Formulas = require(Shared.Logic.Formulas)
local Net = require(Shared.Net)

local MenuController = {
	OnSettings = nil :: ((any) -> ())?,
	MapToCanvas = nil :: ((number, number) -> UDim2)?,
}

local player = Players.LocalPlayer
local UIKit, ClientState, InputController, HUD, AudioController
local T
local gui: ScreenGui
local window: Frame
local tabBar: Frame
local content: Frame
local titleLabel: TextLabel
local currentPage = "Character"
local context: any = {} -- NPC context (Shop id, quest list, ...)
local pendingAlloc = {}
local selectedItem: string? = nil
local inventoryFilter = "All"
local classOverlay: Frame? = nil
local mapDot: Frame? = nil

local MAIN_TABS = { "Character", "Inventory", "Abilities", "Quests", "Map", "Tower", "Party", "Achievements", "Cosmetics", "Codes", "Settings" }

local function profile()
	return ClientState.Profile
end

local function notifyResult(ok: boolean, err, successText: string?)
	if ok then
		if successText then
			HUD.Toast(successText, "Reward")
		end
		AudioController.Play("Ui")
	else
		HUD.Toast(ClientState.ErrorText(err), "Error")
	end
end

-- Sends a request and reports the outcome (keeps the server's error code).
local function act(name: string, payload: any?, successText: string?)
	local ok, res = ClientState.Request(name, payload)
	notifyResult(ok, res, successText)
	return ok, res
end

local function rarityColor(def): Color3
	local r = def and Rarities[def.Rarity]
	return r and r.Color or T.Text
end

local function row(parent: Instance, height: number?)
	local f = UIKit.new("Frame", { BackgroundColor3 = T.Panel2, BorderSizePixel = 0, Size = UDim2.new(1, -8, 0, height or 40), Parent = parent })
	UIKit.corner(f, 6)
	return f
end

local function header(parent: Instance, text: string)
	return UIKit.label(text, { Size = UDim2.new(1, 0, 0, 28), TextSize = 22, TextColor3 = T.Accent, Parent = parent })
end

-- Item description used by inventory, shop and blacksmith.
local function describeItem(def, upgrade: number?, attrs): string
	local lines = { ("%s  [%s]"):format(def.Kind, def.Rarity) }
	if def.Kind == "Weapon" then
		local ar = Formulas.weaponAttackRating(def, upgrade or 0, attrs)
		table.insert(lines, ("Attack %d (%s)  Type: %s"):format(math.floor(ar.Total), def.DamageType, def.WeaponType))
		local sc = {}
		for a, g in def.Scaling do
			table.insert(sc, a:sub(1, 3) .. " " .. g)
		end
		table.insert(lines, "Scaling: " .. table.concat(sc, ", "))
		local req = {}
		for a, v in def.Requires do
			local ok = (attrs[a] or 0) >= v
			table.insert(req, ("%s %d%s"):format(a:sub(1, 3), v, if ok then "" else " (!)"))
		end
		if #req > 0 then
			table.insert(lines, "Requires: " .. table.concat(req, ", ") .. (if ar.RequirementsMet then "" else "  - unmet: -40% damage"))
		end
		local wt = WeaponTypes[def.WeaponType]
		table.insert(lines, ("Reach %s  Speed %.2fs"):format(wt.Ranged and "ranged" or tostring(wt.Range), wt.Light.Windup + wt.Light.Recovery))
		if def.Status then
			for k, v in def.Status do
				table.insert(lines, ("%s build-up %d"):format(k, v))
			end
		end
	elseif def.Kind == "Shield" then
		table.insert(lines, ("Stability %d%%%s"):format(Formulas.shieldStability(def, upgrade or 0), if def.ParryBonus > 0 then "  Parry window +" .. def.ParryBonus .. "s" else ""))
	elseif def.Kind == "Armor" then
		local d, m = Formulas.armorDefense(def, upgrade or 0)
		table.insert(lines, ("%s  Defence %d  Magic %d  Poise %d"):format(def.Slot, math.floor(d), math.floor(m), def.Poise))
	elseif def.Kind == "Accessory" then
		for k, v in def.Bonuses do
			table.insert(lines, ("%s %s"):format(k, if v < 1 then ("+%d%%"):format(v * 100) else "+" .. v))
		end
	end
	if def.Weight then
		table.insert(lines, ("Weight %.1f"):format(def.Weight))
	end
	if def.Description and def.Description ~= "" then
		table.insert(lines, def.Description)
	end
	return table.concat(lines, "\n")
end

local function itemName(inst): string
	local def = Items[inst.Id]
	return def.Name .. (if inst.Upgrade > 0 then (" +%d"):format(inst.Upgrade) else "")
end

-- ===================================================================== pages
local Pages = {}

Pages.Character = function(c)
	local p = profile()
	local stats = p.Derived
	header(c, ("%s  -  Level %d"):format(p.Class, p.Level))
	local spent = 0
	for _, v in pendingAlloc do
		spent += v
	end
	UIKit.label(("Unspent points: %d   (allocate while resting at an Ember Shrine)"):format(p.UnspentPoints - spent), { Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = T.Muted, Parent = c })
	for _, attr in GameConfig.Attributes.List do
		local r = row(c, 34)
		local pending = pendingAlloc[attr] or 0
		local bonus = p.TrainingBonus[attr] or 0
		UIKit.label(("%s  %d%s%s"):format(attr, p.Attributes[attr] + pending, if pending > 0 then (" (+%d)"):format(pending) else "", if bonus > 0 then ("  [+%d trained]"):format(bonus) else ""),
			{ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.45, 0, 1, 0), TextSize = 18, Parent = r })
		UIKit.label(GameConfig.Attributes.Descriptions[attr], { Position = UDim2.new(0.45, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 14, TextColor3 = T.Muted, Parent = r })
		UIKit.button("-", function()
			if pending > 0 then
				pendingAlloc[attr] = pending - 1
				MenuController.Render()
			end
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0), Size = UDim2.fromOffset(32, 26), Parent = r })
		UIKit.button("+", function()
			if p.UnspentPoints - spent > 0 then
				pendingAlloc[attr] = pending + 1
				MenuController.Render()
			end
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(32, 26), Parent = r })
	end
	if spent > 0 then
		UIKit.button(("Confirm %d point%s"):format(spent, spent > 1 and "s" or ""), function()
			local ok, err = ClientState.Request("AllocateAttributes", pendingAlloc)
			if ok then
				table.clear(pendingAlloc)
			end
			notifyResult(ok, err, "Attributes increased.")
		end, { Size = UDim2.fromOffset(200, 34), Parent = c })
	end
	if stats then
		local s = row(c, 120)
		UIKit.label(("Health %d   Stamina %d   Mana %d\nDefence %d   Magic Defence %d   Poise %d\nAttack rating %d%s   Shield/guard stability %d%%\nEquip load %.1f / %.1f  (%s)"):format(
			stats.MaxHealth, stats.MaxStamina, stats.MaxMana, stats.Defense, stats.MagicDefense, stats.Poise,
			math.floor(stats.AttackRating), if stats.RequirementsMet then "" else " (requirements unmet)", stats.Stability,
			stats.EquipLoad, stats.MaxEquipLoad, stats.LoadTier), { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 1, -12), TextSize = 17, Parent = s })
	end
	local need = Formulas.xpToNext(p.Level)
	UIKit.label(("XP %d / %s   -   Embers %d   -   Flask charges %d"):format(p.Xp, if need == math.huge then "MAX" else tostring(need), p.Currency, p.Flask.MaxCharges), { Size = UDim2.new(1, 0, 0, 24), TextSize = 16, TextColor3 = T.Muted, Parent = c })
end

local KIND_FILTERS = { "All", "Weapon", "Shield", "Armor", "Accessory", "Consumable", "Material" }

Pages.Inventory = function(c)
	local p = profile()
	local attrs = p.Derived and p.Derived.Attributes or p.Attributes
	local equippedBy = {}
	for slot, uid in p.Equipped do
		equippedBy[uid] = slot
	end
	local filters = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Parent = c })
	UIKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = filters })
	for _, f in KIND_FILTERS do
		UIKit.button(f, function()
			inventoryFilter = f
			MenuController.Render()
		end, { Size = UDim2.fromOffset(92, 28), TextSize = 15, BackgroundColor3 = if inventoryFilter == f then T.Border else T.Panel2, Parent = filters })
	end
	local body = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -120), Parent = c })
	local list = UIKit.list({ Size = UDim2.new(0.5, -4, 1, 0), Parent = body }, 4)
	local detail = UIKit.panel({ Position = UDim2.new(0.5, 4, 0, 0), Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = T.Bg, Parent = body })
	UIKit.padding(detail, 10)
	local entries = {}
	for uid, inst in p.Inventory.Items do
		local def = Items[inst.Id]
		if def and (inventoryFilter == "All" or def.Kind == inventoryFilter) then
			table.insert(entries, { Key = uid, Def = def, Inst = inst, Name = itemName(inst), Equipped = equippedBy[uid] })
		end
	end
	for id, n in p.Inventory.Stacks do
		local def = Items[id]
		if def and (inventoryFilter == "All" or def.Kind == inventoryFilter) then
			table.insert(entries, { Key = id, Def = def, Count = n, Name = def.Name .. " x" .. n })
		end
	end
	table.sort(entries, function(a, b)
		if (a.Equipped ~= nil) ~= (b.Equipped ~= nil) then
			return a.Equipped ~= nil
		end
		return a.Name < b.Name
	end)
	for _, e in entries do
		local b = UIKit.button((if e.Equipped then "[E] " else "") .. e.Name, function()
			selectedItem = e.Key
			MenuController.Render()
		end, { Size = UDim2.new(1, -8, 0, 32), TextSize = 16, TextColor3 = rarityColor(e.Def), TextXAlignment = Enum.TextXAlignment.Left, Parent = list })
		UIKit.padding(b, 6)
	end
	-- details
	local sel
	for _, e in entries do
		if e.Key == selectedItem then
			sel = e
		end
	end
	if sel then
		UIKit.label(sel.Name, { Size = UDim2.new(1, 0, 0, 26), TextSize = 22, TextColor3 = rarityColor(sel.Def), Parent = detail })
		UIKit.label(describeItem(sel.Def, sel.Inst and sel.Inst.Upgrade or 0, attrs), { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -80), TextSize = 16, TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
		-- comparison with equipped
		if sel.Inst and not sel.Equipped and (sel.Def.Kind == "Weapon" or sel.Def.Kind == "Armor") then
			local slot = if sel.Def.Kind == "Weapon" then "Weapon" else sel.Def.Slot
			local cur = p.Equipped[slot] and p.Inventory.Items[p.Equipped[slot]]
			if cur then
				local cdef = Items[cur.Id]
				local delta
				if sel.Def.Kind == "Weapon" then
					delta = Formulas.weaponAttackRating(sel.Def, sel.Inst.Upgrade, attrs).Total - Formulas.weaponAttackRating(cdef, cur.Upgrade, attrs).Total
					delta = ("Attack %+d vs equipped"):format(math.floor(delta))
				else
					delta = ("Defence %+d vs equipped"):format(math.floor((Formulas.armorDefense(sel.Def, sel.Inst.Upgrade)) - (Formulas.armorDefense(cdef, cur.Upgrade))))
				end
				UIKit.label(delta, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 20), TextSize = 16, TextColor3 = T.Accent, Parent = detail })
			end
		end
		local actions = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 34), Parent = detail })
		UIKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = actions })
		if sel.Inst then
			if sel.Equipped then
				UIKit.button("Unequip", function()
					act("Unequip", sel.Equipped)
				end, { Size = UDim2.fromOffset(110, 32), Parent = actions })
			elseif sel.Def.Kind ~= "Material" then
				UIKit.button("Equip", function()
					act("Equip", { Uid = sel.Key })
				end, { Size = UDim2.fromOffset(110, 32), Parent = actions })
				if sel.Def.Kind == "Accessory" then
					UIKit.button("Equip (slot 2)", function()
						act("Equip", { Uid = sel.Key, Slot = "Accessory2" })
					end, { Size = UDim2.fromOffset(130, 32), Parent = actions })
				end
			end
		elseif sel.Def.Kind == "Consumable" then
			UIKit.button("Use", function()
				ClientState.Request("UseItem", sel.Key)
			end, { Size = UDim2.fromOffset(110, 32), Parent = actions })
		end
		if context.Menu == "Shop" then
			local price = Formulas.sellPrice(sel.Def)
			if price > 0 and not sel.Equipped then
				UIKit.button(("Sell (%d)"):format(price), function()
					act("Sell", { Key = sel.Key, Amount = 1 })
				end, { Size = UDim2.fromOffset(120, 32), Parent = actions })
			end
		end
	else
		UIKit.label("Select an item to see details.", { Size = UDim2.fromScale(1, 1), TextColor3 = T.Muted, Parent = detail })
	end
	-- build presets
	local presets = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 74), Parent = c })
	local max = if p.HasWardrobePass then GameConfig.Inventory.BuildPresetsWithPass else GameConfig.Inventory.BuildPresetsFree
	UIKit.label(("Build presets (%d slots)"):format(max), { Size = UDim2.new(1, 0, 0, 20), TextSize = 16, TextColor3 = T.Muted, Parent = presets })
	for i = 1, max do
		local has = p.BuildPresets[tostring(i)] ~= nil
		UIKit.button(("Save %d"):format(i), function()
			act("SavePreset", i, "Preset saved.")
		end, { Position = UDim2.fromOffset((i - 1) * 150, 22), Size = UDim2.fromOffset(70, 28), TextSize = 14, Parent = presets })
		UIKit.button(("Load %d"):format(i), function()
			act("LoadPreset", i, "Preset loaded.")
		end, { Position = UDim2.fromOffset((i - 1) * 150 + 74, 22), Size = UDim2.fromOffset(70, 28), TextSize = 14, BackgroundColor3 = if has then T.Panel2 else T.Bg, Parent = presets })
	end
end

Pages.Abilities = function(c)
	local p = profile()
	header(c, "Abilities")
	UIKit.label(("Slot 1: %s     Slot 2: %s"):format(Abilities[p.Abilities.Slot1] and Abilities[p.Abilities.Slot1].Name or "-", Abilities[p.Abilities.Slot2] and Abilities[p.Abilities.Slot2].Name or "-"),
		{ Size = UDim2.new(1, 0, 0, 22), TextSize = 17, Parent = c })
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -60), Parent = c }, 6)
	local ids = {}
	for id in p.Abilities.Unlocked do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		local def = Abilities[id]
		local r = row(list, 64)
		UIKit.label(("%s  -  %s  (mana %d, stamina %d, cooldown %ds)\n%s"):format(def.Name, def.Type, def.Mana or 0, def.Stamina or 0, def.Cooldown, def.Description),
			{ Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -250, 1, -8), TextSize = 15, Parent = r })
		for i, slot in { "Slot1", "Slot2" } do
			UIKit.button("Slot " .. i, function()
				act("SetAbilitySlot", { Slot = slot, Ability = id })
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10 - (2 - i) * 110, 0.5, 0), Size = UDim2.fromOffset(100, 30), Parent = r })
		end
	end
	UIKit.label("Defeat tower guardians to learn more abilities - any build may use any ability.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = T.Muted, Parent = c })
end

local function questProgressText(p, id): string
	local q = Quests[id]
	local o = q.Objective
	local active = p.Quests.Active[id]
	if o.Type == "Kill" or o.Type == "Training" then
		return ("%d / %d"):format(math.min(active and active.Progress or 0, o.Count), o.Count)
	elseif o.Type == "Boss" then
		return if p.Tower.HighestCleared >= o.Floor then "Complete" else ("Floor %d"):format(o.Floor)
	elseif o.Type == "Collect" then
		return ("%d / %d"):format(math.min(p.Inventory.Stacks[o.Item] or 0, o.Count), o.Count)
	end
	return ""
end

Pages.Quests = function(c)
	local p = profile()
	header(c, "Quest Log")
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -34), Parent = c }, 6)
	local any = false
	for id in p.Quests.Active do
		any = true
		local q = Quests[id]
		local r = row(list, 56)
		UIKit.label(("%s   [%s]\n%s"):format(q.Name, questProgressText(p, id), q.Description), { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -140, 1, -8), TextSize = 16, Parent = r })
		UIKit.button("Abandon", function()
			act("AbandonQuest", id)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(110, 30), Parent = r })
	end
	if not any then
		UIKit.label("No active quests. Speak to the people of the Sanctuary.", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.Muted, Parent = list })
	end
	local done = 0
	for _ in p.Quests.Completed do
		done += 1
	end
	UIKit.label(("Completed quests: %d"):format(done), { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.Muted, Parent = list })
end

Pages.Map = function(c)
	local p = profile()
	header(c, "Map of the Fallen Lands")
	local size = 420
	local scale = size / 2100
	local canvas = UIKit.panel({ Size = UDim2.fromOffset(size, size), BackgroundColor3 = Color3.fromRGB(30, 34, 28), Parent = c })
	canvas.ClipsDescendants = true
	local function toMap(x, z)
		return UDim2.fromOffset(size / 2 + x * scale, size / 2 + z * scale)
	end
	for _, r in World.Regions do
		if not r.Hidden or p.Tower.HighestCleared >= (r.RequiresFloor or 0) or p.Discovered.loc_vale then
			local d = r.Radius * 2 * scale
			local f = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(r.Center[1], r.Center[3]), Size = UDim2.fromOffset(d, d),
				BackgroundColor3 = if r.Safe then Color3.fromRGB(90, 80, 60) else Color3.fromRGB(60, 70, 55), BackgroundTransparency = 0.3, Parent = canvas })
			UIKit.corner(f, 999)
			UIKit.label(r.Name, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(120, 30), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
		end
	end
	local tower = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(0, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.fromRGB(200, 60, 50), Parent = canvas })
	UIKit.corner(tower, 999)
	for _, cp in World.Checkpoints do
		local on = p.Checkpoints.Activated[cp.Id]
		local d = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(cp.Position[1], cp.Position[3]), Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = if on then Color3.fromRGB(255, 170, 70) else Color3.fromRGB(90, 90, 90), Parent = canvas })
		UIKit.corner(d, 999)
	end
	if p.LostCurrency then
		local l = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(p.LostCurrency.X, p.LostCurrency.Z), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(255, 90, 30), Parent = canvas })
		UIKit.corner(l, 999)
	end
	local me = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(120, 200, 255), Parent = canvas })
	UIKit.corner(me, 999)
	mapDot = me
	MenuController.MapToCanvas = toMap
	UIKit.label("Red: Tower   Orange: kindled shrines   Ember: lost embers   Blue: you", { Size = UDim2.new(1, 0, 0, 22), TextSize = 14, TextColor3 = T.Muted, Parent = c })
end

Pages.Tower = function(c)
	local p = profile()
	header(c, ("Tower of the Fallen  -  %d / 20 cleared"):format(p.Tower.HighestCleared))
	if player:GetAttribute("ArenaFloor") then
		UIKit.button("Leave arena (forfeit)", function()
			act("LeaveArena")
			MenuController.Close()
		end, { Size = UDim2.fromOffset(220, 32), BackgroundColor3 = Color3.fromRGB(90, 30, 30), Parent = c })
	end
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -70), Parent = c }, 4)
	for floor = 1, 20 do
		local b = Bosses.List[floor]
		local cleared = p.Tower.HighestCleared >= floor
		local unlocked = p.Tower.HighestCleared >= floor - 1
		local r = row(list, 52)
		local clears = p.Tower.Clears[tostring(floor)] or 0
		UIKit.label(("Floor %d  -  %s%s\n%s  (recommended level %d)"):format(floor, if unlocked then b.Name else "???", if cleared then ("   [cleared x%d]"):format(clears) else "",
			if unlocked then b.Mechanic else "Defeat the previous guardian to reveal this floor.", Formulas.recommendedLevel(floor)),
			{ Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -140, 1, -4), TextSize = 14, TextColor3 = if cleared then T.Accent elseif unlocked then T.Text else T.Muted, Parent = r })
		if unlocked then
			UIKit.button(if cleared then "Replay" else "Challenge", function()
				local ok, err = ClientState.Request("EnterFloor", floor)
				notifyResult(ok, err)
				if ok then
					MenuController.Close()
				end
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(120, 30), Parent = r })
		end
	end
	UIKit.label("Encounters begin at the Tower Gate. Party leaders bring every member standing at the gate.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = T.Muted, Parent = c })
end

Pages.Party = function(c)
	local party = ClientState.Party
	header(c, "Fellowship")
	UIKit.label("Parties are optional. Bosses gain health per extra member; every member is rewarded individually.", { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = T.Muted, Parent = c })
	local list = UIKit.list({ Size = UDim2.new(1, 0, 0.45, 0), Parent = c }, 4)
	local isLeader = party.Leader == player.UserId
	if #party.Members == 0 then
		UIKit.label("You are travelling alone.", { Size = UDim2.new(1, 0, 0, 24), Parent = list })
	end
	for _, m in party.Members do
		local r = row(list, 36)
		UIKit.label(("%s%s  -  %s Lv.%d  -  floor %d"):format(m.Name, if m.UserId == party.Leader then " (leader)" else "", m.Class, m.Level, m.Floor),
			{ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -250, 1, 0), TextSize = 16, Parent = r })
		if isLeader and m.UserId ~= player.UserId then
			UIKit.button("Kick", function()
				act("PartyKick", m.UserId)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -120, 0.5, 0), Size = UDim2.fromOffset(100, 28), Parent = r })
			UIKit.button("Promote", function()
				act("PartyPromote", m.UserId)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 28), Parent = r })
		end
	end
	if #party.Members > 0 then
		UIKit.button("Leave party", function()
			act("PartyLeave")
		end, { Size = UDim2.fromOffset(160, 30), Parent = c })
	end
	UIKit.label("Invite players in this server:", { Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Parent = c })
	local others = UIKit.list({ Size = UDim2.new(1, 0, 0.35, 0), Parent = c }, 4)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local r = row(others, 34)
			UIKit.label(("%s  Lv.%d"):format(other.DisplayName, other:GetAttribute("Level") or 1), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, Parent = r })
			UIKit.button("Invite", function()
				act("PartyInvite", other.UserId, "Invite sent.")
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 28), Parent = r })
		end
	end
end

Pages.Achievements = function(c)
	local p = profile()
	local ids = {}
	for id in Achievements do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local da, db = p.Achievements[a] == true, p.Achievements[b] == true
		if da ~= db then
			return da
		end
		return Achievements[a].Name < Achievements[b].Name
	end)
	local n = 0
	for _ in p.Achievements do
		n += 1
	end
	header(c, ("Achievements  %d / %d"):format(n, #ids))
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -34), Parent = c }, 4)
	for _, id in ids do
		local a = Achievements[id]
		local done = p.Achievements[id] == true
		local prog = ""
		if a.Stat and not done then
			prog = ("  (%d / %d)"):format(math.min(p.Stats[a.Stat] or 0, a.Goal), a.Goal)
		end
		local reward = a.Reward and (a.Reward.Title and ("Title: " .. a.Reward.Title) or a.Reward.Cosmetic and ("Cosmetic: " .. Cosmetics[a.Reward.Cosmetic].Name)) or ""
		local r = row(list, 40)
		UIKit.label(("%s%s%s\n%s  %s"):format(if done then "[x] " else "[ ] ", a.Name, prog, a.Description, reward), { Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 1, -4), TextSize = 14,
			TextColor3 = if done then T.Accent else T.Text, Parent = r })
	end
end

Pages.Cosmetics = function(c)
	local p = profile()
	header(c, "Wardrobe (cosmetic only - never affects combat)")
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -34), Parent = c }, 4)
	for _, slot in { "Aura", "WeaponSkin", "ArmorDye" } do
		UIKit.label(slot, { Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = T.Accent, Parent = list })
		local r0 = row(list, 32)
		UIKit.button("None", function()
			act("EquipCosmetic", { Slot = slot, Id = "" })
		end, { Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(100, 28), Parent = r0 })
		for id, def in Cosmetics do
			if def.Type == slot and p.Cosmetics.Owned[id] then
				local r = row(list, 32)
				local equipped = p.Cosmetics.Equipped[slot] == id
				UIKit.label(def.Name .. (if equipped then "  (equipped)" else ""), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, TextColor3 = def.Color, Parent = r })
				UIKit.button("Equip", function()
					act("EquipCosmetic", { Slot = slot, Id = id })
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 26), Parent = r })
			end
		end
	end
	UIKit.label("Titles", { Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = T.Accent, Parent = list })
	local titles = {}
	for t in p.Titles do
		table.insert(titles, t)
	end
	table.sort(titles)
	table.insert(titles, 1, "")
	for _, t in titles do
		local r = row(list, 32)
		UIKit.label(if t == "" then "(no title)" else t, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, Parent = r })
		UIKit.button(if p.ActiveTitle == t then "Active" else "Use", function()
			act("SetTitle", t)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 26), Parent = r })
	end
	UIKit.label("Store", { Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = T.Accent, Parent = list })
	local anyProduct = false
	for key, prod in Products.DevProducts do
		if prod.Id ~= 0 then
			anyProduct = true
			local r = row(list, 32)
			UIKit.label(("%s  -  R$ %d"):format(prod.Name, prod.PriceRobux), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, Parent = r })
			UIKit.button("Buy", function()
				act("PromptProduct", key)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 26), Parent = r })
		end
	end
	for key, pass in Products.GamePasses do
		if pass.Id ~= 0 then
			anyProduct = true
			local r = row(list, 40)
			UIKit.label(("%s  -  R$ %d\n%s"):format(pass.Name, pass.PriceRobux, pass.Description), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 14, Parent = r })
			UIKit.button(if p.HasWardrobePass then "Owned" else "Buy", function()
				act("PromptPass", key)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 26), Parent = r })
		end
	end
	if not anyProduct then
		UIKit.label("The store is not open yet.", { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = T.Muted, Parent = list })
	end
end

local SETTINGS_NUMERIC = {
	{ Key = "CameraSensitivity", Name = "Camera sensitivity", Step = 0.1, Min = 0.2, Max = 3 },
	{ Key = "MusicVolume", Name = "Music volume", Step = 0.1, Min = 0, Max = 1 },
	{ Key = "SfxVolume", Name = "Effects volume", Step = 0.1, Min = 0, Max = 1 },
	{ Key = "TextScale", Name = "Interface scale", Step = 0.05, Min = 0.75, Max = 1.5 },
}
local SETTINGS_TOGGLES = {
	{ Key = "ShowDamageNumbers", Name = "Damage numbers" },
	{ Key = "HighContrastTelegraphs", Name = "High-contrast attack telegraphs" },
	{ Key = "ReducedEffects", Name = "Reduced visual effects" },
	{ Key = "ScreenShake", Name = "Screen shake" },
	{ Key = "MouseLock", Name = "Combat mouse lock (desktop)" },
	{ Key = "ShowControls", Name = "Show controls legend" },
}

Pages.Settings = function(c)
	local s = ClientState.Settings
	header(c, "Settings")
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -80), Parent = c }, 4)
	for _, n in SETTINGS_NUMERIC do
		local r = row(list, 34)
		UIKit.label(("%s: %.2f"):format(n.Name, s[n.Key] or 1), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 16, Parent = r })
		UIKit.button("-", function()
			s[n.Key] = math.clamp((s[n.Key] or 1) - n.Step, n.Min, n.Max)
			MenuController.ApplySettings()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -54, 0.5, 0), Size = UDim2.fromOffset(36, 26), Parent = r })
		UIKit.button("+", function()
			s[n.Key] = math.clamp((s[n.Key] or 1) + n.Step, n.Min, n.Max)
			MenuController.ApplySettings()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(36, 26), Parent = r })
	end
	for _, tg in SETTINGS_TOGGLES do
		local r = row(list, 34)
		UIKit.label(tg.Name, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 16, Parent = r })
		UIKit.button(if s[tg.Key] then "On" else "Off", function()
			s[tg.Key] = not s[tg.Key]
			MenuController.ApplySettings()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(80, 26), Parent = r })
	end
	UIKit.button("Save settings", function()
		act("SaveSettings", s, "Settings saved.")
	end, { Size = UDim2.fromOffset(180, 32), Parent = c })
end

Pages.Codes = function(c)
	local p = profile()
	header(c, "Promo Codes")
	local r = row(c, 44)
	local box = UIKit.new("TextBox", {
		Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -150, 0, 32), BackgroundColor3 = T.Bg, TextColor3 = T.Text,
		PlaceholderText = "Enter a code", PlaceholderColor3 = T.Muted, Font = T.Font, TextSize = 18, Text = "",
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Parent = r,
	}) :: TextBox
	UIKit.corner(box, 6)
	UIKit.padding(box, 6)
	UIKit.button("Redeem", function()
		local ok, res = ClientState.Request("RedeemCode", box.Text)
		notifyResult(ok, res, if res == "Admin" then "Admin access granted." else "Code redeemed!")
		if ok then
			box.Text = ""
		end
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 32), Parent = r })

	local admin = p.Admin
	if not (admin and admin.Granted) then
		return
	end
	header(c, "Admin Panel")
	UIKit.label("Available because you redeemed an admin code.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = T.Muted, Parent = c })
	local god = row(c, 40)
	UIKit.label(("Never Die: %s"):format(if admin.GodMode then "ON" else "OFF"), { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -150, 1, 0), TextSize = 18, Parent = god })
	UIKit.button(if admin.GodMode then "Turn off" else "Turn on", function()
		act("AdminAction", { Action = "GodMode", On = not admin.GodMode })
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 30), Parent = god })
	for _, entry in {
		{ "UnlockAll", "Unlock all", "All 20 floors cleared, every shrine, location and ability, max flask charges." },
		{ "MaxUpgrades", "All upgrades", "Every owned weapon, shield and armour piece to its maximum level." },
		{ "AllItems", "All items", "One of every weapon, shield, armour piece and accessory, plus full stacks of consumables and materials." },
		{ "AllCosmetics", "All customisations", "Every aura, weapon finish, dye and title." },
	} do
		local er = row(c, 48)
		UIKit.label(("%s\n%s"):format(entry[2], entry[3]), { Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -150, 1, -4), TextSize = 14, Parent = er })
		UIKit.button("Apply", function()
			act("AdminAction", { Action = entry[1] })
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 30), Parent = er })
	end
end

-- ===================================================================== NPC pages
Pages.Shop = function(c)
	local p = profile()
	local shop = Shops[context.Shop]
	header(c, ("%s  -  %d Embers"):format(shop.Name, p.Currency))
	UIKit.label("Selling: open the Inventory tab while talking to a merchant.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = T.Muted, Parent = c })
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -56), Parent = c }, 4)
	for _, entry in shop.Stock do
		local def = Items[entry.Item]
		local locked = (entry.RequiresFloor or 0) > p.Tower.HighestCleared
		local r = row(list, 52)
		local owned = p.Inventory.Stacks[entry.Item]
		if not owned then
			owned = 0
			for _, inst in p.Inventory.Items do
				if inst.Id == entry.Item then
					owned += 1
				end
			end
		end
		local limit = ""
		if entry.Limit then
			limit = ("  (limit %d, bought %d)"):format(entry.Limit, p.ShopPurchases[context.Shop .. ":" .. entry.Item] or 0)
		end
		UIKit.label(("%s  -  %d%s   owned %d\n%s"):format(def.Name, entry.Price, limit, owned, if locked then ("Unlocks after tower floor %d"):format(entry.RequiresFloor) else (describeItem(def, 0, p.Derived.Attributes):match("[^\n]*\n?([^\n]*)") or "")),
			{ Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -240, 1, -4), TextSize = 14, TextColor3 = if locked then T.Muted else rarityColor(def), Parent = r })
		if not locked then
			UIKit.button("Buy 1", function()
				act("Buy", { Shop = context.Shop, Item = entry.Item, Quantity = 1 })
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -116, 0.5, 0), Size = UDim2.fromOffset(100, 28), Parent = r })
			if def.Stackable then
				UIKit.button("Buy 5", function()
					act("Buy", { Shop = context.Shop, Item = entry.Item, Quantity = 5 })
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 28), Parent = r })
			end
		end
	end
end

Pages.Blacksmith = function(c)
	local p = profile()
	header(c, ("Doran's Forge  -  %d Embers"):format(p.Currency))
	local body = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -34), Parent = c })
	local list = UIKit.list({ Size = UDim2.new(0.5, -4, 1, 0), Parent = body }, 4)
	local detail = UIKit.panel({ Position = UDim2.new(0.5, 4, 0, 0), Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = T.Bg, Parent = body })
	UIKit.padding(detail, 10)
	local entries = {}
	for uid, inst in p.Inventory.Items do
		local def = Items[inst.Id]
		if def.Kind == "Weapon" or def.Kind == "Shield" or def.Kind == "Armor" then
			table.insert(entries, { Uid = uid, Inst = inst, Def = def })
		end
	end
	table.sort(entries, function(a, b)
		return itemName(a.Inst) < itemName(b.Inst)
	end)
	for _, e in entries do
		UIKit.button(itemName(e.Inst), function()
			selectedItem = e.Uid
			MenuController.Render()
		end, { Size = UDim2.new(1, -8, 0, 30), TextSize = 15, TextColor3 = rarityColor(e.Def), Parent = list })
	end
	if selectedItem and p.Inventory.Items[selectedItem] then
		local uid = selectedItem
		local inst = p.Inventory.Items[uid]
		UIKit.label(itemName(inst), { Size = UDim2.new(1, 0, 0, 26), TextSize = 22, TextColor3 = rarityColor(Items[inst.Id]), Parent = detail })
		local info = UIKit.label("Inspecting...", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -80), TextSize = 17, TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
		task.spawn(function()
			local ok, preview = ClientState.Request("UpgradePreview", uid)
			if not info.Parent then
				return
			end
			if not ok then
				info.Text = ClientState.ErrorText(preview)
				return
			end
			local cost = preview.Cost
			local have = p.Inventory.Stacks[cost.Material] or 0
			info.Text = ("Upgrade +%d  ->  +%d\n\n%s: %d  ->  %d\n\nCost: %d Embers + %s x%d (you have %d)"):format(
				preview.From, preview.To, if Items[inst.Id].Kind == "Weapon" then "Attack" elseif Items[inst.Id].Kind == "Shield" then "Stability" else "Defence",
				math.floor(preview.Before or 0), math.floor(preview.After or 0), cost.Currency, Items[cost.Material].Name, cost.Amount, have)
			UIKit.button("Confirm upgrade", function()
				act("Upgrade", uid)
			end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromOffset(180, 34), Parent = detail })
		end)
	else
		UIKit.label("Select equipment to see upgrade costs and results before confirming.", { Size = UDim2.fromScale(1, 1), TextColor3 = T.Muted, Parent = detail })
	end
end

Pages.Quest = function(c)
	local p = profile()
	header(c, context.Name or "Quests")
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -34), Parent = c }, 6)
	for _, id in context.Quests or {} do
		local q = Quests[id]
		local status
		if p.Quests.Completed[id] then
			status = "Completed"
		elseif p.Quests.Active[id] then
			status = "Active"
		else
			status = "Available"
			for _, req in q.Requires do
				if not p.Quests.Completed[req] then
					status = "Locked"
				end
			end
		end
		local r = row(list, 70)
		local rewards = {}
		if q.Rewards.Xp then
			table.insert(rewards, q.Rewards.Xp .. " XP")
		end
		if q.Rewards.Currency then
			table.insert(rewards, q.Rewards.Currency .. " Embers")
		end
		for item, n in q.Rewards.Items or {} do
			table.insert(rewards, Items[item].Name .. " x" .. n)
		end
		if q.Rewards.Title then
			table.insert(rewards, "Title: " .. q.Rewards.Title)
		end
		UIKit.label(("%s  [%s]%s\n%s\nRewards: %s"):format(q.Name, status, if status == "Active" then "  " .. questProgressText(p, id) else "", if status == "Locked" then "Complete earlier tasks first." else q.Description, table.concat(rewards, ", ")),
			{ Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -140, 1, -4), TextSize = 14, TextColor3 = if status == "Locked" then T.Muted else T.Text, Parent = r })
		if status == "Available" then
			UIKit.button("Accept", function()
				act("AcceptQuest", id)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(110, 30), Parent = r })
		elseif status == "Active" then
			UIKit.button("Turn in", function()
				act("TurnInQuest", id)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(110, 30), Parent = r })
		end
	end
end

Pages.Shrine = function(c)
	local p = profile()
	local name = context.ShrineId
	for _, cp in World.Checkpoints do
		if cp.Id == context.ShrineId then
			name = cp.Name
		end
	end
	header(c, name)
	UIKit.label("You rest by the embers. Health, stamina, mana and flask charges are restored, and you will return here when you fall.", { Size = UDim2.new(1, 0, 0, 44), TextSize = 16, Parent = c })
	UIKit.button(("Level up (%d point%s)"):format(p.UnspentPoints, p.UnspentPoints == 1 and "" or "s"), function()
		MenuController.Show("Character")
	end, { Size = UDim2.fromOffset(220, 34), Parent = c })
	UIKit.label("Travel to a kindled shrine:", { Size = UDim2.new(1, 0, 0, 24), TextSize = 17, TextColor3 = T.Accent, Parent = c })
	local list = UIKit.list({ Size = UDim2.new(1, 0, 1, -140), Parent = c }, 4)
	for _, cp in World.Checkpoints do
		if p.Checkpoints.Activated[cp.Id] and cp.Id ~= context.ShrineId then
			UIKit.button(cp.Name, function()
				local ok, err = ClientState.Request("Travel", cp.Id)
				notifyResult(ok, err)
				if ok then
					MenuController.Close()
				end
			end, { Size = UDim2.new(1, -8, 0, 32), Parent = list })
		end
	end
end

local TUTORIAL = {
	"Welcome to the Fallen Sanctuary. The tower above us holds twenty guardians. Defeat them, one floor at a time.",
	"Combat is deliberate: attacks, dodges, blocks and parries cost STAMINA. Watch the green bar - an exhausted fighter cannot roll.",
	"Enemy attacks are telegraphed on the ground. GOLD markings can be parried (F), WHITE can be blocked (RMB), RED must be avoided. Dodging (Q) grants a moment of invulnerability.",
	"Lock on with T (or the Lock button) to keep your target in view. Heavy attacks (hold R) break poise; a staggered foe takes a devastating riposte.",
	"Your Ember Flask (H) heals. Rest at Ember Shrines to refill it, set your respawn point and spend attribute points.",
	"When you die you drop your carried Embers where you fell. Return and touch the glowing marker to reclaim them - die again first and they are lost.",
	"Merchants sell gear, the blacksmith upgrades it, and the Training Grounds east of here sharpen your skills. Party up at the Fellowship Board if you want company.",
}

Pages.Tutorial = function(c)
	context.Page = context.Page or 1
	header(c, "Ilya the Guide")
	UIKit.label(TUTORIAL[context.Page], { Size = UDim2.new(1, 0, 0, 120), TextSize = 20, Parent = c })
	UIKit.label(("%d / %d"):format(context.Page, #TUTORIAL), { Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.Muted, Parent = c })
	UIKit.button(if context.Page < #TUTORIAL then "Next" else "Farewell", function()
		if context.Page < #TUTORIAL then
			context.Page += 1
			MenuController.Render()
		else
			MenuController.Close()
		end
	end, { Size = UDim2.fromOffset(160, 34), Parent = c })
end

-- ===================================================================== window
local function buildWindow()
	window = UIKit.panel({ Name = "Menu", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.9, 0, 0.85, 0), BackgroundColor3 = T.Bg, Visible = false, Parent = gui })
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(980, 620), Parent = window })
	titleLabel = UIKit.label("", { Position = UDim2.fromOffset(16, 6), Size = UDim2.new(1, -80, 0, 34), TextSize = 28, TextColor3 = T.Accent, Parent = window })
	UIKit.button("X", function()
		MenuController.Close()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(36, 32), Parent = window })
	tabBar = UIKit.list({ Position = UDim2.fromOffset(10, 48), Size = UDim2.new(0, 150, 1, -58), Parent = window }, 4)
	content = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(170, 48), Size = UDim2.new(1, -184, 1, -58), Parent = window })
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })
	for i, name in MAIN_TABS do
		local b = UIKit.button(name, function()
			context = {}
			selectedItem = nil
			MenuController.Show(name)
		end, { Size = UDim2.new(1, -8, 0, 34), LayoutOrder = i, Parent = tabBar })
		b.Name = name
	end
end

function MenuController.Render()
	if not window.Visible or not profile() then
		return
	end
	UIKit.clear(content)
	titleLabel.Text = if context.Menu then (context.Name or currentPage) else currentPage
	for _, b in tabBar:GetChildren() do
		if b:IsA("TextButton") then
			b.BackgroundColor3 = if b.Name == currentPage then T.Border else T.Panel2
		end
	end
	local page = Pages[currentPage]
	if page then
		local ok, err = pcall(page, content)
		if not ok then
			warn("[Menu] render error: " .. tostring(err))
		end
	end
end

function MenuController.Show(page: string)
	currentPage = page
	window.Visible = true
	InputController.SetMenuOpen(true)
	MenuController.Render()
	if UserInputService.GamepadEnabled then
		local first = tabBar:FindFirstChild(page) or tabBar:FindFirstChildWhichIsA("TextButton")
		GuiService.SelectedObject = first
	end
end

function MenuController.Close()
	window.Visible = false
	context = {}
	InputController.SetMenuOpen(false)
	GuiService.SelectedObject = nil
end

function MenuController.Toggle()
	if classOverlay then
		return
	end
	if window.Visible then
		MenuController.Close()
	else
		MenuController.Show(currentPage ~= "" and Pages[currentPage] and not table.find({ "Shop", "Blacksmith", "Quest", "Shrine", "Tutorial" }, currentPage) and currentPage or "Character")
	end
end

function MenuController.ApplySettings()
	local s = ClientState.Settings
	if not s then
		return
	end
	AudioController.ApplySettings(s)
	local cb = MenuController.OnSettings
	if cb then
		cb(s)
	end
	MenuController.Render()
end

-- ===================================================================== class selection
local function showClassSelect()
	if classOverlay then
		return
	end
	InputController.SetMenuOpen(true)
	local overlay = UIKit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.25, Size = UDim2.fromScale(1, 1), Parent = gui })
	classOverlay = overlay
	UIKit.label("TOWER OF THE FALLEN", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 30), Size = UDim2.fromOffset(800, 60), TextSize = 52, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Center, Parent = overlay })
	UIKit.label("Choose who you were before the fall. Your class shapes where you begin - never what you may become.", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 92), Size = UDim2.fromOffset(820, 30), TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, Parent = overlay })
	local grid = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 130), Size = UDim2.new(0.94, 0, 0, 230), BackgroundTransparency = 1, Parent = overlay })
	UIKit.new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -8, 0.5, -6), CellPadding = UDim2.fromOffset(8, 8), Parent = grid })
	local detail = UIKit.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 370), Size = UDim2.new(0.94, 0, 0, 220), BackgroundColor3 = T.Bg, Parent = overlay })
	UIKit.padding(detail, 12)
	local info = UIKit.label("Select a class.", { Size = UDim2.new(1, 0, 1, -44), TextSize = 17, TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })
	local confirm
	local function select(name)
		local c = Classes[name]
		local attrs = {}
		for _, a in GameConfig.Attributes.List do
			table.insert(attrs, ("%s %d"):format(a:sub(1, 3), c.Attributes[a]))
		end
		local abil = {}
		for _, id in c.Abilities do
			table.insert(abil, ("%s%s"):format(Abilities[id].Name, if Abilities[id].UnlockLevel > 1 then (" (level %d)"):format(Abilities[id].UnlockLevel) else ""))
		end
		info.Text = ("%s  -  %s\n%s\n\nAttributes: %s\nStarting weapon: %s%s\nAbilities: %s"):format(
			c.Name, c.Playstyle, c.Description, table.concat(attrs, "  "), Items[c.Loadout.Weapon].Name,
			if c.Loadout.Offhand then " + " .. Items[c.Loadout.Offhand].Name else "", table.concat(abil, ", "))
		if confirm then
			confirm:Destroy()
		end
		confirm = UIKit.button("Begin as " .. c.Name, function()
			local ok, err = ClientState.Request("ChooseClass", name)
			if ok then
				overlay:Destroy()
				classOverlay = nil
				InputController.SetMenuOpen(false)
			else
				HUD.Toast(ClientState.ErrorText(err), "Error")
			end
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(220, 38), Parent = detail })
	end
	for _, name in Classes.Order do
		local c = Classes[name]
		local card = UIKit.button("", function()
			select(name)
		end, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Panel, Parent = grid })
		UIKit.label(c.Name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 30), TextSize = 26, TextColor3 = c.Color, Parent = card })
		UIKit.label(c.Playstyle, { Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -24, 0, 22), TextSize = 16, TextColor3 = T.Muted, Parent = card })
	end
	select(Classes.Order[1])
end

-- ===================================================================== init
function MenuController.Init(deps)
	UIKit = deps.UIKit
	ClientState = deps.ClientState
	InputController = deps.InputController
	HUD = deps.HUDController
	AudioController = deps.AudioController
	T = UIKit.Theme
	gui = UIKit.new("ScreenGui", { Name = "TotfMenu", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })
	UIKit.new("UIScale", { Name = "Scale", Parent = gui })
	buildWindow()

	ClientState.Changed:Connect(function(p)
		if p.Class == "" then
			showClassSelect()
		elseif classOverlay then
			classOverlay:Destroy()
			classOverlay = nil
			InputController.SetMenuOpen(false)
		end
		local scale = gui:FindFirstChild("Scale") :: UIScale
		scale.Scale = math.clamp(p.Settings.TextScale or 1, 0.75, 1.5)
		MenuController.Render()
	end)
	ClientState.PartyChanged:Connect(function()
		if currentPage == "Party" then
			MenuController.Render()
		end
	end)

	Net.event("OpenUI").OnClientEvent:Connect(function(payload)
		context = payload
		selectedItem = nil
		local map = { Shop = "Shop", Blacksmith = "Blacksmith", Quest = "Quest", Shrine = "Shrine", Tower = "Tower", Party = "Party", Wardrobe = "Cosmetics", Tutorial = "Tutorial" }
		local page = map[payload.Menu]
		if page then
			if page == "Tower" or page == "Party" or page == "Cosmetics" then
				context = {}
			end
			MenuController.Show(page)
		end
	end)

	Net.event("Party").OnClientEvent:Connect(function(payload)
		if payload.Type ~= "Invite" then
			return
		end
		local pop = UIKit.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(380, 110), BackgroundColor3 = T.Bg, Parent = gui })
		UIKit.padding(pop, 10)
		UIKit.label(payload.FromName .. " invites you to their party.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 18, Parent = pop })
		UIKit.button("Accept", function()
			act("PartyRespond", true, "Joined the party.")
			pop:Destroy()
		end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromOffset(150, 32), Parent = pop })
		UIKit.button("Decline", function()
			ClientState.Request("PartyRespond", false)
			pop:Destroy()
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(150, 32), Parent = pop })
		task.delay(GameConfig.Party.InviteExpiry, function()
			if pop.Parent then
				pop:Destroy()
			end
		end)
	end)

	-- live map dot
	RunService.RenderStepped:Connect(function()
		local toMap = MenuController.MapToCanvas
		if window.Visible and currentPage == "Map" and mapDot and mapDot.Parent and toMap then
			local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if r then
				mapDot.Position = toMap((r :: BasePart).Position.X, (r :: BasePart).Position.Z)
			end
		end
	end)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--[[
	UIKit
	Small helper library for building the dark-fantasy interface in code: theme, frames,
	labels, buttons (mouse/touch/gamepad selectable), bars and scrolling lists.
]]

local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Theme = {
	Bg = Color3.fromRGB(14, 12, 16),
	Panel = Color3.fromRGB(26, 23, 28),
	Panel2 = Color3.fromRGB(36, 32, 38),
	Border = Color3.fromRGB(110, 88, 56),
	Accent = Color3.fromRGB(214, 170, 90),
	Text = Color3.fromRGB(236, 226, 206),
	Muted = Color3.fromRGB(160, 150, 136),
	Danger = Color3.fromRGB(210, 60, 50),
	Good = Color3.fromRGB(110, 200, 120),
	Health = Color3.fromRGB(190, 40, 40),
	Stamina = Color3.fromRGB(90, 170, 70),
	Mana = Color3.fromRGB(70, 110, 220),
	Xp = Color3.fromRGB(214, 170, 90),
	Font = Enum.Font.Garamond,
	FontBold = Enum.Font.GothamBold,
}
local T = UIKit.Theme

function UIKit.new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in props or {} do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UIKit.corner(parent: Instance, r: number?)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

function UIKit.stroke(parent: Instance, color: Color3?, thickness: number?)
	return UIKit.new("UIStroke", { Color = color or T.Border, Thickness = thickness or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UIKit.padding(parent: Instance, px: number)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), Parent = parent,
	})
end

function UIKit.panel(props)
	props.BackgroundColor3 = props.BackgroundColor3 or T.Panel
	props.BorderSizePixel = 0
	local f = UIKit.new("Frame", props)
	UIKit.corner(f, 8)
	UIKit.stroke(f)
	return f
end

function UIKit.label(text: string, props)
	props = props or {}
	props.Text = text
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or T.Font
	props.TextColor3 = props.TextColor3 or T.Text
	props.TextSize = props.TextSize or 18
	props.TextWrapped = if props.TextWrapped == nil then true else props.TextWrapped
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return UIKit.new("TextLabel", props)
end

function UIKit.button(text: string, onClick: () -> (), props)
	props = props or {}
	props.Text = text
	props.AutoButtonColor = true
	props.BackgroundColor3 = props.BackgroundColor3 or T.Panel2
	props.Font = props.Font or T.Font
	props.TextColor3 = props.TextColor3 or T.Text
	props.TextSize = props.TextSize or 18
	props.Size = props.Size or UDim2.fromOffset(140, 36)
	props.Selectable = true
	local b = UIKit.new("TextButton", props) :: TextButton
	UIKit.corner(b, 6)
	UIKit.stroke(b, T.Border, 1)
	b.Activated:Connect(function()
		onClick()
	end)
	return b
end

-- Vertical scrolling list that grows with its content.
function UIKit.list(props, spacing: number?)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = props.ScrollBarThickness or 6
	props.ScrollBarImageColor3 = T.Border
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.CanvasSize = UDim2.new()
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	local s = UIKit.new("ScrollingFrame", props)
	UIKit.new("UIListLayout", { Padding = UDim.new(0, spacing or 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = s })
	return s
end

function UIKit.clear(container: Instance)
	for _, c in container:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

-- Resource bar. Returns an object with :Set(current, max).
function UIKit.bar(parent: Instance, color: Color3, props)
	props = props or {}
	props.BackgroundColor3 = Color3.fromRGB(20, 18, 20)
	props.BorderSizePixel = 0
	props.Parent = parent
	local bg = UIKit.new("Frame", props)
	UIKit.corner(bg, 4)
	UIKit.stroke(bg, Color3.fromRGB(60, 50, 40), 1)
	local lag = UIKit.new("Frame", { BackgroundColor3 = Color3.fromRGB(230, 200, 150), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = bg })
	UIKit.corner(lag, 4)
	local fill = UIKit.new("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = bg })
	UIKit.corner(fill, 4)
	local text = UIKit.label("", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.FontBold, Parent = bg, ZIndex = 3 })
	local obj = {}
	local lastFrac = -1
	function obj.Set(_self, current: number, max: number, showText: boolean?)
		local frac = if max > 0 then math.clamp(current / max, 0, 1) else 0
		text.Text = if showText ~= false then ("%d / %d"):format(math.floor(current), math.floor(max)) else ""
		if math.abs(frac - lastFrac) < 0.001 then
			return
		end
		local dropped = frac < lastFrac
		lastFrac = frac
		fill.Size = UDim2.fromScale(frac, 1)
		if dropped then
			-- damage "lag" chip shows how much was lost
			TweenService:Create(lag, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.25), { Size = UDim2.fromScale(frac, 1) }):Play()
		else
			lag.Size = UDim2.fromScale(frac, 1)
		end
	end
	obj.Frame = bg
	obj.Text = text
	return obj
end

function UIKit.tween(inst: Instance, t: number, props)
	local tw = TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="121">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point. Wires controllers together; each controller only presents state and
	sends intents - all outcomes are decided by the server.
]]

local Controllers = script.Parent:WaitForChild("Controllers")

local UIKit = require(Controllers.UIKit)
local ClientState = require(Controllers.ClientState)
local AudioController = require(Controllers.AudioController)
local CameraController = require(Controllers.CameraController)
local CombatController = require(Controllers.CombatController)
local InputController = require(Controllers.InputController)
local HUDController = require(Controllers.HUDController)
local MenuController = require(Controllers.MenuController)
local EffectsController = require(Controllers.EffectsController)

local deps = {
	UIKit = UIKit,
	ClientState = ClientState,
	AudioController = AudioController,
	CameraController = CameraController,
	CombatController = CombatController,
	InputController = InputController,
	HUDController = HUDController,
	MenuController = MenuController,
	EffectsController = EffectsController,
}

ClientState.Init()
AudioController.Init()
CameraController.Init()
CombatController.Init(deps)
HUDController.Init(deps)
MenuController.Init(deps)
InputController.Init(deps)
EffectsController.Init(deps)

MenuController.OnSettings = function(settings)
	EffectsController.ApplySettings(settings)
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="122">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>