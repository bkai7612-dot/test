      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">Achievement.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local AchievementCore = require(SSS.Server.Core.AchievementCore)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect
	t.it("stat achievements unlock once and grant titles", function()
		local p = Helpers.profile("Warrior")
		AchievementCore.increment(p, "Kills")
		local u = AchievementCore.evaluate(p)
		local found = false
		for _, a in u do if a.Id == "first_blood" then found = true end end
		expect(found).toBe(true)
		expect(p.Titles.Initiate).toBe(true)
		local again = AchievementCore.evaluate(p)
		for _, a in again do expect(a.Id ~= "first_blood").toBeTruthy() end
	end)
	t.it("hybrid check", function()
		local p = Helpers.profile("Warrior")
		p.Attributes.Strength = 30
		p.Attributes.Intelligence = 30
		AchievementCore.evaluate(p)
		expect(p.Achievements.hybrid).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">Balance.spec</string>
          <string name="Source"><![CDATA[--[[
	Balance simulation (Tester). For every class at every floor's recommended level and upgrade,
	estimates time-to-kill on the floor's boss and the share of player HP a boss hit removes.
	Bounds are deliberately wide; they catch broken tuning, not fine balance.
]]
local RS = game:GetService("ReplicatedStorage")
local Formulas = require(RS.Shared.Logic.Formulas)
local Items = require(RS.Shared.Config.Items)
local Bosses = require(RS.Shared.Config.Bosses)
local Classes = require(RS.Shared.Config.Classes)
local WeaponTypes = require(RS.Shared.Config.WeaponTypes)
local GameConfig = require(RS.Shared.Config.GameConfig)

-- Build plans: share of levelled points per attribute.
local Plans = {
	Warrior = { Vigor = 0.32, Endurance = 0.18, Strength = 0.4, Dexterity = 0.1 },
	Knight = { Vigor = 0.35, Endurance = 0.2, Strength = 0.35, Dexterity = 0.1 },
	Mage = { Vigor = 0.3, Endurance = 0.12, Intelligence = 0.5, Dexterity = 0.08 },
	Wizard = { Vigor = 0.3, Endurance = 0.12, Intelligence = 0.5, Faith = 0.08 },
	Assassin = { Vigor = 0.3, Endurance = 0.15, Dexterity = 0.45, Arcane = 0.1 },
	Paladin = { Vigor = 0.32, Endurance = 0.15, Strength = 0.23, Faith = 0.3 },
}
-- Weapon progression: { fromFloorCleared, itemId }
local Weapons = {
	Warrior = { { 0, "warrior_handaxe" }, { 1, "iron_greatsword" }, { 6, "executioner_axe" }, { 10, "siege_breaker" }, { 13, "champion_blade" }, { 18, "general_warblade" } },
	Knight = { { 0, "knight_longsword" }, { 4, "gravebound_blade" }, { 15, "regent_sword" } },
	Mage = { { 0, "apprentice_staff" }, { 2, "lucent_staff" }, { 8, "veiled_staff" }, { 17, "eclipse_staff" } },
	Wizard = { { 0, "apprentice_staff" }, { 2, "lucent_staff" }, { 8, "veiled_staff" }, { 17, "eclipse_staff" } },
	Assassin = { { 0, "shadow_dagger" }, { 2, "serrated_dagger" }, { 5, "ember_fangs" }, { 9, "crimson_rapier" }, { 12, "reaper_scythe" } },
	Paladin = { { 0, "lightbound_mace" }, { 3, "thorn_seal" }, { 11, "oracle_seal" }, { 19, "godbreaker" } },
}

local function buildAttrs(class, level)
	local attrs = table.clone(Classes[class].Attributes)
	local pts = level - 1
	for attr, share in Plans[class] do
		attrs[attr] = math.min(GameConfig.Attributes.Max, attrs[attr] + math.floor(pts * share))
	end
	return attrs
end

local function weaponFor(class, floor)
	local pick = Weapons[class][1][2]
	for _, w in Weapons[class] do
		if floor - 1 >= w[1] then pick = w[2] end
	end
	return Items[pick]
end

local function upgradeFor(def, floor)
	local u = Formulas.recommendedUpgrade(floor)
	if def.Upgrade == "Unique" then
		u = math.min(5, math.floor(u / 2))
	end
	return u
end

local function estimate(class, floor)
	local level = Formulas.recommendedLevel(floor)
	local attrs = buildAttrs(class, level)
	local def = weaponFor(class, floor)
	local ar = Formulas.weaponAttackRating(def, upgradeFor(def, floor), attrs).Total
	local wt = WeaponTypes[def.WeaponType]
	local motions = wt.Light.Motion
	local avg = 0
	for _, m in motions do avg += m end
	avg /= #motions
	local cycle = wt.Light.Windup + wt.Light.Recovery * 0.85
	local uptime = if wt.Ranged then 0.45 else 0.35
	local boss = Bosses.List[floor]
	local absorb = Formulas.absorption(boss.Defense, GameConfig.Combat.EnemyDefenseK)
	local dps = ar * avg / cycle * uptime * (1 - absorb)
	local hp = Formulas.bossHealth(floor) * boss.HealthMult
	if boss.Mechanics.Twin then hp *= boss.Mechanics.Twin.Count end
	local ttk = hp / dps

	-- incoming: player HP vs biggest single hit
	local playerHp = Formulas.maxHealth(attrs)
	local armorDef = 30 + 5.5 * floor -- typical worn armour at that point incl. upgrades
	local maxMult = 0
	for _, phase in boss.Phases do
		local lists = {}
		if phase.Stances then for _, s in phase.Stances do table.insert(lists, s.Attacks) end else lists = { phase.Attacks } end
		for _, list in lists do
			for _, a in list do
				local steps = if a.Shape == "Combo" then a.Steps else { a }
				for _, s in steps do maxMult = math.max(maxMult, s.Damage or 0) end
			end
		end
	end
	local hit = Formulas.bossDamage(floor) * boss.DamageMult * maxMult * (1 - Formulas.absorption(armorDef, GameConfig.Combat.PlayerDefenseK))
	return ttk, hit / playerHp, ar
end

return function(t)
	local expect = t.expect

	t.it("solo time-to-kill stays within 30s..360s (final boss 450s) for every class and floor", function()
		local report = {}
		for floor = 1, 20 do
			local maxTtk = if floor == 20 then 450 else 360
			for _, class in Classes.Order do
				local ttk = estimate(class, floor)
				if ttk < 30 or ttk > maxTtk then
					table.insert(report, ("%s floor %d TTK %.0fs"):format(class, floor, ttk))
				end
			end
		end
		if #report > 0 then error(table.concat(report, "; ")) end
	end)

	t.it("no boss hit removes more than the fairness cap of HP at recommended level", function()
		local report = {}
		for floor = 1, 20 do
			for _, class in Classes.Order do
				local _, frac = estimate(class, floor)
				if frac > Bosses.Fairness.MaxHitFractionOfHealth then
					table.insert(report, ("%s floor %d biggest hit %.0f%%"):format(class, floor, frac * 100))
				end
			end
		end
		if #report > 0 then error(table.concat(report, "; ")) end
	end)

	t.it("bosses remain threatening (biggest hit >= 15% HP)", function()
		for floor = 1, 20 do
			local _, frac = estimate("Knight", floor)
			expect(frac >= 0.15).toBeTruthy()
		end
	end)

	t.it("prints a balance table", function()
		local lines = { "floor | " .. table.concat(Classes.Order, " | ") }
		for floor = 1, 20, 3 do
			local row = { tostring(floor) }
			for _, class in Classes.Order do
				local ttk, frac = estimate(class, floor)
				table.insert(row, ("%3.0fs/%2.0f%%"):format(ttk, frac * 100))
			end
			table.insert(lines, table.concat(row, " | "))
		end
		print("[balance] TTK / biggest-hit-%HP\n" .. table.concat(lines, "\n"))
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">BossFairness.spec</string>
          <string name="Source"><![CDATA[-- Tester-owned fairness and design checks for all 20 bosses.
local RS = game:GetService("ReplicatedStorage")
local Bosses = require(RS.Shared.Config.Bosses)
local BossBrain = require(game:GetService("ServerScriptService").Server.Core.BossBrain)
local F = Bosses.Fairness

local function allAttacks(def)
	local out = {}
	for _, phase in def.Phases do
		if phase.Stances then
			for _, s in phase.Stances do
				for _, a in s.Attacks do table.insert(out, a) end
			end
		else
			for _, a in phase.Attacks do table.insert(out, a) end
		end
	end
	if def.Mechanics.Ambient then
		table.insert(out, def.Mechanics.Ambient.Attack)
	end
	return out
end

return function(t)
	local expect = t.expect

	t.it("every boss has >= 3 distinct attacks, phases, arena, model and mechanic text", function()
		for floor = 1, 20 do
			local b = Bosses.List[floor]
			local names = {}
			local n = 0
			for _, a in allAttacks(b) do
				if not names[a.Name] then names[a.Name] = true; n += 1 end
			end
			if n < 3 then error("boss " .. floor .. " has only " .. n .. " attacks") end
			expect(#b.Phases >= 2).toBeTruthy()
			expect(b.Arena.Size >= 100).toBeTruthy()
			expect(type(b.Model.Style)).toBe("string")
			expect(type(b.Mechanic)).toBe("string")
		end
	end)

	t.it("authored telegraphs stay above fairness minimums after floor scaling", function()
		for floor = 1, 20 do
			for _, a in allAttacks(Bosses.List[floor]) do
				for i, step in BossBrain.steps(a) do
					local w = BossBrain.rawTiming(step, floor)
					local min = if i == 1 then F.MinWindup else F.MinComboFollowUp
					if w < min then
						error(("boss %d '%s' step %d windup %.2f < %.2f"):format(floor, a.Name, i, w, min))
					end
				end
			end
		end
	end)

	t.it("main attacks give a recovery window", function()
		for floor = 1, 20 do
			local def = Bosses.List[floor]
			for _, phase in def.Phases do
				local lists = {}
				if phase.Stances then for _, s in phase.Stances do table.insert(lists, s.Attacks) end else lists = { phase.Attacks } end
				for _, list in lists do
					for _, a in list do
						local steps = BossBrain.steps(a)
						local last = steps[#steps]
						local _, rec = BossBrain.rawTiming(last, floor)
						if rec < F.MinRecovery then
							error(("boss %d '%s' recovery %.2f"):format(floor, a.Name, rec))
						end
					end
				end
			end
		end
	end)

	t.it("arena pulses always provide safe zones", function()
		for floor = 1, 20 do
			for _, a in allAttacks(Bosses.List[floor]) do
				for _, step in BossBrain.steps(a) do
					if step.Shape == "Pulse" then
						expect(step.SafeZones >= 2).toBeTruthy()
						expect(step.SafeRadius >= 8).toBeTruthy()
						expect(step.Windup >= 2.0).toBeTruthy()
					end
				end
			end
		end
	end)

	t.it("difficulty escalates through mechanics, not just numbers", function()
		-- later bosses must have at least as many phases or combo steps on average
		local function complexity(def)
			local steps = 0
			for _, a in allAttacks(def) do steps += #BossBrain.steps(a) end
			return #def.Phases * 10 + steps
		end
		local early, late = 0, 0
		for f = 1, 5 do early += complexity(Bosses.List[f]) end
		for f = 16, 20 do late += complexity(Bosses.List[f]) end
		expect(late > early).toBeTruthy()
		-- final boss has 3+ phases
		expect(#Bosses.List[20].Phases >= 3).toBeTruthy()
	end)

	t.it("phase thresholds are descending and start at 1", function()
		for floor = 1, 20 do
			local phases = Bosses.List[floor].Phases
			expect(phases[1].Threshold).toBe(1)
			for i = 2, #phases do
				expect(phases[i].Threshold < phases[i - 1].Threshold).toBeTruthy()
			end
		end
	end)

	t.it("phase selection picks the right phase", function()
		local def = Bosses.List[15]
		expect(BossBrain.phaseIndex(def, 1)).toBe(1)
		expect(BossBrain.phaseIndex(def, 0.6)).toBe(2)
		expect(BossBrain.phaseIndex(def, 0.1)).toBe(3)
	end)

	t.it("attack choice respects range and avoids triple repeats", function()
		local Rng = require(RS.Shared.Util.Rng)
		local attacks = Bosses.List[1].Phases[1].Attacks
		local ctx = { Distance = 5, Now = 0, Cooldowns = {}, History = {}, Rng = Rng.new(3) }
		for _ = 1, 50 do
			local a = BossBrain.choose(attacks, ctx)
			expect(a ~= nil).toBeTruthy()
			expect(5 <= a.MaxRange + 2).toBeTruthy()
			BossBrain.recordChoice(ctx, a, 0)
			local h = ctx.History
			if #h >= 3 then
				expect(h[#h] == h[#h - 1] and h[#h - 1] == h[#h - 2]).toBe(false)
			end
		end
		ctx.Distance = 500
		expect(BossBrain.choose(attacks, ctx)).toBeNil()
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">Combat.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local CombatCore = require(SSS.Server.Core.CombatCore)
local Stats = require(game:GetService("ReplicatedStorage").Shared.Logic.Stats)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)
local C = GameConfig.Combat

return function(t)
	local expect = t.expect
	local function setup(class)
		local p = Helpers.profile(class or "Knight")
		local stats = Stats.compute(p)
		local s = CombatCore.newPlayerState(stats, -100)
		return s, stats
	end
	local hit = { Damage = 100, DamageType = "Physical", Poise = 10, Parryable = true, Blockable = true }

	t.it("attacks cost stamina and lock actions", function()
		local s = setup()
		local ok, info = CombatCore.attack(s, "Light", "Sword", 0)
		expect(ok).toBe(true)
		expect(s.Stamina < s.MaxStamina).toBeTruthy()
		local ok2 = CombatCore.attack(s, "Light", "Sword", 0.05)
		expect(ok2).toBe(false)
		local ok3 = CombatCore.attack(s, "Light", "Sword", info.Windup + info.Recovery)
		expect(ok3).toBe(true)
	end)

	t.it("cannot act with zero stamina", function()
		local s = setup()
		s.Stamina = 0
		expect((CombatCore.attack(s, "Light", "Sword", 0))).toBe(false)
		expect((CombatCore.dodge(s, 0))).toBe(false)
	end)

	t.it("invalid attack kinds are rejected", function()
		local s = setup()
		expect((CombatCore.attack(s, "Ultra", "Sword", 0))).toBe(false)
	end)

	t.it("heavy charge is clamped", function()
		local s = setup()
		local _, a = CombatCore.attack(s, "Heavy", "Sword", 0, 999)
		local s2 = setup()
		local _, b = CombatCore.attack(s2, "Heavy", "Sword", 0, C.HeavyChargeMax)
		expect(a.Motion).toBe(b.Motion)
	end)

	t.it("heavy charge is measured by the server, not the client (QA D5)", function()
		local s = setup()
		expect(CombatCore.takeCharge(s, 5)).toBe(0) -- release without a press
		CombatCore.beginCharge(s, 5)
		expect(CombatCore.takeCharge(s, 5.4)).toBeNear(0.4)
		expect(CombatCore.takeCharge(s, 6)).toBe(0) -- consumed
		CombatCore.beginCharge(s, 10)
		expect(CombatCore.takeCharge(s, 13)).toBe(C.HeavyChargeMax)
		CombatCore.beginCharge(s, 20)
		CombatCore.dodge(s, 20.1)
		expect(CombatCore.takeCharge(s, 21)).toBe(0) -- dodging cancels a charge
	end)

	t.it("dodge i-frames avoid hits, including the latency grace window", function()
		local s, stats = setup()
		CombatCore.dodge(s, 10)
		expect(CombatCore.resolveIncoming(s, hit, 10.1, stats, true).Outcome).toBe("Dodged")
		-- dodge arriving slightly after the hit resolved (within grace) still counts
		local s2, stats2 = setup()
		CombatCore.dodge(s2, 10.1)
		expect(CombatCore.resolveIncoming(s2, hit, 10.0, stats2, true).Outcome).toBe("Dodged")
		-- too late
		local s3, stats3 = setup()
		CombatCore.dodge(s3, 10 + C.LatencyGrace + 0.05)
		expect(CombatCore.resolveIncoming(s3, hit, 10.0, stats3, true).Outcome).toBe("Hit")
		-- i-frames expire
		local s4, stats4 = setup()
		CombatCore.dodge(s4, 10)
		expect(CombatCore.resolveIncoming(s4, hit, 10 + C.DodgeIFrames + 0.05, stats4, true).Outcome).toBe("Hit")
	end)

	t.it("dodge spam is limited by cooldown", function()
		local s = setup()
		expect((CombatCore.dodge(s, 0))).toBe(true)
		expect((CombatCore.dodge(s, 0.1))).toBe(false)
	end)

	t.it("dodge cannot cancel an attack windup", function()
		local s = setup()
		CombatCore.attack(s, "Heavy", "Greatsword", 0)
		expect((CombatCore.dodge(s, 0.1))).toBe(false)
	end)

	t.it("parry only works on parryable attacks while facing", function()
		local s, stats = setup()
		CombatCore.parry(s, 5)
		expect(CombatCore.resolveIncoming(s, hit, 5.1, stats, true).Outcome).toBe("Parried")
		local s2, stats2 = setup()
		CombatCore.parry(s2, 5)
		expect(CombatCore.resolveIncoming(s2, hit, 5.1, stats2, false).Outcome).toBe("Hit")
		local s3, stats3 = setup()
		CombatCore.parry(s3, 5)
		local unparryable = table.clone(hit)
		unparryable.Parryable = false
		expect(CombatCore.resolveIncoming(s3, unparryable, 5.1, stats3, true).Outcome ~= "Parried").toBeTruthy()
	end)

	t.it("blocking reduces damage by stability and drains stamina", function()
		local s, stats = setup("Knight")
		CombatCore.setBlocking(s, true, 0)
		local r = CombatCore.resolveIncoming(s, hit, 1, stats, true)
		expect(r.Outcome).toBe("Blocked")
		local s2, stats2 = setup("Knight")
		local r2 = CombatCore.resolveIncoming(s2, hit, 1, stats2, true)
		expect(r.Damage < r2.Damage).toBeTruthy()
		expect(s.Stamina < s.MaxStamina).toBeTruthy()
	end)

	t.it("guard breaks at zero stamina", function()
		local s, stats = setup("Knight")
		CombatCore.setBlocking(s, true, 0)
		s.Stamina = 1
		local r = CombatCore.resolveIncoming(s, hit, 1, stats, true)
		expect(r.Outcome).toBe("GuardBroken")
		expect(s.Blocking).toBe(false)
	end)

	t.it("stagger immunity prevents stun-lock", function()
		local s, stats = setup("Mage")
		local heavy = { Damage = 5, DamageType = "Physical", Poise = 999, Parryable = false, Blockable = true }
		local r1 = CombatCore.resolveIncoming(s, heavy, 1, stats, true)
		expect(r1.Staggered).toBe(true)
		local r2 = CombatCore.resolveIncoming(s, heavy, 1.3, stats, true)
		expect(r2.Staggered).toBe(false)
		local r3 = CombatCore.resolveIncoming(s, heavy, 1 + C.StaggerDuration + C.StaggerImmunity + 0.01, stats, true)
		expect(r3.Staggered).toBe(true)
	end)

	t.it("respawn invulnerability", function()
		local p = Helpers.profile("Knight")
		local stats = Stats.compute(p)
		local s = CombatCore.newPlayerState(stats, 100)
		expect(CombatCore.resolveIncoming(s, hit, 101, stats, true).Outcome).toBe("Immune")
	end)

	t.it("death is terminal and further hits are ignored", function()
		local s, stats = setup("Mage")
		local big = { Damage = 1e6, DamageType = "Physical", Poise = 0, Blockable = false }
		local r = CombatCore.resolveIncoming(s, big, 1, stats, true)
		expect(r.Died).toBe(true)
		expect(CombatCore.resolveIncoming(s, big, 2, stats, true).Outcome).toBe("Ignored")
	end)

	t.it("defence buffs are capped", function()
		local s, stats = setup("Knight")
		CombatCore.addBuff(s, "Defense", 5, 100, 0)
		expect(CombatCore.mitigate(1000, "Physical", stats, s, 1) >= 1).toBeTruthy()
		expect(CombatCore.mitigate(1000, "Physical", stats, s, 1) > 0).toBeTruthy()
	end)

	t.it("status build-up procs at threshold", function()
		local st = CombatCore.newStatus()
		expect(CombatCore.addBuildup(st, "Bleed", 60, 0)).toBe(false)
		expect(CombatCore.addBuildup(st, "Bleed", 60, 0)).toBe(true)
		expect(st.Bleed).toBe(0)
		expect(CombatCore.addBuildup(st, "Nope", 999, 0)).toBe(false)
	end)

	t.it("target poise break staggers once, then regenerates", function()
		local tgt = CombatCore.newTarget(1000, 50)
		local r = CombatCore.damageTarget(tgt, 10, 60, 0)
		expect(r.Staggered).toBe(true)
		local r2 = CombatCore.damageTarget(tgt, 10, 60, 0.5)
		expect(r2.Staggered).toBe(false) -- poise frozen while staggered
		expect(CombatCore.isStaggered(tgt, 0.5)).toBe(true)
	end)

	t.it("outgoing damage is never below the minimum", function()
		expect(CombatCore.outgoing(0, 1, { TargetDefense = 1e9 })).toBe(C.MinDamage)
	end)

	t.it("stamina regenerates after the delay", function()
		local s, stats = setup()
		CombatCore.spendStamina(s, 50, 0)
		local before = s.Stamina
		CombatCore.regen(s, 0.1, 0.2, stats)
		expect(s.Stamina).toBe(before)
		CombatCore.regen(s, 1, 2, stats)
		expect(s.Stamina > before).toBeTruthy()
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">DataIntegrity.spec</string>
          <string name="Source"><![CDATA[-- Cross-reference validation for all data-driven configuration.
local RS = game:GetService("ReplicatedStorage")
local Config = RS.Shared.Config
local Items = require(Config.Items)
local Classes = require(Config.Classes)
local Abilities = require(Config.Abilities)
local Enemies = require(Config.Enemies)
local Bosses = require(Config.Bosses)
local LootTables = require(Config.LootTables)
local Shops = require(Config.Shops)
local Quests = require(Config.Quests)
local Achievements = require(Config.Achievements)
local Cosmetics = require(Config.Cosmetics)
local World = require(Config.World)
local WeaponTypes = require(Config.WeaponTypes)
local Rarities = require(Config.Rarities)
local Training = require(Config.Training)
local Upgrades = require(Config.Upgrades)
local Products = require(Config.Products)
local GameConfig = require(Config.GameConfig)

return function(t)
	local expect = t.expect

	t.it("every item has a valid kind, rarity and fields", function()
		local kinds = { Weapon = true, Shield = true, Armor = true, Accessory = true, Consumable = true, Material = true }
		for id, def in Items do
			if string.sub(id, 1, 1) ~= "_" then
				expect(kinds[def.Kind] ~= nil).toBeTruthy()
				expect(Rarities[def.Rarity] ~= nil).toBeTruthy()
				expect(type(def.Name)).toBe("string")
				if def.Kind == "Weapon" then
					expect(WeaponTypes[def.WeaponType] ~= nil).toBeTruthy()
					expect(def.Damage > 0).toBeTruthy()
					expect(Upgrades[def.Upgrade] ~= nil).toBeTruthy()
					for attr, grade in def.Scaling do
						expect(table.find(GameConfig.Attributes.List, attr) ~= nil).toBeTruthy()
						expect(GameConfig.ScalingGrades[grade] ~= nil).toBeTruthy()
					end
					for attr in def.Requires do
						expect(table.find(GameConfig.Attributes.List, attr) ~= nil).toBeTruthy()
					end
				end
			end
		end
	end)

	t.it("all six classes exist with valid loadouts and 74 starting points", function()
		expect(#Classes.Order).toBe(6)
		for _, name in Classes.Order do
			local c = Classes[name]
			expect(c ~= nil).toBeTruthy()
			local sum = 0
			for _, attr in GameConfig.Attributes.List do
				expect(type(c.Attributes[attr])).toBe("number")
				sum += c.Attributes[attr]
			end
			expect(sum).toBe(74)
			expect(Items[c.Loadout.Weapon].Kind).toBe("Weapon")
			if c.Loadout.Offhand then
				expect(Items[c.Loadout.Offhand].Kind).toBe("Shield")
			end
			for slot, id in c.Loadout.Armor do
				expect(Items[id].Kind).toBe("Armor")
				expect(Items[id].Slot).toBe(slot)
			end
			for _, a in c.Abilities do
				expect(Abilities[a] ~= nil).toBeTruthy()
			end
			for id in c.Items do
				expect(Items[id] ~= nil).toBeTruthy()
			end
			-- starting weapon requirements must be met by the class itself
			for attr, req in Items[c.Loadout.Weapon].Requires do
				expect(c.Attributes[attr] >= req).toBeTruthy()
			end
		end
	end)

	t.it("loot tables reference real items", function()
		for id, tbl in LootTables do
			for _, e in tbl.Entries do
				if not Items[e.Item] then error("loot " .. id .. " unknown item " .. e.Item) end
				expect(e.Weight > 0).toBeTruthy()
				expect(e.Min <= e.Max).toBeTruthy()
			end
			for item in tbl.Guaranteed or {} do
				if not Items[item] then error("loot " .. id .. " unknown guaranteed " .. item) end
			end
		end
	end)

	t.it("enemies reference valid loot tables and summons", function()
		for id, e in Enemies do
			if e.Loot and not LootTables[e.Loot] then error(id .. " bad loot " .. e.Loot) end
			expect(#e.Attacks > 0).toBeTruthy()
			for _, a in e.Attacks do
				if a.Shape == "Summon" and not Enemies[a.Summon] then error(id .. " bad summon") end
			end
		end
	end)

	t.it("there are exactly 20 bosses with rewards that exist", function()
		for floor = 1, 20 do
			local b = Bosses.List[floor]
			expect(b ~= nil).toBeTruthy()
			expect(b.Floor).toBe(floor)
			for item in b.Rewards.FirstClear.Items do
				if not Items[item] then error("boss " .. floor .. " unknown reward " .. item) end
			end
			if b.Rewards.FirstClear.Ability and not Abilities[b.Rewards.FirstClear.Ability] then
				error("boss " .. floor .. " unknown ability")
			end
			if b.Rewards.FirstClear.Cosmetic and not Cosmetics[b.Rewards.FirstClear.Cosmetic] then
				error("boss " .. floor .. " unknown cosmetic")
			end
			for _, phase in b.Phases do
				local lists = phase.Stances and {} or { phase.Attacks }
				for _, s in phase.Stances or {} do table.insert(lists, s.Attacks) end
				for _, list in lists do
					for _, a in list do
						if a.Shape == "Summon" and not Enemies[a.Summon] then error("boss " .. floor .. " bad summon") end
					end
				end
			end
		end
		expect(Bosses.List[21]).toBeNil()
	end)

	t.it("shops sell real items at positive prices", function()
		for shopId, shop in Shops do
			for _, entry in shop.Stock do
				if not Items[entry.Item] then error(shopId .. " unknown item " .. entry.Item) end
				expect(entry.Price > 0).toBeTruthy()
				-- no shop sells boss uniques
				expect(Items[entry.Item].BossWeapon == nil).toBeTruthy()
			end
		end
	end)

	t.it("shop sell-back can never exceed purchase price (no arbitrage)", function()
		local Formulas = require(RS.Shared.Logic.Formulas)
		for _, shop in Shops do
			for _, entry in shop.Stock do
				expect(Formulas.sellPrice(Items[entry.Item]) < entry.Price).toBeTruthy()
			end
		end
	end)

	t.it("quests reference real givers, enemies, items, locations", function()
		local npcs = {}
		for _, n in World.NPCs do npcs[n.Id] = n end
		local locs = {}
		for _, l in World.Locations do locs[l.Id] = true end
		for id, q in Quests do
			expect(npcs[q.Giver] ~= nil).toBeTruthy()
			expect(table.find(npcs[q.Giver].Quests, id) ~= nil).toBeTruthy()
			local o = q.Objective
			if o.Type == "Kill" and not Enemies[o.Enemy] then error(id .. " bad enemy") end
			if o.Type == "Collect" and not Items[o.Item] then error(id .. " bad item") end
			if o.Type == "Discover" and o.Location and not locs[o.Location] then error(id .. " bad location") end
			for _, r in q.Requires do expect(Quests[r] ~= nil).toBeTruthy() end
			for item in q.Rewards.Items or {} do expect(Items[item] ~= nil).toBeTruthy() end
		end
	end)

	t.it("achievement rewards reference real cosmetics", function()
		for id, a in Achievements do
			if a.Reward and a.Reward.Cosmetic and not Cosmetics[a.Reward.Cosmetic] then error(id) end
		end
	end)

	t.it("world spawn zones, chests and training stations are valid", function()
		for _, z in World.SpawnZones do
			if not Enemies[z.Enemy] then error("zone " .. z.Id) end
			expect(z.Count >= 1 and z.Count <= 6).toBeTruthy()
		end
		for _, c in World.Chests do
			if not LootTables[c.Loot] then error("chest " .. c.Id) end
		end
		for _, s in World.TrainingStations do
			expect(Training[s.Challenge] ~= nil).toBeTruthy()
		end
		local defaults = 0
		for _, cp in World.Checkpoints do if cp.Default then defaults += 1 end end
		expect(defaults).toBe(1)
	end)

	t.it("products only grant cosmetics", function()
		for _, p in Products.DevProducts do
			local list = p.Grant.Cosmetics or { p.Grant.Cosmetic }
			for _, c in list do
				expect(Cosmetics[c] ~= nil).toBeTruthy()
			end
			for k in p.Grant do
				expect(k == "Cosmetic" or k == "Cosmetics").toBeTruthy()
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">Death.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local DeathCore = require(SSS.Server.Core.DeathCore)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("death drops all carried currency into a marker", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 500
		local r = DeathCore.onDeath(p, 10, 0, 10, 1000)
		expect(r.Dropped).toBe(500)
		expect(p.Currency).toBe(0)
		expect(p.LostCurrency.Amount).toBe(500)
	end)

	t.it("recovery is awarded exactly once", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 500
		DeathCore.onDeath(p, 10, 0, 10, 1000)
		local ok, amount = DeathCore.recover(p, 11, 0, 10, 1010)
		expect(ok).toBe(true)
		expect(amount).toBe(500)
		expect(p.Currency).toBe(500)
		local ok2 = DeathCore.recover(p, 11, 0, 10, 1011)
		expect(ok2).toBe(false)
		expect(p.Currency).toBe(500)
	end)

	t.it("recovery requires proximity", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 300
		DeathCore.onDeath(p, 0, 0, 0, 0)
		local ok, err = DeathCore.recover(p, 100, 0, 0, 5)
		expect(ok).toBe(false)
		expect(err).toBe("TooFar")
		expect(p.LostCurrency.Amount).toBe(300)
	end)

	t.it("second death before recovery follows the configured rule", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 400
		DeathCore.onDeath(p, 0, 0, 0, 0)
		p.Currency = 50
		local r = DeathCore.onDeath(p, 50, 0, 50, 10)
		if GameConfig.Death.SecondDeathRule == "LosePrevious" then
			expect(r.LostForever).toBe(400)
			expect(p.LostCurrency.Amount).toBe(50)
		else
			expect(p.LostCurrency.Amount).toBe(450)
		end
		expect(p.LostCurrency.X).toBe(50)
	end)

	t.it("dying with nothing leaves no marker (LosePrevious)", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 0
		DeathCore.onDeath(p, 0, 0, 0, 0)
		expect(p.LostCurrency).toBeNil()
	end)

	t.it("markers expire", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 100
		DeathCore.onDeath(p, 0, 0, 0, 0)
		local ok, err = DeathCore.recover(p, 0, 0, 0, GameConfig.Death.RecoveryExpirySeconds + 1)
		expect(ok).toBe(false)
		expect(err).toBe("Expired")
		expect(p.LostCurrency).toBeNil()
	end)

	t.it("no-loss deaths (PvP/training) keep currency and existing marker", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 100
		DeathCore.onDeath(p, 0, 0, 0, 0)
		p.Currency = 70
		DeathCore.onDeath(p, 5, 0, 5, 1, { NoLoss = true })
		expect(p.Currency).toBe(70)
		expect(p.LostCurrency.Amount).toBe(100)
	end)

	t.it("marker survives a save/load round trip (disconnect)", function()
		local ProfileSchema = require(SSS.Server.Core.ProfileSchema)
		local p = Helpers.profile("Warrior")
		p.Currency = 250
		DeathCore.onDeath(p, 1, 2, 3, 100)
		local loaded = ProfileSchema.reconcile(Helpers.snapshot(p))
		expect(loaded.LostCurrency.Amount).toBe(250)
		expect(loaded.Currency).toBe(0)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">Economy.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local EconomyCore = require(SSS.Server.Core.EconomyCore)
local InventoryCore = require(SSS.Server.Core.InventoryCore)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("buying deducts the server price and grants the item", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 1000
		local ok, res = EconomyCore.buy(p, "potions", "healing_draught", 3)
		expect(ok).toBe(true)
		expect(res.Spent).toBe(360)
		expect(p.Currency).toBe(640)
	end)

	t.it("cannot create a negative balance", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 100
		local snap = Helpers.snapshot(p)
		local ok, err = EconomyCore.buy(p, "potions", "healing_draught", 1)
		expect(ok).toBe(false)
		expect(err).toBe("NotEnoughCurrency")
		expect(p).toEqual(snap)
	end)

	t.it("rejects malicious quantities and ids", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 1e6
		for _, q in { 0, -5, 2.5, 0 / 0, math.huge, 21, -math.huge } do
			expect((EconomyCore.buy(p, "potions", "healing_draught", q))).toBe(false)
		end
		expect((EconomyCore.buy(p, "potions", "sovereign_blade", 1))).toBe(false)
		expect((EconomyCore.buy(p, "nope", "healing_draught", 1))).toBe(false)
		expect((EconomyCore.buy(p, nil, nil, nil))).toBe(false)
		expect(p.Currency).toBe(1e6)
	end)

	t.it("locked stock requires tower progress", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 1e6
		local ok, err = EconomyCore.buy(p, "weapons", "rift_staff", 1)
		expect(ok).toBe(false)
		expect(err).toBe("Locked")
		p.Tower.HighestCleared = 7
		expect((EconomyCore.buy(p, "weapons", "rift_staff", 1))).toBe(true)
	end)

	t.it("lifetime purchase limits cannot be bypassed by split purchases", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 1e6
		p.Tower.HighestCleared = 5
		expect((EconomyCore.buy(p, "general", "flask_shard", 1))).toBe(true)
		expect((EconomyCore.buy(p, "general", "flask_shard", 2))).toBe(false)
		expect((EconomyCore.buy(p, "general", "flask_shard", 1))).toBe(true)
		expect((EconomyCore.buy(p, "general", "flask_shard", 1))).toBe(false)
		expect(InventoryCore.stackCount(p, "flask_shard")).toBe(2)
	end)

	t.it("buy then sell loop always loses currency", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 10000
		for _ = 1, 10 do
			local ok, res = EconomyCore.buy(p, "weapons", "rusted_longsword", 1)
			expect(ok).toBe(true)
			InventoryCore.sell(p, res.Uids[1])
		end
		expect(p.Currency < 10000).toBeTruthy()
	end)

	t.it("full stacks refuse purchase without charging", function()
		local p = Helpers.profile("Warrior")
		p.Currency = 1e6
		p.Inventory.Stacks.healing_draught = 995
		local before = p.Currency
		expect((EconomyCore.buy(p, "potions", "healing_draught", 10))).toBe(false)
		expect(p.Currency).toBe(before)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">Encounter.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local EncounterCore = require(SSS.Server.Core.EncounterCore)
local Formulas = require(game:GetService("ReplicatedStorage").Shared.Logic.Formulas)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("floors unlock sequentially", function()
		local p = Helpers.profile("Warrior")
		expect((EncounterCore.canEnter(p, 1))).toBe(true)
		expect((EncounterCore.canEnter(p, 2))).toBe(false)
		expect((EncounterCore.canEnter(p, 0))).toBe(false)
		expect((EncounterCore.canEnter(p, 21))).toBe(false)
		expect((EncounterCore.canEnter(p, 1.5))).toBe(false)
		expect((EncounterCore.canEnter(Helpers.profile(), 1))).toBe(false)
	end)

	t.it("first clear advances progression and grants uniques exactly once", function()
		local p = Helpers.profile("Warrior")
		local enc = EncounterCore.new("e1", 1, { 1 }, 0)
		expect(EncounterCore.claim(enc, 1, p, Helpers.rng())).toBeNil() -- not yet victorious
		EncounterCore.markVictory(enc)
		local r = EncounterCore.claim(enc, 1, p, Helpers.rng())
		expect(r.FirstClear).toBe(true)
		expect(r.Items.warden_halberd).toBe(1)
		expect(p.Tower.HighestCleared).toBe(1)
		expect(EncounterCore.claim(enc, 1, p, Helpers.rng())).toBeNil()
		-- same encounter id from another encounter object (e.g. reconnect race)
		local enc2 = EncounterCore.new("e1", 1, { 1 }, 0)
		EncounterCore.markVictory(enc2)
		expect(EncounterCore.claim(enc2, 1, p, Helpers.rng())).toBeNil()
	end)

	t.it("replays give reduced rewards and do not advance progression", function()
		local p = Helpers.profile("Warrior")
		p.Tower.HighestCleared = 5
		local enc = EncounterCore.new("e2", 3, { 1 }, 0)
		EncounterCore.markVictory(enc)
		local r = EncounterCore.claim(enc, 1, p, Helpers.rng(7))
		expect(r.FirstClear).toBe(false)
		expect(r.Xp < Formulas.bossXp(3)).toBeTruthy()
		expect(p.Tower.HighestCleared).toBe(5)
	end)

	t.it("dead or disconnected participants are not eligible; others are", function()
		local a, b = Helpers.profile("Warrior"), Helpers.profile("Mage")
		local enc = EncounterCore.new("e3", 1, { 1, 2 }, 0)
		local scale, failed = EncounterCore.removeParticipant(enc, 2)
		expect(failed).toBe(false)
		expect(scale).toBeNear(1 / Formulas.partyHealthMult(2))
		EncounterCore.markVictory(enc)
		expect(EncounterCore.claim(enc, 1, a, Helpers.rng()) ~= nil).toBeTruthy()
		expect(EncounterCore.claim(enc, 2, b, Helpers.rng())).toBeNil()
		expect(b.Tower.HighestCleared).toBe(0)
	end)

	t.it("encounter fails when everyone is gone and cannot then be won", function()
		local enc = EncounterCore.new("e4", 1, { 1 }, 0)
		local _, failed = EncounterCore.removeParticipant(enc, 1)
		expect(failed).toBe(true)
		expect(EncounterCore.markVictory(enc)).toBe(false)
	end)

	t.it("victory can only be marked once", function()
		local enc = EncounterCore.new("e5", 1, { 1 }, 0)
		expect(EncounterCore.markVictory(enc)).toBe(true)
		expect(EncounterCore.markVictory(enc)).toBe(false)
	end)

	t.it("flawless tracking", function()
		local p = Helpers.profile("Warrior")
		local enc = EncounterCore.new("e6", 1, { 1 }, 0)
		EncounterCore.recordHitTaken(enc, 1)
		EncounterCore.markVictory(enc)
		local r = EncounterCore.claim(enc, 1, p, Helpers.rng())
		expect(r.Flawless).toBe(false)
		expect(r.Solo).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">Formulas.spec</string>
          <string name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local Formulas = require(RS.Shared.Logic.Formulas)
local Items = require(RS.Shared.Config.Items)
local GameConfig = require(RS.Shared.Config.GameConfig)

return function(t)
	local expect = t.expect
	local attrs = { Vigor = 10, Endurance = 10, Strength = 10, Dexterity = 10, Intelligence = 10, Faith = 10, Arcane = 10 }

	t.it("softCap applies diminishing segments", function()
		local curve = { Base = 100, Segments = { { 10, 2 }, { 20, 1 } } }
		expect(Formulas.softCap(0, curve)).toBe(100)
		expect(Formulas.softCap(10, curve)).toBe(120)
		expect(Formulas.softCap(20, curve)).toBe(130)
		expect(Formulas.softCap(99, curve)).toBe(130)
	end)

	t.it("health has diminishing returns past soft caps", function()
		local h20 = Formulas.maxHealth({ Vigor = 20 })
		local h40 = Formulas.maxHealth({ Vigor = 40 })
		local h60 = Formulas.maxHealth({ Vigor = 60 })
		local h99 = Formulas.maxHealth({ Vigor = 99 })
		expect(h40 - h20 > h60 - h40).toBeTruthy()
		expect((h99 - h60) / 39 < (h60 - h40) / 20).toBeTruthy()
	end)

	t.it("xp curve is strictly increasing and capped", function()
		local prev = 0
		for l = 1, GameConfig.Level.Max - 1 do
			local x = Formulas.xpToNext(l)
			expect(x > prev).toBeTruthy()
			prev = x
		end
		expect(Formulas.xpToNext(GameConfig.Level.Max)).toBe(math.huge)
	end)

	t.it("weapon AR increases with upgrades and scaling attribute", function()
		local def = Items.knight_longsword
		local a = Formulas.weaponAttackRating(def, 0, { Strength = 12, Dexterity = 10 })
		local b = Formulas.weaponAttackRating(def, 5, { Strength = 12, Dexterity = 10 })
		local c = Formulas.weaponAttackRating(def, 5, { Strength = 40, Dexterity = 10 })
		expect(b.Total > a.Total).toBeTruthy()
		expect(c.Total > b.Total).toBeTruthy()
	end)

	t.it("unmet requirements penalise but do not lock the weapon", function()
		local def = Items.iron_greatsword
		local weak = Formulas.weaponAttackRating(def, 0, { Strength = 8 })
		local strong = Formulas.weaponAttackRating(def, 0, { Strength = 16 })
		expect(weak.RequirementsMet).toBe(false)
		expect(weak.Total > 0).toBeTruthy()
		expect(strong.Total > weak.Total).toBeTruthy()
	end)

	t.it("upgrade levels are clamped to the path maximum", function()
		local def = Items.warden_halberd -- Unique path, max 5
		local five = Formulas.weaponAttackRating(def, 5, attrs)
		local ninetynine = Formulas.weaponAttackRating(def, 99, attrs)
		expect(ninetynine.Total).toBe(five.Total)
		expect(Formulas.upgradeCost(def, 5)).toBeNil()
		expect(Formulas.upgradeCost(def, 0).Material).toBe("fallen_remnant")
	end)

	t.it("absorption is capped", function()
		expect(Formulas.absorption(1e9, 100)).toBe(GameConfig.Combat.MaxAbsorption)
		expect(Formulas.absorption(0, 100)).toBe(0)
	end)

	t.it("boss stats escalate monotonically", function()
		for f = 2, 20 do
			expect(Formulas.bossHealth(f) > Formulas.bossHealth(f - 1)).toBeTruthy()
			expect(Formulas.bossDamage(f) > Formulas.bossDamage(f - 1)).toBeTruthy()
			expect(Formulas.bossTiming(f).Windup <= Formulas.bossTiming(f - 1).Windup).toBeTruthy()
		end
	end)

	t.it("boss items cannot be sold", function()
		expect(Formulas.sellPrice(Items.sovereign_blade)).toBe(0)
		expect(Formulas.sellPrice(Items.rusted_longsword) > 0).toBeTruthy()
	end)

	t.it("party health scaling", function()
		expect(Formulas.partyHealthMult(1)).toBe(1)
		expect(Formulas.partyHealthMult(4)).toBeNear(1 + 3 * GameConfig.Party.BossHealthPerExtraPlayer)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">Geometry.spec</string>
          <string name="Source"><![CDATA[local Geometry = require(game:GetService("ReplicatedStorage").Shared.Logic.Geometry)

return function(t)
	local expect = t.expect
	t.it("cone includes targets in front and excludes behind", function()
		expect(Geometry.inCone(0, 0, 0, 1, 0, 5, 8, 90)).toBe(true)
		expect(Geometry.inCone(0, 0, 0, 1, 0, -5, 8, 90)).toBe(false)
		expect(Geometry.inCone(0, 0, 0, 1, 5, 1, 8, 90)).toBe(false)
		expect(Geometry.inCone(0, 0, 0, 1, 0, 9, 8, 90)).toBe(false)
		expect(Geometry.inCone(0, 0, 0, 1, 0, 9, 8, 90, 1.5)).toBe(true)
	end)
	t.it("line respects width and length", function()
		expect(Geometry.inLine(0, 0, 1, 0, 10, 1, 20, 4)).toBe(true)
		expect(Geometry.inLine(0, 0, 1, 0, 10, 3, 20, 4)).toBe(false)
		expect(Geometry.inLine(0, 0, 1, 0, 25, 0, 20, 4)).toBe(false)
		expect(Geometry.inLine(0, 0, 1, 0, -2, 0, 20, 4)).toBe(false)
	end)
	t.it("ring has a safe centre", function()
		expect(Geometry.inRing(0, 0, 2, 0, 5, 10)).toBe(false)
		expect(Geometry.inRing(0, 0, 7, 0, 5, 10)).toBe(true)
		expect(Geometry.inRing(0, 0, 12, 0, 5, 10)).toBe(false)
	end)
	t.it("backstab detection", function()
		-- target at origin facing +Z; attacker at -Z is behind
		expect(Geometry.isBehind(0, 0, 0, 1, 0, -3, 60)).toBe(true)
		expect(Geometry.isBehind(0, 0, 0, 1, 0, 3, 60)).toBe(false)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">Helpers</string>
          <string name="Source"><![CDATA[-- Shared helpers for specs.
local SSS = game:GetService("ServerScriptService")
local Core = SSS.Server.Core
local ProfileSchema = require(Core.ProfileSchema)
local ProgressionCore = require(Core.ProgressionCore)
local Rng = require(game:GetService("ReplicatedStorage").Shared.Util.Rng)

local Helpers = {}

function Helpers.profile(className: string?)
	local p = ProfileSchema.reconcile(ProfileSchema.default())
	if className then
		ProgressionCore.chooseClass(p, className)
	end
	return p
end

function Helpers.rng(seed)
	return Rng.new(seed or 12345)
end

function Helpers.snapshot(v)
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = Helpers.snapshot(x)
	end
	return out
end

function Helpers.owns(profile, itemId)
	local InventoryCore = require(Core.InventoryCore)
	return InventoryCore.ownsItemId(profile, itemId)
end

return Helpers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">Inventory.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local InventoryCore = require(SSS.Server.Core.InventoryCore)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("class loadout is owned and equipped", function()
		local p = Helpers.profile("Knight")
		expect(p.Equipped.Weapon ~= nil).toBeTruthy()
		expect(p.Equipped.Offhand ~= nil).toBeTruthy()
		expect(p.Inventory.Items[p.Equipped.Weapon].Id).toBe("knight_longsword")
		expect(p.Equipped.Head ~= nil and p.Equipped.Chest ~= nil and p.Equipped.Hands ~= nil and p.Equipped.Feet ~= nil).toBeTruthy()
	end)

	t.it("rejects invalid quantities", function()
		local p = Helpers.profile("Warrior")
		for _, q in { 0, -1, 1.5, 0 / 0, math.huge, "3" } do
			local ok = InventoryCore.addItem(p, "ember_shard", q)
			expect(ok).toBe(false)
		end
	end)

	t.it("equip validates slot compatibility and ownership", function()
		local p = Helpers.profile("Warrior")
		local _, res = InventoryCore.addItem(p, "hearth_ring", 1)
		local uid = res.Uids[1]
		expect((InventoryCore.equip(p, uid, "Weapon"))).toBe(false)
		expect((InventoryCore.equip(p, "i99999", "Weapon"))).toBe(false)
		local ok, slot = InventoryCore.equip(p, uid)
		expect(ok).toBe(true)
		expect(slot).toBe("Accessory1")
	end)

	t.it("cannot double-equip the same accessory id", function()
		local p = Helpers.profile("Warrior")
		local _, a = InventoryCore.addItem(p, "hearth_ring", 2)
		expect((InventoryCore.equip(p, a.Uids[1], "Accessory1"))).toBe(true)
		local ok, err = InventoryCore.equip(p, a.Uids[2], "Accessory2")
		expect(ok).toBe(false)
		expect(err).toBe("DuplicateAccessory")
	end)

	t.it("cannot sell equipped or boss items; selling credits once", function()
		local p = Helpers.profile("Warrior")
		local before = p.Currency
		expect((InventoryCore.sell(p, p.Equipped.Weapon))).toBe(false)
		local _, r = InventoryCore.addItem(p, "rusted_longsword", 1)
		local ok, price = InventoryCore.sell(p, r.Uids[1])
		expect(ok).toBe(true)
		expect(p.Currency).toBe(before + price)
		expect((InventoryCore.sell(p, r.Uids[1]))).toBe(false) -- already gone
		local _, b = InventoryCore.addItem(p, "sovereign_blade", 1)
		expect((InventoryCore.sell(p, b.Uids[1]))).toBe(false)
	end)

	t.it("upgrade consumes exact materials and currency, failure leaves profile untouched", function()
		local p = Helpers.profile("Warrior")
		local uid = p.Equipped.Weapon
		p.Currency = 100
		p.Inventory.Stacks.ember_shard = nil
		local snap = Helpers.snapshot(p)
		local ok, err = InventoryCore.upgrade(p, uid, p.Attributes)
		expect(ok).toBe(false)
		expect(err).toBe("NotEnoughCurrency")
		expect(p).toEqual(snap)
		p.Currency = 1000
		ok, err = InventoryCore.upgrade(p, uid, p.Attributes)
		expect(err).toBe("NotEnoughMaterials")
		InventoryCore.addItem(p, "ember_shard", 1)
		ok = InventoryCore.upgrade(p, uid, p.Attributes)
		expect(ok).toBe(true)
		expect(p.Inventory.Items[uid].Upgrade).toBe(1)
		expect(p.Currency).toBe(800)
		expect(InventoryCore.stackCount(p, "ember_shard")).toBe(0)
	end)

	t.it("upgrade preview shows before/after stats", function()
		local p = Helpers.profile("Warrior")
		local preview = InventoryCore.upgradePreview(p, p.Equipped.Weapon, p.Attributes)
		expect(preview.After > preview.Before).toBeTruthy()
		expect(preview.Cost.Currency > 0).toBeTruthy()
	end)

	t.it("stack and slot capacity are enforced", function()
		local p = Helpers.profile("Warrior")
		local ok = InventoryCore.addItem(p, "wild_hide", 999)
		expect(ok).toBe(true)
		expect((InventoryCore.addItem(p, "wild_hide", 1))).toBe(false)
		local ok2, res = InventoryCore.addItem(p, "wild_hide", 5, true)
		expect(ok2).toBe(true)
		expect(res.Added).toBe(0)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">Loot.spec</string>
          <string name="Source"><![CDATA[local LootCore = require(game:GetService("ServerScriptService").Server.Core.LootCore)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect
	t.it("rolls are deterministic for a seed", function()
		local a = LootCore.roll("elite", Helpers.rng(42))
		local b = LootCore.roll("elite", Helpers.rng(42))
		expect(a).toEqual(b)
	end)
	t.it("guaranteed drops always appear", function()
		for seed = 1, 50 do
			local r = LootCore.roll("chest_secret", Helpers.rng(seed))
			expect(r.flask_shard).toBe(1)
		end
	end)
	t.it("unknown tables yield nothing", function()
		expect(LootCore.roll("nope", Helpers.rng())).toEqual({})
		expect(LootCore.roll(nil, Helpers.rng())).toEqual({})
	end)
	t.it("rng ranges are inclusive and in bounds", function()
		local rng = Helpers.rng(9)
		local seen = {}
		for _ = 1, 500 do
			local v = rng:NextInteger(1, 3)
			expect(v >= 1 and v <= 3).toBeTruthy()
			seen[v] = true
		end
		expect(seen[1] and seen[2] and seen[3]).toBeTruthy()
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">Party.spec</string>
          <string name="Source"><![CDATA[local PartyCore = require(game:GetService("ServerScriptService").Server.Core.PartyCore)

return function(t)
	local expect = t.expect

	t.it("invite and accept forms a party", function()
		local s = PartyCore.newState()
		expect((PartyCore.invite(s, 1, 2, 0))).toBe(true)
		expect((PartyCore.accept(s, 2, 1))).toBe(true)
		expect(#PartyCore.members(s, 1)).toBe(2)
		expect(PartyCore.get(s, 1).Leader).toBe(1)
	end)

	t.it("expired invites fail", function()
		local s = PartyCore.newState()
		PartyCore.invite(s, 1, 2, 0)
		local ok, err = PartyCore.accept(s, 2, 1000)
		expect(ok).toBe(false)
		expect(err).toBe("Expired")
	end)

	t.it("only the leader may invite, kick or promote", function()
		local s = PartyCore.newState()
		PartyCore.invite(s, 1, 2, 0)
		PartyCore.accept(s, 2, 0)
		expect((PartyCore.invite(s, 2, 3, 0))).toBe(false)
		expect((PartyCore.kick(s, 2, 1))).toBe(false)
		expect((PartyCore.promote(s, 1, 2))).toBe(true)
		expect((PartyCore.kick(s, 2, 1))).toBe(true)
		expect(PartyCore.get(s, 2)).toBeNil() -- disbanded at 1 member
	end)

	t.it("party size is capped", function()
		local s = PartyCore.newState()
		for i = 2, 4 do
			PartyCore.invite(s, 1, i, 0)
			PartyCore.accept(s, i, 0)
		end
		expect((PartyCore.invite(s, 1, 5, 0))).toBe(false)
	end)

	t.it("leader leaving promotes the next member", function()
		local s = PartyCore.newState()
		for i = 2, 3 do
			PartyCore.invite(s, 1, i, 0)
			PartyCore.accept(s, i, 0)
		end
		PartyCore.leave(s, 1)
		expect(PartyCore.get(s, 2).Leader).toBe(2)
	end)

	t.it("cannot be in two parties", function()
		local s = PartyCore.newState()
		PartyCore.invite(s, 1, 2, 0)
		PartyCore.accept(s, 2, 0)
		expect((PartyCore.invite(s, 3, 2, 0))).toBe(false)
	end)

	t.it("unanswered solo parties are pruned", function()
		local s = PartyCore.newState()
		PartyCore.invite(s, 1, 2, 0)
		PartyCore.pruneInvites(s, 1000)
		expect(PartyCore.get(s, 1)).toBeNil()
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">Profile.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local ProfileSchema = require(SSS.Server.Core.ProfileSchema)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("non-table data produces a default profile with a correction note", function()
		local p, corr = ProfileSchema.reconcile("garbage")
		expect(p.Level).toBe(1)
		expect(#corr > 0).toBeTruthy()
	end)

	t.it("corrupt values are clamped without wiping progress", function()
		local p = Helpers.profile("Warrior")
		p.Level = 30
		p.Currency = -50
		p.Attributes.Vigor = 500
		p.Xp = 0 / 0
		p.Inventory.Items.i999 = { Id = "does_not_exist", Upgrade = 3 }
		p.Inventory.Stacks.ember_shard = -4
		p.Equipped.Head = "i424242"
		p.Abilities.Slot2 = "ghost_ability"
		p.LostCurrency = { Amount = "lots" }
		local fixed, corr = ProfileSchema.reconcile(Helpers.snapshot(p))
		expect(fixed.Level).toBe(30)
		expect(fixed.Class).toBe("Warrior")
		expect(fixed.Currency).toBe(0)
		expect(fixed.Attributes.Vigor).toBe(99)
		expect(fixed.Xp).toBe(0)
		expect(fixed.Inventory.Items.i999).toBeNil()
		expect(fixed.Inventory.Stacks.ember_shard).toBeNil()
		expect(fixed.Equipped.Head).toBeNil()
		expect(fixed.Abilities.Slot2).toBe("")
		expect(fixed.LostCurrency).toBeNil()
		expect(fixed.Equipped.Weapon ~= nil).toBeTruthy() -- valid equipment kept
		expect(#corr >= 8).toBeTruthy()
	end)

	t.it("missing fields are filled from defaults", function()
		local fixed = ProfileSchema.reconcile({ DataVersion = GameConfig.DataVersion, Level = 5, Class = "Mage" })
		expect(fixed.Level).toBe(5)
		expect(type(fixed.Inventory.Items)).toBe("table")
		expect(type(fixed.Settings.CameraSensitivity)).toBe("number")
	end)

	t.it("v1 data migrates", function()
		local fixed = ProfileSchema.reconcile({ DataVersion = 1, Gold = 1234, Tower = 4, Class = "Knight", Level = 12 })
		expect(fixed.Currency).toBe(1234)
		expect(fixed.Tower.HighestCleared).toBe(4)
		expect(fixed.Gold).toBeNil()
		expect(fixed.DataVersion).toBe(GameConfig.DataVersion)
	end)

	t.it("uid counter stays ahead of existing uids", function()
		local p = Helpers.profile("Warrior")
		p.Inventory.Items.i500 = { Id = "rusted_longsword", Upgrade = 0 }
		p.Inventory.NextUid = 3
		local fixed = ProfileSchema.reconcile(p)
		expect(fixed.Inventory.NextUid).toBe(501)
	end)

	t.it("reconcile is idempotent", function()
		local p = Helpers.profile("Paladin")
		local a = ProfileSchema.reconcile(Helpers.snapshot(p))
		local b = ProfileSchema.reconcile(Helpers.snapshot(a))
		a.Corrections, b.Corrections = nil, nil
		expect(a).toEqual(b)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">Progression.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local ProgressionCore = require(SSS.Server.Core.ProgressionCore)
local Formulas = require(game:GetService("ReplicatedStorage").Shared.Logic.Formulas)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("class can only be chosen once", function()
		local p = Helpers.profile()
		expect((ProgressionCore.chooseClass(p, "Mage"))).toBe(true)
		expect((ProgressionCore.chooseClass(p, "Warrior"))).toBe(false)
		expect(p.Class).toBe("Mage")
		expect((ProgressionCore.chooseClass(Helpers.profile(), "Necromancer"))).toBe(false)
	end)

	t.it("xp grants levels and points", function()
		local p = Helpers.profile("Warrior")
		local need = Formulas.xpToNext(1) + Formulas.xpToNext(2)
		local r = ProgressionCore.grantXp(p, need + 5)
		expect(r.Levels).toBe(2)
		expect(p.Level).toBe(3)
		expect(p.UnspentPoints).toBe(2)
		expect(p.Xp).toBe(5)
	end)

	t.it("rejects invalid xp amounts", function()
		local p = Helpers.profile("Warrior")
		for _, x in { -100, 0 / 0, math.huge, "100" } do
			ProgressionCore.grantXp(p, x)
		end
		expect(p.Level).toBe(1)
		expect(p.Xp).toBe(0)
	end)

	t.it("level cap is enforced", function()
		local p = Helpers.profile("Warrior")
		ProgressionCore.grantXp(p, 1e12)
		expect(p.Level).toBe(GameConfig.Level.Max)
		expect(p.Xp).toBe(0)
	end)

	t.it("allocation is validated and all-or-nothing", function()
		local p = Helpers.profile("Warrior")
		p.UnspentPoints = 3
		expect((ProgressionCore.allocate(p, { Vigor = 2, Strength = 2 }))).toBe(false)
		expect(p.UnspentPoints).toBe(3)
		expect((ProgressionCore.allocate(p, { Vigor = -1, Strength = 4 }))).toBe(false)
		expect((ProgressionCore.allocate(p, { Luck = 1 }))).toBe(false)
		expect((ProgressionCore.allocate(p, { Vigor = 1.5 }))).toBe(false)
		local vig = p.Attributes.Vigor
		expect((ProgressionCore.allocate(p, { Vigor = 2, Strength = 1 }))).toBe(true)
		expect(p.Attributes.Vigor).toBe(vig + 2)
		expect(p.UnspentPoints).toBe(0)
	end)

	t.it("attribute cap 99", function()
		local p = Helpers.profile("Warrior")
		p.UnspentPoints = 200
		expect((ProgressionCore.allocate(p, { Vigor = 99 }))).toBe(false)
	end)

	t.it("second class ability unlocks at level 10", function()
		local p = Helpers.profile("Mage")
		expect(p.Abilities.Unlocked.glacial_ring).toBeNil()
		ProgressionCore.grantXp(p, Formulas.totalXpForLevel(10))
		expect(p.Level).toBe(10)
		expect(p.Abilities.Unlocked.glacial_ring).toBe(true)
		expect(p.Abilities.Slot2).toBe("glacial_ring")
	end)

	t.it("ability slots only accept unlocked abilities", function()
		local p = Helpers.profile("Mage")
		expect((ProgressionCore.setAbilitySlot(p, "Slot1", "sovereign_wrath"))).toBe(false)
		expect((ProgressionCore.setAbilitySlot(p, "Slot3", "firebolt"))).toBe(false)
		ProgressionCore.unlockAbility(p, "ash_wave")
		expect((ProgressionCore.setAbilitySlot(p, "Slot2", "ash_wave"))).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">Promo.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local PromoCore = require(SSS.Server.Core.PromoCore)
local PromoCodes = require(SSS.Server.Config.PromoCodes)
local CombatCore = require(SSS.Server.Core.CombatCore)
local Items = require(game:GetService("ReplicatedStorage").Shared.Config.Items)
local Cosmetics = require(game:GetService("ReplicatedStorage").Shared.Config.Cosmetics)
local Stats = require(game:GetService("ReplicatedStorage").Shared.Logic.Stats)
local Formulas = require(game:GetService("ReplicatedStorage").Shared.Logic.Formulas)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("both admin codes are 30 characters, distinct, and limited to 2 uses", function()
		local seen = {}
		local admins = 0
		for _, def in PromoCodes do
			expect(seen[string.upper(def.Code)]).toBeNil()
			seen[string.upper(def.Code)] = true
			if def.Kind == "Admin" then
				admins += 1
				expect(#def.Code).toBe(30)
				expect(def.MaxUses).toBe(2)
			end
		end
		expect(admins).toBe(2)
	end)

	t.it("lookup is case/space-insensitive and rejects junk", function()
		local def = PromoCodes.admin_1
		expect(PromoCore.find(PromoCodes, "  " .. string.lower(def.Code) .. " ")).toBe(def)
		expect(PromoCore.find(PromoCodes, "nope")).toBeNil()
		expect(PromoCore.find(PromoCodes, 123)).toBeNil()
		expect(PromoCore.find(PromoCodes, string.rep("A", 200))).toBeNil()
		expect(PromoCore.find(PromoCodes, "")).toBeNil()
	end)

	t.it("a code works once per character", function()
		local p = Helpers.profile("Warrior")
		local def = PromoCodes.launch
		expect((PromoCore.check(p, def, 0))).toBe(true)
		PromoCore.markRedeemed(p, def)
		local ok, err = PromoCore.check(p, def, 0)
		expect(ok).toBe(false)
		expect(err).toBe("AlreadyRedeemed")
	end)

	t.it("admin grants: second admin code cannot be stacked by the same character", function()
		local p = Helpers.profile("Warrior")
		PromoCore.markRedeemed(p, PromoCodes.admin_1)
		expect(p.Admin.Granted).toBe(true)
		expect((PromoCore.check(p, PromoCodes.admin_2, 0))).toBe(false)
	end)

	t.it("unlock all / all items / max upgrades / all cosmetics", function()
		local p = Helpers.profile("Mage")
		PromoCore.unlockAll(p)
		expect(p.Tower.HighestCleared).toBe(20)
		expect(p.Abilities.Unlocked.sovereign_wrath).toBe(true)
		PromoCore.allItems(p)
		for id, def in Items do
			if string.sub(id, 1, 1) ~= "_" then
				expect(Helpers.owns(p, id)).toBe(true)
			end
		end
		PromoCore.maxUpgrades(p)
		for _, inst in p.Inventory.Items do
			local path = Formulas.upgradePath(Items[inst.Id])
			if path then
				expect(inst.Upgrade).toBe(path.Max)
			end
		end
		PromoCore.allCosmetics(p)
		for id in Cosmetics do
			expect(p.Cosmetics.Owned[id]).toBe(true)
		end
		expect(p.Titles.Administrator).toBe(true)
		-- the result is still a valid profile
		local ProfileSchema = require(SSS.Server.Core.ProfileSchema)
		local _, corrections = ProfileSchema.reconcile(Helpers.snapshot(p))
		expect(#corrections).toBe(0)
	end)

	t.it("never die blocks all damage", function()
		local p = Helpers.profile("Mage")
		local stats = Stats.compute(p)
		local s = CombatCore.newPlayerState(stats, -100)
		s.GodMode = true
		local r = CombatCore.resolveIncoming(s, { Damage = 1e9, DamageType = "Physical", Poise = 999 }, 0, stats, true)
		expect(r.Outcome).toBe("Immune")
		expect(CombatCore.applyDamage(s, 1e9)).toBe(false)
		expect(s.Health).toBe(s.MaxHealth)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">Quest.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local QuestCore = require(SSS.Server.Core.QuestCore)
local InventoryCore = require(SSS.Server.Core.InventoryCore)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("prerequisites gate quests", function()
		local p = Helpers.profile("Warrior")
		expect(QuestCore.status(p, "hunt_wolves")).toBe("Locked")
		expect((QuestCore.accept(p, "hunt_wolves"))).toBe(false)
		expect((QuestCore.accept(p, "hunt_thralls"))).toBe(true)
		expect((QuestCore.accept(p, "hunt_thralls"))).toBe(false)
	end)

	t.it("kill progress only counts matching enemies while active", function()
		local p = Helpers.profile("Warrior")
		QuestCore.onEvent(p, { Type = "Kill", Enemy = "hollow_thrall" }) -- not accepted yet
		QuestCore.accept(p, "hunt_thralls")
		for _ = 1, 7 do
			QuestCore.onEvent(p, { Type = "Kill", Enemy = "hollow_thrall" })
		end
		QuestCore.onEvent(p, { Type = "Kill", Enemy = "rotwood_wolf" })
		expect(QuestCore.isComplete(p, "hunt_thralls")).toBe(false)
		QuestCore.onEvent(p, { Type = "Kill", Enemy = "hollow_thrall" })
		expect(QuestCore.isComplete(p, "hunt_thralls")).toBe(true)
		local ok, rewards = QuestCore.turnIn(p, "hunt_thralls")
		expect(ok).toBe(true)
		expect(rewards.Xp > 0).toBeTruthy()
		expect((QuestCore.turnIn(p, "hunt_thralls"))).toBe(false)
	end)

	t.it("collect quests consume items on turn-in", function()
		local p = Helpers.profile("Warrior")
		p.Quests.Completed.smith_upgrade3 = true
		QuestCore.accept(p, "smith_ore")
		InventoryCore.addItem(p, "iron_ore", 7)
		local ok = QuestCore.turnIn(p, "smith_ore")
		expect(ok).toBe(true)
		expect(InventoryCore.stackCount(p, "iron_ore")).toBe(1)
	end)

	t.it("boss objectives read tower progress", function()
		local p = Helpers.profile("Warrior")
		QuestCore.accept(p, "main_tower_1")
		expect(QuestCore.isComplete(p, "main_tower_1")).toBe(false)
		p.Tower.HighestCleared = 1
		expect(QuestCore.isComplete(p, "main_tower_1")).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">Receipt.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local ReceiptCore = require(SSS.Server.Core.ReceiptCore)
local Products = require(game:GetService("ReplicatedStorage").Shared.Config.Products)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect
	-- configure a fake product id for the test only
	local function withProduct(fn)
		local old = Products.DevProducts.aura_wisp.Id
		Products.DevProducts.aura_wisp.Id = 555
		local ok, err = pcall(fn)
		Products.DevProducts.aura_wisp.Id = old
		if not ok then error(err, 0) end
	end

	t.it("grants once per PurchaseId", function()
		withProduct(function()
			local p = Helpers.profile("Warrior")
			local s1, granted = ReceiptCore.process(p, { PurchaseId = "abc", ProductId = 555 })
			expect(s1).toBe("Granted")
			expect(granted[1]).toBe("aura_wisp")
			local s2 = ReceiptCore.process(p, { PurchaseId = "abc", ProductId = 555 })
			expect(s2).toBe("AlreadyGranted")
			expect(p.Purchases.Products.aura_wisp).toBe(1)
		end)
	end)

	t.it("unknown and unconfigured (id 0) products are not processed", function()
		local p = Helpers.profile("Warrior")
		expect((ReceiptCore.process(p, { PurchaseId = "x", ProductId = 999 }))).toBe("Unknown")
		expect((ReceiptCore.process(p, { PurchaseId = "y", ProductId = 0 }))).toBe("Unknown")
		expect(#p.Purchases.ProcessedReceipts).toBe(0)
	end)

	t.it("receipt history is bounded", function()
		withProduct(function()
			local p = Helpers.profile("Warrior")
			for i = 1, 200 do
				ReceiptCore.process(p, { PurchaseId = "r" .. i, ProductId = 555 })
			end
			expect(#p.Purchases.ProcessedReceipts <= 80).toBeTruthy()
		end)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">TestKit</string>
          <string name="Source"><![CDATA[--[[
	TestKit
	Tiny test framework that runs both in the offline luau CLI bundle (tools/build_test_bundle.py)
	and inside Roblox Studio (ServerScriptService.Server.TestRunner, when Workspace attribute
	RunTests = true). Spec modules are ModuleScripts named "*.spec" returning function(t).
]]

local TestKit = {}

local function fmt(v)
	if type(v) == "string" then
		return string.format("%q", v)
	end
	return tostring(v)
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in a do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

function TestKit.expect(actual)
	local e = {}
	function e.toBe(expected)
		if actual ~= expected then
			error(("expected %s to be %s"):format(fmt(actual), fmt(expected)), 2)
		end
	end
	function e.toEqual(expected)
		if not deepEqual(actual, expected) then
			error(("expected tables to be deeply equal (got %s)"):format(fmt(actual)), 2)
		end
	end
	function e.toBeTruthy()
		if not actual then
			error(("expected %s to be truthy"):format(fmt(actual)), 2)
		end
	end
	function e.toBeFalsy()
		if actual then
			error(("expected %s to be falsy"):format(fmt(actual)), 2)
		end
	end
	function e.toBeNear(expected, eps)
		if type(actual) ~= "number" or math.abs(actual - expected) > (eps or 1e-6) then
			error(("expected %s to be near %s"):format(fmt(actual), fmt(expected)), 2)
		end
	end
	function e.toBeAtLeast(n)
		if type(actual) ~= "number" or actual < n then
			error(("expected %s >= %s"):format(fmt(actual), fmt(n)), 2)
		end
	end
	function e.toBeAtMost(n)
		if type(actual) ~= "number" or actual > n then
			error(("expected %s <= %s"):format(fmt(actual), fmt(n)), 2)
		end
	end
	function e.toBeNil()
		if actual ~= nil then
			error(("expected nil, got %s"):format(fmt(actual)), 2)
		end
	end
	return e
end

-- Runs every *.spec module under `folder`. Returns true when all pass.
function TestKit.runAll(folder, requireFn, filter: string?)
	local passed, failed, total = 0, 0, 0
	local failures = {}
	local specs = {}
	for _, child in folder:GetChildren() do
		if string.sub(child.Name, -5) == ".spec" and (not filter or string.find(child.Name, filter, 1, true)) then
			table.insert(specs, child)
		end
	end
	table.sort(specs, function(a, b)
		return a.Name < b.Name
	end)
	for _, spec in specs do
		local suiteName = string.sub(spec.Name, 1, -6)
		local okLoad, specFn = pcall(requireFn, spec)
		if not okLoad then
			failed += 1
			total += 1
			table.insert(failures, suiteName .. " (load): " .. tostring(specFn))
		else
			local t = {
				expect = TestKit.expect,
				it = function(name, fn)
					total += 1
					local ok, err = pcall(fn)
					if ok then
						passed += 1
					else
						failed += 1
						table.insert(failures, suiteName .. " > " .. name .. ": " .. tostring(err))
					end
				end,
			}
			local okRun, err = pcall(specFn, t)
			if not okRun then
				failed += 1
				total += 1
				table.insert(failures, suiteName .. " (suite): " .. tostring(err))
			end
		end
	end
	for _, f in failures do
		print("FAIL  " .. f)
	end
	print(("Tests: %d passed, %d failed, %d total (%d suites)"):format(passed, failed, total, #specs))
	TestKit.LastResult = { Passed = passed, Failed = failed, Total = total, Failures = failures }
	return failed == 0
end

return TestKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">Training.spec</string>
          <string name="Source"><![CDATA[local SSS = game:GetService("ServerScriptService")
local TrainingCore = require(SSS.Server.Core.TrainingCore)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local Helpers = require(game:GetService("ServerStorage").Tests.Helpers)

return function(t)
	local expect = t.expect

	t.it("rep timing is validated server-side (autoclick fails)", function()
		local p = Helpers.profile("Warrior")
		local s = TrainingCore.start(p, "weightlifting", 0)
		TrainingCore.rep(s, 0, true)
		expect(TrainingCore.rep(s, 0.1, true)).toBe("Failed")
	end)

	t.it("completing reps succeeds and rewards once", function()
		local p = Helpers.profile("Warrior")
		local s = TrainingCore.start(p, "weightlifting", 0)
		local now = 0
		local state
		for _ = 1, 12 do
			now += 1
			state = TrainingCore.rep(s, now, true)
		end
		expect(state).toBe("Success")
		local r = TrainingCore.reward(p, s, now)
		expect(r.Points).toBe(2)
		local r2 = TrainingCore.reward(p, s, now)
		expect(r2.Points).toBe(0)
	end)

	t.it("cooldown blocks immediate retries", function()
		local p = Helpers.profile("Warrior")
		p.TrainingCooldowns.weightlifting = 100
		local s, err = TrainingCore.start(p, "weightlifting", 110)
		expect(s).toBeNil()
		expect(err).toBe("Cooldown")
	end)

	t.it("training bonus is capped no matter how long you train", function()
		local p = Helpers.profile("Warrior")
		local now = 0
		for day = 1, 200 do
			now = day * GameConfig.Training.DailyResetSeconds
			for _ = 1, 10 do
				now += 400
				local s = TrainingCore.start(p, "weightlifting", now)
				if s then
					s.State = "Success"
					TrainingCore.reward(p, s, now)
				end
			end
		end
		expect(p.TrainingBonus.Strength).toBe(GameConfig.Training.MaxTrainingBonusPerAttribute)
	end)

	t.it("daily point cap", function()
		local p = Helpers.profile("Warrior")
		local total = 0
		for i = 1, 20 do
			local s = TrainingCore.start(p, "dummy_dps", i * 1000)
			if s then
				s.State = "Success"
				total += TrainingCore.reward(p, s, i * 1000).Points
			end
		end
		expect(total <= GameConfig.Training.DailyPointCap * 2).toBeTruthy()
	end)

	t.it("drills require the configured number of successes", function()
		local p = Helpers.profile("Warrior")
		local s = TrainingCore.start(p, "parry_drill", 0)
		TrainingCore.drillAttack(s, "Parried")
		TrainingCore.drillAttack(s, "Hit")
		TrainingCore.drillAttack(s, "Parried")
		expect(TrainingCore.drillAttack(s, "Parried")).toBe("Success")
		local s2 = TrainingCore.start(Helpers.profile("Warrior"), "dodge_drill", 0)
		TrainingCore.drillAttack(s2, "Hit")
		expect(TrainingCore.drillAttack(s2, "Hit")).toBe("Failed")
	end)

	t.it("course posts must be touched in order and in time", function()
		local p = Helpers.profile("Warrior")
		local s = TrainingCore.start(p, "stamina_run", 0)
		TrainingCore.post(s, 2, 1)
		expect(s.Count).toBe(0)
		for i = 1, 6 do TrainingCore.post(s, i, i) end
		expect(s.State).toBe("Success")
		local s2 = TrainingCore.start(Helpers.profile("Warrior"), "stamina_run", 0)
		expect(TrainingCore.post(s2, 1, 100)).toBe("Failed")
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
