        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--[[
	Abilities
	Class abilities and boss-reward abilities. Any character can equip any ability they have
	unlocked (two slots), which enables hybrid builds; classes only decide the starting set.

	Types:
	  Projectile : server-simulated projectile (Speed, Radius, Range)
	  Circle     : area around the caster (Radius)
	  Cone       : area in front of the caster (Range, Arc)
	  Line       : rectangle in front of the caster (Length, Width)
	  Buff       : timed self buff (Buff, Amount, Duration)
	  Heal       : heal caster (+ allies within AllyRadius)
	  ShadowStep : teleport behind a nearby target, next hit is a critical
	Power = damage as a multiple of the scaling attribute's ability power (see Formulas.abilityPower).
]]

local Abilities = {
	-- Warrior
	war_cry = { Name = "War Cry", Type = "Buff", Buff = "Damage", Amount = 0.2, Poise = 30, Duration = 12, Cooldown = 30, Stamina = 20, Mana = 0,
		Description = "+20% damage and +30 poise for 12 seconds." },
	whirlwind = { Name = "Whirlwind", Type = "Circle", Radius = 9, Power = 1.5, Scaling = "Strength", Windup = 0.35, Cooldown = 10, Stamina = 35, Mana = 0, Poise = 40,
		UnlockLevel = 10, Description = "Spin with your weapon, striking all around you." },
	-- Knight
	bulwark = { Name = "Bulwark", Type = "Buff", Buff = "Defense", Amount = 0.4, Duration = 8, Cooldown = 25, Stamina = 15, Mana = 0,
		Description = "Take 40% less damage for 8 seconds." },
	shield_bash = { Name = "Shield Bash", Type = "Cone", Range = 7, Arc = 80, Power = 0.9, Scaling = "Strength", Windup = 0.2, Cooldown = 8, Stamina = 22, Mana = 0, Poise = 90,
		UnlockLevel = 10, Description = "A heavy bash that breaks poise." },
	-- Mage
	firebolt = { Name = "Firebolt", Type = "Projectile", DamageType = "Fire", Speed = 110, Radius = 2, Range = 120, Power = 1.3, Scaling = "Intelligence", Windup = 0.25,
		Cooldown = 1.4, Stamina = 6, Mana = 12, Poise = 14, Status = { Burn = 30 }, Description = "Hurl a bolt of fire." },
	glacial_ring = { Name = "Glacial Ring", Type = "Circle", DamageType = "Magic", Radius = 12, Power = 1.6, Scaling = "Intelligence", Windup = 0.45, Cooldown = 12,
		Stamina = 10, Mana = 30, Poise = 20, Slow = { Amount = 0.4, Duration = 4 }, UnlockLevel = 10, Description = "A ring of frost that damages and slows." },
	-- Wizard
	arcane_nova = { Name = "Arcane Nova", Type = "Circle", DamageType = "Magic", Radius = 14, Power = 2.2, Scaling = "Intelligence", Windup = 0.7, Cooldown = 10,
		Stamina = 10, Mana = 35, Poise = 40, Description = "A delayed burst of pure force around you." },
	rift_lance = { Name = "Rift Lance", Type = "Line", DamageType = "Magic", Length = 40, Width = 5, Power = 1.9, Scaling = "Intelligence", Windup = 0.5,
		Cooldown = 6, Stamina = 8, Mana = 25, Poise = 25, UnlockLevel = 10, Description = "A piercing lance that strikes everything in a line." },
	-- Assassin
	shadow_step = { Name = "Shadow Step", Type = "ShadowStep", Range = 26, Cooldown = 8, Stamina = 25, Mana = 0, CritDuration = 2.5,
		Description = "Step behind your target. Your next hit within 2.5 seconds is critical." },
	venom_edge = { Name = "Venom Edge", Type = "Buff", Buff = "Poison", Amount = 35, Duration = 20, Cooldown = 30, Stamina = 10, Mana = 0,
		UnlockLevel = 10, Description = "Coat your blade: hits add poison build-up for 20 seconds." },
	-- Paladin
	sacred_mend = { Name = "Sacred Mend", Type = "Heal", Power = 0.22, Scaling = "Faith", AllyRadius = 18, AllyFraction = 0.5, Windup = 0.6, Cooldown = 18,
		Stamina = 0, Mana = 30, Description = "Heal yourself and half as much to nearby allies." },
	radiant_smite = { Name = "Radiant Smite", Type = "Cone", DamageType = "Holy", Range = 11, Arc = 70, Power = 1.6, Scaling = "Faith", Windup = 0.4, Cooldown = 8,
		Stamina = 10, Mana = 20, Poise = 35, UnlockLevel = 10, Description = "A wave of holy light in front of you." },
	-- Boss rewards (any build)
	ash_wave = { Name = "Ash Wave", Type = "Line", DamageType = "Fire", Length = 26, Width = 6, Power = 1.5, Scaling = "Strength", Windup = 0.45, Cooldown = 9,
		Stamina = 20, Mana = 10, Poise = 30, Description = "Send a wave of cinders along the ground." },
	thorn_snare = { Name = "Thorn Snare", Type = "Circle", Radius = 10, Power = 1.0, Scaling = "Arcane", Windup = 0.4, Cooldown = 14, Stamina = 10, Mana = 20,
		Status = { Poison = 50 }, Slow = { Amount = 0.5, Duration = 3 }, Description = "Roots burst from the ground, poisoning and slowing foes." },
	ember_dash = { Name = "Ember Dash", Type = "Line", DamageType = "Fire", Length = 18, Width = 5, Power = 1.2, Scaling = "Dexterity", Windup = 0.15, Cooldown = 7,
		Stamina = 25, Mana = 0, Poise = 20, Dash = true, Description = "Dash forward in a trail of fire." },
	oracle_tide = { Name = "Oracle's Tide", Type = "Heal", Power = 0.3, Scaling = "Faith", AllyRadius = 25, AllyFraction = 0.75, Windup = 0.8, Cooldown = 30,
		Stamina = 0, Mana = 45, Description = "A tide of restoration for you and your allies." },
	eclipse_burst = { Name = "Eclipse Burst", Type = "Circle", DamageType = "Magic", Radius = 16, Power = 2.6, Scaling = "Intelligence", Windup = 0.9, Cooldown = 18,
		Stamina = 10, Mana = 50, Poise = 60, Description = "Darkness collapses around you, then explodes." },
	sovereign_wrath = { Name = "Sovereign's Wrath", Type = "Cone", Range = 16, Arc = 120, Power = 3.0, Scaling = "Strength", Windup = 0.8, Cooldown = 25,
		Stamina = 30, Mana = 30, Poise = 80, Description = "The final ruler's judgement, in your hands." },
}

for id, def in Abilities do
	def.Id = id
	def.DamageType = def.DamageType or "Physical"
	def.UnlockLevel = def.UnlockLevel or 1
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Achievements</string>
            <string name="Source"><![CDATA[--[[
	Achievements
	Counter-based achievements. `Stat` is a key in profile.Stats incremented by the server;
	`Goal` is the threshold. Some use custom checks (Check = "...") evaluated by AchievementCore.
	Rewards are cosmetic (titles, auras) or small quality-of-life items; never combat power.
]]

local Achievements = {
	first_blood = { Name = "First Blood", Description = "Defeat your first enemy.", Stat = "Kills", Goal = 1, Reward = { Title = "Initiate" } },
	slayer = { Name = "Slayer", Description = "Defeat 250 enemies.", Stat = "Kills", Goal = 250, Reward = { Title = "Slayer" } },
	exterminator = { Name = "Exterminator", Description = "Defeat 2000 enemies.", Stat = "Kills", Goal = 2000, Reward = { Cosmetic = "aura_bloodmist" } },
	floor_1 = { Name = "The Climb Begins", Description = "Clear tower floor 1.", Check = "Floor", Goal = 1 },
	floor_5 = { Name = "Fivefold", Description = "Clear tower floor 5.", Check = "Floor", Goal = 5, Reward = { Title = "Climber" } },
	floor_10 = { Name = "Halfway Up", Description = "Clear tower floor 10.", Check = "Floor", Goal = 10, Reward = { Title = "Ascendant" } },
	floor_15 = { Name = "Thin Air", Description = "Clear tower floor 15.", Check = "Floor", Goal = 15 },
	floor_20 = { Name = "Summit of Ruin", Description = "Clear all 20 floors.", Check = "Floor", Goal = 20, Reward = { Title = "Tower Conqueror", Cosmetic = "skin_sovereign" } },
	parry_10 = { Name = "Deflection", Description = "Parry 10 attacks.", Stat = "Parries", Goal = 10 },
	parry_100 = { Name = "Parry Master", Description = "Parry 100 attacks.", Stat = "Parries", Goal = 100, Reward = { Title = "Riposte" } },
	dodge_500 = { Name = "Untouchable Feet", Description = "Dodge 500 times.", Stat = "Dodges", Goal = 500 },
	flawless = { Name = "Flawless", Description = "Defeat a tower boss without taking damage.", Stat = "FlawlessBosses", Goal = 1, Reward = { Title = "Flawless", Cosmetic = "aura_frost" } },
	solo_10 = { Name = "Lone Climber", Description = "Defeat 10 tower bosses solo.", Stat = "SoloBossKills", Goal = 10, Reward = { Title = "Lone Wolf" } },
	coop_5 = { Name = "Fellowship", Description = "Defeat 5 tower bosses with a party.", Stat = "CoopBossKills", Goal = 5, Reward = { Title = "Companion" } },
	recover_10 = { Name = "Never Lost", Description = "Recover your lost embers 10 times.", Stat = "Recoveries", Goal = 10 },
	deaths_50 = { Name = "Fallen, Not Finished", Description = "Die 50 times. It happens.", Stat = "Deaths", Goal = 50, Reward = { Title = "Undying" } },
	explorer = { Name = "Cartographer", Description = "Discover every location.", Check = "AllLocations", Reward = { Title = "Cartographer" } },
	secrets = { Name = "Secret Keeper", Description = "Discover every secret location.", Check = "AllSecrets", Reward = { Cosmetic = "skin_shadow" } },
	collector = { Name = "Collector", Description = "Own 5 Legendary or Mythic items.", Check = "HighRarity", Goal = 5 },
	smith_10 = { Name = "Master Smith", Description = "Upgrade any item to +10.", Check = "UpgradeLevel", Goal = 10, Reward = { Title = "Smith" } },
	hybrid = { Name = "Spellsword", Description = "Have two different damage attributes at 30 or more.", Check = "Hybrid", Goal = 30, Reward = { Title = "Spellsword" } },
	trainer = { Name = "Disciplined", Description = "Complete 25 training challenges.", Stat = "TrainingDone", Goal = 25, Reward = { Title = "Disciplined" } },
	quests_10 = { Name = "Helping Hand", Description = "Complete 10 quests.", Stat = "QuestsDone", Goal = 10 },
	pvp_10 = { Name = "Pit Fighter", Description = "Win 10 duels in the Ashen Pit.", Stat = "PvPWins", Goal = 10, Reward = { Title = "Pit Fighter" } },
}

for id, a in Achievements do
	a.Id = id
end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Attacks</string>
            <string name="Source"><![CDATA[--[[
	Attacks
	Constructors for enemy/boss attack definitions. Every hostile attack is:
	  1. Telegraphed: a ground indicator appears for `Windup` seconds (colour shows whether
	     it can be parried: gold = parryable, red = unblockable, white = blockable).
	  2. Resolved: players inside the shape at resolve time take damage, unless dodging
	     (i-frames), blocking (if Blockable) or parrying (if Parryable).
	  3. Recovered: the attacker is idle/vulnerable for `Recovery` seconds.

	Shapes: Circle, Cone, Line, Ring, Projectile, Summon, Hazard, Teleport, Leap, Dash, Pulse
	Damage is a multiplier of the attacker's base damage.
	Steps: an attack may be a combo, listed as `Steps`; each step has its own windup.
]]

local Attacks = {}

local function base(shape, opts)
	local a = {
		Shape = shape,
		Name = opts.Name or shape,
		Windup = opts.Windup or 0.9,
		Recovery = opts.Recovery or 0.8,
		Damage = opts.Damage or 1,
		Poise = opts.Poise or 20,
		Parryable = opts.Parryable == true,
		Blockable = opts.Blockable ~= false,
		Status = opts.Status,
		MinRange = opts.MinRange or 0,
		MaxRange = opts.MaxRange or 10,
		Weight = opts.Weight or 1,
		Cooldown = opts.Cooldown or 0,
	}
	for k, v in opts do
		if a[k] == nil then
			a[k] = v
		end
	end
	return a
end

-- Melee swing in front of the attacker.
function Attacks.Cone(opts)
	opts.Range = opts.Range or 9
	opts.Arc = opts.Arc or 100
	opts.MaxRange = opts.MaxRange or opts.Range
	return base("Cone", opts)
end

-- Area centred `Offset` studs in front of the attacker.
function Attacks.Circle(opts)
	opts.Radius = opts.Radius or 8
	opts.Offset = opts.Offset or 0
	opts.MaxRange = opts.MaxRange or (opts.Radius + opts.Offset)
	return base("Circle", opts)
end

-- Rectangle starting at the attacker extending forward.
function Attacks.Line(opts)
	opts.Length = opts.Length or 24
	opts.Width = opts.Width or 6
	opts.MaxRange = opts.MaxRange or opts.Length
	return base("Line", opts)
end

-- Donut: safe near the attacker and far away.
function Attacks.Ring(opts)
	opts.Inner = opts.Inner or 8
	opts.Outer = opts.Outer or 18
	opts.MaxRange = opts.MaxRange or 30
	opts.Blockable = opts.Blockable == true
	return base("Ring", opts)
end

function Attacks.Projectile(opts)
	opts.Speed = opts.Speed or 60
	opts.Radius = opts.Radius or 2
	opts.Count = opts.Count or 1
	opts.Spread = opts.Spread or 0
	opts.MaxRange = opts.MaxRange or 70
	opts.MinRange = opts.MinRange or 8
	opts.Homing = opts.Homing or 0
	return base("Projectile", opts)
end

-- Persistent damage zones placed under targets after the windup.
function Attacks.Hazard(opts)
	opts.Radius = opts.Radius or 7
	opts.Duration = opts.Duration or 6
	opts.TickDamage = opts.TickDamage or 0.25
	opts.Count = opts.Count or 1
	opts.MaxRange = opts.MaxRange or 80
	opts.Blockable = false
	return base("Hazard", opts)
end

function Attacks.Summon(opts)
	opts.Count = opts.Count or 2
	opts.MaxAlive = opts.MaxAlive or 4
	opts.MaxRange = opts.MaxRange or 100
	opts.Damage = 0
	return base("Summon", opts)
end

-- Teleport to a point near (or away from) the target, telegraphed at the destination.
function Attacks.Teleport(opts)
	opts.MaxRange = opts.MaxRange or 100
	opts.Damage = opts.Damage or 0
	opts.Distance = opts.Distance or 14
	return base("Teleport", opts)
end

-- Jump onto the target's position at windup start; lands with a Circle.
function Attacks.Leap(opts)
	opts.Radius = opts.Radius or 9
	opts.MinRange = opts.MinRange or 12
	opts.MaxRange = opts.MaxRange or 45
	return base("Leap", opts)
end

-- Charge in a straight line toward the target, damaging along the Line.
function Attacks.Dash(opts)
	opts.Length = opts.Length or 30
	opts.Width = opts.Width or 7
	opts.MinRange = opts.MinRange or 8
	opts.MaxRange = opts.MaxRange or opts.Length
	return base("Dash", opts)
end

-- Arena-wide pulse with explicit safe zones (players inside a safe zone take no damage).
function Attacks.Pulse(opts)
	opts.SafeZones = opts.SafeZones or 3
	opts.SafeRadius = opts.SafeRadius or 9
	opts.MaxRange = opts.MaxRange or 200
	opts.Blockable = false
	return base("Pulse", opts)
end

-- Guard/counter stance: the attacker guards for `Duration` (= Windup). Hitting it during the
-- stance triggers an immediate, telegraphed counter (cone). Waiting it out is always safe.
function Attacks.CounterStance(opts)
	opts.Range = opts.Range or 10
	opts.Arc = opts.Arc or 140
	opts.MaxRange = opts.MaxRange or 14
	opts.CounterWindup = opts.CounterWindup or 0.45
	return base("CounterStance", opts)
end

-- Combo: a sequence of attacks performed back to back.
function Attacks.Combo(name, steps, opts)
	opts = opts or {}
	local maxRange = 0
	for _, s in steps do
		maxRange = math.max(maxRange, s.MaxRange or 0)
	end
	return {
		Shape = "Combo",
		Name = name,
		Steps = steps,
		Recovery = opts.Recovery or steps[#steps].Recovery,
		MinRange = opts.MinRange or 0,
		MaxRange = opts.MaxRange or steps[1].MaxRange or maxRange,
		Weight = opts.Weight or 1,
		Cooldown = opts.Cooldown or 0,
		Damage = 0,
		Windup = steps[1].Windup,
	}
end

return Attacks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--[[
	Audio
	Sound configuration. Only Roblox built-in content sounds (rbxasset://) are referenced by
	default because no licensed audio has been uploaded for this project yet. Music and
	ambience IDs are intentionally empty: add your own licensed "rbxassetid://..." values here.
	Empty entries are skipped silently.
]]

local Audio = {
	Sfx = {
		Swing = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, PitchRange = { 0.9, 1.1 } },
		HeavySwing = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.6, PitchRange = { 0.8, 0.95 } },
		Hit = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.6, PitchRange = { 0.6, 0.75 } },
		Hurt = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.6, PitchRange = { 0.5, 0.6 } },
		Parry = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.9, PitchRange = { 1.2, 1.3 } },
		Dodge = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.25, PitchRange = { 1.4, 1.6 } },
		Drink = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.4, PitchRange = { 0.6, 0.7 } },
		Ui = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.25, PitchRange = { 0.9, 1.0 } },
		Reward = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.4, PitchRange = { 1.3, 1.4 } },
		Death = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.8, PitchRange = { 0.3, 0.35 } },
	},
	-- Licensed music / ambience goes here (rbxassetid://...). Empty = silent.
	Music = {
		Sanctuary = "",
		Wilds = "",
		Boss = "",
		Victory = "",
	},
	Ambience = {
		Wind = "",
		Forest = "",
		Cave = "",
	},
}

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Bosses</string>
            <string name="Source"><![CDATA[--[[
	Bosses
	The twenty guardians of the Tower of the Fallen. Each entry defines:
	  Floor, Name, Title, Lore
	  HealthMult / DamageMult / Poise / Defense : multipliers on Formulas.bossHealth/bossDamage
	  Model   : procedural silhouette (Services/EntityModels.luau)
	  Arena   : size + visual theme of the encounter space
	  Phases  : ordered by Threshold (fraction of HP at which the phase begins)
	  Mechanics : distinctive rules handled by the boss framework
	  Rewards : first-clear and replay rewards

	Attack windups/recoveries are authored at "floor 1" speed. The framework multiplies them
	by Formulas.bossTiming(floor), which tightens timings with floor but never below the
	fairness minimums in Bosses.Fairness (validated by tests/BossFairness.spec.luau).
]]

local Attacks = require(script.Parent.Attacks)
local C, Ci, L, R, P = Attacks.Cone, Attacks.Circle, Attacks.Line, Attacks.Ring, Attacks.Projectile
local H, S, T, Lp, D, Pu = Attacks.Hazard, Attacks.Summon, Attacks.Teleport, Attacks.Leap, Attacks.Dash, Attacks.Pulse
local Combo = Attacks.Combo

local Bosses = {}

Bosses.Fairness = {
	MinWindup = 0.42, -- no hostile attack resolves faster than this after its telegraph appears
	MinComboFollowUp = 0.35, -- follow-up steps inside a combo
	MinRecovery = 0.3,
	MaxHitFractionOfHealth = 0.6, -- at recommended level, no single hit takes more than 60% HP
}

local list = {}
local function boss(def)
	def.Id = "boss_" .. def.Floor
	def.HealthMult = def.HealthMult or 1
	def.DamageMult = def.DamageMult or 1
	def.Poise = def.Poise or 150
	def.Defense = def.Defense or 40
	def.WalkSpeed = def.WalkSpeed or 13
	def.Mechanics = def.Mechanics or {}
	list[def.Floor] = def
	Bosses[def.Id] = def
end

-- ===================================================================== 1
boss({
	Floor = 1, Name = "The Ashen Warden", Title = "Keeper of the First Gate",
	Lore = "A gatekeeper who kept his post long after there was nothing left to guard.",
	Mechanic = "Introductory melee: learn to dodge sweeps and punish slow recoveries.",
	Model = { Style = "Humanoid", Scale = 1.9, Color = Color3.fromRGB(110, 104, 98), Glow = Color3.fromRGB(255, 140, 60), Weapon = "Spear" },
	Arena = { Size = 120, Material = "Slate", Color = Color3.fromRGB(70, 66, 62), Fog = Color3.fromRGB(80, 70, 64), Light = Color3.fromRGB(255, 150, 90), Props = "Pillars" },
	Phases = {
		{ Threshold = 1, Attacks = {
			C({ Name = "Halberd Sweep", Windup = 1.1, Recovery = 1.2, Damage = 1, Range = 12, Arc = 140, Parryable = true }),
			L({ Name = "Gate Thrust", Windup = 1.0, Recovery = 1.3, Damage = 1.1, Length = 16, Width = 4, Parryable = true }),
			Combo("Warden's Rhythm", {
				C({ Windup = 1.0, Recovery = 0.3, Damage = 0.9, Range = 11, Arc = 120, Parryable = true }),
				C({ Windup = 0.8, Recovery = 1.4, Damage = 1.0, Range = 11, Arc = 120, Parryable = true }),
			}),
		} },
		{ Threshold = 0.5, Name = "Embers Rekindled", Attacks = {
			C({ Name = "Halberd Sweep", Windup = 1.0, Recovery = 1.1, Damage = 1, Range = 12, Arc = 140, Parryable = true }),
			L({ Name = "Ash Wave", DamageType = "Fire", Windup = 1.2, Recovery = 1.3, Damage = 1.2, Length = 30, Width = 6, Blockable = true }),
			Lp({ Name = "Falling Gate", Windup = 1.2, Recovery = 1.5, Damage = 1.3, Radius = 9 }),
		} },
	},
	Rewards = { FirstClear = { Items = { warden_halberd = 1, ember_shard = 3, flask_shard = 1 }, Ability = "ash_wave", Title = "Gatebreaker" } },
})

-- ===================================================================== 2
boss({
	Floor = 2, Name = "The Hollow Butcher", Title = "Carver of the Lower Halls",
	Lore = "He learned that a delayed blow is the one nobody dodges.",
	Mechanic = "Heavy, deliberately delayed strikes. Do not panic-roll; wait for the swing.",
	HealthMult = 1.1,
	Model = { Style = "Brute", Scale = 2.1, Color = Color3.fromRGB(120, 80, 70), Weapon = "Cleaver" },
	Arena = { Size = 110, Material = "Cobblestone", Color = Color3.fromRGB(70, 50, 46), Fog = Color3.fromRGB(70, 40, 36), Light = Color3.fromRGB(220, 90, 70), Props = "Hooks" },
	Phases = {
		{ Threshold = 1, Attacks = {
			C({ Name = "Delayed Cleave", Windup = 1.6, Recovery = 1.4, Damage = 1.3, Range = 11, Arc = 120, Parryable = true, Delayed = true }),
			Ci({ Name = "Overhead Chop", Windup = 1.4, Recovery = 1.6, Damage = 1.5, Radius = 5, Offset = 7, MaxRange = 12 }),
			Combo("Butcher's Hack", {
				C({ Windup = 1.0, Recovery = 0.3, Damage = 0.8, Range = 10, Arc = 110, Parryable = true, Status = { Bleed = 30 } }),
