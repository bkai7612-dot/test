	{ Id = "huntmaster", Name = "Huntmaster Corvin", Role = "Quest", Quests = { "hunt_thralls", "hunt_wolves", "hunt_shepherd", "hunt_bandits", "hunt_varrow" }, Position = { 80, 0, 290 } },
