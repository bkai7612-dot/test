        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig
	Central tunables for Tower of the Fallen. Every gameplay number that a designer
	may want to change lives here or in the other Config modules; logic modules read
	from these tables rather than hard-coding values.
]]

local GameConfig = {}

GameConfig.Version = "0.4.0"
GameConfig.DataVersion = 2

GameConfig.Currency = {
	Name = "Embers",
	StartingAmount = 150,
	MaxCarried = 50_000_000,
}

GameConfig.Level = {
	Max = 120, -- hard level cap; prevents unlimited scaling
	PointsPerLevel = 1,
	-- XP needed to advance FROM `level` to `level + 1` = floor(Base * level ^ Exponent + Linear * level)
	XpBase = 60,
	XpExponent = 1.45,
	XpLinear = 40,
}

GameConfig.Attributes = {
	Min = 1,
	Max = 99,
	List = { "Vigor", "Endurance", "Strength", "Dexterity", "Intelligence", "Faith", "Arcane" },
	Descriptions = {
		Vigor = "Raises maximum health.",
		Endurance = "Raises stamina, stamina regeneration and equipment load.",
		Strength = "Improves damage of heavy weapons and strength-scaling gear.",
		Dexterity = "Improves damage of fast and precise weapons, and bow handling.",
		Intelligence = "Improves sorcery damage and maximum mana.",
		Faith = "Improves holy damage, healing magic and maximum mana.",
		Arcane = "Improves bleed and poison build-up, and arcane-scaling gear.",
	},
}

-- Soft-cap curves: each segment is { upToValue, gainPerPoint }.
-- After the last segment no further gain is awarded.
GameConfig.Curves = {
	Health = { Base = 300, Segments = { { 20, 30 }, { 40, 20 }, { 60, 8 }, { 99, 2 } } },
	Stamina = { Base = 80, Segments = { { 20, 3 }, { 40, 2 }, { 60, 0.75 }, { 99, 0.25 } } },
	Mana = { Base = 50, Segments = { { 20, 5 }, { 40, 3.5 }, { 60, 1.5 }, { 99, 0.5 } } },
	EquipLoad = { Base = 40, Segments = { { 20, 1.5 }, { 40, 1 }, { 60, 0.5 }, { 99, 0.2 } } },
	-- Weapon attribute bonus (fraction of base damage before grade coefficient)
	ScalingBonus = { Base = 0, Segments = { { 20, 0.015 }, { 40, 0.012 }, { 60, 0.006 }, { 99, 0.002 } } },
	StatusBonus = { Base = 0, Segments = { { 20, 0.02 }, { 45, 0.015 }, { 99, 0.004 } } },
}

-- Attribute scaling grade coefficients.
GameConfig.ScalingGrades = { S = 1.2, A = 0.95, B = 0.75, C = 0.5, D = 0.3, E = 0.15 }

GameConfig.Stamina = {
	RegenPerSecond = 34,
	RegenDelay = 0.75, -- seconds after spending before regen resumes
	BlockingRegenMultiplier = 0.4,
	SprintCostPerSecond = 14,
	SprintSpeed = 24,
	WalkSpeed = 16,
	ExhaustedThreshold = 0, -- actions require stamina > threshold
}

GameConfig.Mana = {
	RegenPerSecond = 1.5,
}

GameConfig.Combat = {
	LightAttackCost = 14,
	HeavyAttackCost = 26,
	DodgeCost = 18,
	DodgeCooldown = 0.5,
	DodgeIFrames = 0.32,
	DodgeDistance = 16,
	LatencyGrace = 0.15, -- extra time allowed on dodge/parry windows for network latency
	ParryWindow = 0.22,
	ParryCooldown = 0.9,
	ParryStaminaCost = 10,
	BlockAngle = 130, -- degrees in front of the player that a block covers
	BlockStaminaPerDamage = 0.55, -- multiplied by (1 - stability)
	GuardBreakStun = 1.1,
	StaggerDuration = 0.45, -- player hitstun
	StaggerImmunity = 1.2, -- seconds of stagger immunity after being staggered (anti stun-lock)
	EnemyStaggerDuration = 1.6,
	RiposteWindow = 2.0,
	RiposteMultiplier = 2.5,
	BackstabAngle = 60, -- attacker within this angle of target's back counts as a backstab
	BackstabMultiplier = 1.6,
	DaggerCritBonus = 0.5, -- added to crit multipliers for daggers
	MaxReachTolerance = 3, -- studs of slack on server-side reach checks
	CombatTagSeconds = 8,
	HeavyChargeMax = 1.2, -- seconds of charge for max heavy bonus
	HeavyChargeBonus = 0.6, -- +60% damage at full charge
	MinDamage = 1,
	MaxHitsPerSwing = 6, -- caps multi-target cleave
	PlayerDefenseK = 160, -- absorption = def / (def + K)
	MaxAbsorption = 0.72,
	EnemyDefenseK = 120,
	PoiseRegenDelay = 3,
	PvPDamageMultiplier = 0.5,
}

GameConfig.Status = {
	Bleed = { Threshold = 100, PlayerFraction = 0.12, EnemyFraction = 0.08, BossFraction = 0.04, Decay = 8 },
	Poison = { Threshold = 100, Duration = 10, PlayerDps = 0.012, EnemyDps = 0.01, BossDps = 0.003, Decay = 6 },
	Burn = { Threshold = 100, Duration = 4, PlayerDps = 0.02, EnemyDps = 0.015, BossDps = 0.005, Decay = 10 },
}

GameConfig.EquipLoad = {
	-- ratio thresholds -> dodge cost / dodge cooldown multipliers
	Tiers = {
		{ MaxRatio = 0.3, Name = "Light", DodgeCost = 0.85, Speed = 1.05 },
		{ MaxRatio = 0.7, Name = "Medium", DodgeCost = 1.0, Speed = 1.0 },
		{ MaxRatio = 1.0, Name = "Heavy", DodgeCost = 1.3, Speed = 0.9 },
		{ MaxRatio = math.huge, Name = "Overloaded", DodgeCost = 1.8, Speed = 0.75 },
	},
}

GameConfig.Flask = {
	BaseCharges = 3,
	MaxCharges = 9,
	HealFraction = 0.42,
	UseTime = 0.9, -- seconds the player is committed
	Cooldown = 1.6,
}

GameConfig.Consumables = {
	SharedCooldown = 1.0,
	MaxStack = 20,
}

GameConfig.Death = {
	RecoveryExpirySeconds = 2 * 60 * 60, -- lost embers expire after 2 hours of real time
	-- "LosePrevious": a second death before recovery destroys the earlier marker (classic rule).
	-- "Merge": the new marker holds the sum of both drops.
	SecondDeathRule = "LosePrevious",
	RecoveryRadius = 9,
	RespawnInvulnerability = 2.5,
	LoseCurrencyInPvP = false,
}

GameConfig.Save = {
	StoreName = "TOTF_PlayerData_v2",
	KeyPrefix = "player_",
	AutosaveInterval = 120,
	MaxRetries = 5,
	RetryBaseDelay = 1.5,
	LockStaleSeconds = 600, -- a session lock older than this is considered abandoned
	LockAcquireAttempts = 4,
	LockRetryWait = 4,
	ProcessedReceiptHistory = 80,
	LeaderboardStore = "TOTF_Leaderboard_v1",
	LeaderboardRefresh = 300,
}

GameConfig.Party = {
	MaxSize = 4,
	InviteExpiry = 60,
	BossHealthPerExtraPlayer = 0.7, -- +70% boss HP per extra participant
	BossPoisePerExtraPlayer = 0.25,
	GatherRadius = 40, -- party members must be this close to the tower gate to enter together
}

GameConfig.Tower = {
	Floors = 20,
	ReplayCurrencyMultiplier = 0.35,
	ReplayXpMultiplier = 0.35,
	ReplayUniqueDropChance = 0.12,
	ArenaSlotSpacing = 700,
	ArenaOrigin = { X = 4000, Y = 600, Z = 0 },
	MaxConcurrentArenas = 12,
	EncounterIdleTimeout = 900,
	VictoryTeleportDelay = 8,
}

GameConfig.Enemy = {
	TickRate = 0.1,
	ActivationRadius = 220, -- AI sleeps if no player within this range
	DefaultLeash = 85,
	LootPickupLifetime = 120,
	MaxActive = 120,
	ContributionThreshold = 0.1, -- fraction of max HP a player must deal to earn rewards
}

GameConfig.Training = {
	DailyResetSeconds = 24 * 60 * 60,
	MaxTrainingBonusPerAttribute = 5,
	PointsPerBonus = 10,
	DailyPointCap = 12,
}

GameConfig.Shop = {
	SellRatio = 0.35,
	MaxPurchaseQuantity = 20,
	InteractRadius = 18,
}

GameConfig.Inventory = {
	MaxSlots = 300,
	MaxStack = 999,
	BuildPresetsFree = 2,
	BuildPresetsWithPass = 5,
}

GameConfig.Checkpoint = {
	InteractRadius = 14,
}

GameConfig.AntiCheat = {
	MaxHorizontalSpeed = 75, -- studs/s averaged over a sample window, generous for dodges
	SampleWindow = 1,
	ViolationsBeforeReset = 3,
}

GameConfig.Interaction = {
	MaxRemoteRate = 20, -- per-player requests per second per remote before throttling
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--[[
	Items
	Data-driven definitions for every item. Kinds:
	  Weapon, Shield, Armor, Accessory, Consumable, Material

	Weapon fields:
	  WeaponType  -> WeaponTypes.luau entry (timing, reach, shape)
	  Damage      -> base attack rating at +0
	  DamageType  -> Physical | Magic | Fire | Holy
	  Scaling     -> { Attribute = Grade }  (grades in GameConfig.ScalingGrades)
	  Requires    -> { Attribute = value } ; unmet requirements apply a damage penalty (no hard lock)
	  Upgrade     -> "Standard" (+10, shards) | "Unique" (+5, remnants)
	  Status      -> { Bleed|Poison|Burn = buildup per hit }
	  Weight      -> equip load
	  Value       -> base shop price (sell = Value * SellRatio * rarity mult)

	Armor pieces are generated from ArmorSets below to keep the data compact.
]]

local Items = {}

local function add(id: string, def)
	def.Id = id
	Items[id] = def
end

local function weapon(id, name, wtype, rarity, damage, scaling, requires, opts)
	opts = opts or {}
	add(id, {
		Kind = "Weapon",
		Name = name,
		WeaponType = wtype,
		Rarity = rarity,
		Damage = damage,
		DamageType = opts.DamageType or "Physical",
		Scaling = scaling,
		Requires = requires or {},
		Upgrade = opts.Upgrade or "Standard",
		Status = opts.Status,
		Weight = opts.Weight or 4,
		Value = opts.Value or math.floor(damage * 12),
		Description = opts.Description or "",
		Color = opts.Color,
	})
end

-- ===================================================================== Weapons
-- Starting / shop weapons
weapon("rusted_longsword", "Rusted Longsword", "Sword", "Common", 30, { Strength = "D", Dexterity = "D" }, { Strength = 8, Dexterity = 8 },
	{ Weight = 4, Value = 220, Description = "A blade worn thin by a hundred forgotten battles." })
weapon("knight_longsword", "Knight's Longsword", "Sword", "Uncommon", 36, { Strength = "C", Dexterity = "D" }, { Strength = 11, Dexterity = 9 },
	{ Weight = 4.5, Value = 900, Description = "Standard issue of the sanctuary's oath-bound knights." })
weapon("warrior_handaxe", "Warrior's Hand Axe", "Axe", "Common", 34, { Strength = "C" }, { Strength = 10 },
	{ Weight = 4, Value = 320, Description = "Heavy-headed and dependable." })
weapon("iron_greatsword", "Iron Greatsword", "Greatsword", "Uncommon", 56, { Strength = "B" }, { Strength = 16 },
	{ Weight = 11, Value = 1600, Description = "Slow, heavy, and decisive." })
weapon("ironbound_maul", "Ironbound Maul", "Hammer", "Uncommon", 52, { Strength = "B" }, { Strength = 15 },
	{ Weight = 10, Value = 1500, Description = "Crushes guards and bones alike." })
weapon("shadow_dagger", "Shadow Dagger", "Dagger", "Common", 22, { Dexterity = "B" }, { Dexterity = 9 },
	{ Weight = 1.5, Value = 260, Status = { Bleed = 18 }, Description = "Favoured by those who strike unseen." })
weapon("serrated_dagger", "Serrated Dagger", "Dagger", "Uncommon", 26, { Dexterity = "B", Arcane = "D" }, { Dexterity = 11 },
	{ Weight = 1.5, Value = 1100, Status = { Bleed = 30 }, Description = "Each cut opens the next." })
weapon("pilgrim_spear", "Pilgrim Spear", "Spear", "Common", 32, { Strength = "D", Dexterity = "C" }, { Strength = 9, Dexterity = 10 },
	{ Weight = 5, Value = 480, Description = "Long reach for a cautious traveller." })
weapon("hunter_shortbow", "Hunter's Shortbow", "Bow", "Common", 24, { Dexterity = "C" }, { Dexterity = 10 },
	{ Weight = 3, Value = 500, Description = "Draws quickly. Arrows are fletched from ash." })
weapon("ashwood_longbow", "Ashwood Longbow", "Bow", "Rare", 38, { Dexterity = "B" }, { Dexterity = 16, Strength = 10 },
	{ Weight = 5, Value = 2600, Description = "Its string hums before every shot." })
weapon("apprentice_staff", "Apprentice Staff", "Staff", "Common", 26, { Intelligence = "B" }, { Intelligence = 10 },
	{ DamageType = "Magic", Weight = 3, Value = 400, Description = "A focus for raw, untamed sorcery." })
weapon("lucent_staff", "Lucent Staff", "Staff", "Uncommon", 32, { Intelligence = "A" }, { Intelligence = 16 },
	{ DamageType = "Magic", Weight = 3, Value = 1800, Description = "Crystal-tipped; bends light into force." })
weapon("rift_staff", "Rift Staff", "Staff", "Rare", 40, { Intelligence = "A", Arcane = "D" }, { Intelligence = 22 },
	{ DamageType = "Magic", Weight = 3.5, Value = 4200, Description = "Tears small wounds in the world." })
weapon("pilgrim_seal", "Pilgrim Seal", "Seal", "Common", 24, { Faith = "B" }, { Faith = 10 },
	{ DamageType = "Holy", Weight = 1.5, Value = 400, Description = "A prayer-worn sigil of the old light." })
weapon("lightbound_mace", "Lightbound Mace", "Hammer", "Uncommon", 38, { Strength = "C", Faith = "C" }, { Strength = 12, Faith = 12 },
	{ DamageType = "Holy", Weight = 6, Value = 1400, Description = "Its head glows faintly in the dark." })
weapon("cinder_axe", "Cinder Axe", "Axe", "Rare", 44, { Strength = "C" }, { Strength = 14 },
	{ DamageType = "Fire", Weight = 6, Value = 3800, Status = { Burn = 25 }, Description = "Embers still smoulder in its edge." })
weapon("moonlit_estoc", "Moonlit Estoc", "Sword", "Rare", 40, { Dexterity = "A", Intelligence = "D" }, { Dexterity = 18 },
	{ Weight = 3.5, Value = 4000, Description = "Thin as a moonbeam and twice as cold." })
weapon("vale_glaive", "Hollow Vale Glaive", "Spear", "Epic", 54, { Strength = "B", Dexterity = "B" }, { Strength = 18, Dexterity = 18 },
	{ Weight = 7, Value = 9000, Description = "Found only in the hidden vale beyond the falls." })

-- Boss weapons (Unique upgrade path, +5 max)
local function bossWeapon(id, name, wtype, rarity, damage, scaling, requires, opts)
	opts = opts or {}
	opts.Upgrade = "Unique"
	opts.Value = opts.Value or 0 -- cannot be bought
	weapon(id, name, wtype, rarity, damage, scaling, requires, opts)
	Items[id].BossWeapon = true
end

bossWeapon("warden_halberd", "Ashen Warden's Halberd", "Spear", "Rare", 46, { Strength = "C", Dexterity = "C" }, { Strength = 12, Dexterity = 12 },
	{ Weight = 7, Description = "The Warden held the gate long after the city fell." })
bossWeapon("butcher_cleaver", "Hollow Butcher's Cleaver", "Greatsword", "Rare", 62, { Strength = "B" }, { Strength = 18 },
	{ Weight = 12, Status = { Bleed = 35 }, Description = "Notched by countless delayed swings." })
bossWeapon("thorn_seal", "Matriarch's Thorn Seal", "Seal", "Rare", 38, { Faith = "B", Arcane = "C" }, { Faith = 14 },
	{ DamageType = "Holy", Weight = 2, Status = { Poison = 25 }, Description = "Roots answer the bearer's prayers." })
bossWeapon("gravebound_blade", "Gravebound Blade", "Sword", "Epic", 50, { Strength = "B", Dexterity = "C" }, { Strength = 16, Dexterity = 12 },
	{ Weight = 5, Description = "Strikes hardest against those who wait." })
bossWeapon("ember_fangs", "Ember Fangs", "Dagger", "Epic", 36, { Dexterity = "A" }, { Dexterity = 18 },
	{ DamageType = "Fire", Weight = 2, Status = { Burn = 30 }, Description = "Torn from the hound's still-burning jaw." })
bossWeapon("executioner_axe", "Executioner's Twin Axe", "Axe", "Epic", 64, { Strength = "A" }, { Strength = 22 },
	{ Weight = 9, Description = "Two sentences, one blade." })
bossWeapon("colossus_maul", "Mire Colossus Maul", "Hammer", "Epic", 76, { Strength = "S" }, { Strength = 28 },
	{ Weight = 16, Description = "Swamp water still drips from the stone head." })
bossWeapon("veiled_staff", "Veiled Arcanist's Staff", "Staff", "Epic", 52, { Intelligence = "S" }, { Intelligence = 26 },
	{ DamageType = "Magic", Weight = 3, Description = "Whispers the location of its next spell." })
bossWeapon("crimson_rapier", "Crimson Rapier", "Sword", "Epic", 50, { Dexterity = "S" }, { Dexterity = 26 },
	{ Weight = 3, Status = { Bleed = 40 }, Description = "The duelist never missed a riposte." })
bossWeapon("siege_breaker", "Siege Breaker", "Greatsword", "Epic", 84, { Strength = "A" }, { Strength = 30 },
	{ Weight = 15, Description = "Built to crack walls, used to crack armour." })
bossWeapon("oracle_seal", "Drowned Oracle's Seal", "Seal", "Legendary", 56, { Faith = "S" }, { Faith = 30 },
	{ DamageType = "Holy", Weight = 2, Description = "Its prophecies arrive a moment late." })
bossWeapon("reaper_scythe", "Blackwing Scythe", "Spear", "Legendary", 66, { Dexterity = "A", Arcane = "B" }, { Dexterity = 28, Arcane = 16 },
	{ Weight = 7, Status = { Bleed = 45 }, Description = "Swung from above, it falls like a shadow." })
bossWeapon("champion_blade", "Forsaken Champion's Blade", "Greatsword", "Legendary", 88, { Strength = "A", Dexterity = "B" }, { Strength = 30, Dexterity = 20 },
	{ Weight = 13, Description = "Three stances, one oath, no kingdom." })
bossWeapon("plague_bow", "Plague Alchemist's Bow", "Bow", "Legendary", 56, { Dexterity = "A", Arcane = "B" }, { Dexterity = 26, Arcane = 18 },
	{ Weight = 4, Status = { Poison = 40 }, Description = "Arrows tipped with the alchemist's last recipe." })
bossWeapon("regent_sword", "Iron Regent's Sword", "Sword", "Legendary", 74, { Strength = "A", Dexterity = "A" }, { Strength = 26, Dexterity = 26 },
	{ Weight = 6, Description = "A ruler's blade, heavier than it looks." })
bossWeapon("leviathan_spear", "Leviathan Tooth Spear", "Spear", "Legendary", 76, { Strength = "B", Dexterity = "A" }, { Strength = 22, Dexterity = 30 },
	{ Weight = 8, Description = "Still hungry." })
bossWeapon("eclipse_staff", "Eclipse Staff", "Staff", "Legendary", 68, { Intelligence = "S", Faith = "C" }, { Intelligence = 34, Faith = 16 },
	{ DamageType = "Magic", Weight = 3, Description = "Casts two shadows; only one is real." })
bossWeapon("general_warblade", "Nameless General's Warblade", "Greatsword", "Mythic", 96, { Strength = "S", Dexterity = "B" }, { Strength = 36, Dexterity = 22 },
	{ Weight = 14, Description = "Every scar on it belongs to a different war." })
bossWeapon("godbreaker", "Godbreaker", "Hammer", "Mythic", 106, { Strength = "S", Faith = "B" }, { Strength = 40, Faith = 22 },
	{ DamageType = "Holy", Weight = 18, Description = "It was forged for exactly one purpose." })
bossWeapon("sovereign_blade", "Blade of the Ruined Sovereign", "Sword", "Mythic", 92,
	{ Strength = "B", Dexterity = "B", Intelligence = "B", Faith = "B" }, { Strength = 20, Dexterity = 20, Intelligence = 20, Faith = 20 },
	{ Weight = 7, Description = "It answers to every discipline, and favours none." })

-- ===================================================================== Shields
local function shield(id, name, rarity, stability, opts)
	opts = opts or {}
	add(id, {
		Kind = "Shield",
		Name = name,
		Rarity = rarity,
		Stability = stability, -- 0..100 ; % of blocked damage absorbed
		ParryBonus = opts.ParryBonus or 0, -- extra seconds on parry window
		Requires = opts.Requires or {},
		Weight = opts.Weight or 4,
		Value = opts.Value or 300,
		Upgrade = opts.Upgrade or "Standard",
		Description = opts.Description or "",
		BossWeapon = opts.BossWeapon,
	})
end

shield("wooden_shield", "Weathered Round Shield", "Common", 55, { Weight = 3, Value = 200, Description = "Splintered but serviceable." })
shield("kite_shield", "Sanctuary Kite Shield", "Uncommon", 78, { Weight = 6, Value = 900, Requires = { Strength = 10 }, Description = "Bears the faded crest of the sanctuary." })
shield("tower_shield", "Bastion Tower Shield", "Rare", 92, { Weight = 14, Value = 3500, Requires = { Strength = 20 }, Description = "A wall you can carry, barely." })
shield("sacred_buckler", "Sacred Buckler", "Uncommon", 60, { Weight = 2.5, Value = 800, ParryBonus = 0.06, Description = "Small, bright and quick to turn a blade." })
shield("gravebound_aegis", "Gravebound Aegis", "Epic", 96, { Weight = 10, Value = 0, Upgrade = "Unique", BossWeapon = true, Requires = { Strength = 16 }, Description = "The knight's shield never fell, even when he did." })

-- ===================================================================== Armor
-- Slot multipliers distribute a set's totals across the four pieces.
local SLOT_SHARE = { Head = 0.2, Chest = 0.4, Hands = 0.15, Feet = 0.25 }
local SLOT_NAMES = { Head = "Helm", Chest = "Armor", Hands = "Gauntlets", Feet = "Greaves" }

local ArmorSets = {
	{ Id = "wanderer", Name = "Wanderer", Rarity = "Common", Defense = 30, Magic = 20, Poise = 8, Weight = 8, Value = 600, Color = Color3.fromRGB(105, 92, 78) },
	{ Id = "brigand", Name = "Brigand", Rarity = "Common", Defense = 42, Magic = 18, Poise = 16, Weight = 14, Value = 900, Color = Color3.fromRGB(92, 70, 55) },
	{ Id = "oathknight", Name = "Oathknight", Rarity = "Uncommon", Defense = 70, Magic = 30, Poise = 34, Weight = 28, Value = 2400, Color = Color3.fromRGB(120, 124, 130) },
	{ Id = "scholar", Name = "Scholar", Rarity = "Common", Defense = 22, Magic = 46, Poise = 4, Weight = 6, Value = 700, Color = Color3.fromRGB(52, 60, 96) },
	{ Id = "arcanist", Name = "Arcanist", Rarity = "Uncommon", Defense = 28, Magic = 62, Poise = 6, Weight = 8, Value = 2000, Color = Color3.fromRGB(70, 44, 98) },
	{ Id = "nightstalker", Name = "Nightstalker", Rarity = "Common", Defense = 34, Magic = 26, Poise = 8, Weight = 9, Value = 800, Color = Color3.fromRGB(38, 38, 44) },
	{ Id = "lightward", Name = "Lightward", Rarity = "Uncommon", Defense = 60, Magic = 44, Poise = 26, Weight = 22, Value = 2200, Color = Color3.fromRGB(196, 184, 140) },
	{ Id = "vale", Name = "Hollow Vale", Rarity = "Epic", Defense = 88, Magic = 70, Poise = 30, Weight = 20, Value = 12000, Color = Color3.fromRGB(70, 96, 88) },
	{ Id = "regent", Name = "Iron Regent", Rarity = "Legendary", Defense = 120, Magic = 80, Poise = 52, Weight = 34, Value = 0, Color = Color3.fromRGB(80, 82, 90), BossArmor = true },
	{ Id = "eclipse", Name = "Eclipse", Rarity = "Legendary", Defense = 70, Magic = 120, Poise = 14, Weight = 12, Value = 0, Color = Color3.fromRGB(30, 20, 46), BossArmor = true },
}

for _, set in ArmorSets do
	for slot, share in SLOT_SHARE do
		add(set.Id .. "_" .. string.lower(slot), {
			Kind = "Armor",
			Slot = slot,
			Set = set.Id,
			Name = set.Name .. " " .. SLOT_NAMES[slot],
			Rarity = set.Rarity,
			Defense = math.floor(set.Defense * share + 0.5),
			MagicDefense = math.floor(set.Magic * share + 0.5),
			Poise = math.floor(set.Poise * share + 0.5),
			Weight = math.floor(set.Weight * share * 10 + 0.5) / 10,
			Value = math.floor(set.Value * share),
			Upgrade = "Armor",
			Color = set.Color,
			BossWeapon = set.BossArmor,
			Description = set.Name .. " set piece.",
		})
	end
end
Items._ArmorSets = ArmorSets

-- ===================================================================== Accessories
local function accessory(id, name, rarity, bonuses, value, desc)
	add(id, {
		Kind = "Accessory",
		Name = name,
		Rarity = rarity,
		Bonuses = bonuses,
		Weight = 0.5,
		Value = value,
		Description = desc,
	})
end

accessory("hearth_ring", "Ring of the Hearth", "Uncommon", { MaxHealth = 80 }, 1500, "Warmth that lingers after the fire dies.")
accessory("endurance_band", "Band of Endurance", "Uncommon", { StaminaRegen = 0.15 }, 1500, "Breathe, and go again.")
accessory("ogre_signet", "Ogre Signet", "Rare", { PhysicalDamage = 0.06 }, 3000, "Too large for most fingers.")
accessory("bloodstone_ring", "Bloodstone Ring", "Rare", { StatusBuildup = 0.3 }, 3000, "Pulses when blood is spilled nearby.")
accessory("pilgrim_amulet", "Pilgrim Amulet", "Uncommon", { HolyDamage = 0.1, HealingPower = 0.1 }, 1800, "Carried by those who walked to the tower and back.")
accessory("lucent_pendant", "Lucent Pendant", "Uncommon", { MaxMana = 40 }, 1600, "A drop of trapped starlight.")
accessory("iron_ring", "Iron Ring", "Common", { Poise = 12 }, 700, "Plain, heavy, steadying.")
accessory("shadow_ring", "Shadow Ring", "Rare", { CritDamage = 0.2 }, 3200, "Rewards those who strike from behind.")
accessory("sorcery_band", "Sorcerer's Band", "Rare", { MagicDamage = 0.1 }, 3000, "Etched with sigils that refuse to stay still.")
accessory("ember_heart", "Ember Heart", "Epic", { MaxHealth = 120, FireDamage = 0.1 }, 0, "Taken from the Ember Hound. It still beats.")
accessory("oracle_tear", "Oracle's Tear", "Legendary", { MaxMana = 60, HealingPower = 0.2 }, 0, "Salt water that never dries.")
accessory("regent_crown", "Regent's Iron Circlet", "Legendary", { Poise = 25, PhysicalDamage = 0.05 }, 0, "Heavy is the head.")
accessory("sovereign_sigil", "Sigil of the Sovereign", "Mythic", { MaxHealth = 150, PhysicalDamage = 0.05, MagicDamage = 0.05, HolyDamage = 0.05 }, 0, "Proof you climbed the whole way.")

-- ===================================================================== Consumables
local function consumable(id, name, rarity, effect, value, desc)
	add(id, {
		Kind = "Consumable",
		Name = name,
		Rarity = rarity,
		Effect = effect,
		Stackable = true,
		Value = value,
		Description = desc,
	})
end

consumable("healing_draught", "Healing Draught", "Common", { Type = "Heal", Fraction = 0.3, Cooldown = 6 }, 120, "Restores 30% of maximum health.")
consumable("mana_tonic", "Mana Tonic", "Common", { Type = "Mana", Fraction = 0.45, Cooldown = 6 }, 110, "Restores 45% of maximum mana.")
consumable("stamina_tonic", "Stamina Tonic", "Uncommon", { Type = "Buff", Buff = "StaminaRegen", Amount = 0.4, Duration = 30, Cooldown = 45 }, 260, "Stamina regenerates 40% faster for 30 seconds.")
consumable("antidote", "Antidote", "Common", { Type = "Cure", Status = "Poison", Cooldown = 3 }, 80, "Cures poison and clears poison build-up.")
consumable("fire_resin", "Cinder Resin", "Uncommon", { Type = "Buff", Buff = "FireCoat", Amount = 0.15, Duration = 45, Cooldown = 60 }, 300, "Coats your weapon in fire: +15% damage as fire for 45 seconds.")
consumable("iron_resin", "Iron Resin", "Uncommon", { Type = "Buff", Buff = "Defense", Amount = 0.15, Duration = 40, Cooldown = 60 }, 300, "Reduces damage taken by 15% for 40 seconds.")
consumable("flask_shard", "Flask Shard", "Rare", { Type = "FlaskUpgrade" }, 0, "Use to permanently add one charge to your Ember Flask.")

-- ===================================================================== Materials
local function material(id, name, rarity, value, desc)
	add(id, {
		Kind = "Material",
		Name = name,
		Rarity = rarity,
		Stackable = true,
		Value = value,
		Description = desc,
	})
end

material("ember_shard", "Ember Shard", "Common", 80, "Upgrades standard equipment to +1 through +3.")
material("tempered_shard", "Tempered Shard", "Uncommon", 260, "Upgrades standard equipment to +4 through +6.")
material("ancient_shard", "Ancient Shard", "Rare", 700, "Upgrades standard equipment to +7 through +9.")
material("fallen_core", "Fallen Core", "Epic", 2500, "Upgrades standard equipment to +10.")
material("fallen_remnant", "Fallen Remnant", "Epic", 0, "Residue of a fallen tower guardian. Upgrades unique equipment.")
material("armor_plate", "Armour Plate", "Uncommon", 150, "Reinforces armour.")
material("wild_hide", "Wild Hide", "Common", 25, "Tough hide from the Wildlands. Merchants pay for it.")
material("grave_dust", "Grave Dust", "Uncommon", 60, "Collected from the haunted cemetery.")
material("iron_ore", "Iron Ore", "Common", 35, "Mined from the abandoned fortress.")
material("vale_bloom", "Vale Bloom", "Rare", 220, "Grows only in the hidden vale.")

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">LootTables</string>
            <string name="Source"><![CDATA[--[[
	LootTables
	Each table has:
	  Rolls   : number of weighted rolls from `Entries`
	  Chance  : probability that each roll produces anything (default 1)
	  Entries : { Item, Weight, Min, Max }
	  Guaranteed : items always granted { [itemId] = amount }
	Currency for enemies is defined on the enemy itself.
]]

local LootTables = {
	thrall = { Rolls = 1, Chance = 0.35, Entries = {
		{ Item = "wild_hide", Weight = 40, Min = 1, Max = 2 },
		{ Item = "ember_shard", Weight = 25, Min = 1, Max = 1 },
		{ Item = "healing_draught", Weight = 15, Min = 1, Max = 1 },
		{ Item = "rusted_longsword", Weight = 3, Min = 1, Max = 1 },
		{ Item = "wanderer_head", Weight = 3, Min = 1, Max = 1 },
	} },
	beast = { Rolls = 1, Chance = 0.45, Entries = {
		{ Item = "wild_hide", Weight = 60, Min = 1, Max = 3 },
		{ Item = "ember_shard", Weight = 15, Min = 1, Max = 1 },
	} },
	swamp = { Rolls = 1, Chance = 0.4, Entries = {
		{ Item = "antidote", Weight = 30, Min = 1, Max = 1 },
		{ Item = "ember_shard", Weight = 30, Min = 1, Max = 1 },
		{ Item = "wild_hide", Weight = 20, Min = 1, Max = 1 },
	} },
	bandit = { Rolls = 1, Chance = 0.5, Entries = {
		{ Item = "ember_shard", Weight = 30, Min = 1, Max = 2 },
		{ Item = "tempered_shard", Weight = 8, Min = 1, Max = 1 },
		{ Item = "healing_draught", Weight = 20, Min = 1, Max = 2 },
		{ Item = "serrated_dagger", Weight = 2, Min = 1, Max = 1 },
		{ Item = "brigand_chest", Weight = 3, Min = 1, Max = 1 },
		{ Item = "iron_ore", Weight = 15, Min = 1, Max = 2 },
	} },
	cultist = { Rolls = 1, Chance = 0.5, Entries = {
		{ Item = "ember_shard", Weight = 30, Min = 1, Max = 2 },
		{ Item = "fire_resin", Weight = 15, Min = 1, Max = 1 },
		{ Item = "mana_tonic", Weight = 20, Min = 1, Max = 1 },
		{ Item = "cinder_axe", Weight = 1, Min = 1, Max = 1 },
	} },
	grave = { Rolls = 1, Chance = 0.5, Entries = {
		{ Item = "grave_dust", Weight = 40, Min = 1, Max = 2 },
		{ Item = "tempered_shard", Weight = 12, Min = 1, Max = 1 },
		{ Item = "mana_tonic", Weight = 15, Min = 1, Max = 1 },
		{ Item = "scholar_chest", Weight = 2, Min = 1, Max = 1 },
	} },
	cave = { Rolls = 1, Chance = 0.55, Entries = {
		{ Item = "tempered_shard", Weight = 20, Min = 1, Max = 1 },
		{ Item = "iron_ore", Weight = 30, Min = 1, Max = 3 },
		{ Item = "armor_plate", Weight = 15, Min = 1, Max = 1 },
		{ Item = "moonlit_estoc", Weight = 1, Min = 1, Max = 1 },
	} },
	forest_high = { Rolls = 1, Chance = 0.55, Entries = {
		{ Item = "tempered_shard", Weight = 25, Min = 1, Max = 2 },
		{ Item = "ancient_shard", Weight = 5, Min = 1, Max = 1 },
		{ Item = "stamina_tonic", Weight = 15, Min = 1, Max = 1 },
	} },
	elite = { Rolls = 2, Chance = 0.8, Entries = {
		{ Item = "tempered_shard", Weight = 30, Min = 1, Max = 2 },
		{ Item = "ancient_shard", Weight = 10, Min = 1, Max = 1 },
		{ Item = "armor_plate", Weight = 25, Min = 1, Max = 2 },
		{ Item = "oathknight_chest", Weight = 3, Min = 1, Max = 1 },
		{ Item = "iron_ring", Weight = 4, Min = 1, Max = 1 },
		{ Item = "ogre_signet", Weight = 1, Min = 1, Max = 1 },
	} },
	vale = { Rolls = 2, Chance = 0.85, Entries = {
		{ Item = "ancient_shard", Weight = 25, Min = 1, Max = 2 },
		{ Item = "vale_bloom", Weight = 30, Min = 1, Max = 2 },
		{ Item = "fallen_core", Weight = 2, Min = 1, Max = 1 },
		{ Item = "vale_head", Weight = 2, Min = 1, Max = 1 },
		{ Item = "vale_chest", Weight = 2, Min = 1, Max = 1 },
		{ Item = "vale_hands", Weight = 2, Min = 1, Max = 1 },
		{ Item = "vale_feet", Weight = 2, Min = 1, Max = 1 },
		{ Item = "vale_glaive", Weight = 1, Min = 1, Max = 1 },
	} },
	miniboss_forest = { Rolls = 2, Guaranteed = { tempered_shard = 2 }, Entries = {
		{ Item = "hearth_ring", Weight = 20, Min = 1, Max = 1 },
		{ Item = "ember_shard", Weight = 40, Min = 2, Max = 4 },
		{ Item = "stamina_tonic", Weight = 20, Min = 1, Max = 2 },
	} },
	miniboss_cave = { Rolls = 2, Guaranteed = { tempered_shard = 3, armor_plate = 2 }, Entries = {
		{ Item = "endurance_band", Weight = 20, Min = 1, Max = 1 },
		{ Item = "ancient_shard", Weight = 15, Min = 1, Max = 1 },
		{ Item = "iron_ore", Weight = 40, Min = 2, Max = 5 },
	} },
	miniboss_fortress = { Rolls = 2, Guaranteed = { ancient_shard = 1, flask_shard = 1 }, Entries = {
		{ Item = "tower_shield", Weight = 15, Min = 1, Max = 1 },
		{ Item = "ogre_signet", Weight = 15, Min = 1, Max = 1 },
		{ Item = "ancient_shard", Weight = 30, Min = 1, Max = 2 },
	} },
	chest_low = { Rolls = 2, Guaranteed = { ember_shard = 2 }, Entries = {
		{ Item = "healing_draught", Weight = 30, Min = 1, Max = 2 },
		{ Item = "pilgrim_spear", Weight = 10, Min = 1, Max = 1 },
		{ Item = "hunter_shortbow", Weight = 10, Min = 1, Max = 1 },
		{ Item = "wanderer_chest", Weight = 10, Min = 1, Max = 1 },
	} },
	chest_mid = { Rolls = 2, Guaranteed = { tempered_shard = 1 }, Entries = {
		{ Item = "lucent_pendant", Weight = 10, Min = 1, Max = 1 },
		{ Item = "iron_ring", Weight = 15, Min = 1, Max = 1 },
		{ Item = "stamina_tonic", Weight = 25, Min = 1, Max = 2 },
		{ Item = "armor_plate", Weight = 25, Min = 1, Max = 2 },
	} },
	chest_high = { Rolls = 2, Guaranteed = { ancient_shard = 1 }, Entries = {
		{ Item = "ashwood_longbow", Weight = 10, Min = 1, Max = 1 },
		{ Item = "rift_staff", Weight = 10, Min = 1, Max = 1 },
		{ Item = "pilgrim_amulet", Weight = 10, Min = 1, Max = 1 },
		{ Item = "armor_plate", Weight = 30, Min = 2, Max = 3 },
	} },
	chest_secret = { Rolls = 1, Guaranteed = { flask_shard = 1, tempered_shard = 1 }, Entries = {
		{ Item = "hearth_ring", Weight = 10, Min = 1, Max = 1 },
		{ Item = "endurance_band", Weight = 10, Min = 1, Max = 1 },
		{ Item = "ember_shard", Weight = 20, Min = 3, Max = 4 },
	} },
	chest_secret_high = { Rolls = 1, Guaranteed = { flask_shard = 1, ancient_shard = 1 }, Entries = {
		{ Item = "shadow_ring", Weight = 10, Min = 1, Max = 1 },
		{ Item = "sorcery_band", Weight = 10, Min = 1, Max = 1 },
		{ Item = "bloodstone_ring", Weight = 10, Min = 1, Max = 1 },
	} },
	chest_vale = { Rolls = 2, Guaranteed = { fallen_core = 1 }, Entries = {
		{ Item = "vale_glaive", Weight = 10, Min = 1, Max = 1 },
		{ Item = "vale_bloom", Weight = 40, Min = 2, Max = 4 },
		{ Item = "ancient_shard", Weight = 30, Min = 1, Max = 2 },
	} },
	boss_replay = { Rolls = 2, Entries = {
		{ Item = "ember_shard", Weight = 30, Min = 2, Max = 4 },
		{ Item = "tempered_shard", Weight = 25, Min = 1, Max = 2 },
		{ Item = "ancient_shard", Weight = 12, Min = 1, Max = 1 },
		{ Item = "armor_plate", Weight = 20, Min = 1, Max = 3 },
		{ Item = "fallen_remnant", Weight = 6, Min = 1, Max = 1 },
	} },
	training_dummy = { Rolls = 1, Chance = 0, Entries = { { Item = "ember_shard", Weight = 1, Min = 1, Max = 1 } } },
}

return LootTables
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--[[
	Products
	Roblox monetisation configuration. ALL purchases are cosmetic or non-combat convenience.

	IMPORTANT: Product and pass IDs are 0 until real assets are created in the Creator Dashboard.
	Entries with Id = 0 are hidden from the store UI and ignored by receipt processing,
	so nothing can be bought until a developer configures real IDs.

	DevProducts grant `Grant` on a successful, server-validated ProcessReceipt:
	  { Cosmetic = id } or { Cosmetics = { ids } }
	GamePasses are checked with UserOwnsGamePassAsync (and PromptGamePassPurchaseFinished).
]]

local Products = {
	DevProducts = {
		aura_starlight = { Id = 0, Name = "Starlight Aura", PriceRobux = 99, Grant = { Cosmetic = "aura_starlight" } },
		aura_wisp = { Id = 0, Name = "Wisp Aura", PriceRobux = 99, Grant = { Cosmetic = "aura_wisp" } },
		skin_gilded = { Id = 0, Name = "Gilded Weapon Finish", PriceRobux = 79, Grant = { Cosmetic = "skin_gilded" } },
		skin_bone = { Id = 0, Name = "Bone Weapon Finish", PriceRobux = 79, Grant = { Cosmetic = "skin_bone" } },
		dye_pack = { Id = 0, Name = "Dye Pack (Crimson + Ivory)", PriceRobux = 59, Grant = { Cosmetics = { "dye_crimson", "dye_ivory" } } },
	},
	GamePasses = {
		wardrobe_plus = { Id = 0, Name = "Wardrobe Plus", PriceRobux = 149,
			Description = "Three extra build preset slots (5 total). Presets only store equipment you already own." },
	},
}

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--[[
	Quests
	Objective types:
	  Kill      { Enemy, Count }   enemy defeats credited to the player (contribution rules apply)
	  Boss      { Floor }          tower floor cleared (first clear or earlier)
	  Discover  { Location | Count } location id, or any N locations
	  Secret    { Count }          number of Secret locations discovered
	  Upgrade   { Level }          any equipment upgraded to Level
	  Collect   { Item, Count }    items handed in (consumed on turn-in)
	  Training  { Count }          training challenges completed
	Rewards: { Xp, Currency, Items = { [id] = n }, Title }
	Requires: quest ids that must be completed first.
]]

local Quests = {
	main_tower_1 = { Name = "The First Gate", Giver = "elder", Description = "Defeat the Ashen Warden on the tower's first floor.",
		Objective = { Type = "Boss", Floor = 1 }, Rewards = { Xp = 400, Currency = 500, Items = { healing_draught = 3 } } },
	main_tower_5 = { Name = "Fire on the Fifth", Giver = "elder", Requires = { "main_tower_1" }, Description = "Reach and defeat the Ember Hound.",
		Objective = { Type = "Boss", Floor = 5 }, Rewards = { Xp = 3000, Currency = 2500, Items = { tempered_shard = 2 } } },
	main_tower_10 = { Name = "The Broken Engine", Giver = "elder", Requires = { "main_tower_5" }, Description = "Destroy the Siege Golem.",
		Objective = { Type = "Boss", Floor = 10 }, Rewards = { Xp = 12000, Currency = 8000, Items = { ancient_shard = 2 } } },
	main_tower_15 = { Name = "Regicide", Giver = "elder", Requires = { "main_tower_10" }, Description = "Overthrow the Iron Regent.",
		Objective = { Type = "Boss", Floor = 15 }, Rewards = { Xp = 30000, Currency = 20000, Items = { fallen_core = 1 } } },
	main_tower_20 = { Name = "The Summit", Giver = "elder", Requires = { "main_tower_15" }, Description = "End the Sovereign of Ruin.",
		Objective = { Type = "Boss", Floor = 20 }, Rewards = { Xp = 80000, Currency = 50000, Title = "Fallen No More" } },

	hunt_thralls = { Name = "Thinning the Hollow", Giver = "huntmaster", Description = "Defeat 8 Hollow Thralls in the Wildlands.",
		Objective = { Type = "Kill", Enemy = "hollow_thrall", Count = 8 }, Rewards = { Xp = 250, Currency = 300, Items = { ember_shard = 2 } } },
	hunt_wolves = { Name = "Rotwood Cull", Giver = "huntmaster", Requires = { "hunt_thralls" }, Description = "Defeat 6 Rotwood Wolves in Mistveil Forest.",
		Objective = { Type = "Kill", Enemy = "rotwood_wolf", Count = 6 }, Rewards = { Xp = 400, Currency = 400, Items = { healing_draught = 2 } } },
	hunt_shepherd = { Name = "The Rot Shepherd", Giver = "huntmaster", Requires = { "hunt_wolves" }, Description = "Find and defeat the Rot Shepherd deep in the forest.",
		Objective = { Type = "Kill", Enemy = "rot_shepherd", Count = 1 }, Rewards = { Xp = 1500, Currency = 1200, Items = { flask_shard = 1 } } },
	hunt_bandits = { Name = "Bandits of Ashford", Giver = "huntmaster", Requires = { "hunt_thralls" }, Description = "Defeat 10 Ruin Bandits.",
		Objective = { Type = "Kill", Enemy = "ruin_bandit", Count = 10 }, Rewards = { Xp = 1400, Currency = 1100, Items = { tempered_shard = 1 } } },
	hunt_varrow = { Name = "The Broken Gate", Giver = "huntmaster", Requires = { "hunt_bandits" }, Description = "Defeat Captain Varrow in the abandoned fortress.",
		Objective = { Type = "Kill", Enemy = "captain_varrow", Count = 1 }, Rewards = { Xp = 5000, Currency = 4000, Items = { ancient_shard = 2 } } },

	explore_regions = { Name = "Charting the Wilds", Giver = "archivist", Description = "Discover 6 locations.",
		Objective = { Type = "Discover", Count = 6 }, Rewards = { Xp = 600, Currency = 500 } },
	explore_secrets = { Name = "What the Maps Forgot", Giver = "archivist", Requires = { "explore_regions" }, Description = "Discover 3 secret locations.",
		Objective = { Type = "Secret", Count = 3 }, Rewards = { Xp = 2000, Currency = 1500, Items = { flask_shard = 1 } } },
	explore_vale = { Name = "Beyond the Falls", Giver = "archivist", Requires = { "explore_secrets" }, Description = "Find the Hollow Vale.",
		Objective = { Type = "Discover", Location = "loc_vale" }, Rewards = { Xp = 6000, Currency = 4000, Title = "Valewalker" } },

	smith_upgrade3 = { Name = "Tempered Steel", Giver = "smith_quest", Description = "Upgrade any weapon or shield to +3.",
		Objective = { Type = "Upgrade", Level = 3 }, Rewards = { Xp = 500, Currency = 400, Items = { tempered_shard = 1 } } },
	smith_ore = { Name = "Ore for the Forge", Giver = "smith_quest", Requires = { "smith_upgrade3" }, Description = "Bring 6 Iron Ore to the forge.",
		Objective = { Type = "Collect", Item = "iron_ore", Count = 6 }, Rewards = { Xp = 900, Currency = 300, Items = { armor_plate = 3 } } },

	train_basics = { Name = "Forms and Footwork", Giver = "trainer", Description = "Complete 3 training challenges.",
		Objective = { Type = "Training", Count = 3 }, Rewards = { Xp = 300, Currency = 250, Items = { stamina_tonic = 1 } } },
}

for id, q in Quests do
	q.Id = id
	q.Requires = q.Requires or {}
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--[[
	Rarities
	Six rarity tiers. `Power` modestly scales base damage/defence; rarity is mostly about
	special properties and upgrade paths rather than raw numbers, so earnable gear stays relevant.
]]

local Rarities = {
	Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" },
	Common = { Rank = 1, Color = Color3.fromRGB(190, 190, 185), Power = 1.0, SellMultiplier = 1.0 },
	Uncommon = { Rank = 2, Color = Color3.fromRGB(110, 200, 120), Power = 1.04, SellMultiplier = 1.2 },
	Rare = { Rank = 3, Color = Color3.fromRGB(90, 150, 235), Power = 1.08, SellMultiplier = 1.5 },
	Epic = { Rank = 4, Color = Color3.fromRGB(170, 100, 225), Power = 1.12, SellMultiplier = 2.0 },
	Legendary = { Rank = 5, Color = Color3.fromRGB(235, 170, 60), Power = 1.16, SellMultiplier = 2.6 },
	Mythic = { Rank = 6, Color = Color3.fromRGB(225, 60, 70), Power = 1.2, SellMultiplier = 3.2 },
}

return Rarities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Shops</string>
            <string name="Source"><![CDATA[--[[
	Shops
	Server-authoritative stock lists. `Price` is always read from here on the server; clients
	only send (shopId, itemId, quantity). `Limit` caps lifetime purchases per character.
	`RequiresFloor` hides stock until that tower floor has been cleared.
]]

local Shops = {
	weapons = {
		Name = "Hedra's Arms",
		Stock = {
			{ Item = "rusted_longsword", Price = 220 },
			{ Item = "warrior_handaxe", Price = 320 },
			{ Item = "shadow_dagger", Price = 260 },
			{ Item = "pilgrim_spear", Price = 480 },
			{ Item = "hunter_shortbow", Price = 500 },
			{ Item = "apprentice_staff", Price = 400 },
			{ Item = "pilgrim_seal", Price = 400 },
			{ Item = "wooden_shield", Price = 200 },
			{ Item = "knight_longsword", Price = 900 },
			{ Item = "lightbound_mace", Price = 1400 },
			{ Item = "kite_shield", Price = 900 },
			{ Item = "sacred_buckler", Price = 800 },
			{ Item = "iron_greatsword", Price = 1600, RequiresFloor = 1 },
			{ Item = "ironbound_maul", Price = 1500, RequiresFloor = 1 },
			{ Item = "serrated_dagger", Price = 1100, RequiresFloor = 2 },
			{ Item = "lucent_staff", Price = 1800, RequiresFloor = 2 },
			{ Item = "ashwood_longbow", Price = 2600, RequiresFloor = 4 },
			{ Item = "tower_shield", Price = 3500, RequiresFloor = 5 },
			{ Item = "moonlit_estoc", Price = 4000, RequiresFloor = 6 },
			{ Item = "rift_staff", Price = 4200, RequiresFloor = 7 },
		},
	},
	armor = {
		Name = "Oswin's Outfitting",
		Stock = {
			{ Item = "wanderer_head", Price = 120 }, { Item = "wanderer_chest", Price = 240 },
			{ Item = "wanderer_hands", Price = 90 }, { Item = "wanderer_feet", Price = 150 },
			{ Item = "scholar_head", Price = 140 }, { Item = "scholar_chest", Price = 280 },
			{ Item = "scholar_hands", Price = 105 }, { Item = "scholar_feet", Price = 175 },
			{ Item = "brigand_head", Price = 180 }, { Item = "brigand_chest", Price = 360 },
			{ Item = "brigand_hands", Price = 135 }, { Item = "brigand_feet", Price = 225 },
			{ Item = "nightstalker_head", Price = 160 }, { Item = "nightstalker_chest", Price = 320 },
			{ Item = "nightstalker_hands", Price = 120 }, { Item = "nightstalker_feet", Price = 200 },
			{ Item = "oathknight_head", Price = 480, RequiresFloor = 1 }, { Item = "oathknight_chest", Price = 960, RequiresFloor = 1 },
			{ Item = "oathknight_hands", Price = 360, RequiresFloor = 1 }, { Item = "oathknight_feet", Price = 600, RequiresFloor = 1 },
			{ Item = "arcanist_head", Price = 400, RequiresFloor = 1 }, { Item = "arcanist_chest", Price = 800, RequiresFloor = 1 },
			{ Item = "arcanist_hands", Price = 300, RequiresFloor = 1 }, { Item = "arcanist_feet", Price = 500, RequiresFloor = 1 },
