      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Formulas</string>
            <string name="Source"><![CDATA[--[[
	Formulas
	Pure, documented gameplay maths shared by server (authoritative) and client (previews).
	No Roblox services are used here so the module runs in the offline test harness.

	Key formulas:
	  softCap(v, curve)       = curve.Base + Σ segment gains (diminishing returns per segment)
	  xpToNext(L)             = floor(XpBase * L^XpExponent + XpLinear * L)
	  maxHealth               = softCap(Vigor, Health) (+ bonuses)
	  weapon attack rating    = D*R*(1 + u*Up) + Σ D*R*G(grade)*S(attr)*(1 + u*UpScale)
	                            (×0.6 and no scaling when requirements are unmet)
	  absorption              = min(Max, def / (def + K))
	  bossHealth(f)           = 1100 * 1.14^(f-1)
	  bossDamage(f)           = 120 * (1 + 0.16 * (f-1))
	  bossTiming(f)           = windup ×max(0.7, 1.08 - 0.02(f-1)), recovery ×max(0.6, 1.1 - 0.03(f-1))
	  partyHealthMult(n)      = 1 + BossHealthPerExtraPlayer * (n-1)
]]

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Rarities = require(Config.Rarities)
local Upgrades = require(Config.Upgrades)

local Formulas = {}

function Formulas.softCap(value: number, curve): number
	local total = curve.Base or 0
	local prev = 0
	for _, seg in curve.Segments do
		local cap, gain = seg[1], seg[2]
		if value <= prev then
			break
		end
		local span = math.min(value, cap) - prev
		if span > 0 then
			total += span * gain
		end
		prev = cap
	end
	return total
end

function Formulas.clamp(v: number, lo: number, hi: number): number
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

-- ================================================================ Levels
function Formulas.xpToNext(level: number): number
	local c = GameConfig.Level
	if level >= c.Max then
		return math.huge
	end
	return math.floor(c.XpBase * level ^ c.XpExponent + c.XpLinear * level)
end

function Formulas.totalXpForLevel(level: number): number
	local total = 0
	for l = 1, level - 1 do
		total += Formulas.xpToNext(l)
	end
	return total
end

-- ================================================================ Resources
function Formulas.maxHealth(attrs, bonus: number?): number
	return math.floor(Formulas.softCap(attrs.Vigor or 1, GameConfig.Curves.Health) + (bonus or 0))
end

function Formulas.maxStamina(attrs): number
	return math.floor(Formulas.softCap(attrs.Endurance or 1, GameConfig.Curves.Stamina))
end

function Formulas.maxMana(attrs, bonus: number?): number
	local int, fai = attrs.Intelligence or 1, attrs.Faith or 1
	local curve = GameConfig.Curves.Mana
	local hi = Formulas.softCap(math.max(int, fai), curve)
	local lo = Formulas.softCap(math.min(int, fai), curve) - curve.Base
	return math.floor(hi + 0.3 * lo + (bonus or 0))
end

function Formulas.maxEquipLoad(attrs): number
	return Formulas.softCap(attrs.Endurance or 1, GameConfig.Curves.EquipLoad)
end

function Formulas.loadTier(load: number, maxLoad: number)
	local ratio = if maxLoad > 0 then load / maxLoad else math.huge
	for _, tier in GameConfig.EquipLoad.Tiers do
		if ratio <= tier.MaxRatio then
			return tier, ratio
		end
	end
	local tiers = GameConfig.EquipLoad.Tiers
	return tiers[#tiers], ratio
end

-- ================================================================ Damage
function Formulas.scalingBonus(attrValue: number): number
	return Formulas.softCap(attrValue or 0, GameConfig.Curves.ScalingBonus)
end

function Formulas.statusBonus(arcane: number): number
	return Formulas.softCap(arcane or 0, GameConfig.Curves.StatusBonus)
end

function Formulas.requirementsMet(def, attrs): boolean
	for attr, req in def.Requires or {} do
		if (attrs[attr] or 0) < req then
			return false
		end
	end
	return true
end

-- Returns { Total, Base, Scaling, RequirementsMet }
function Formulas.weaponAttackRating(def, upgradeLevel: number?, attrs)
	if not def or def.Kind ~= "Weapon" then
		-- Unarmed
		local str = attrs and attrs.Strength or 10
		local total = 14 + 14 * Formulas.scalingBonus(str)
		return { Total = total, Base = 14, Scaling = total - 14, RequirementsMet = true }
	end
	local path = Upgrades[def.Upgrade] or Upgrades.Standard
	local up = Formulas.clamp(math.floor(upgradeLevel or 0), 0, path.Max)
	local rarity = Rarities[def.Rarity] or Rarities.Common
	local raw = def.Damage * rarity.Power
	local base = raw * (1 + path.DamagePerLevel * up)
	local scaling = 0
	for attr, grade in def.Scaling or {} do
		local coef = GameConfig.ScalingGrades[grade] or 0
		scaling += raw * coef * Formulas.scalingBonus(attrs[attr] or 0) * (1 + path.ScalingPerLevel * up)
	end
	local met = Formulas.requirementsMet(def, attrs)
	if not met then
		return { Total = base * 0.6, Base = base * 0.6, Scaling = 0, RequirementsMet = false }
	end
	return { Total = base + scaling, Base = base, Scaling = scaling, RequirementsMet = true }
end

function Formulas.shieldStability(def, upgradeLevel: number?): number
	if not def then
		return 0
	end
	local path = Upgrades[def.Upgrade] or Upgrades.Standard
	local up = Formulas.clamp(math.floor(upgradeLevel or 0), 0, path.Max)
	return math.min(100, def.Stability + (path.StabilityPerLevel or 0) * up)
end

function Formulas.armorDefense(def, upgradeLevel: number?)
	local up = Formulas.clamp(math.floor(upgradeLevel or 0), 0, Upgrades.Armor.Max)
	local mult = 1 + Upgrades.Armor.DefensePerLevel * up
	return def.Defense * mult, def.MagicDefense * mult
end

-- Ability base power: grows with character level and the ability's scaling attribute.
function Formulas.abilityPower(def, attrs, level: number): number
	local attr = attrs[def.Scaling or "Strength"] or 10
	return (28 + 1.6 * math.max(1, level)) * (1 + 2.2 * Formulas.scalingBonus(attr)) * (def.Power or 1)
end

function Formulas.healAmount(def, attrs, maxHealth: number, healingBonus: number?): number
	local attr = attrs[def.Scaling or "Faith"] or 10
	return math.floor(maxHealth * (def.Power or 0.2) * (1 + Formulas.scalingBonus(attr)) * (1 + (healingBonus or 0)))
end

function Formulas.absorption(defense: number, k: number): number
	if defense <= 0 then
		return 0
	end
	return math.min(GameConfig.Combat.MaxAbsorption, defense / (defense + k))
end

-- ================================================================ Bosses / scaling
function Formulas.bossHealth(floor: number): number
	return math.floor(1100 * 1.14 ^ (floor - 1))
end

function Formulas.bossDamage(floor: number): number
	return 120 * (1 + 0.16 * (floor - 1))
end

function Formulas.bossTiming(floor: number)
	return {
		Windup = math.max(0.7, 1.08 - 0.02 * (floor - 1)),
		Recovery = math.max(0.6, 1.1 - 0.03 * (floor - 1)),
	}
end

function Formulas.partyHealthMult(participants: number): number
	return 1 + GameConfig.Party.BossHealthPerExtraPlayer * math.max(0, participants - 1)
end

function Formulas.partyPoiseMult(participants: number): number
	return 1 + GameConfig.Party.BossPoisePerExtraPlayer * math.max(0, participants - 1)
end

function Formulas.recommendedLevel(floor: number): number
	return math.floor(5 + 4.5 * (floor - 1))
end

function Formulas.recommendedUpgrade(floor: number): number
	return math.min(10, math.floor(floor / 2))
end

function Formulas.bossXp(floor: number): number
	return math.floor(800 * 1.28 ^ (floor - 1))
end

function Formulas.bossCurrency(floor: number): number
	return math.floor(600 * 1.24 ^ (floor - 1))
end

-- ================================================================ Economy
function Formulas.sellPrice(def): number
	if not def or (def.Value or 0) <= 0 or def.BossWeapon then
		return 0
	end
	local rarity = Rarities[def.Rarity] or Rarities.Common
	return math.max(1, math.floor(def.Value * GameConfig.Shop.SellRatio * rarity.SellMultiplier))
end

function Formulas.upgradePath(def)
	if not def then
		return nil
	end
	if def.Kind == "Armor" then
		return Upgrades.Armor
	elseif def.Kind == "Weapon" or def.Kind == "Shield" then
		return Upgrades[def.Upgrade] or Upgrades.Standard
	end
	return nil
end

-- Cost to go from `currentLevel` to currentLevel + 1, or nil if not upgradable / maxed.
function Formulas.upgradeCost(def, currentLevel: number)
	local path = Formulas.upgradePath(def)
	if not path or currentLevel >= path.Max then
		return nil
	end
	return path.Costs[currentLevel + 1]
end

return Formulas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Geometry</string>
            <string name="Source"><![CDATA[--[[
	Geometry
	Pure 2D (X/Z plane) shape tests used for hit resolution and telegraph validation.
	All functions take plain numbers so they run outside Roblox and allocate nothing.
	`r` is the target's own radius, so large targets are easier to clip.
]]

local Geometry = {}

local rad, cos, sqrt = math.rad, math.cos, math.sqrt

function Geometry.dist2(ax: number, az: number, bx: number, bz: number): number
	local dx, dz = bx - ax, bz - az
	return sqrt(dx * dx + dz * dz)
end

-- Normalise a 2D direction; returns 0,1 for a zero vector.
function Geometry.normalize(x: number, z: number): (number, number)
	local m = sqrt(x * x + z * z)
	if m < 1e-6 then
		return 0, 1
	end
	return x / m, z / m
end

function Geometry.inCircle(cx: number, cz: number, px: number, pz: number, radius: number, r: number?): boolean
	return Geometry.dist2(cx, cz, px, pz) <= radius + (r or 0)
end

function Geometry.inRing(cx: number, cz: number, px: number, pz: number, inner: number, outer: number, r: number?): boolean
	local d = Geometry.dist2(cx, cz, px, pz)
	local rr = r or 0
	return d <= outer + rr and d >= inner - rr
end

-- Cone with apex at origin, facing (fx, fz), half-angle arc/2.
function Geometry.inCone(ox: number, oz: number, fx: number, fz: number, px: number, pz: number, range: number, arcDeg: number, r: number?): boolean
	local rr = r or 0
	local dx, dz = px - ox, pz - oz
	local d = sqrt(dx * dx + dz * dz)
	if d > range + rr then
		return false
	end
	if d <= rr + 0.5 then
		return true -- overlapping the attacker
	end
	local nfx, nfz = Geometry.normalize(fx, fz)
	local dot = (dx * nfx + dz * nfz) / d
	-- widen the arc slightly by the angular size of the target
	local extra = math.atan(rr / math.max(d, 0.001))
	local half = math.min(math.pi, rad(arcDeg) / 2 + extra)
	return dot >= cos(half)
end

-- Rectangle from origin extending `length` along (fx, fz) with full width `width`.
function Geometry.inLine(ox: number, oz: number, fx: number, fz: number, px: number, pz: number, length: number, width: number, r: number?): boolean
	local rr = r or 0
	local nfx, nfz = Geometry.normalize(fx, fz)
	local dx, dz = px - ox, pz - oz
	local along = dx * nfx + dz * nfz
	if along < -rr or along > length + rr then
		return false
	end
	local across = math.abs(dx * -nfz + dz * nfx)
	return across <= width / 2 + rr
end

-- Angle in degrees between facing (fx, fz) and the direction to (px, pz).
function Geometry.angleTo(ox: number, oz: number, fx: number, fz: number, px: number, pz: number): number
	local nfx, nfz = Geometry.normalize(fx, fz)
	local dx, dz = Geometry.normalize(px - ox, pz - oz)
	local dot = math.clamp(nfx * dx + nfz * dz, -1, 1)
	return math.deg(math.acos(dot))
end

-- True when (ax, az) is behind a target at (tx, tz) facing (tfx, tfz) within `angleDeg`.
function Geometry.isBehind(tx: number, tz: number, tfx: number, tfz: number, ax: number, az: number, angleDeg: number): boolean
	return Geometry.angleTo(tx, tz, -tfx, -tfz, ax, az) <= angleDeg
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[--[[
	Stats
	Derives a character's combat statistics from its saved profile:
	attributes (+ capped training bonus), equipped items and upgrade levels.
	Used authoritatively by the server and for previews/tooltips on the client.
]]

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Items = require(Config.Items)
local WeaponTypes = require(Config.WeaponTypes)
local Formulas = require(script.Parent.Formulas)

local Stats = {}

Stats.EquipSlots = { "Weapon", "Offhand", "Head", "Chest", "Hands", "Feet", "Accessory1", "Accessory2" }
Stats.ArmorSlots = { "Head", "Chest", "Hands", "Feet" }

-- Effective attributes = base + training bonus (bonus capped per attribute).
function Stats.effectiveAttributes(profile)
	local out = {}
	local cap = GameConfig.Training.MaxTrainingBonusPerAttribute
	for _, name in GameConfig.Attributes.List do
		local base = (profile.Attributes and profile.Attributes[name]) or GameConfig.Attributes.Min
		local bonus = math.min(cap, (profile.TrainingBonus and profile.TrainingBonus[name]) or 0)
		out[name] = math.min(GameConfig.Attributes.Max + cap, base + bonus)
	end
	return out
end

-- Returns (itemDef, itemInstance) for an equipped slot, or nil.
function Stats.equipped(profile, slot: string)
	local uid = profile.Equipped and profile.Equipped[slot]
	if not uid then
		return nil, nil
	end
	local inst = profile.Inventory and profile.Inventory.Items[uid]
	if not inst then
		return nil, nil
	end
	return Items[inst.Id], inst
end

function Stats.compute(profile)
	local attrs = Stats.effectiveAttributes(profile)
	local bonuses = {
		MaxHealth = 0, MaxMana = 0, Poise = 0, StaminaRegen = 0, PhysicalDamage = 0, MagicDamage = 0,
		FireDamage = 0, HolyDamage = 0, CritDamage = 0, StatusBuildup = 0, HealingPower = 0,
	}
	local defense, magicDefense, poise, load = 0, 0, 0, 0

	for _, slot in Stats.EquipSlots do
		local def, inst = Stats.equipped(profile, slot)
		if def then
			load += def.Weight or 0
			if def.Kind == "Armor" then
				local d, m = Formulas.armorDefense(def, inst.Upgrade)
				defense += d
				magicDefense += m
				poise += def.Poise or 0
			elseif def.Kind == "Accessory" then
				for k, v in def.Bonuses or {} do
					bonuses[k] = (bonuses[k] or 0) + v
				end
			end
		end
	end
	poise += bonuses.Poise

	local weaponDef, weaponInst = Stats.equipped(profile, "Weapon")
	local offDef, offInst = Stats.equipped(profile, "Offhand")
	local ar = Formulas.weaponAttackRating(weaponDef, weaponInst and weaponInst.Upgrade or 0, attrs)
	local wtype = WeaponTypes[weaponDef and weaponDef.WeaponType or "Fist"] or WeaponTypes.Fist

	local maxLoad = Formulas.maxEquipLoad(attrs)
	local tier, ratio = Formulas.loadTier(load, maxLoad)

	local stability
	local parryBonus = 0
	if offDef and offDef.Kind == "Shield" then
		stability = Formulas.shieldStability(offDef, offInst.Upgrade)
		parryBonus = offDef.ParryBonus or 0
	else
		stability = math.floor((wtype.Guard or 0.2) * 100)
	end

	return {
		Attributes = attrs,
		MaxHealth = Formulas.maxHealth(attrs, bonuses.MaxHealth),
		MaxStamina = Formulas.maxStamina(attrs),
		MaxMana = Formulas.maxMana(attrs, bonuses.MaxMana),
		Defense = defense,
		MagicDefense = magicDefense,
		Poise = poise,
		EquipLoad = load,
		MaxEquipLoad = maxLoad,
		LoadRatio = ratio,
		LoadTier = tier.Name,
		DodgeCostMult = tier.DodgeCost,
		SpeedMult = tier.Speed,
		WeaponId = weaponDef and weaponDef.Id or nil,
		WeaponType = weaponDef and weaponDef.WeaponType or "Fist",
		WeaponDamageType = weaponDef and weaponDef.DamageType or "Physical",
		WeaponStatus = weaponDef and weaponDef.Status or nil,
		AttackRating = ar.Total,
		RequirementsMet = ar.RequirementsMet,
		Stability = stability,
		ParryBonus = parryBonus,
		HasShield = offDef ~= nil and offDef.Kind == "Shield",
		Bonuses = bonuses,
		StaminaRegen = GameConfig.Stamina.RegenPerSecond * (1 + bonuses.StaminaRegen),
	}
end

return Stats
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	Declares every remote used by the game. The server creates them under
	ReplicatedStorage.Remotes at boot; clients wait for them.

	Client -> Server
	  Action  (RemoteEvent)    high-frequency combat input: { Kind, ... }
	  Request (RemoteFunction) menu/interaction requests: (name, payload) -> { Ok, Result | Error }

	Server -> Client
	  Profile   (RemoteEvent)  sanitized profile snapshot + derived stats
	  Notify    (RemoteEvent)  toast / banner messages
	  Fx        (RemoteEvent)  combat feedback (damage numbers, hit flashes, parry, stagger)
	  Boss      (RemoteEvent)  boss bar, phase and victory/defeat state
	  OpenUI    (RemoteEvent)  ask the client to open a menu (shop, blacksmith, dialog, tower)
	  Party     (RemoteEvent)  party state + invites
	  Training  (RemoteEvent)  training challenge HUD state
]]

local Net = {}

Net.Events = { "Action", "Profile", "Notify", "Fx", "Boss", "OpenUI", "Party", "Training" }
Net.Functions = { "Request" }

local FOLDER = "Remotes"

function Net.setupServer()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER
		folder.Parent = ReplicatedStorage
	end
	for _, name in Net.Events do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
	for _, name in Net.Functions do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
	end
	return folder
end

function Net.folder()
	return game:GetService("ReplicatedStorage"):WaitForChild(FOLDER)
end

function Net.event(name: string): RemoteEvent
	return Net.folder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return Net.folder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--[[
	Rng
	Deterministic, seedable Park-Miller PRNG. Used for loot and AI choices so that tests can
	reproduce results exactly. On the server it is seeded from os.clock()/os.time().
]]

local Rng = {}
Rng.__index = Rng

local MOD = 2147483647

function Rng.new(seed: number?)
	local self = setmetatable({}, Rng)
	local s = math.floor((seed or (os.time() + os.clock() * 1e6)) % MOD)
	if s <= 0 then
		s += MOD - 1
	end
	self._state = s
	return self
end

-- Uniform in [0, 1)
function Rng:NextNumber(): number
	self._state = (self._state * 16807) % MOD
	return (self._state - 1) / (MOD - 1)
end

-- Uniform integer in [min, max]
function Rng:NextInteger(min: number, max: number): number
	if max <= min then
		return min
	end
	return min + math.floor(self:NextNumber() * (max - min + 1))
end

function Rng:Chance(p: number): boolean
	return self:NextNumber() < p
end

-- Picks an entry from `list` using `weightKey` (default "Weight"). Returns entry, index.
function Rng:Weighted(list, weightKey: string?)
	local key = weightKey or "Weight"
	local total = 0
	for _, e in list do
		total += math.max(0, e[key] or 0)
	end
	if total <= 0 then
		return nil, nil
	end
	local roll = self:NextNumber() * total
	for i, e in list do
		roll -= math.max(0, e[key] or 0)
		if roll < 0 then
			return e, i
		end
	end
	return list[#list], #list
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--[[
	Signal
	Minimal synchronous signal for server-internal events (kills, discoveries, boss clears).
	Handlers run in their own thread so one failing handler cannot break the others.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handler = { Fn = fn, Connected = true }
	table.insert(self._handlers, handler)
	local handlers = self._handlers
	return {
		Disconnect = function()
			handler.Connected = false
			local i = table.find(handlers, handler)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, h in table.clone(self._handlers) do
		if h.Connected then
			task.spawn(h.Fn, ...)
		end
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="31">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="33">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Bootstrap
	Creates remotes, then initialises and starts every service in dependency order.
	Init() wires references and builds static content; Start() connects events and loops.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

Net.setupServer()

local ServicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"DataService",
	"NotifyService",
	"RequestService",
	"TelegraphService",
	"EntityService",
	"WorldBuilder",
	"PlayerStateService",
	"AntiCheatService",
	"ProjectileService",
	"AttackExecutor",
	"CombatService",
	"ProgressionService",
	"InventoryService",
	"ShopService",
	"InteractionService",
	"CheckpointService",
	"DeathService",
	"QuestService",
	"ExplorationService",
	"EnemyService",
	"PartyService",
	"BossService",
	"TrainingService",
	"CosmeticService",
	"PurchaseService",
	"PromoService",
	"LeaderboardService",
}

local services = {}
for _, name in ORDER do
	services[name] = require(ServicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local svc = services[name]
	if svc.Init then
		local ok, err = pcall(svc.Init, services)
		if not ok then
			warn(("[Bootstrap] %s.Init failed: %s"):format(name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local svc = services[name]
	if svc.Start then
		local ok, err = pcall(svc.Start)
		if not ok then
			warn(("[Bootstrap] %s.Start failed: %s"):format(name, tostring(err)))
		end
	end
end

workspace:SetAttribute("ServerReady", true)
print(("[Tower of the Fallen] server ready (%d services)"):format(#ORDER))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PromoCodes</string>
            <string name="Source"><![CDATA[--[[
	PromoCodes (SERVER ONLY - lives in ServerScriptService, never replicated to clients)

	Fields:
	  Code        : the text players type (compared case-insensitively, spaces ignored)
	  Kind        : "Reward" (one-off bundle) | "Admin" (unlocks the admin panel)
	  MaxUses     : total redemptions across ALL servers (atomic DataStore counter); nil = unlimited
	  Reward      : for Kind "Reward": { Currency, Items = { [itemId] = n }, Title, Cosmetic }
	  Expires     : optional os.time() after which the code stops working
	Every code can be redeemed at most once per character.

	SECURITY: anyone who can read this repository can read these codes. Change them before
	making the repository public, and never put them in ReplicatedStorage.
]]

local PromoCodes = {
	admin_1 = { Code = "FKYCZ6BGQ3RF3HHDEGADWWCPZRW9XX", Kind = "Admin", MaxUses = 2 },
	admin_2 = { Code = "ZU2R2S4JQE29XFCR8NMU8HWQC33WEX", Kind = "Admin", MaxUses = 2 },
	-- example public code (edit or remove freely)
	launch = { Code = "TOWERLAUNCH", Kind = "Reward", MaxUses = nil,
		Reward = { Currency = 500, Items = { healing_draught = 3 } } },
}

for id, def in PromoCodes do
	def.Id = id
end

return PromoCodes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">AchievementCore</string>
            <string name="Source"><![CDATA[--[[
	AchievementCore
	Stat counters and achievement evaluation. Rewards are titles and cosmetics only.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared.Config.Achievements)
local Items = require(Shared.Config.Items)
local Rarities = require(Shared.Config.Rarities)
local World = require(Shared.Config.World)
local InventoryCore = require(script.Parent.InventoryCore)

local AchievementCore = {}

function AchievementCore.increment(profile, stat: string, amount: number?)
	profile.Stats[stat] = (profile.Stats[stat] or 0) + (amount or 1)
	return profile.Stats[stat]
end

local function checkCustom(profile, a): boolean
	if a.Check == "Floor" then
		return profile.Tower.HighestCleared >= a.Goal
	elseif a.Check == "AllLocations" then
		for _, loc in World.Locations do
			if not profile.Discovered[loc.Id] then
				return false
			end
		end
		return true
	elseif a.Check == "AllSecrets" then
		for _, loc in World.Locations do
			if loc.Secret and not profile.Discovered[loc.Id] then
				return false
			end
		end
		return true
	elseif a.Check == "HighRarity" then
		local n = 0
		for _, inst in profile.Inventory.Items do
			local def = Items[inst.Id]
			if def and Rarities[def.Rarity].Rank >= Rarities.Legendary.Rank then
				n += 1
			end
		end
		return n >= a.Goal
	elseif a.Check == "UpgradeLevel" then
		return InventoryCore.highestUpgrade(profile) >= a.Goal
	elseif a.Check == "Hybrid" then
		local n = 0
		for _, attr in { "Strength", "Dexterity", "Intelligence", "Faith", "Arcane" } do
			if (profile.Attributes[attr] or 0) >= a.Goal then
				n += 1
			end
		end
		return n >= 2
	end
	return false
end

-- Unlocks every newly satisfied achievement; returns list of { Id, Reward }.
function AchievementCore.evaluate(profile)
	local unlocked = {}
	for id, a in Achievements do
		if not profile.Achievements[id] then
			local done
			if a.Stat then
				done = (profile.Stats[a.Stat] or 0) >= a.Goal
			else
				done = checkCustom(profile, a)
			end
			if done then
				profile.Achievements[id] = true
				if a.Reward then
					if a.Reward.Title then
						profile.Titles[a.Reward.Title] = true
					end
					if a.Reward.Cosmetic then
						profile.Cosmetics.Owned[a.Reward.Cosmetic] = true
					end
				end
				table.insert(unlocked, { Id = id, Reward = a.Reward })
			end
		end
	end
	table.sort(unlocked, function(x, y)
		return x.Id < y.Id
	end)
	return unlocked
end

return AchievementCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">BossBrain</string>
            <string name="Source"><![CDATA[--[[
	BossBrain
	Pure decision logic shared by bosses and regular enemies:
	  * phase selection from health fraction
	  * attack selection by range, cooldown and weight, avoiding 3x repeats
	  * floor-based timing (tighter windups/recoveries on higher floors, never below fairness minimums)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Bosses = require(Shared.Config.Bosses)
local Formulas = require(Shared.Logic.Formulas)

local BossBrain = {}

-- Phases are ordered by descending Threshold. Returns phase index for the HP fraction.
function BossBrain.phaseIndex(def, hpFraction: number): number
	local idx = 1
	for i, phase in def.Phases do
		if hpFraction <= phase.Threshold then
			idx = i
		end
	end
	return idx
end

-- Attack list for a phase, honouring stances (Forsaken Champion).
function BossBrain.phaseAttacks(phase, stanceIndex: number?)
	if phase.Stances then
		local s = phase.Stances[((stanceIndex or 1) - 1) % #phase.Stances + 1]
		return s.Attacks, s.Name
	end
	return phase.Attacks, nil
end

--[[
	ctx = { Distance, Now, Cooldowns = { [name] = readyAt }, History = { lastName, ... }, Rng }
	Returns attack or nil (nil => reposition / chase).
]]
function BossBrain.choose(attacks, ctx)
	local candidates = {}
	local hist = ctx.History or {}
	local last, prev = hist[#hist], hist[#hist - 1]
	for _, a in attacks do
		local ready = (ctx.Cooldowns[a.Name] or 0) <= ctx.Now
		local inRange = ctx.Distance >= (a.MinRange or 0) and ctx.Distance <= (a.MaxRange or 10) + 2
		local repeated = last == a.Name and prev == a.Name
		if ready and inRange and not repeated then
			table.insert(candidates, a)
		end
	end
	if #candidates == 0 then
		return nil
	end
	return (ctx.Rng:Weighted(candidates))
end

function BossBrain.recordChoice(ctx, attack, now: number)
	ctx.History = ctx.History or {}
	table.insert(ctx.History, attack.Name)
	if #ctx.History > 4 then
		table.remove(ctx.History, 1)
	end
	if (attack.Cooldown or 0) > 0 then
		ctx.Cooldowns[attack.Name] = now + attack.Cooldown
	end
end

-- Effective timings for a step on a given floor. `isFollowUp` = not the first step of a combo.
function BossBrain.timing(step, floor: number?, isFollowUp: boolean?)
	local f = Bosses.Fairness
	local scale = if floor then Formulas.bossTiming(floor) else { Windup = 1, Recovery = 1 }
	local minWindup = if isFollowUp then f.MinComboFollowUp else f.MinWindup
	return math.max(minWindup, (step.Windup or 0.9) * scale.Windup), math.max(f.MinRecovery, (step.Recovery or 0.8) * scale.Recovery)
end

-- Unscaled-by-clamp timings, used by the fairness test to detect authored values that rely on the clamp.
function BossBrain.rawTiming(step, floor: number)
	local scale = Formulas.bossTiming(floor)
	return (step.Windup or 0.9) * scale.Windup, (step.Recovery or 0.8) * scale.Recovery
end

-- Flattens an attack into executable steps.
function BossBrain.steps(attack)
	if attack.Shape == "Combo" then
		return attack.Steps
	end
	return { attack }
end

return BossBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">CombatCore</string>
            <string name="Source"><![CDATA[--[[
	CombatCore
	Pure combat state machine for players and NPC targets. All timing uses a `now` argument
	(server clock) so behaviour is deterministic and testable.

	Latency handling ("grace window"): a hostile hit that resolves at time T is applied at
	T + LatencyGrace. A dodge registered in [T - IFrames, T + grace] or a parry registered in
	[T - ParryWindow, T + grace] still counts. This forgives a client whose input left in time
	but arrived slightly late, without granting extra invulnerability on the server.

	Anti stun-lock: after a stagger the player is immune to further staggers for
	StaggerDuration + StaggerImmunity seconds (damage still applies).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local WeaponTypes = require(Shared.Config.WeaponTypes)
local Formulas = require(Shared.Logic.Formulas)

local C = GameConfig.Combat
local NEG = -1e9

local CombatCore = {}

-- ===================================================================== Player state
function CombatCore.newPlayerState(stats, now: number)
	return {
		Health = stats.MaxHealth,
		MaxHealth = stats.MaxHealth,
		Stamina = stats.MaxStamina,
		MaxStamina = stats.MaxStamina,
		Mana = stats.MaxMana,
		MaxMana = stats.MaxMana,
		LastStaminaSpend = NEG,
		ActionLockUntil = 0,
		DodgeCancelFrom = 0,
		ComboIndex = 0,
		LastAttackEnd = NEG,
		LastDodge = NEG,
		LastParry = NEG,
		ParryWindow = C.ParryWindow,
		Blocking = false,
		StaggeredUntil = 0,
		StaggerImmuneUntil = 0,
		InvulnerableUntil = now + GameConfig.Death.RespawnInvulnerability,
		LastDamagedAt = NEG,
		Dead = false,
		Buffs = {},
		Cooldowns = {},
		CritUntil = 0,
		AttackSeq = 0, -- incremented when a stagger/death cancels pending swings
		Status = CombatCore.newStatus(),
	}
end

-- Re-apply max values after equipment/attribute changes, keeping current ratios.
function CombatCore.refreshMax(state, stats)
	local hpRatio = if state.MaxHealth > 0 then state.Health / state.MaxHealth else 1
	state.MaxHealth = stats.MaxHealth
	state.Health = math.clamp(math.floor(stats.MaxHealth * hpRatio + 0.5), if state.Dead then 0 else 1, stats.MaxHealth)
	state.MaxStamina = stats.MaxStamina
	state.Stamina = math.min(state.Stamina, stats.MaxStamina)
	state.MaxMana = stats.MaxMana
	state.Mana = math.min(state.Mana, stats.MaxMana)
end

function CombatCore.buffAmount(state, name: string, now: number): number
	local b = state.Buffs[name]
	if b and now < b.Expires then
		return b.Amount
	end
	return 0
end

function CombatCore.addBuff(state, name: string, amount: number, duration: number, now: number)
	state.Buffs[name] = { Amount = amount, Expires = now + duration }
end

function CombatCore.regen(state, dt: number, now: number, stats)
	if state.Dead then
		return
	end
	if now - state.LastStaminaSpend >= GameConfig.Stamina.RegenDelay and state.Stamina < state.MaxStamina then
		local rate = (stats.StaminaRegen or GameConfig.Stamina.RegenPerSecond) * (1 + CombatCore.buffAmount(state, "StaminaRegen", now))
		if state.Blocking then
			rate *= GameConfig.Stamina.BlockingRegenMultiplier
		end
		state.Stamina = math.min(state.MaxStamina, state.Stamina + rate * dt)
	end
	if state.Mana < state.MaxMana then
		state.Mana = math.min(state.MaxMana, state.Mana + GameConfig.Mana.RegenPerSecond * dt)
	end
end

function CombatCore.canAct(state, now: number, tolerance: number?): boolean
	local tol = tolerance or 0
	return not state.Dead and now + tol >= state.ActionLockUntil and now >= state.StaggeredUntil
end

function CombatCore.spendStamina(state, cost: number, now: number): boolean
	if state.Stamina <= GameConfig.Stamina.ExhaustedThreshold then
		return false
	end
	state.Stamina = math.max(0, state.Stamina - cost)
	state.LastStaminaSpend = now
	return true
end

-- kind = "Light" | "Heavy". charge = seconds the heavy was held (client-reported, clamped).
function CombatCore.attack(state, kind: string, weaponType: string, now: number, charge: number?)
	if kind ~= "Light" and kind ~= "Heavy" then
		return false, "InvalidKind"
	end
	if not CombatCore.canAct(state, now, 0.08) then
		return false, "Busy"
	end
	local wt = WeaponTypes[weaponType] or WeaponTypes.Fist
	local move = wt[kind]
	local cost = (if kind == "Light" then C.LightAttackCost else C.HeavyAttackCost) * (wt.StaminaMult or 1)
	local manaCost = move.Mana or 0
	if manaCost > 0 and state.Mana < manaCost then
		return false, "NoMana"
	end
	if state.Stamina <= GameConfig.Stamina.ExhaustedThreshold then
		return false, "NoStamina"
	end
	-- combo
	local motion
	if kind == "Light" then
		if now - state.LastAttackEnd <= 0.7 and state.ComboIndex > 0 then
			state.ComboIndex = state.ComboIndex % #move.Motion + 1
		else
			state.ComboIndex = 1
		end
		motion = move.Motion[state.ComboIndex]
	else
		state.ComboIndex = 0
		local c = math.clamp(tonumber(charge) or 0, 0, C.HeavyChargeMax)
		motion = move.Motion * (1 + C.HeavyChargeBonus * (c / C.HeavyChargeMax))
	end
	CombatCore.spendStamina(state, cost, now)
	state.Mana -= manaCost
	state.Blocking = false
	local windup = move.Windup
	local recovery = move.Recovery
	state.DodgeCancelFrom = now + windup
	state.ActionLockUntil = now + windup + recovery * 0.85
	state.LastAttackEnd = state.ActionLockUntil
	return true, {
		Kind = kind,
		Windup = windup,
		Recovery = recovery,
		Motion = motion,
		Poise = move.Poise,
		StaminaCost = cost,
		ManaCost = manaCost,
		Combo = state.ComboIndex,
		Ranged = wt.Ranged == true,
	}
end

-- Heavy charge is timed by the server: begin on press, measured on release.
function CombatCore.beginCharge(state, now: number): boolean
	if not CombatCore.canAct(state, now, 0.08) then
		return false
	end
	state.ChargeStart = now
	return true
end

-- Seconds charged (0 if no valid charge in progress). Consumes the charge.
function CombatCore.takeCharge(state, now: number): number
	local start = state.ChargeStart
	state.ChargeStart = nil
	if not start or now < start or now - start > 4 then
		return 0
	end
	return math.min(now - start, C.HeavyChargeMax)
end

function CombatCore.dodge(state, now: number, costMult: number?)
	if state.Dead or now < state.StaggeredUntil then
		return false, "Busy"
	end
	-- dodging may cancel attack recovery, but not the windup
	if now < state.DodgeCancelFrom then
		return false, "Busy"
	end
	if now - state.LastDodge < C.DodgeCooldown then
		return false, "Cooldown"
	end
	if not CombatCore.spendStamina(state, C.DodgeCost * (costMult or 1), now) then
		return false, "NoStamina"
	end
	state.LastDodge = now
	state.Blocking = false
	state.ChargeStart = nil
	state.ActionLockUntil = math.max(now + 0.35, 0)
	state.LastAttackEnd = NEG
	return true, { IFrames = C.DodgeIFrames }
end

function CombatCore.parry(state, now: number, parryBonus: number?)
	if not CombatCore.canAct(state, now, 0.05) then
		return false, "Busy"
	end
	if now - state.LastParry < C.ParryCooldown then
		return false, "Cooldown"
	end
	if not CombatCore.spendStamina(state, C.ParryStaminaCost, now) then
		return false, "NoStamina"
	end
	state.LastParry = now
	state.ParryWindow = C.ParryWindow + (parryBonus or 0)
	state.Blocking = false
	state.ActionLockUntil = now + 0.4
	return true, { Window = state.ParryWindow }
end

function CombatCore.setBlocking(state, on: boolean, now: number): boolean
	if on then
		if not CombatCore.canAct(state, now, 0.05) or state.Stamina <= 0 then
			return false
		end
		state.Blocking = true
	else
		state.Blocking = false
	end
	return true
end

function CombatCore.dodgeCovers(state, hitTime: number): boolean
	local d = state.LastDodge
	return d >= hitTime - C.DodgeIFrames and d <= hitTime + C.LatencyGrace
end

function CombatCore.parryCovers(state, hitTime: number): boolean
	local p = state.LastParry
	return p >= hitTime - state.ParryWindow and p <= hitTime + C.LatencyGrace
end

-- Damage reduction from armour and defensive buffs.
function CombatCore.mitigate(raw: number, damageType: string, stats, state, now: number): number
	local def = if damageType == "Physical" then stats.Defense else stats.MagicDefense
	local dmg = raw * (1 - Formulas.absorption(def, C.PlayerDefenseK))
	local buffReduction = math.min(0.8, CombatCore.buffAmount(state, "Defense", now))
	dmg *= (1 - buffReduction)
	return math.max(C.MinDamage, math.floor(dmg + 0.5))
end

--[[
	hit = { Damage, DamageType, Poise, Parryable, Blockable, Status = {..}, Unavoidable? }
	facing = true when the attacker is inside the defender's block arc.
	Returns { Outcome, Damage, StaminaDamage, Staggered, GuardBroken, Died, StatusProcs }
	Outcome: Ignored | Immune | Dodged | Parried | Blocked | GuardBroken | Hit
]]
function CombatCore.resolveIncoming(state, hit, hitTime: number, stats, facing: boolean)
	local r = { Outcome = "Hit", Damage = 0, StaminaDamage = 0, Staggered = false, GuardBroken = false, Died = false, StatusProcs = {} }
	if state.Dead then
		r.Outcome = "Ignored"
		return r
	end
	if state.GodMode or hitTime < state.InvulnerableUntil then
		r.Outcome = "Immune"
		return r
	end
	if CombatCore.dodgeCovers(state, hitTime) then
		r.Outcome = "Dodged"
		return r
	end
	if hit.Parryable and facing and CombatCore.parryCovers(state, hitTime) then
		r.Outcome = "Parried"
		return r
	end
	local damage = CombatCore.mitigate(hit.Damage, hit.DamageType or "Physical", stats, state, hitTime)
	if hit.Blockable and state.Blocking and facing then
		local stability = math.clamp(stats.Stability or 0, 0, 100) / 100
		local chip = math.floor(damage * (1 - stability) + 0.5)
		local staminaDamage = math.max(6, (hit.Poise or 20) * 0.8) * (1.5 - stability)
		r.StaminaDamage = staminaDamage
		state.Stamina -= staminaDamage
		state.LastStaminaSpend = hitTime
		if state.Stamina <= 0 then
			state.Stamina = 0
			state.Blocking = false
			r.Outcome = "GuardBroken"
			r.GuardBroken = true
			state.StaggeredUntil = hitTime + C.GuardBreakStun
			state.ActionLockUntil = math.max(state.ActionLockUntil, state.StaggeredUntil)
			state.StaggerImmuneUntil = state.StaggeredUntil + C.StaggerImmunity
		else
			r.Outcome = "Blocked"
		end
		r.Damage = chip
	else
		r.Damage = damage
		local poise = (stats.Poise or 0) + CombatCore.buffAmount(state, "Poise", hitTime)
		if (hit.Poise or 0) > poise and hitTime >= state.StaggerImmuneUntil then
			r.Staggered = true
			state.Blocking = false
			state.StaggeredUntil = hitTime + C.StaggerDuration
			state.ActionLockUntil = math.max(state.ActionLockUntil, state.StaggeredUntil)
			state.StaggerImmuneUntil = state.StaggeredUntil + C.StaggerImmunity
		end
		if hit.Status then
			for kind, amount in hit.Status do
				if CombatCore.addBuildup(state.Status, kind, amount, hitTime) then
					table.insert(r.StatusProcs, kind)
				end
			end
		end
	end
	if r.Damage > 0 then
		state.LastDamagedAt = hitTime
		r.Died = CombatCore.applyDamage(state, r.Damage)
	end
	return r
end

function CombatCore.applyDamage(state, amount: number): boolean
	if state.Dead or state.GodMode then
		return false
	end
	state.Health = math.max(0, state.Health - amount)
	if state.Health <= 0 then
		state.Dead = true
		state.Blocking = false
		return true
	end
	return false
end

function CombatCore.heal(state, amount: number): number
	if state.Dead or amount <= 0 then
		return 0
	end
	local before = state.Health
	state.Health = math.min(state.MaxHealth, state.Health + math.floor(amount))
	return state.Health - before
end

-- ===================================================================== Status effects
function CombatCore.newStatus()
	return { Bleed = 0, Poison = 0, Burn = 0, PoisonUntil = 0, BurnUntil = 0, LastDecay = 0 }
end

-- Returns true when the build-up procs.
function CombatCore.addBuildup(status, kind: string, amount: number, now: number): boolean
	local cfg = GameConfig.Status[kind]
	if not cfg or status[kind] == nil then
		return false
	end
	status[kind] += amount
	if status[kind] >= cfg.Threshold then
		status[kind] = 0
		if cfg.Duration then
			status[kind .. "Until"] = now + cfg.Duration
		end
		return true
	end
	return false
end

-- Decays build-up and returns damage-over-time fraction of max HP for this tick.
-- targetKind: "Player" | "Enemy" | "Boss"
function CombatCore.tickStatus(status, dt: number, now: number, targetKind: string): number
	local dot = 0
	for kind, cfg in GameConfig.Status do
		if status[kind] > 0 then
			status[kind] = math.max(0, status[kind] - cfg.Decay * dt)
		end
		local untilKey = kind .. "Until"
		if status[untilKey] and now < status[untilKey] then
			dot += (cfg[targetKind .. "Dps"] or 0) * dt
		end
	end
	return dot
end

function CombatCore.cureStatus(status, kind: string)
	if status[kind] then
		status[kind] = 0
		status[kind .. "Until"] = 0
	end
end

-- Instant damage fraction for a Bleed proc.
function CombatCore.bleedFraction(targetKind: string): number
	return GameConfig.Status.Bleed[targetKind .. "Fraction"] or 0
end

-- ===================================================================== Outgoing damage
--[[
	opts = { CritMult, DamageBuff, TypeBonus, TargetDefense, Pvp }
]]
function CombatCore.outgoing(attackRating: number, motion: number, opts)
	opts = opts or {}
	local dmg = attackRating * motion
	dmg *= 1 + (opts.DamageBuff or 0)
	dmg *= 1 + (opts.TypeBonus or 0)
	dmg *= opts.CritMult or 1
	if opts.TargetDefense then
		dmg *= 1 - Formulas.absorption(opts.TargetDefense, C.EnemyDefenseK)
	end
	if opts.Pvp then
		dmg *= C.PvPDamageMultiplier
	end
	return math.max(C.MinDamage, math.floor(dmg + 0.5))
end

-- ===================================================================== NPC targets
function CombatCore.newTarget(maxHealth: number, maxPoise: number)
	return {
		Health = maxHealth,
		MaxHealth = maxHealth,
		Poise = maxPoise,
		MaxPoise = maxPoise,
		LastPoiseDamage = NEG,
		StaggeredUntil = 0,
		Dead = false,
		Status = CombatCore.newStatus(),
		SlowUntil = 0,
		SlowAmount = 0,
	}
end

-- Returns { Died, Staggered, Damage }
function CombatCore.damageTarget(target, damage: number, poiseDamage: number, now: number)
	local r = { Died = false, Staggered = false, Damage = 0 }
	if target.Dead then
		return r
	end
	local dmg = math.max(0, math.floor(damage))
	target.Health = math.max(0, target.Health - dmg)
	r.Damage = dmg
	if target.Health <= 0 then
		target.Dead = true
		r.Died = true
		return r
	end
	if poiseDamage > 0 and now >= target.StaggeredUntil then
		target.Poise -= poiseDamage
		target.LastPoiseDamage = now
		if target.Poise <= 0 then
			target.Poise = target.MaxPoise
			target.StaggeredUntil = now + C.EnemyStaggerDuration
			r.Staggered = true
		end
	end
	return r
end

function CombatCore.regenTargetPoise(target, dt: number, now: number)
	if now - target.LastPoiseDamage >= C.PoiseRegenDelay and target.Poise < target.MaxPoise then
		target.Poise = math.min(target.MaxPoise, target.Poise + target.MaxPoise * 0.25 * dt)
	end
end

function CombatCore.isStaggered(target, now: number): boolean
	return now < target.StaggeredUntil
end

-- Scales a target's health pool by `scale`, preserving the current ratio.
function CombatCore.scaleTargetHealth(target, scale: number)
	if scale == 1 or target.Dead then
		return
	end
	target.MaxHealth = math.max(1, math.floor(target.MaxHealth * scale))
	target.Health = math.clamp(math.floor(target.Health * scale), 1, target.MaxHealth)
end

return CombatCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">DeathCore</string>
            <string name="Source"><![CDATA[--[[
	DeathCore
	Soulslike currency loss and recovery. State lives in profile.LostCurrency so it survives
	disconnects and server shutdowns; the marker in the world is only a view of this state.

	Rules (configurable in GameConfig.Death):
	  * On death, all carried currency moves into a recovery marker at the death position.
	  * SecondDeathRule "LosePrevious": dying again before recovering destroys the old marker
	    (its currency is gone) and creates a new one. "Merge": the new marker holds both sums.
	  * Markers expire after RecoveryExpirySeconds of real time.
	  * Recovery: only the owner (the profile itself), within RecoveryRadius, exactly once.
	  * Equipment and purchases are never touched by death.
	  * A death with nothing to drop and no rule-preserved marker leaves no marker.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local DeathCore = {}

function DeathCore.isExpired(lost, now: number): boolean
	return lost ~= nil and (now - lost.CreatedAt) >= GameConfig.Death.RecoveryExpirySeconds
end

-- Clears an expired marker. Returns the amount that expired (0 if none).
function DeathCore.expire(profile, now: number): number
	local lost = profile.LostCurrency
	if lost and DeathCore.isExpired(lost, now) then
		profile.LostCurrency = nil
		return lost.Amount
	end
	return 0
end

--[[
	context = { NoLoss = bool }  (PvP arena / training deaths cost nothing)
	Returns { Dropped = n, LostForever = n, Marker = table? }
]]
function DeathCore.onDeath(profile, x: number, y: number, z: number, now: number, context)
	local result = { Dropped = 0, LostForever = 0, Marker = nil }
	if context and context.NoLoss then
		result.Marker = profile.LostCurrency
		return result
	end
	DeathCore.expire(profile, now)
	local carried = math.max(0, math.floor(profile.Currency))
	local previous = profile.LostCurrency
	local amount = carried
	if previous then
		if GameConfig.Death.SecondDeathRule == "Merge" then
			amount += previous.Amount
		else
			result.LostForever = previous.Amount
		end
	end
	profile.Currency = 0
	if amount > 0 then
		profile.LostCurrency = { Amount = amount, X = x, Y = y, Z = z, CreatedAt = now }
	else
		profile.LostCurrency = nil
	end
	result.Dropped = carried
	result.Marker = profile.LostCurrency
	return result
end

-- Attempt recovery at the player's position. Returns ok, amountOrError.
function DeathCore.recover(profile, px: number, py: number, pz: number, now: number)
	local lost = profile.LostCurrency
	if not lost then
		return false, "NoMarker"
	end
	if DeathCore.isExpired(lost, now) then
		profile.LostCurrency = nil
		return false, "Expired"
	end
	local dx, dy, dz = px - lost.X, py - lost.Y, pz - lost.Z
	local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
	if dist > GameConfig.Death.RecoveryRadius then
		return false, "TooFar"
	end
	-- single mutation: clear marker and credit in the same step (no double-award possible)
	profile.LostCurrency = nil
	local before = profile.Currency
	profile.Currency = math.min(GameConfig.Currency.MaxCarried, before + lost.Amount)
	return true, profile.Currency - before
end

return DeathCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">EconomyCore</string>
            <string name="Source"><![CDATA[--[[
	EconomyCore
	Server-authoritative shop purchases. The client sends only (shopId, itemId, quantity);
	price, availability and limits come from Config/Shops.luau.
	All validation happens before any mutation, so a purchase either fully succeeds or
	changes nothing (no negative balances, no partial grants).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Shops = require(Shared.Config.Shops)
local Items = require(Shared.Config.Items)
local InventoryCore = require(script.Parent.InventoryCore)

local EconomyCore = {}

function EconomyCore.findStock(shopId: string, itemId: string)
	local shop = Shops[shopId]
	if not shop then
		return nil
	end
	for _, entry in shop.Stock do
		if entry.Item == itemId then
			return entry
		end
	end
	return nil
end

function EconomyCore.isVisible(entry, highestCleared: number): boolean
	return (entry.RequiresFloor or 0) <= highestCleared
end

function EconomyCore.purchaseKey(shopId: string, itemId: string): string
	return shopId .. ":" .. itemId
end

function EconomyCore.remainingLimit(profile, shopId: string, entry): number?
	if not entry.Limit then
		return nil
	end
	local bought = profile.ShopPurchases[EconomyCore.purchaseKey(shopId, entry.Item)] or 0
	return math.max(0, entry.Limit - bought)
end

function EconomyCore.buy(profile, shopId, itemId, quantity)
	if type(shopId) ~= "string" or type(itemId) ~= "string" then
		return false, "InvalidRequest"
	end
	if type(quantity) ~= "number" or quantity ~= quantity or math.floor(quantity) ~= quantity
		or quantity < 1 or quantity > GameConfig.Shop.MaxPurchaseQuantity then
		return false, "InvalidQuantity"
	end
	local entry = EconomyCore.findStock(shopId, itemId)
	if not entry or not Items[itemId] then
		return false, "NotForSale"
	end
	if not EconomyCore.isVisible(entry, profile.Tower.HighestCleared) then
		return false, "Locked"
	end
	local limit = EconomyCore.remainingLimit(profile, shopId, entry)
	if limit and quantity > limit then
		return false, "LimitReached"
	end
	local total = entry.Price * quantity
	if total <= 0 or total ~= total then
		return false, "InvalidPrice"
	end
	if profile.Currency < total then
		return false, "NotEnoughCurrency"
	end
	local canAdd, err = InventoryCore.canAdd(profile, itemId, quantity)
	if not canAdd then
		return false, err
	end
	-- mutate
	profile.Currency -= total
	local ok, result = InventoryCore.addItem(profile, itemId, quantity)
	if not ok then
		-- should be impossible after canAdd; refund defensively
		profile.Currency += total
		return false, result
	end
	if entry.Limit then
		local key = EconomyCore.purchaseKey(shopId, itemId)
		profile.ShopPurchases[key] = (profile.ShopPurchases[key] or 0) + quantity
	end
	return true, { Spent = total, Item = itemId, Quantity = quantity, Uids = result.Uids }
end

function EconomyCore.addCurrency(profile, amount: number): number
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local before = profile.Currency
	profile.Currency = math.min(GameConfig.Currency.MaxCarried, before + math.floor(amount))
	return profile.Currency - before
end

return EconomyCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EncounterCore</string>
            <string name="Source"><![CDATA[--[[
	EncounterCore
	Pure state for tower boss encounters (one encounter = one arena instance).

	Ownership & eligibility rules (documented in docs/DESIGN.md):
	  * An encounter is created for a solo player or a party. Every participant must have the
	    floor unlocked (HighestCleared >= Floor - 1). Members who have not are left behind.
	  * Participants are fixed at start. Nobody joins mid-fight.
	  * A participant who dies or disconnects is removed from the fight (no re-entry).
	  * Boss HP scales with the participant count at start; when someone leaves, current and
	    max HP are scaled down proportionally so the remaining players are not punished.
	  * If no participants remain, the encounter fails and the boss resets.
	  * On victory, every participant still alive in the arena is eligible. Each is rewarded
	    exactly once per encounter (Rewarded set) and once per encounter id per profile
	    (profile.Tower.RewardedEncounters), so reconnects or simultaneous kills can't duplicate.
	  * First clear (HighestCleared == Floor - 1): full rewards + unique items, progression +1.
	    Replays: reduced currency/XP + replay loot table, small chance of the unique weapon.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Bosses = require(Shared.Config.Bosses)
local Formulas = require(Shared.Logic.Formulas)
local LootCore = require(script.Parent.LootCore)

local EncounterCore = {}

function EncounterCore.canEnter(profile, floor: number): (boolean, string?)
	if type(floor) ~= "number" or floor < 1 or floor > GameConfig.Tower.Floors or math.floor(floor) ~= floor then
		return false, "InvalidFloor"
	end
	if profile.Class == "" then
		return false, "NoClass"
	end
	if profile.Tower.HighestCleared < floor - 1 then
		return false, "Locked"
	end
	return true, nil
end

function EncounterCore.new(id: string, floor: number, userIds, now: number)
	local enc = {
		Id = id,
		Floor = floor,
		State = "Active",
		StartedAt = now,
		Participants = {},
		Rewarded = {},
		StartCount = #userIds,
		DamageTaken = {},
	}
	for _, uid in userIds do
		enc.Participants[uid] = { Alive = true, Damage = 0, Hits = 0 }
	end
	return enc
end

function EncounterCore.activeCount(enc): number
	local n = 0
	for _, p in enc.Participants do
		if p.Alive then
			n += 1
		end
	end
	return n
end

function EncounterCore.isParticipant(enc, uid): boolean
	local p = enc.Participants[uid]
	return p ~= nil and p.Alive
end

function EncounterCore.recordDamage(enc, uid, amount: number)
	local p = enc.Participants[uid]
	if p and p.Alive and enc.State == "Active" then
		p.Damage += amount
	end
end

function EncounterCore.recordHitTaken(enc, uid)
	local p = enc.Participants[uid]
	if p then
		p.Hits += 1
	end
end

-- Removes a participant (death or disconnect). Returns hpScale to apply to the boss
-- (newMultiplier / oldMultiplier), and whether the encounter has failed.
function EncounterCore.removeParticipant(enc, uid)
	local p = enc.Participants[uid]
	if not p or not p.Alive or enc.State ~= "Active" then
		return 1, false
	end
	local before = math.max(1, EncounterCore.activeCount(enc))
	p.Alive = false
	local after = EncounterCore.activeCount(enc)
	if after == 0 then
		enc.State = "Failed"
		return 1, true
	end
	return Formulas.partyHealthMult(after) / Formulas.partyHealthMult(before), false
end

function EncounterCore.markVictory(enc): boolean
	if enc.State ~= "Active" then
		return false
	end
	enc.State = "Victory"
	return true
end

function EncounterCore.eligible(enc, uid): boolean
	return enc.State == "Victory" and EncounterCore.isParticipant(enc, uid) and not enc.Rewarded[uid]
end

-- Builds the reward bundle (does not apply it).
function EncounterCore.buildRewards(profile, floor: number, rng)
	local def = Bosses.List[floor]
	local firstClear = profile.Tower.HighestCleared == floor - 1
	local rewards = { FirstClear = firstClear, Floor = floor, Items = {}, Xp = 0, Currency = 0 }
	local xp, currency = Formulas.bossXp(floor), Formulas.bossCurrency(floor)
	if firstClear then
		rewards.Xp, rewards.Currency = xp, currency
		for item, n in def.Rewards.FirstClear.Items or {} do
			rewards.Items[item] = (rewards.Items[item] or 0) + n
		end
		rewards.Ability = def.Rewards.FirstClear.Ability
		rewards.Title = def.Rewards.FirstClear.Title
		rewards.Cosmetic = def.Rewards.FirstClear.Cosmetic
	else
		rewards.Xp = math.floor(xp * GameConfig.Tower.ReplayXpMultiplier)
		rewards.Currency = math.floor(currency * GameConfig.Tower.ReplayCurrencyMultiplier)
		for item, n in LootCore.roll(Bosses.ReplayLoot, rng) do
			rewards.Items[item] = (rewards.Items[item] or 0) + n
		end
		if rng:NextNumber() < GameConfig.Tower.ReplayUniqueDropChance then
			-- one of the boss's unique weapons/shields (not consumables)
			local uniques = {}
			for item in def.Rewards.FirstClear.Items or {} do
				if string.find(item, "_shard") == nil and item ~= "flask_shard" and item ~= "fallen_core" and item ~= "fallen_remnant" and item ~= "armor_plate" then
					table.insert(uniques, item)
				end
			end
			table.sort(uniques)
			if #uniques > 0 then
				local pick = uniques[rng:NextInteger(1, #uniques)]
				rewards.Items[pick] = (rewards.Items[pick] or 0) + 1
			end
		end
	end
	return rewards
end

-- Marks the player rewarded and applies tower progression. Returns rewards or nil if ineligible.
-- The caller applies XP/currency/items via ProgressionCore/InventoryCore.
function EncounterCore.claim(enc, uid, profile, rng)
	if not EncounterCore.eligible(enc, uid) then
		return nil, "NotEligible"
	end
	local history = profile.Tower.RewardedEncounters
	if table.find(history, enc.Id) then
		enc.Rewarded[uid] = true
		return nil, "AlreadyRewarded"
	end
	enc.Rewarded[uid] = true
	local rewards = EncounterCore.buildRewards(profile, enc.Floor, rng)
	table.insert(history, enc.Id)
	while #history > 20 do
		table.remove(history, 1)
	end
	local key = tostring(enc.Floor)
	profile.Tower.Clears[key] = (profile.Tower.Clears[key] or 0) + 1
	if rewards.FirstClear then
		profile.Tower.HighestCleared = enc.Floor
	end
	local p = enc.Participants[uid]
	rewards.Flawless = p ~= nil and p.Hits == 0
	rewards.Solo = enc.StartCount == 1
	return rewards, nil
end

return EncounterCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">InventoryCore</string>
            <string name="Source"><![CDATA[--[[
	InventoryCore
	Pure inventory/equipment operations on a profile table. Every function validates fully
	BEFORE mutating, so a failed call leaves the profile untouched (no partial updates).
	Returns (ok: boolean, errOrResult).

	Data model:
	  profile.Inventory.Items  = { [uid: string] = { Id = itemId, Upgrade = n } }  -- equipment
	  profile.Inventory.Stacks = { [itemId] = count }                               -- stackables
	  profile.Equipped         = { [slot] = uid }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Formulas = require(Shared.Logic.Formulas)

local InventoryCore = {}

local function isPositiveInt(n)
	return type(n) == "number" and n == n and n >= 1 and n <= 1e6 and math.floor(n) == n
end

function InventoryCore.instanceCount(profile): number
	local n = 0
	for _ in profile.Inventory.Items do
		n += 1
	end
	return n
end

function InventoryCore.stackCount(profile, itemId: string): number
	return profile.Inventory.Stacks[itemId] or 0
end

function InventoryCore.ownsItemId(profile, itemId: string): boolean
	local def = Items[itemId]
	if not def then
		return false
	end
	if def.Stackable then
		return InventoryCore.stackCount(profile, itemId) > 0
	end
	for _, inst in profile.Inventory.Items do
		if inst.Id == itemId then
			return true
		end
	end
	return false
end

-- Can `amount` of `itemId` be added? (capacity check only)
function InventoryCore.canAdd(profile, itemId: string, amount: number): (boolean, string?)
	local def = Items[itemId]
	if not def then
		return false, "UnknownItem"
	end
	if not isPositiveInt(amount) then
		return false, "InvalidQuantity"
	end
	if def.Stackable then
		if InventoryCore.stackCount(profile, itemId) + amount > GameConfig.Inventory.MaxStack then
			return false, "StackFull"
		end
	elseif InventoryCore.instanceCount(profile) + amount > GameConfig.Inventory.MaxSlots then
		return false, "InventoryFull"
	end
	return true, nil
end

-- Adds items. For loot, `clampToCapacity` adds as many as fit instead of failing.
-- Returns ok, { Added = n, Uids = {...} } or error.
function InventoryCore.addItem(profile, itemId: string, amount: number, clampToCapacity: boolean?)
	local def = Items[itemId]
	if not def then
		return false, "UnknownItem"
	end
	if not isPositiveInt(amount) then
		return false, "InvalidQuantity"
	end
	if def.Stackable then
		local have = InventoryCore.stackCount(profile, itemId)
		local room = GameConfig.Inventory.MaxStack - have
		local add = amount
		if add > room then
			if not clampToCapacity then
				return false, "StackFull"
			end
			add = math.max(0, room)
		end
		if add > 0 then
			profile.Inventory.Stacks[itemId] = have + add
		end
		return true, { Added = add, Uids = {} }
	end
	local room = GameConfig.Inventory.MaxSlots - InventoryCore.instanceCount(profile)
	local add = amount
	if add > room then
		if not clampToCapacity then
			return false, "InventoryFull"
		end
		add = math.max(0, room)
	end
	local uids = {}
	for _ = 1, add do
		local uid = "i" .. profile.Inventory.NextUid
		profile.Inventory.NextUid += 1
		profile.Inventory.Items[uid] = { Id = itemId, Upgrade = 0 }
		table.insert(uids, uid)
	end
	return true, { Added = add, Uids = uids }
end

function InventoryCore.removeStack(profile, itemId: string, amount: number)
	if not isPositiveInt(amount) then
		return false, "InvalidQuantity"
	end
	local have = InventoryCore.stackCount(profile, itemId)
	if have < amount then
		return false, "NotEnough"
	end
	local left = have - amount
	profile.Inventory.Stacks[itemId] = if left > 0 then left else nil
	return true, left
end

function InventoryCore.isEquipped(profile, uid: string): boolean
	for _, v in profile.Equipped do
		if v == uid then
			return true
		end
	end
	return false
end

-- Which slot(s) can hold this item?
function InventoryCore.slotsFor(def)
	if not def then
		return {}
	end
	if def.Kind == "Weapon" then
		return { "Weapon" }
	elseif def.Kind == "Shield" then
		return { "Offhand" }
	elseif def.Kind == "Armor" then
		return { def.Slot }
	elseif def.Kind == "Accessory" then
		return { "Accessory1", "Accessory2" }
	end
	return {}
end

function InventoryCore.equip(profile, uid: string, slot: string?)
	if type(uid) ~= "string" then
		return false, "InvalidItem"
	end
	local inst = profile.Inventory.Items[uid]
	if not inst then
		return false, "NotOwned"
	end
	local def = Items[inst.Id]
	local allowed = InventoryCore.slotsFor(def)
	if #allowed == 0 then
		return false, "NotEquippable"
	end
	local target = slot
	if target == nil then
		target = allowed[1]
		if def.Kind == "Accessory" and profile.Equipped.Accessory1 and not profile.Equipped.Accessory2 then
			target = "Accessory2"
		end
	end
	if not table.find(allowed, target) then
		return false, "WrongSlot"
	end
	-- prevent the same accessory id in both accessory slots (no double-stacking bonuses)
	if def.Kind == "Accessory" then
		local other = if target == "Accessory1" then "Accessory2" else "Accessory1"
		local otherUid = profile.Equipped[other]
		if otherUid and otherUid ~= uid and profile.Inventory.Items[otherUid] and profile.Inventory.Items[otherUid].Id == inst.Id then
			return false, "DuplicateAccessory"
		end
	end
	-- move from any other slot it currently occupies
	for s, v in profile.Equipped do
		if v == uid then
			profile.Equipped[s] = nil
		end
	end
	profile.Equipped[target] = uid
	return true, target
end

function InventoryCore.unequip(profile, slot: string)
	if type(slot) ~= "string" or profile.Equipped[slot] == nil then
		return false, "NothingEquipped"
	end
	profile.Equipped[slot] = nil
	return true, slot
end

-- Sell equipment (uid) or stackables (itemId + amount). Currency is computed server-side.
function InventoryCore.sell(profile, key: string, amount: number?)
	if type(key) ~= "string" then
		return false, "InvalidItem"
	end
	local inst = profile.Inventory.Items[key]
	if inst then
		if InventoryCore.isEquipped(profile, key) then
			return false, "Equipped"
		end
		local def = Items[inst.Id]
		local price = Formulas.sellPrice(def)
		if price <= 0 then
			return false, "CannotSell"
		end
		profile.Inventory.Items[key] = nil
		profile.Currency = math.min(GameConfig.Currency.MaxCarried, profile.Currency + price)
		return true, price
	end
	local def = Items[key]
	if not def or not def.Stackable then
		return false, "NotOwned"
	end
	local qty = amount or 1
	if not isPositiveInt(qty) then
		return false, "InvalidQuantity"
	end
	local price = Formulas.sellPrice(def)
	if price <= 0 then
		return false, "CannotSell"
	end
	if InventoryCore.stackCount(profile, key) < qty then
		return false, "NotEnough"
	end
	InventoryCore.removeStack(profile, key, qty)
	profile.Currency = math.min(GameConfig.Currency.MaxCarried, profile.Currency + price * qty)
	return true, price * qty
end

-- Returns a preview { Cost, From, To, Before, After } or nil, err
function InventoryCore.upgradePreview(profile, uid: string, attrs)
	local inst = profile.Inventory.Items[uid]
	if not inst then
		return nil, "NotOwned"
	end
	local def = Items[inst.Id]
	local cost = Formulas.upgradeCost(def, inst.Upgrade)
	if not cost then
		return nil, "MaxLevel"
	end
	local preview = { Cost = cost, From = inst.Upgrade, To = inst.Upgrade + 1 }
	if def.Kind == "Weapon" then
		preview.Before = Formulas.weaponAttackRating(def, inst.Upgrade, attrs).Total
		preview.After = Formulas.weaponAttackRating(def, inst.Upgrade + 1, attrs).Total
	elseif def.Kind == "Shield" then
		preview.Before = Formulas.shieldStability(def, inst.Upgrade)
		preview.After = Formulas.shieldStability(def, inst.Upgrade + 1)
	elseif def.Kind == "Armor" then
		preview.Before = (Formulas.armorDefense(def, inst.Upgrade))
		preview.After = (Formulas.armorDefense(def, inst.Upgrade + 1))
	end
	return preview, nil
end

function InventoryCore.upgrade(profile, uid: string, attrs)
	if type(uid) ~= "string" then
		return false, "InvalidItem"
	end
	local preview, err = InventoryCore.upgradePreview(profile, uid, attrs or {})
	if not preview then
		return false, err
	end
	local cost = preview.Cost
	if profile.Currency < cost.Currency then
		return false, "NotEnoughCurrency"
	end
	if InventoryCore.stackCount(profile, cost.Material) < cost.Amount then
		return false, "NotEnoughMaterials"
	end
	-- all checks passed: mutate
	InventoryCore.removeStack(profile, cost.Material, cost.Amount)
	profile.Currency -= cost.Currency
	local inst = profile.Inventory.Items[uid]
	inst.Upgrade += 1
	return true, preview
end

function InventoryCore.highestUpgrade(profile): number
	local best = 0
	for _, inst in profile.Inventory.Items do
		if inst.Upgrade > best then
			best = inst.Upgrade
		end
	end
	return best
end

return InventoryCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">LootCore</string>
            <string name="Source"><![CDATA[--[[
	LootCore
	Rolls loot tables with an injected Rng so results are reproducible in tests.
	Returns a map { [itemId] = quantity }.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local LootTables = require(Shared.Config.LootTables)

local LootCore = {}

local function addTo(out, item, n)
	out[item] = (out[item] or 0) + n
end

function LootCore.roll(tableId: string?, rng, luck: number?)
	local out = {}
	if not tableId then
		return out
	end
	local tbl = LootTables[tableId]
	if not tbl then
		return out
	end
	for item, n in tbl.Guaranteed or {} do
		addTo(out, item, n)
	end
	local chance = math.min(1, (tbl.Chance or 1) * (1 + (luck or 0)))
	for _ = 1, tbl.Rolls or 1 do
		if rng:NextNumber() < chance then
			local entry = rng:Weighted(tbl.Entries)
			if entry then
				addTo(out, entry.Item, rng:NextInteger(entry.Min or 1, entry.Max or 1))
			end
		end
	end
	return out
end

function LootCore.rollRange(range, rng): number
	if type(range) ~= "table" then
		return 0
	end
	return rng:NextInteger(range[1] or 0, range[2] or range[1] or 0)
end

return LootCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PartyCore</string>
            <string name="Source"><![CDATA[--[[
	PartyCore
	Pure party state machine: invite, accept, decline, leave, kick, promote, disband.
	State is per-server (parties do not persist across servers).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local PartyCore = {}

function PartyCore.newState()
	return { Parties = {}, MemberOf = {}, Invites = {}, NextId = 1 }
end

function PartyCore.get(state, uid)
	local pid = state.MemberOf[uid]
	return pid and state.Parties[pid], pid
end

function PartyCore.members(state, uid)
	local party = PartyCore.get(state, uid)
	if not party then
		return { uid }
	end
	return table.clone(party.Members)
end

local function createParty(state, leader)
	local pid = "p" .. state.NextId
	state.NextId += 1
	state.Parties[pid] = { Id = pid, Leader = leader, Members = { leader } }
	state.MemberOf[leader] = pid
	return state.Parties[pid], pid
end

local function disband(state, pid)
	local party = state.Parties[pid]
	if not party then
		return
	end
	for _, m in party.Members do
		state.MemberOf[m] = nil
	end
	state.Parties[pid] = nil
	for target, inv in state.Invites do
		if inv.Party == pid then
			state.Invites[target] = nil
		end
	end
end

-- Invites[target] = { From, Party, Expires }  (one pending invite per target)
function PartyCore.invite(state, from, to, now: number)
	if from == to then
		return false, "Self"
	end
	if state.MemberOf[to] then
		return false, "TargetInParty"
	end
	local party, pid = PartyCore.get(state, from)
	if party and party.Leader ~= from then
		return false, "NotLeader"
	end
	if party and #party.Members >= GameConfig.Party.MaxSize then
		return false, "PartyFull"
	end
	if not party then
		party, pid = createParty(state, from)
	end
	state.Invites[to] = { From = from, Party = pid, Expires = now + GameConfig.Party.InviteExpiry }
	return true, pid
end

function PartyCore.accept(state, uid, now: number)
	local inv = state.Invites[uid]
	if not inv then
		return false, "NoInvite"
	end
	state.Invites[uid] = nil
	if now > inv.Expires then
		return false, "Expired"
	end
	if state.MemberOf[uid] then
		return false, "AlreadyInParty"
	end
	local party = state.Parties[inv.Party]
	if not party then
		return false, "PartyGone"
	end
	if #party.Members >= GameConfig.Party.MaxSize then
		return false, "PartyFull"
	end
	table.insert(party.Members, uid)
	state.MemberOf[uid] = inv.Party
	return true, inv.Party
end

function PartyCore.decline(state, uid)
	if not state.Invites[uid] then
		return false, "NoInvite"
	end
	state.Invites[uid] = nil
	return true, nil
end

function PartyCore.leave(state, uid)
	local party, pid = PartyCore.get(state, uid)
	state.Invites[uid] = nil
	if not party then
		return false, "NotInParty"
	end
	local idx = table.find(party.Members, uid)
	if idx then
		table.remove(party.Members, idx)
	end
	state.MemberOf[uid] = nil
	if #party.Members <= 1 then
		disband(state, pid)
		return true, "Disbanded"
	end
	if party.Leader == uid then
		party.Leader = party.Members[1]
	end
	return true, pid
end

function PartyCore.kick(state, leader, target)
	local party = PartyCore.get(state, leader)
	if not party or party.Leader ~= leader then
		return false, "NotLeader"
	end
	if leader == target or not table.find(party.Members, target) then
		return false, "InvalidTarget"
	end
	return PartyCore.leave(state, target)
end

function PartyCore.promote(state, leader, target)
	local party = PartyCore.get(state, leader)
	if not party or party.Leader ~= leader then
		return false, "NotLeader"
	end
	if not table.find(party.Members, target) then
		return false, "InvalidTarget"
	end
	party.Leader = target
	return true, target
end

function PartyCore.pruneInvites(state, now: number)
	for target, inv in state.Invites do
		if now > inv.Expires then
			state.Invites[target] = nil
		end
	end
	-- disband parties that were created by an invite nobody accepted
	for pid, party in state.Parties do
		if #party.Members <= 1 then
			local pending = false
			for _, inv in state.Invites do
				if inv.Party == pid then
					pending = true
				end
			end
			if not pending then
				disband(state, pid)
			end
		end
	end
end

return PartyCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--[[
	ProfileSchema
	Default player data, migrations and validation/reconciliation.

	reconcile(data) never throws and never resets progress wholesale: it fills missing fields,
	clamps out-of-range numbers, drops references to items that no longer exist and records
	every correction in the returned `corrections` list so problems are visible in logs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Abilities = require(Shared.Config.Abilities)
local Classes = require(Shared.Config.Classes)

local ProfileSchema = {}

function ProfileSchema.defaultAttributes()
	local attrs = {}
	for _, name in GameConfig.Attributes.List do
		attrs[name] = 10
	end
	return attrs
end

function ProfileSchema.default()
	return {
		DataVersion = GameConfig.DataVersion,
		CreatedAt = 0,
		LastSaved = 0,
		Class = "",
		Level = 1,
		Xp = 0,
		UnspentPoints = 0,
		Attributes = ProfileSchema.defaultAttributes(),
		TrainingBonus = {},
		TrainingPoints = {},
		TrainingDaily = { Day = 0, Points = 0 },
		TrainingCooldowns = {},
		Currency = GameConfig.Currency.StartingAmount,
		Inventory = { Items = {}, Stacks = {}, NextUid = 1 },
		Equipped = {},
		Abilities = { Unlocked = {}, Slot1 = "", Slot2 = "" },
		Flask = { MaxCharges = GameConfig.Flask.BaseCharges, Charges = GameConfig.Flask.BaseCharges },
		Tower = { HighestCleared = 0, Clears = {}, RewardedEncounters = {} },
		Checkpoints = { Activated = { sanctuary = true }, Last = "sanctuary" },
		Discovered = {},
		OpenedChests = {},
		Quests = { Active = {}, Completed = {} },
		Stats = {},
		KillsByEnemy = {},
		Achievements = {},
		Titles = {},
		ActiveTitle = "",
		Cosmetics = { Owned = { dye_midnight = true }, Equipped = { Aura = "", WeaponSkin = "", ArmorDye = "" } },
		Settings = {
			CameraSensitivity = 1,
			MusicVolume = 0.5,
			SfxVolume = 0.8,
			ReducedEffects = false,
			ShowDamageNumbers = true,
			HighContrastTelegraphs = false,
			TextScale = 1,
			LockOnToggle = true,
			ScreenShake = true,
			MouseLock = true,
			ShowControls = true,
		},
		LostCurrency = nil,
		ShopPurchases = {},
		Purchases = { ProcessedReceipts = {}, Products = {} },
		BuildPresets = {},
		RedeemedCodes = {},
		Admin = { Granted = false, GodMode = false },
		Corrections = {},
	}
end

-- ===================================================================== Migrations
-- Each migration upgrades data FROM version `n` to `n + 1`.
ProfileSchema.Migrations = {
	[1] = function(data)
		-- v1 stored currency as `Gold` and tower progress as a bare number.
		if data.Gold ~= nil and data.Currency == nil then
			data.Currency = data.Gold
		end
		data.Gold = nil
		if type(data.Tower) == "number" then
			data.Tower = { HighestCleared = data.Tower, Clears = {}, RewardedEncounters = {} }
		end
		return data
	end,
}

local function isFiniteNumber(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function note(corrections, msg)
	table.insert(corrections, msg)
end

-- Fill missing keys (recursively for plain tables) from defaults; fix mismatched primitive types.
local function fill(target, defaults, path, corrections)
	for key, dv in defaults do
		local tv = target[key]
		if tv == nil then
			if type(dv) == "table" then
				target[key] = table.clone(dv)
				-- deep-copy nested defaults
				fill(target[key], dv, path .. "." .. key, {})
			else
				target[key] = dv
			end
		elseif type(dv) == "table" then
			if type(tv) ~= "table" then
				note(corrections, "type fix " .. path .. "." .. key)
				target[key] = table.clone(dv)
				fill(target[key], dv, path .. "." .. key, {})
			elseif next(dv) ~= nil then
				fill(tv, dv, path .. "." .. key, corrections)
			end
		elseif type(tv) ~= type(dv) then
			note(corrections, "type fix " .. path .. "." .. key)
			target[key] = dv
		end
	end
end

local function clampNumber(container, key, lo, hi, corrections, path)
	local v = container[key]
	if not isFiniteNumber(v) then
		note(corrections, "invalid number " .. path .. "." .. key)
		container[key] = lo
		return
	end
	local c = math.clamp(math.floor(v), lo, hi)
	if c ~= v then
		note(corrections, ("clamped %s.%s %s -> %s"):format(path, key, tostring(v), tostring(c)))
		container[key] = c
	end
end

function ProfileSchema.reconcile(data)
	local corrections = {}
	if type(data) ~= "table" then
		return ProfileSchema.default(), { "profile was not a table; created default" }
	end

	-- migrations
	local version = isFiniteNumber(data.DataVersion) and data.DataVersion or 1
	while version < GameConfig.DataVersion do
		local migrate = ProfileSchema.Migrations[version]
		if migrate then
			data = migrate(data)
			note(corrections, "migrated v" .. version .. " -> v" .. (version + 1))
		end
		version += 1
	end
	data.DataVersion = GameConfig.DataVersion

	fill(data, ProfileSchema.default(), "Profile", corrections)
	data.Corrections = {} -- runtime only, rebuilt each load

	-- class
	if data.Class ~= "" and not Classes[data.Class] then
		note(corrections, "unknown class " .. tostring(data.Class))
		data.Class = ""
	end

	-- numbers
	clampNumber(data, "Level", 1, GameConfig.Level.Max, corrections, "Profile")
	clampNumber(data, "Xp", 0, 1e12, corrections, "Profile")
	clampNumber(data, "UnspentPoints", 0, GameConfig.Level.Max * GameConfig.Level.PointsPerLevel, corrections, "Profile")
	clampNumber(data, "Currency", 0, GameConfig.Currency.MaxCarried, corrections, "Profile")
	for _, name in GameConfig.Attributes.List do
		clampNumber(data.Attributes, name, GameConfig.Attributes.Min, GameConfig.Attributes.Max, corrections, "Attributes")
		if data.TrainingBonus[name] ~= nil then
			clampNumber(data.TrainingBonus, name, 0, GameConfig.Training.MaxTrainingBonusPerAttribute, corrections, "TrainingBonus")
		end
	end
	-- drop unknown attribute keys
	for k in data.Attributes do
		if not table.find(GameConfig.Attributes.List, k) then
			data.Attributes[k] = nil
			note(corrections, "removed attribute " .. tostring(k))
		end
	end
	clampNumber(data.Flask, "MaxCharges", GameConfig.Flask.BaseCharges, GameConfig.Flask.MaxCharges, corrections, "Flask")
	clampNumber(data.Flask, "Charges", 0, data.Flask.MaxCharges, corrections, "Flask")
	clampNumber(data.Tower, "HighestCleared", 0, GameConfig.Tower.Floors, corrections, "Tower")
	clampNumber(data.Inventory, "NextUid", 1, 1e9, corrections, "Inventory")

	-- inventory instances
	local itemCount = 0
	for uid, inst in data.Inventory.Items do
		if type(uid) ~= "string" or type(inst) ~= "table" or type(inst.Id) ~= "string" or not Items[inst.Id] or Items[inst.Id].Stackable then
			note(corrections, "removed invalid item " .. tostring(uid))
			data.Inventory.Items[uid] = nil
		else
			itemCount += 1
			if not isFiniteNumber(inst.Upgrade) then
				inst.Upgrade = 0
			end
			inst.Upgrade = math.max(0, math.floor(inst.Upgrade))
			-- uid counter must stay ahead of every existing uid
			local n = tonumber(string.match(uid, "^i(%d+)$"))
			if n and n >= data.Inventory.NextUid then
				data.Inventory.NextUid = n + 1
			end
		end
	end
	for id, count in data.Inventory.Stacks do
		if not Items[id] or not Items[id].Stackable or not isFiniteNumber(count) or count <= 0 then
			note(corrections, "removed invalid stack " .. tostring(id))
			data.Inventory.Stacks[id] = nil
		else
			data.Inventory.Stacks[id] = math.min(math.floor(count), GameConfig.Inventory.MaxStack)
		end
	end

	-- equipped references must point at owned, compatible items
	for slot, uid in data.Equipped do
		local inst = data.Inventory.Items[uid]
		if not inst then
			note(corrections, "unequipped missing item in " .. tostring(slot))
			data.Equipped[slot] = nil
		end
	end

	-- abilities
	for id in data.Abilities.Unlocked do
		if not Abilities[id] then
			data.Abilities.Unlocked[id] = nil
			note(corrections, "removed unknown ability " .. tostring(id))
		end
	end
	for _, slot in { "Slot1", "Slot2" } do
		local id = data.Abilities[slot]
		if id ~= "" and not data.Abilities.Unlocked[id] then
			data.Abilities[slot] = ""
			note(corrections, "cleared ability slot " .. slot)
		end
	end

	-- lost currency marker
	local lost = data.LostCurrency
	if lost ~= nil then
		if type(lost) ~= "table" or not isFiniteNumber(lost.Amount) or lost.Amount <= 0
			or not isFiniteNumber(lost.X) or not isFiniteNumber(lost.Y) or not isFiniteNumber(lost.Z) or not isFiniteNumber(lost.CreatedAt) then
			note(corrections, "removed invalid lost currency marker")
			data.LostCurrency = nil
		else
			lost.Amount = math.min(math.floor(lost.Amount), GameConfig.Currency.MaxCarried)
		end
	end

	-- receipts list must be an array of strings
	local receipts = data.Purchases.ProcessedReceipts
	local cleaned = {}
	for _, r in receipts do
		if type(r) == "string" then
			table.insert(cleaned, r)
		end
	end
	while #cleaned > GameConfig.Save.ProcessedReceiptHistory do
		table.remove(cleaned, 1)
	end
	data.Purchases.ProcessedReceipts = cleaned

	data.Corrections = corrections
	return data, corrections
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">ProgressionCore</string>
            <string name="Source"><![CDATA[--[[
	ProgressionCore
	Class selection, XP/levels, attribute allocation and ability unlocks.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Classes = require(Shared.Config.Classes)
local Abilities = require(Shared.Config.Abilities)
local Formulas = require(Shared.Logic.Formulas)
local InventoryCore = require(script.Parent.InventoryCore)

local ProgressionCore = {}

function ProgressionCore.chooseClass(profile, className)
	if type(className) ~= "string" or not Classes[className] then
		return false, "UnknownClass"
	end
	if profile.Class ~= "" then
		return false, "AlreadyChosen"
	end
	local class = Classes[className]
	profile.Class = className
	for name, value in class.Attributes do
		profile.Attributes[name] = value
	end
	local loadout = class.Loadout
	local function giveAndEquip(itemId, slot)
		local ok, res = InventoryCore.addItem(profile, itemId, 1)
		if ok and res.Uids[1] then
			InventoryCore.equip(profile, res.Uids[1], slot)
		end
	end
	if loadout.Weapon then
		giveAndEquip(loadout.Weapon, "Weapon")
	end
	if loadout.Offhand then
		giveAndEquip(loadout.Offhand, "Offhand")
	end
	for slot, itemId in loadout.Armor or {} do
		giveAndEquip(itemId, slot)
	end
	for itemId, amount in class.Items or {} do
		InventoryCore.addItem(profile, itemId, amount, true)
	end
	for _, abilityId in class.Abilities do
		local def = Abilities[abilityId]
		if def and def.UnlockLevel <= profile.Level then
			profile.Abilities.Unlocked[abilityId] = true
		end
	end
	profile.Abilities.Slot1 = class.Abilities[1] or ""
	profile.Abilities.Slot2 = ""
	return true, className
end

-- Class abilities whose UnlockLevel has been reached. Returns newly unlocked ids.
function ProgressionCore.unlockLevelAbilities(profile)
	local unlocked = {}
	local class = Classes[profile.Class]
	if not class then
		return unlocked
	end
	for _, abilityId in class.Abilities do
		local def = Abilities[abilityId]
		if def and def.UnlockLevel <= profile.Level and not profile.Abilities.Unlocked[abilityId] then
			profile.Abilities.Unlocked[abilityId] = true
			table.insert(unlocked, abilityId)
			if profile.Abilities.Slot2 == "" and profile.Abilities.Slot1 ~= abilityId then
				profile.Abilities.Slot2 = abilityId
			end
		end
	end
	return unlocked
end

-- Grants XP and levels up. Returns { Gained = xp, Levels = n, NewAbilities = {...} }
function ProgressionCore.grantXp(profile, amount)
	local result = { Gained = 0, Levels = 0, NewAbilities = {} }
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge then
		return result
	end
	amount = math.floor(amount)
	local maxLevel = GameConfig.Level.Max
	if profile.Level >= maxLevel then
		return result
	end
	profile.Xp += amount
	result.Gained = amount
	while profile.Level < maxLevel do
		local need = Formulas.xpToNext(profile.Level)
		if profile.Xp < need then
			break
		end
		profile.Xp -= need
		profile.Level += 1
		profile.UnspentPoints += GameConfig.Level.PointsPerLevel
		result.Levels += 1
	end
	if profile.Level >= maxLevel then
		profile.Xp = 0
	end
	if result.Levels > 0 then
		result.NewAbilities = ProgressionCore.unlockLevelAbilities(profile)
	end
	return result
end

-- allocations: { [attribute] = points }. All-or-nothing.
function ProgressionCore.allocate(profile, allocations)
	if type(allocations) ~= "table" then
		return false, "InvalidRequest"
	end
	local total = 0
	for attr, points in allocations do
		if not table.find(GameConfig.Attributes.List, attr) then
			return false, "UnknownAttribute"
		end
		if type(points) ~= "number" or points ~= points or points < 0 or math.floor(points) ~= points then
			return false, "InvalidPoints"
		end
		if profile.Attributes[attr] + points > GameConfig.Attributes.Max then
			return false, "AttributeCap"
		end
		total += points
	end
	if total <= 0 then
		return false, "NothingToSpend"
	end
	if total > profile.UnspentPoints then
		return false, "NotEnoughPoints"
	end
	for attr, points in allocations do
		profile.Attributes[attr] += points
	end
	profile.UnspentPoints -= total
	return true, total
end

function ProgressionCore.unlockAbility(profile, abilityId: string): boolean
	if not Abilities[abilityId] or profile.Abilities.Unlocked[abilityId] then
		return false
	end
	profile.Abilities.Unlocked[abilityId] = true
	return true
end

function ProgressionCore.setAbilitySlot(profile, slot, abilityId)
	if slot ~= "Slot1" and slot ~= "Slot2" then
		return false, "InvalidSlot"
	end
	if abilityId == "" then
		profile.Abilities[slot] = ""
		return true, slot
	end
	if type(abilityId) ~= "string" or not profile.Abilities.Unlocked[abilityId] then
		return false, "NotUnlocked"
	end
	local other = if slot == "Slot1" then "Slot2" else "Slot1"
	if profile.Abilities[other] == abilityId then
		profile.Abilities[other] = profile.Abilities[slot]
	end
	profile.Abilities[slot] = abilityId
	return true, slot
end

return ProgressionCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PromoCore</string>
            <string name="Source"><![CDATA[--[[
	PromoCore
	Pure promo-code logic: code lookup, per-character redemption rules and the admin grants
	(unlock all, max upgrades, all items, all customisations). The global use limit is
	enforced separately by PromoService with an atomic DataStore counter.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Abilities = require(Shared.Config.Abilities)
local Cosmetics = require(Shared.Config.Cosmetics)
local Bosses = require(Shared.Config.Bosses)
local Achievements = require(Shared.Config.Achievements)
local Quests = require(Shared.Config.Quests)
local World = require(Shared.Config.World)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Logic.Formulas)
local InventoryCore = require(script.Parent.InventoryCore)

local PromoCore = {}

function PromoCore.normalize(text): string?
	if type(text) ~= "string" or #text > 64 then
		return nil
	end
	local s = string.upper((string.gsub(text, "%s+", "")))
	if s == "" then
		return nil
	end
	return s
end

-- Returns codeDef or nil.
function PromoCore.find(codes, text)
	local norm = PromoCore.normalize(text)
	if not norm then
		return nil
	end
	for _, def in codes do
		if string.upper(def.Code) == norm then
			return def
		end
	end
	return nil
end

-- Per-character checks (does not touch the global counter).
function PromoCore.check(profile, def, now: number): (boolean, string?)
	if not def then
		return false, "InvalidCode"
	end
	if def.Expires and now > def.Expires then
		return false, "CodeExpired"
	end
	if profile.RedeemedCodes[def.Id] then
		return false, "AlreadyRedeemed"
	end
	if def.Kind == "Admin" and profile.Admin.Granted then
		return false, "AlreadyRedeemed"
	end
	return true, nil
end

function PromoCore.markRedeemed(profile, def)
	profile.RedeemedCodes[def.Id] = true
	if def.Kind == "Admin" then
		profile.Admin.Granted = true
	end
end

-- ===================================================================== admin grants
function PromoCore.unlockAll(profile)
	profile.Tower.HighestCleared = GameConfig.Tower.Floors
	for _, cp in World.Checkpoints do
		profile.Checkpoints.Activated[cp.Id] = true
	end
	for _, loc in World.Locations do
		profile.Discovered[loc.Id] = true
	end
	for id in Abilities do
		profile.Abilities.Unlocked[id] = true
	end
	profile.Flask.MaxCharges = GameConfig.Flask.MaxCharges
	profile.Flask.Charges = GameConfig.Flask.MaxCharges
end

function PromoCore.allCosmetics(profile)
	for id in Cosmetics do
		profile.Cosmetics.Owned[id] = true
	end
	for _, b in Bosses.List do
		if b.Rewards.FirstClear.Title then
			profile.Titles[b.Rewards.FirstClear.Title] = true
		end
	end
	for _, a in Achievements do
		if a.Reward and a.Reward.Title then
			profile.Titles[a.Reward.Title] = true
		end
	end
	for _, q in Quests do
		if q.Rewards.Title then
			profile.Titles[q.Rewards.Title] = true
		end
	end
	profile.Titles["Administrator"] = true
end

-- One of every piece of equipment not yet owned, plus stacks of consumables and materials.
function PromoCore.allItems(profile)
	local added = 0
	local ids = {}
	for id in Items do
		if string.sub(id, 1, 1) ~= "_" then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	for _, id in ids do
		local def = Items[id]
		if def.Stackable then
			local want = if def.Kind == "Consumable" then GameConfig.Consumables.MaxStack else 99
			local have = InventoryCore.stackCount(profile, id)
			if have < want then
				local ok, res = InventoryCore.addItem(profile, id, want - have, true)
				if ok then
					added += res.Added
				end
			end
		elseif not InventoryCore.ownsItemId(profile, id) then
			local ok, res = InventoryCore.addItem(profile, id, 1, true)
			if ok then
				added += res.Added
			end
		end
	end
	return added
end

-- Every owned weapon, shield and armour piece to its maximum upgrade level.
function PromoCore.maxUpgrades(profile)
	local n = 0
	for _, inst in profile.Inventory.Items do
		local path = Formulas.upgradePath(Items[inst.Id])
		if path and inst.Upgrade < path.Max then
			inst.Upgrade = path.Max
			n += 1
		end
	end
	return n
end

return PromoCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">QuestCore</string>
            <string name="Source"><![CDATA[--[[
	QuestCore
	Quest acceptance, progress tracking and turn-in. Progress for Kill/Training objectives is
	counted only while the quest is active; Boss/Discover/Secret/Upgrade objectives are evaluated
	from profile state so they can never desync.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local World = require(Shared.Config.World)
local InventoryCore = require(script.Parent.InventoryCore)

local QuestCore = {}

local secretSet = {}
for _, loc in World.Locations do
	if loc.Secret then
		secretSet[loc.Id] = true
	end
end

function QuestCore.status(profile, questId: string): string
	if profile.Quests.Completed[questId] then
		return "Completed"
	elseif profile.Quests.Active[questId] then
		return "Active"
	end
	local q = Quests[questId]
	if not q then
		return "Unknown"
	end
	for _, req in q.Requires do
		if not profile.Quests.Completed[req] then
			return "Locked"
		end
	end
	return "Available"
end

function QuestCore.accept(profile, questId)
	if type(questId) ~= "string" or not Quests[questId] then
		return false, "UnknownQuest"
	end
	local status = QuestCore.status(profile, questId)
	if status ~= "Available" then
		return false, status
	end
	profile.Quests.Active[questId] = { Progress = 0 }
	return true, questId
end

function QuestCore.abandon(profile, questId)
	if not profile.Quests.Active[questId] then
		return false, "NotActive"
	end
	profile.Quests.Active[questId] = nil
	return true, questId
end

local function countTable(t)
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Returns current, goal for a quest.
function QuestCore.progress(profile, questId: string): (number, number)
	local q = Quests[questId]
	if not q then
		return 0, 1
	end
	local o = q.Objective
	local active = profile.Quests.Active[questId]
	if o.Type == "Kill" or o.Type == "Training" then
		return math.min(active and active.Progress or 0, o.Count), o.Count
	elseif o.Type == "Boss" then
		return (profile.Tower.HighestCleared >= o.Floor) and 1 or 0, 1
	elseif o.Type == "Discover" then
		if o.Location then
			return profile.Discovered[o.Location] and 1 or 0, 1
		end
		return math.min(countTable(profile.Discovered), o.Count), o.Count
	elseif o.Type == "Secret" then
		local n = 0
		for id in profile.Discovered do
			if secretSet[id] then
				n += 1
			end
		end
		return math.min(n, o.Count), o.Count
	elseif o.Type == "Upgrade" then
		return math.min(InventoryCore.highestUpgrade(profile), o.Level), o.Level
	elseif o.Type == "Collect" then
		return math.min(InventoryCore.stackCount(profile, o.Item), o.Count), o.Count
	end
	return 0, 1
end

function QuestCore.isComplete(profile, questId: string): boolean
	if not profile.Quests.Active[questId] then
		return false
	end
	local cur, goal = QuestCore.progress(profile, questId)
	return cur >= goal
end

-- event = { Type = "Kill", Enemy = id } | { Type = "Training" }
-- Returns list of quest ids whose progress changed.
function QuestCore.onEvent(profile, event)
	local changed = {}
	for questId, state in profile.Quests.Active do
		local q = Quests[questId]
		if q then
			local o = q.Objective
			if o.Type == event.Type and (o.Type ~= "Kill" or o.Enemy == event.Enemy) then
				if state.Progress < o.Count then
					state.Progress += 1
					table.insert(changed, questId)
				end
			end
		end
	end
	return changed
end

-- Validates completion, consumes Collect items, marks completed. Returns ok, rewards.
function QuestCore.turnIn(profile, questId)
	if type(questId) ~= "string" or not Quests[questId] then
		return false, "UnknownQuest"
	end
	if not QuestCore.isComplete(profile, questId) then
		return false, "NotComplete"
	end
	local q = Quests[questId]
	if q.Objective.Type == "Collect" then
		local ok = InventoryCore.removeStack(profile, q.Objective.Item, q.Objective.Count)
		if not ok then
			return false, "NotComplete"
		end
	end
	profile.Quests.Active[questId] = nil
	profile.Quests.Completed[questId] = true
	return true, q.Rewards
end

return QuestCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">ReceiptCore</string>
            <string name="Source"><![CDATA[--[[
	ReceiptCore
	Idempotent Developer Product receipt handling (MarketplaceService.ProcessReceipt).

	process() returns one of:
	  "Granted"        newly granted; caller must SAVE successfully before returning PurchaseGranted
	  "AlreadyGranted" PurchaseId was processed before; return PurchaseGranted without re-granting
	  "Unknown"        product id is not configured; return NotProcessedYet
	Rewards are only ever cosmetics; nothing here affects combat power.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Products = require(Shared.Config.Products)
local Cosmetics = require(Shared.Config.Cosmetics)

local ReceiptCore = {}

function ReceiptCore.findProduct(productId: number)
	if type(productId) ~= "number" or productId == 0 then
		return nil, nil
	end
	for key, p in Products.DevProducts do
		if p.Id == productId then
			return key, p
		end
	end
	return nil, nil
end

function ReceiptCore.isProcessed(profile, purchaseId: string): boolean
	return table.find(profile.Purchases.ProcessedReceipts, purchaseId) ~= nil
end

function ReceiptCore.grant(profile, grant)
	local granted = {}
	local list = grant.Cosmetics or (grant.Cosmetic and { grant.Cosmetic }) or {}
	for _, id in list do
		if Cosmetics[id] then
			profile.Cosmetics.Owned[id] = true
			table.insert(granted, id)
		end
	end
	return granted
end

function ReceiptCore.process(profile, receipt)
	local purchaseId = tostring(receipt.PurchaseId)
	if ReceiptCore.isProcessed(profile, purchaseId) then
		return "AlreadyGranted", nil
	end
	local key, product = ReceiptCore.findProduct(receipt.ProductId)
	if not product then
		return "Unknown", nil
	end
	local granted = ReceiptCore.grant(profile, product.Grant)
	local list = profile.Purchases.ProcessedReceipts
	table.insert(list, purchaseId)
	while #list > GameConfig.Save.ProcessedReceiptHistory do
		table.remove(list, 1)
	end
	profile.Purchases.Products[key] = (profile.Purchases.Products[key] or 0) + 1
	return "Granted", granted
end

return ReceiptCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">TrainingCore</string>
            <string name="Source"><![CDATA[--[[
	TrainingCore
	Server-measured training sessions and capped rewards.

	A session is created when the player starts a challenge; the server feeds it events it
	observed itself (rep presses with server timestamps, validated dummy hits, attacks avoided
	or parried, course posts touched). Completion is decided here, never by the client.

	Reward caps:
	  * Cooldown per challenge.
	  * DailyPointCap training points per real-time day.
	  * Every PointsPerBonus points in an attribute grants +1 bonus, up to
	    MaxTrainingBonusPerAttribute (+5). Repetition can never produce unlimited stats.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Training = require(Shared.Config.Training)

local TrainingCore = {}

function TrainingCore.day(now: number): number
	return math.floor(now / GameConfig.Training.DailyResetSeconds)
end

function TrainingCore.cooldownRemaining(profile, challengeId: string, now: number): number
	local def = Training[challengeId]
	if not def then
		return math.huge
	end
	local last = profile.TrainingCooldowns[challengeId] or -math.huge
	return math.max(0, last + def.Cooldown - now)
end

function TrainingCore.start(profile, challengeId, now: number)
	local def = Training[challengeId]
	if not def then
		return nil, "Unknown"
	end
	if profile.Class == "" then
		return nil, "NoClass"
	end
	if TrainingCore.cooldownRemaining(profile, challengeId, now) > 0 then
		return nil, "Cooldown"
	end
	return {
		Id = challengeId,
		Def = def,
		StartedAt = now,
		Count = 0,
		Failures = 0,
		LastRep = nil,
		Posts = {},
		State = "Running",
	}, nil
end

local function finish(session, success: boolean)
	session.State = if success then "Success" else "Failed"
	return session.State
end

-- Called once per server tick or event; returns session.State.
function TrainingCore.tick(session, now: number)
	if session.State ~= "Running" then
		return session.State
	end
	local def = session.Def
	if def.TimeLimit and now - session.StartedAt > def.TimeLimit then
		return finish(session, false)
	end
	if def.Kind == "Reps" and session.LastRep and now - session.LastRep > def.MaxInterval then
		return finish(session, false)
	end
	return session.State
end

-- Reps: a press at server time `now`. Too-fast presses (macro/autoclick) fail the set.
function TrainingCore.rep(session, now: number, hasStamina: boolean)
	if session.State ~= "Running" or session.Def.Kind ~= "Reps" then
		return session.State
	end
	local def = session.Def
	if session.LastRep then
		local dt = now - session.LastRep
		if dt < def.MinInterval or dt > def.MaxInterval then
			return finish(session, false)
		end
	end
	if not hasStamina then
		return finish(session, false)
	end
	session.LastRep = now
	session.Count += 1
	if session.Count >= def.Reps then
		return finish(session, true)
	end
	return session.State
end

-- Hits: a server-validated hit on the dummy.
function TrainingCore.hit(session, now: number)
	if session.State ~= "Running" or session.Def.Kind ~= "Hits" then
		return session.State
	end
	if now - session.StartedAt > session.Def.TimeLimit then
		return finish(session, false)
	end
	session.Count += 1
	if session.Count >= session.Def.Hits then
		return finish(session, true)
	end
	return session.State
end

-- Avoid/Parry drills: called after each drill attack resolves.
-- outcome: "Hit" | "Avoided" | "Blocked" | "Parried"
function TrainingCore.drillAttack(session, outcome: string)
	if session.State ~= "Running" then
		return session.State
	end
	local def = session.Def
	if def.Kind == "Avoid" then
		if outcome == "Avoided" or outcome == "Parried" then
			session.Count += 1
		else
			session.Failures += 1
		end
	elseif def.Kind == "Parry" then
		if outcome == "Parried" then
			session.Count += 1
		else
			session.Failures += 1
		end
	else
		return session.State
	end
	if session.Count >= def.Required then
		return finish(session, true)
	end
	if session.Failures > def.Attacks - def.Required then
		return finish(session, false)
	end
	return session.State
end

-- Course: posts must be touched in order 1..N.
function TrainingCore.post(session, index: number, now: number)
	if session.State ~= "Running" or session.Def.Kind ~= "Course" then
		return session.State
	end
	if now - session.StartedAt > session.Def.TimeLimit then
		return finish(session, false)
	end
	if index == session.Count + 1 then
		session.Count = index
		if session.Count >= session.Def.Posts then
			return finish(session, true)
		end
	end
	return session.State
end

function TrainingCore.spar(session, won: boolean)
	if session.State ~= "Running" or session.Def.Kind ~= "Spar" then
		return session.State
	end
	return finish(session, won)
end

-- Applies rewards for a successful session. Returns { Xp, Points, BonusGained, Capped }.
function TrainingCore.reward(profile, session, now: number)
	local result = { Xp = 0, Points = 0, BonusGained = 0, Capped = false }
	if session.State ~= "Success" or session.Rewarded then
		return result
	end
	session.Rewarded = true
	local def = session.Def
	profile.TrainingCooldowns[session.Id] = now
	result.Xp = math.floor(def.Xp * (1 + profile.Level * 0.05))

	local today = TrainingCore.day(now)
	if profile.TrainingDaily.Day ~= today then
		profile.TrainingDaily.Day = today
		profile.TrainingDaily.Points = 0
	end
	local room = math.max(0, GameConfig.Training.DailyPointCap - profile.TrainingDaily.Points)
	local attr = def.Attribute
	local bonus = profile.TrainingBonus[attr] or 0
	if bonus >= GameConfig.Training.MaxTrainingBonusPerAttribute then
		room = 0
	end
	local points = math.min(def.Points, room)
	result.Capped = points < def.Points
	if points > 0 then
		profile.TrainingDaily.Points += points
		local total = (profile.TrainingPoints[attr] or 0) + points
		while total >= GameConfig.Training.PointsPerBonus and bonus < GameConfig.Training.MaxTrainingBonusPerAttribute do
			total -= GameConfig.Training.PointsPerBonus
			bonus += 1
			result.BonusGained += 1
		end
		if bonus >= GameConfig.Training.MaxTrainingBonusPerAttribute then
			total = 0
		end
		profile.TrainingPoints[attr] = total
		profile.TrainingBonus[attr] = bonus
	end
	result.Points = points
	return result
end

return TrainingCore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="52">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">AntiCheatService</string>
            <string name="Source"><![CDATA[--[[
	AntiCheatService
	Lightweight movement sanity check. Characters are client-simulated on Roblox, so we sample
	horizontal speed once per window and, after repeated impossible movement, return the
	player to their last valid position. Server-initiated teleports are whitelisted briefly.
	(Combat, economy and progression are already fully server-authoritative.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local AntiCheatService = {}
local S
local tracking = {}

function AntiCheatService.Init(services)
	S = services
end

function AntiCheatService.AllowTeleport(player: Player)
	local t = tracking[player]
	if t then
		t.GraceUntil = os.clock() + 3
		t.LastPos = nil
	else
		tracking[player] = { GraceUntil = os.clock() + 3, Violations = 0 }
	end
end

function AntiCheatService.Start()
	local cfg = GameConfig.AntiCheat
	S.PlayerStateService.CharacterReady:Connect(function(player)
		AntiCheatService.AllowTeleport(player)
	end)
	task.spawn(function()
		while true do
			task.wait(cfg.SampleWindow)
			for player, rt in S.PlayerStateService.All() do
				local root = rt.Root
				if root and root.Parent then
					local t = tracking[player] or { Violations = 0, GraceUntil = 0 }
					tracking[player] = t
					local pos = root.Position
					if t.LastPos and os.clock() > t.GraceUntil then
						local flat = Vector3.new(pos.X - t.LastPos.X, 0, pos.Z - t.LastPos.Z).Magnitude
						if flat / cfg.SampleWindow > cfg.MaxHorizontalSpeed then
							t.Violations += 1
							if t.Violations >= cfg.ViolationsBeforeReset and t.ValidPos then
								warn(("[AntiCheat] %s moved %.0f studs/s; resetting position"):format(player.Name, flat / cfg.SampleWindow))
								root.CFrame = CFrame.new(t.ValidPos)
								t.Violations = 0
								pos = t.ValidPos
							end
						else
							t.Violations = math.max(0, t.Violations - 1)
							t.ValidPos = pos
						end
					else
						t.ValidPos = pos
					end
					t.LastPos = pos
				end
			end
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		tracking[p] = nil
	end)
end

return AntiCheatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">AttackExecutor</string>
            <string name="Source"><![CDATA[--[[
	AttackExecutor
	Runs an enemy/boss attack definition (Config/Attacks.luau) against players:
	telegraph -> windup (interruptible by stagger/death) -> resolve -> recovery.
	Positions are locked when the telegraph appears, so what the player sees is exactly what
	gets checked. Used by EnemyService, BossService and TrainingService.

	attacker = {
	  Entity, Model, Root, Humanoid, Shoulder, BaseDamage, Floor?, DamageScale?,
	  Targets(): { Player }            -- eligible victims
	  ArenaCenter?: Vector3, ArenaRadius?: number
	  OnSummon?(enemyId, count, maxAlive, position)
	  OnHitPlayer?(player, outcome)
	  OnLand?(), OnTakeoff?()          -- airborne bosses
	  Airborne?: bool
	}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Geometry = require(Shared.Logic.Geometry)
local BossBrain = require(script.Parent.Parent.Core.BossBrain)
local EntityModels = require(script.Parent.EntityModels)

local AttackExecutor = {}

local S
local VERTICAL_TOLERANCE = 12

function AttackExecutor.Init(services)
	S = services
end
function AttackExecutor.Start() end

local function now()
	return workspace:GetServerTimeNow()
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include

function AttackExecutor.GroundY(pos: Vector3, fallback: number?): number
	local map = workspace:FindFirstChild("Map")
	local list = { workspace.Terrain }
	if map then
		table.insert(list, map)
	end
	local arenas = workspace:FindFirstChild("Arenas")
	if arenas then
		table.insert(list, arenas)
	end
	groundParams.FilterDescendantsInstances = list
	local hit = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -80, 0), groundParams)
	if hit then
		return hit.Position.Y
	end
	return fallback or (pos.Y - 3)
end

local function interrupted(attacker): boolean
	local e = attacker.Entity
	if not e or not e.Alive or e.Target.Dead then
		return true
	end
	if attacker.Model == nil or attacker.Model.Parent == nil then
		return true
	end
	return now() < e.Target.StaggeredUntil
end

-- Waits `t` seconds; returns false if interrupted.
local function waitInterruptible(attacker, t: number): boolean
	local deadline = os.clock() + t
	while os.clock() < deadline do
		if interrupted(attacker) then
			return false
		end
		task.wait(math.min(0.05, deadline - os.clock()))
	end
	return not interrupted(attacker)
end

local function targetPos(player: Player?): Vector3?
	if not player then
		return nil
	end
	local rt = S.PlayerStateService.Get(player)
	if rt and rt.Root and rt.Root.Parent and rt.Combat and not rt.Combat.Dead then
		return rt.Root.Position
	end
	return nil
end

local function face(attacker, pos: Vector3)
	local root = attacker.Root
	if not root or not root.Parent then
		return
	end
	local flat = Vector3.new(pos.X, root.Position.Y, pos.Z)
	if (flat - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
end

local function hitSpec(attacker, step)
	return {
		Damage = attacker.BaseDamage * (step.Damage or 1) * (attacker.DamageScale or 1),
		DamageType = step.DamageType or "Physical",
		Poise = step.Poise or 20,
		Parryable = step.Parryable == true,
		Blockable = step.Blockable ~= false,
		Status = step.Status,
		Attacker = attacker,
		Name = step.Name,
	}
end

local function damagePlayers(attacker, step, test: (Vector3) -> boolean, sourcePos: Vector3, groundY: number)
	local spec = hitSpec(attacker, step)
	for _, plr in attacker.Targets() do
		local pos = targetPos(plr)
		if pos and math.abs(pos.Y - groundY) <= VERTICAL_TOLERANCE + 3 and test(pos) then
			S.CombatService.QueueHostileHit(plr, spec, sourcePos)
		end
	end
end

local function moveKinematic(attacker, toPos: Vector3, duration: number, arcHeight: number)
	local root = attacker.Root
	if not root or not root.Parent then
		return
	end
	local from = root.Position
	local look = Vector3.new(toPos.X - from.X, 0, toPos.Z - from.Z)
	root.Anchored = true
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local p = from:Lerp(toPos, a) + Vector3.new(0, arcHeight * 4 * a * (1 - a), 0)
		if look.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(p, p + look)
		else
			root.CFrame = CFrame.new(p) * root.CFrame.Rotation
		end
		if a >= 1 or not root.Parent then
			break
		end
		task.wait()
	end
	-- a boss that died mid-move stays anchored for its death fade
	if root.Parent and attacker.Entity and attacker.Entity.Alive then
		root.Anchored = false
		-- anchoring resets network ownership; keep AI physics on the server
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
end

local function clampToArena(attacker, pos: Vector3): Vector3
	local c, r = attacker.ArenaCenter, attacker.ArenaRadius
	if not c or not r then
		return pos
	end
	local d = Vector3.new(pos.X - c.X, 0, pos.Z - c.Z)
	local limit = r - 8
	if d.Magnitude > limit then
		d = d.Unit * limit
	end
	return Vector3.new(c.X + d.X, pos.Y, c.Z + d.Z)
end

-- Executes one step. Returns false if interrupted.
local function runStep(attacker, step, isFollowUp: boolean, primary: Player?): boolean
	local windup, _ = BossBrain.timing(step, attacker.Floor, isFollowUp)
	local root = attacker.Root
	if not root or not root.Parent then
		return false
	end
	local tpos = targetPos(primary) or (root.Position + root.CFrame.LookVector * 10)
	if attacker.Humanoid then
		attacker.Humanoid:MoveTo(root.Position)
		attacker.Humanoid.AutoRotate = false
	end
	face(attacker, tpos)
	local origin = root.Position
	local groundY = attacker.GroundY or AttackExecutor.GroundY(origin)
	if attacker.Airborne and not (step.Lands or step.Shape == "Dash" or step.Shape == "Leap") then
		-- airborne attackers telegraph from directly beneath them
		origin = Vector3.new(origin.X, groundY, origin.Z)
	end
	local dir = Vector3.new(tpos.X - origin.X, 0, tpos.Z - origin.Z)
	dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local kind = S.TelegraphService.KindFor(step)
	local shape = step.Shape
	local ground = Vector3.new(origin.X, groundY, origin.Z)

	EntityModels.windup(attacker.Shoulder, windup)

	if shape == "Cone" then
		S.TelegraphService.Show({ Shape = "Cone", Origin = ground, Dir = dir, Range = step.Range, Arc = step.Arc, Kind = kind, GroundY = groundY }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		EntityModels.strike(attacker.Shoulder)
		damagePlayers(attacker, step, function(p)
			return Geometry.inCone(ground.X, ground.Z, dir.X, dir.Z, p.X, p.Z, step.Range, step.Arc, 1.2)
		end, origin, groundY)
	elseif shape == "Circle" then
		local c = ground + dir * (step.Offset or 0)
		S.TelegraphService.Show({ Shape = "Circle", Center = c, Radius = step.Radius, Kind = kind }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		EntityModels.strike(attacker.Shoulder)
		S.TelegraphService.Impact(c, step.Radius)
		damagePlayers(attacker, step, function(p)
			return Geometry.inCircle(c.X, c.Z, p.X, p.Z, step.Radius, 1)
		end, origin, groundY)
	elseif shape == "Line" then
		local o = ground
		local d = dir
		if step.FromEdge and attacker.ArenaCenter then
			local ang = math.random() * math.pi * 2
			d = Vector3.new(math.cos(ang), 0, math.sin(ang))
			o = Vector3.new(attacker.ArenaCenter.X, groundY, attacker.ArenaCenter.Z) - d * (attacker.ArenaRadius or 70)
			local side = Vector3.new(-d.Z, 0, d.X)
			o += side * (math.random() * 2 - 1) * (attacker.ArenaRadius or 70) * 0.6
		end
		S.TelegraphService.Show({ Shape = "Line", Origin = o, Dir = d, Length = step.Length, Width = step.Width, Kind = kind, GroundY = groundY }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		EntityModels.strike(attacker.Shoulder)
		damagePlayers(attacker, step, function(p)
			return Geometry.inLine(o.X, o.Z, d.X, d.Z, p.X, p.Z, step.Length, step.Width, 1)
		end, o, groundY)
	elseif shape == "Ring" then
		S.TelegraphService.Show({ Shape = "Ring", Center = ground, Inner = step.Inner, Outer = step.Outer, Kind = kind }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		S.TelegraphService.Impact(ground, step.Outer * 0.5)
		damagePlayers(attacker, step, function(p)
			return Geometry.inRing(ground.X, ground.Z, p.X, p.Z, step.Inner, step.Outer, 0.5)
		end, origin, groundY)
	elseif shape == "Dash" then
		local length = math.min(step.Length, (Vector3.new(tpos.X, 0, tpos.Z) - Vector3.new(origin.X, 0, origin.Z)).Magnitude + 6)
		length = math.max(length, 8)
		S.TelegraphService.Show({ Shape = "Line", Origin = ground, Dir = dir, Length = length, Width = step.Width, Kind = kind, GroundY = groundY }, windup)
		if attacker.Airborne and attacker.OnLand then
			attacker.OnLand()
		end
		if not waitInterruptible(attacker, windup) then
			return false
		end
		local dest = clampToArena(attacker, Vector3.new(origin.X, root.Position.Y, origin.Z) + dir * length)
		if attacker.Airborne then
			dest = Vector3.new(dest.X, groundY + (attacker.Model:GetAttribute("Height") or 5) * 0.5, dest.Z)
		end
		moveKinematic(attacker, dest, 0.25, 0)
		damagePlayers(attacker, step, function(p)
			return Geometry.inLine(ground.X, ground.Z, dir.X, dir.Z, p.X, p.Z, length, step.Width, 1)
		end, origin, groundY)
		if step.LeaveHazard then
			for i = 1, 3 do
				local pt = ground + dir * (length * i / 4)
				AttackExecutor.SpawnHazard(attacker, { Radius = 4, Duration = 4, TickDamage = 0.12, DamageType = "Fire", Status = step.Status }, pt)
			end
		end
	elseif shape == "Leap" then
		local landing = clampToArena(attacker, Vector3.new(tpos.X, groundY, tpos.Z))
		S.TelegraphService.Show({ Shape = "Circle", Center = landing, Radius = step.Radius, Kind = kind }, windup)
		if attacker.Airborne and attacker.OnLand then
			attacker.OnLand()
		end
		local rootOffset = root.Position.Y - groundY
		if attacker.Airborne then
			rootOffset = (attacker.Model:GetAttribute("Height") or 5) * 0.5
		end
		-- hang in the air briefly, then fall on the marked spot at the end of the windup
		if not waitInterruptible(attacker, windup * 0.45) then
			return false
		end
		moveKinematic(attacker, landing + Vector3.new(0, rootOffset, 0), windup * 0.55, 18)
		if interrupted(attacker) then
			return false
		end
		S.TelegraphService.Impact(landing, step.Radius)
		damagePlayers(attacker, step, function(p)
			return Geometry.inCircle(landing.X, landing.Z, p.X, p.Z, step.Radius, 1)
		end, landing, groundY)
	elseif shape == "Teleport" then
		local dest
		if step.Away then
			local away = Vector3.new(origin.X - tpos.X, 0, origin.Z - tpos.Z)
			away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)
			dest = tpos + away * (step.Distance or 20)
		else
			local ang = math.random() * math.pi * 2
			dest = tpos + Vector3.new(math.cos(ang), 0, math.sin(ang)) * (step.Distance or 12)
		end
		dest = clampToArena(attacker, Vector3.new(dest.X, groundY, dest.Z))
		S.TelegraphService.Show({ Shape = "Circle", Center = dest, Radius = 4, Kind = if (step.Damage or 0) > 0 then kind else "Block" }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		local rootOffset = root.Position.Y - groundY
		attacker.Model:PivotTo(CFrame.lookAt(dest + Vector3.new(0, rootOffset, 0), Vector3.new(tpos.X, dest.Y + rootOffset, tpos.Z)))
		S.TelegraphService.Impact(dest, 4, Color3.fromRGB(150, 120, 255))
		if (step.Damage or 0) > 0 then
			damagePlayers(attacker, step, function(p)
				return Geometry.inCircle(dest.X, dest.Z, p.X, p.Z, 6, 1)
			end, dest, groundY)
		end
	elseif shape == "Projectile" then
		-- telegraph: a short line showing the firing direction
		S.TelegraphService.Show({ Shape = "Line", Origin = ground, Dir = dir, Length = 10, Width = 1.5, Kind = kind, GroundY = groundY }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		EntityModels.strike(attacker.Shoulder)
		local count = step.Count or 1
		local spread = math.rad(step.Spread or 0)
		local spec = hitSpec(attacker, step)
		local primaryRt = primary and S.PlayerStateService.Get(primary)
		for i = 1, count do
			local ang = if count > 1 then -spread / 2 + spread * ((i - 1) / (count - 1)) else 0
			local base = math.atan2(dir.X, dir.Z) + ang
			local d = Vector3.new(math.sin(base), 0, math.cos(base))
			local start = root.Position + d * 2 + Vector3.new(0, 1, 0)
			if attacker.Airborne then
				local aim = (tpos - start)
				d = if aim.Magnitude > 0.1 then (Vector3.new(math.sin(base), 0, math.cos(base)) * aim.Magnitude + Vector3.new(0, aim.Y, 0)).Unit else d
			end
			S.ProjectileService.Fire({
				Origin = start,
				Direction = d,
				Speed = step.Speed or 60,
				Radius = step.Radius or 2,
				Range = (step.MaxRange or 70) + 30,
				Color = if spec.DamageType == "Fire" then Color3.fromRGB(255, 120, 40) elseif spec.DamageType == "Magic" then Color3.fromRGB(140, 120, 255) else Color3.fromRGB(230, 220, 200),
				Hostile = true,
				IgnoreCharacters = true,
				HomingTarget = primaryRt and primaryRt.Root or nil,
				Homing = step.Homing or 0,
				OnHit = function(plr, pos)
					S.CombatService.QueueHostileHit(plr, spec, pos - d * 3)
				end,
			})
		end
	elseif shape == "Hazard" then
		local victims = attacker.Targets()
		local points = {}
		for i = 1, step.Count or 1 do
			local plr = victims[((i - 1) % math.max(1, #victims)) + 1]
			local p = targetPos(plr) or tpos
			local jitter = if i > #victims then Vector3.new(math.random(-12, 12), 0, math.random(-12, 12)) else Vector3.zero
			table.insert(points, clampToArena(attacker, Vector3.new(p.X, groundY, p.Z) + jitter))
		end
		for _, pt in points do
			S.TelegraphService.Show({ Shape = "Hazard", Center = pt, Radius = step.Radius, Kind = "Danger" }, windup)
		end
		if not waitInterruptible(attacker, windup) then
			return false
		end
		for _, pt in points do
			if (step.Damage or 0) > 0 then
				damagePlayers(attacker, step, function(p)
					return Geometry.inCircle(pt.X, pt.Z, p.X, p.Z, step.Radius, 0.5)
				end, pt, groundY)
			end
			if (step.Duration or 0) > 1 then
				AttackExecutor.SpawnHazard(attacker, step, pt)
			end
		end
	elseif shape == "Summon" then
		S.TelegraphService.Show({ Shape = "Circle", Center = ground, Radius = 6, Kind = "Block" }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		if attacker.OnSummon then
			attacker.OnSummon(step.Summon, step.Count or 1, step.MaxAlive or 4, ground)
		end
	elseif shape == "Pulse" then
		local c = attacker.ArenaCenter or ground
		local r = attacker.ArenaRadius or 60
		local cy = Vector3.new(c.X, groundY, c.Z)
		local zones = {}
		local count = step.SafeZones or 3
		-- seed safe zones near players (one per victim, up to the zone count) so a zone is always
		-- within sprinting distance; the rest are spread around the arena
		local victims = attacker.Targets()
		for i = 1, count do
			local plr = victims[i]
			local p = plr and targetPos(plr)
			local z
			if p then
				local ang = math.random() * math.pi * 2
				z = clampToArena(attacker, Vector3.new(p.X, groundY, p.Z) + Vector3.new(math.cos(ang), 0, math.sin(ang)) * (10 + math.random() * 10))
			else
				local ang = (i / count) * math.pi * 2 + math.random()
				z = cy + Vector3.new(math.cos(ang), 0, math.sin(ang)) * r * (0.35 + 0.3 * math.random())
			end
			table.insert(zones, Vector3.new(z.X, groundY, z.Z))
		end
		-- guarantee time to reach the nearest zone at sprint speed (24 studs/s) with margin
		for _, plr in victims do
			local p = targetPos(plr)
			if p then
				local nearest = math.huge
				for _, z in zones do
					nearest = math.min(nearest, Vector3.new(p.X - z.X, 0, p.Z - z.Z).Magnitude - step.SafeRadius)
				end
				windup = math.max(windup, math.max(0, nearest) / 20 + 0.6)
			end
		end
		S.TelegraphService.Show({ Shape = "Pulse", Center = cy, Radius = r, SafeZones = zones, SafeRadius = step.SafeRadius }, windup)
		if not waitInterruptible(attacker, windup) then
			return false
		end
		S.TelegraphService.Impact(cy, r * 0.6, Color3.fromRGB(255, 80, 60))
		damagePlayers(attacker, step, function(p)
			for _, z in zones do
				if Geometry.inCircle(z.X, z.Z, p.X, p.Z, step.SafeRadius, 0) then
					return false
				end
			end
			return true
		end, cy, groundY)
	elseif shape == "CounterStance" then
		local e = attacker.Entity
		local fired = false
		e.CounterStance = {
			Until = now() + windup,
			Reduction = attacker.CounterReduction or 0.85,
			Fired = false,
			OnCounter = function(player)
				fired = true
				local p = targetPos(player)
				if p then
					face(attacker, p)
				end
				local counter = {
					Shape = "Cone", Name = step.Name .. " (Counter)", Windup = step.CounterWindup or 0.45, Recovery = 0.4,
					Damage = step.Damage, Range = step.Range, Arc = step.Arc, Poise = 50, Parryable = true, Blockable = true,
				}
				runStep(attacker, counter, true, player)
			end,
		}
		if attacker.Model then
			attacker.Model:SetAttribute("CounterStance", true)
		end
		S.TelegraphService.Show({ Shape = "Ring", Center = ground, Inner = 2, Outer = 4, Kind = "Parry" }, windup)
		local deadline = os.clock() + windup
		while os.clock() < deadline and not fired and not interrupted(attacker) do
			task.wait(0.05)
		end
		if fired then
			-- let the counterattack (running on its own thread) finish before recovering
			task.wait((step.CounterWindup or 0.45) + 0.5)
		end
		e.CounterStance = nil
		if attacker.Model and attacker.Model.Parent then
			attacker.Model:SetAttribute("CounterStance", false)
		end
	end
	return true
end

function AttackExecutor.SpawnHazard(attacker, step, center: Vector3)
	local duration = step.Duration or 5
	local radius = step.Radius or 5
	S.TelegraphService.Hazard(center, radius, duration)
	local spec = hitSpec(attacker, step)
	spec.Damage = attacker.BaseDamage * (step.TickDamage or 0.15) * (attacker.DamageScale or 1)
	spec.Blockable = false
	spec.Parryable = false
	spec.Poise = 0
	spec.Tick = true
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			task.wait(0.6)
			if not attacker.Model or not attacker.Model.Parent then
				-- hazards outlive dead casters briefly, but stop if the arena is gone
				if attacker.ArenaGone and attacker.ArenaGone() then
					return
				end
			end
			for _, plr in attacker.Targets() do
				local p = targetPos(plr)
				if p and Geometry.inCircle(center.X, center.Z, p.X, p.Z, radius, 0.5) and math.abs(p.Y - center.Y) < 8 then
					S.CombatService.QueueHostileHit(plr, spec, center)
				end
			end
		end
	end)
end

-- Runs a full attack (single or combo). Yields. Returns true if completed.
function AttackExecutor.Run(attacker, attack, primary: Player?): boolean
	local steps = BossBrain.steps(attack)
	local ok = true
	for i, step in steps do
		if interrupted(attacker) then
			ok = false
			break
		end
		if not runStep(attacker, step, i > 1, primary) then
			ok = false
			break
		end
		if i < #steps then
			local _, rec = BossBrain.timing(step, attacker.Floor, i > 1)
			-- inside a combo, only the authored short gap separates steps
			task.wait(math.min(rec, step.Recovery or 0.3))
		end
	end
	local last = steps[#steps]
	local _, recovery = BossBrain.timing({ Windup = 1, Recovery = attack.Recovery or last.Recovery }, attacker.Floor, false)
	if ok and attacker.Airborne and (last.Lands or last.Shape == "Dash" or last.Shape == "Leap") and attacker.OnLand then
		attacker.OnLand()
	end
	if attacker.Humanoid and attacker.Humanoid.Parent then
		attacker.Humanoid.AutoRotate = true
	end
	-- recovery window (vulnerable)
	if attacker.Model and attacker.Model.Parent then
		attacker.Model:SetAttribute("Recovering", true)
	end
	task.wait(recovery)
	if attacker.Model and attacker.Model.Parent then
		attacker.Model:SetAttribute("Recovering", false)
	end
	if attacker.Airborne and attacker.OnTakeoff then
		attacker.OnTakeoff()
	end
	return ok
end

return AttackExecutor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">BossService</string>
            <string name="Source"><![CDATA[--[[
	BossService
	Reusable boss framework for the 20 tower floors.

	* Each attempt builds a private arena instance in one of MaxConcurrentArenas slots far
	  from the world, so several solo players / parties can fight any floor at the same time.
	* Encounter ownership and reward eligibility live in EncounterCore (pure, tested).
	* Phases come from Config/Bosses; mechanics are generic and data-driven:
	    Twin, Armor, WeakPoints, Airborne, Stances, Ambient, Counter, ParryReward, summons.
	* Phase transitions grant a short invulnerable roar so players can read the change.
	* Boss HP scales with participant count; leaving/dying participants scale it back down.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Bosses = require(Shared.Config.Bosses)
local World = require(Shared.Config.World)
local Formulas = require(Shared.Logic.Formulas)
local Rng = require(Shared.Util.Rng)
local Net = require(Shared.Net)
local Core = script.Parent.Parent.Core
local EncounterCore = require(Core.EncounterCore)
local BossBrain = require(Core.BossBrain)
local CombatCore = require(Core.CombatCore)
local AchievementCore = require(Core.AchievementCore)
local EntityModels = require(script.Parent.EntityModels)

local BossService = {}
local S
local bossRemote: RemoteEvent
local slots = {} -- [slotIndex] = encounter runtime
local rng = Rng.new()

local function now()
	return workspace:GetServerTimeNow()
end

local function gatePos(): Vector3
	local g = World.Tower.GatePosition
	return Vector3.new(g[1], g[2], g[3])
end

function BossService.Init(services)
	S = services
	bossRemote = Net.event("Boss")
	local arenas = Instance.new("Folder")
	arenas.Name = "Arenas"
	arenas.Parent = workspace
end

local function participants(run)
	local out = {}
	for uid, p in run.Core.Participants do
		if p.Alive then
			local plr = run.Players[uid]
			if plr and plr.Parent then
				table.insert(out, plr)
			end
		end
	end
	return out
end

local function broadcast(run, payload, includeRemoved: boolean?)
	for uid, plr in run.Players do
		if plr.Parent and (includeRemoved or (run.Core.Participants[uid] and run.Core.Participants[uid].Alive)) then
			bossRemote:FireClient(plr, payload)
		end
	end
end

local function bossSnapshot(run)
	local list = {}
	for _, ctl in run.Bosses do
		table.insert(list, {
			Id = ctl.Entity.Id,
			Name = ctl.Name,
			Health = math.max(0, math.floor(ctl.Entity.Target.Health)),
			Max = ctl.Entity.Target.MaxHealth,
			Poise = ctl.Entity.Target.Poise / ctl.Entity.Target.MaxPoise,
			Armor = ctl.Entity.ArmorUp == true,
		})
	end
	return list
end

local function sendUpdate(run)
	broadcast(run, {
		Type = "Update",
		Bosses = bossSnapshot(run),
		Phase = run.PhaseName,
		Stance = run.StanceName,
	})
end

local function teleport(player: Player, cf: CFrame)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Character then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 5)
	end)
	S.AntiCheatService.AllowTeleport(player)
	rt.Character:PivotTo(cf)
end

local function cleanup(run)
	if run.Cleaned then
		return
	end
	run.Cleaned = true
	run.Ended = true
	for _, ai in run.Summons do
		if not ai.Dead then
			S.EnemyService.Despawn(ai, false)
		end
	end
	for _, ctl in run.Bosses do
		for _, wp in ctl.WeakPoints or {} do
			S.EntityService.Unregister(wp)
		end
		if ctl.Entity.Alive then
			S.EntityService.Unregister(ctl.Entity)
		end
		if ctl.Model then
			ctl.Model:Destroy()
		end
	end
	for uid, plr in run.Players do
		local rt = S.PlayerStateService.Get(plr)
		if rt and rt.Encounter == run then
			rt.Encounter = nil
			plr:SetAttribute("ArenaFloor", nil)
		end
		if plr.Parent then
			bossRemote:FireClient(plr, { Type = "End" })
		end
		run.Players[uid] = nil
	end
	if run.ArenaEntity then
		run.ArenaEntity.Alive = false
	end
	if run.Arena then
		run.Arena:Destroy()
	end
	slots[run.Slot] = nil
end

local function exitArena(run, player: Player)
	local rt = S.PlayerStateService.Get(player)
	if rt and rt.Encounter == run then
		rt.Encounter = nil
		player:SetAttribute("ArenaFloor", nil)
		if rt.Combat and not rt.Combat.Dead then
			teleport(player, CFrame.new(gatePos() + Vector3.new(math.random(-6, 6), 4, 16)))
		end
	end
end

-- ===================================================================== victory / defeat
local function victory(run)
	if not EncounterCore.markVictory(run.Core) then
		return
	end
	local def = run.Def
	run.Ended = true
	for _, ai in run.Summons do
		if not ai.Dead then
			S.EnemyService.Despawn(ai, true)
		end
	end
	broadcast(run, { Type = "Victory", Name = def.Name, Floor = def.Floor, Final = def.Floor == GameConfig.Tower.Floors })
	for _, plr in participants(run) do
		local rt = S.PlayerStateService.Get(plr)
		if rt then
			local rewards = EncounterCore.claim(run.Core, plr.UserId, rt.Profile, rng)
			if rewards then
				AchievementCore.increment(rt.Profile, if rewards.Solo then "SoloBossKills" else "CoopBossKills")
				if rewards.Flawless then
					AchievementCore.increment(rt.Profile, "FlawlessBosses")
				end
				S.NotifyService.Banner(plr, if rewards.FirstClear then "GUARDIAN FELLED" else "GUARDIAN FELLED AGAIN", def.Name .. (if rewards.FirstClear and def.Floor < GameConfig.Tower.Floors then (" - Floor %d unlocked"):format(def.Floor + 1) else ""), "Victory")
				S.ProgressionService.GrantBundle(plr, rewards, def.Name)
				if S.LeaderboardService then
					S.LeaderboardService.Update(plr)
				end
				if rewards.FirstClear and def.Floor == GameConfig.Tower.Floors then
					bossRemote:FireClient(plr, { Type = "Ending" })
				end
				task.spawn(S.DataService.Save, plr)
			end
		end
	end
	-- death sequence
	task.delay(GameConfig.Tower.VictoryTeleportDelay, function()
		for _, plr in participants(run) do
			exitArena(run, plr)
		end
		cleanup(run)
	end)
end

local function defeat(run)
	if run.Ended then
		return
	end
	run.Ended = true
	broadcast(run, { Type = "Defeat", Name = run.Def.Name }, true)
	task.delay(3, function()
		cleanup(run)
	end)
end

-- ===================================================================== participants
local function removeParticipant(player: Player)
	local rt = S.PlayerStateService.Get(player)
	local run = rt and rt.Encounter
	if not run then
		-- player may already be gone from runtime: search
		for _, r in slots do
			if r.Players[player.UserId] then
				run = r
			end
		end
	end
	if not run or run.Ended then
		return
	end
	local scale, failed = EncounterCore.removeParticipant(run.Core, player.UserId)
	if failed then
		defeat(run)
		return
	end
	if scale ~= 1 then
		for _, ctl in run.Bosses do
			CombatCore.scaleTargetHealth(ctl.Entity.Target, scale)
			S.EntityService.PushHealth(ctl.Entity)
		end
		sendUpdate(run)
	end
	if rt then
		rt.Encounter = nil
		player:SetAttribute("ArenaFloor", nil)
	end
end

function BossService.OnParticipantDied(player: Player)
	local rt = S.PlayerStateService.Get(player)
	local run = rt and rt.Encounter
	if run and player.Parent then
		bossRemote:FireClient(player, { Type = "Removed" })
	end
	removeParticipant(player)
end

function BossService.OnParticipantLeft(player: Player)
	removeParticipant(player)
end

function BossService.RecordDamage(player: Player, amount: number)
	local rt = S.PlayerStateService.Get(player)
	if rt and rt.Encounter then
		EncounterCore.recordDamage(rt.Encounter.Core, player.UserId, amount)
	end
end

function BossService.RecordHitTaken(player: Player)
	local rt = S.PlayerStateService.Get(player)
	if rt and rt.Encounter then
		EncounterCore.recordHitTaken(rt.Encounter.Core, player.UserId)
	end
end

-- ===================================================================== boss controllers
local function nearestParticipant(run, pos: Vector3): Player?
	local best, bestD = nil, math.huge
	for _, plr in participants(run) do
		local rt = S.PlayerStateService.Get(plr)
		if rt and rt.Root and rt.Combat and not rt.Combat.Dead then
			local d = (rt.Root.Position - pos).Magnitude
			if d < bestD then
				best, bestD = plr, d
			end
		end
	end
	return best
end

local function setPlatesVisible(ctl, visible: boolean)
	for _, p in ctl.Model:GetDescendants() do
		if p:IsA("BasePart") and p.Name == "ArmorPlate" then
			p.Transparency = if visible then 0 else 1
		end
	end
end

local function spawnBoss(run, index: number, count: number)
	local def = run.Def
	local floor = def.Floor
	local n = run.Core.StartCount
	local name = def.Name
	if count > 1 then
		name = def.Name .. (if index == 1 then " (Judge)" else " (Sentence)")
	end
	local model, root, humanoid, radius, _height, shoulder = EntityModels.build(name, def.Model, "Boss")
	local offset = if count > 1 then Vector3.new((index - 1.5) * 24, 0, 0) else Vector3.zero
	local spawnPos = run.Origin + Vector3.new(0, 0, -run.Radius * 0.45) + offset
	model:PivotTo(CFrame.lookAt(spawnPos + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0), run.Origin + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)))
	model.Parent = run.Arena
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	humanoid.WalkSpeed = def.WalkSpeed
	local maxHp = math.floor(Formulas.bossHealth(floor) * def.HealthMult * Formulas.partyHealthMult(n))
	local ctl: any = {
		Run = run,
		Name = name,
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Phase = 0,
		Busy = false,
		NextAttackAt = now() + 2.5,
		Ctx = { Cooldowns = {}, History = {}, Rng = Rng.new(math.random(1, 1e6)) },
		GroundHip = humanoid.HipHeight,
	}
	ctl.Entity = S.EntityService.Register({
		Kind = "Boss",
		Encounter = run,
		Model = model,
		Root = root,
		Name = name,
		Level = Formulas.recommendedLevel(floor),
		MaxHealth = maxHp,
		Poise = math.floor(def.Poise * Formulas.partyPoiseMult(n)),
		Defense = def.Defense,
		Radius = radius,
		Def = def,
		OnDeath = function()
			ctl.Dead = true
			for _, wp in ctl.WeakPoints or {} do
				S.EntityService.Unregister(wp)
			end
			for _, p in model:GetDescendants() do
				if p:IsA("BasePart") then
					p.Anchored = true
					TweenService:Create(p, TweenInfo.new(3), { Transparency = 1, Position = p.Position - Vector3.new(0, 4, 0) }):Play()
				end
			end
			S.TelegraphService.Impact(root.Position, 20, def.Model.Glow)
			local alive = 0
			for _, other in run.Bosses do
				if not other.Dead then
					alive += 1
					local twin = def.Mechanics.Twin
					if twin and not other.Enraged then
						other.Enraged = true
						other.Attacker.DamageScale = 1 + twin.EnrageDamage
						other.Humanoid.WalkSpeed = def.WalkSpeed * (1 + twin.EnrageSpeed)
						other.ForcedPhase = #def.Phases
						broadcast(run, { Type = "Phase", Name = "Grief-stricken fury" })
					end
				end
			end
			if alive == 0 then
				victory(run)
			end
		end,
	})
	local baseDamage = Formulas.bossDamage(floor) * def.DamageMult
	ctl.Attacker = {
		Entity = ctl.Entity,
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Shoulder = shoulder,
		BaseDamage = baseDamage,
		Floor = floor,
		GroundY = run.Origin.Y,
		ArenaCenter = run.Origin,
		ArenaRadius = run.Radius,
		CounterReduction = def.Mechanics.Counter and def.Mechanics.Counter.GuardDamageReduction or nil,
		ParryReward = def.Mechanics.ParryReward,
		Targets = function()
			return participants(run)
		end,
		ArenaGone = function()
			return run.Cleaned == true
		end,
		OnSummon = function(enemyId, count, maxAlive, pos)
			local alive = 0
			for _, ai in run.Summons do
				if not ai.Dead and ai.Def.Id == enemyId then
					alive += 1
				end
			end
			for i = 1, math.min(count, maxAlive - alive) do
				local ang = (i / count) * math.pi * 2 + math.random()
				local p = pos + Vector3.new(math.cos(ang) * 8, 6, math.sin(ang) * 8)
				local ai = S.EnemyService.Spawn(enemyId, p, {
					TargetsFn = function()
						return participants(run)
					end,
					Restrict = function(plr)
						return run.Core.Participants[plr.UserId] ~= nil and run.Core.Participants[plr.UserId].Alive
					end,
					BaseDamage = baseDamage * 0.3,
					HealthScale = 1 + floor * 0.15,
					Floor = floor,
					NoRewards = true,
					Leash = 1e4,
					Encounter = run,
					ArenaCenter = run.Origin,
					ArenaRadius = run.Radius,
				})
				if ai then
					if ai.Model then
						ai.Model.Parent = run.Arena
					end
					table.insert(run.Summons, ai)
				end
			end
		end,
	}
	local mech = def.Mechanics
	if mech.Armor then
		ctl.Entity.ArmorUp = true
		ctl.Entity.ArmorReduction = mech.Armor.Reduction
	end
	if mech.WeakPoints then
		ctl.Entity.DamageMultiplier = mech.WeakPoints.BodyMultiplier
		ctl.WeakPoints = {}
		local torso = model:FindFirstChild("Torso") :: BasePart?
		for i = 1, mech.WeakPoints.Count do
			local wp = Instance.new("Part")
			wp.Name = "WeakPoint"
			wp.Shape = Enum.PartType.Ball
			wp.Size = Vector3.new(2.6, 2.6, 2.6)
			wp.Material = Enum.Material.Neon
			wp.Color = def.Model.Glow or Color3.fromRGB(80, 255, 220)
			wp.CanCollide = false
			wp.CanQuery = false
			wp.Massless = true
			local anchor = torso or root
			wp.CFrame = anchor.CFrame * CFrame.new((i == 1 and 1 or -1) * 2.2, 1.5, 2 + i * 2)
			local w = Instance.new("WeldConstraint")
			w.Part0 = anchor
			w.Part1 = wp
			w.Parent = wp
			wp.Parent = model
			local wpe = S.EntityService.Register({
				Kind = "WeakPoint", Root = wp, Name = name .. " Weak Point", MaxHealth = 1e9, Poise = 1e9, Defense = 0,
				Radius = 1.8, Parent = ctl.Entity, WeakMultiplier = mech.WeakPoints.WeakMultiplier,
			})
			table.insert(ctl.WeakPoints, wpe)
		end
	end
	if mech.Airborne then
		ctl.Attacker.Airborne = true
		ctl.Entity.Airborne = true
		ctl.Attacker.OnLand = function()
			ctl.Entity.Airborne = false
			humanoid.HipHeight = math.max(2, ctl.GroundHip - mech.Airborne.Height)
			model:SetAttribute("Grounded", true)
		end
		ctl.Attacker.OnTakeoff = function()
			ctl.Entity.Airborne = true
			humanoid.HipHeight = ctl.GroundHip
			model:SetAttribute("Grounded", false)
		end
	end
	ctl.Entity.OnDamaged = function(e, _player, result)
		if result.Staggered and e.ArmorUp and mech.Armor then
			e.ArmorUp = false
			setPlatesVisible(ctl, false)
			broadcast(run, { Type = "Phase", Name = "ARMOR BROKEN" })
			task.delay(mech.Armor.BreakDuration, function()
				if e.Alive then
					e.ArmorUp = true
					setPlatesVisible(ctl, true)
				end
			end)
		end
	end
	return ctl
end

local function phaseTransition(run, ctl, phaseIndex: number)
	local phase = run.Def.Phases[phaseIndex]
	ctl.Phase = phaseIndex
	if phaseIndex == 1 then
		return
	end
	ctl.Busy = true
	ctl.Entity.Invulnerable = true -- brief roar so players can read the phase change
	run.PhaseName = phase.Name or ("Phase " .. phaseIndex)
	broadcast(run, { Type = "Phase", Name = run.PhaseName })
	ctl.Humanoid:MoveTo(ctl.Root.Position)
	S.TelegraphService.Impact(ctl.Root.Position, 14, run.Def.Model.Glow)
	task.delay(2, function()
		ctl.Entity.Invulnerable = false
		ctl.Busy = false
		ctl.NextAttackAt = now() + 0.5
	end)
end

local function bossThink(run, ctl)
	if ctl.Dead or ctl.Busy or run.Ended then
		return
	end
	local e = ctl.Entity
	local t = now()
	S.EntityService.TickStatus(e, 0.1, t)
	if ctl.Dead then
		return
	end
	if t < e.Target.StaggeredUntil then
		ctl.Humanoid:MoveTo(ctl.Root.Position)
		return
	end
	-- keep inside the arena
	local pos = ctl.Root.Position
	local flat = Vector3.new(pos.X - run.Origin.X, 0, pos.Z - run.Origin.Z)
	if flat.Magnitude > run.Radius - 4 or pos.Y < run.Origin.Y - 20 then
		ctl.Model:PivotTo(CFrame.new(run.Origin + Vector3.new(0, ctl.Humanoid.HipHeight + ctl.Root.Size.Y / 2, 0)))
	end
	local phaseIndex = ctl.ForcedPhase or BossBrain.phaseIndex(run.Def, e.Target.Health / e.Target.MaxHealth)
	if phaseIndex ~= ctl.Phase then
		phaseTransition(run, ctl, phaseIndex)
		return
	end
	if ctl.Target == nil or not run.Core.Participants[ctl.Target.UserId] or not run.Core.Participants[ctl.Target.UserId].Alive or t > (ctl.RetargetAt or 0) then
		ctl.Target = nearestParticipant(run, pos)
		ctl.RetargetAt = t + 3
	end
	local target = ctl.Target
	if not target then
		return
	end
	local trt = S.PlayerStateService.Get(target)
	if not trt or not trt.Root then
		ctl.Target = nil
		return
	end
	local tpos = trt.Root.Position
	local dist = Vector3.new(tpos.X - pos.X, 0, tpos.Z - pos.Z).Magnitude - e.Radius
	local phase = run.Def.Phases[ctl.Phase]
	local attacks, stanceName = BossBrain.phaseAttacks(phase, run.StanceIndex)
	if stanceName ~= run.StanceName then
		run.StanceName = stanceName
		if stanceName then
			broadcast(run, { Type = "Phase", Name = stanceName })
		end
	end
	if t >= ctl.NextAttackAt then
		ctl.Ctx.Distance = dist
		ctl.Ctx.Now = t
		local attack = BossBrain.choose(attacks, ctl.Ctx)
		if attack then
			BossBrain.recordChoice(ctl.Ctx, attack, t)
			ctl.Busy = true
			task.spawn(function()
				local ok, err = pcall(S.AttackExecutor.Run, ctl.Attacker, attack, target)
				if not ok then
					warn("[BossService] attack error: " .. tostring(err))
				end
				ctl.Busy = false
				-- aggression rises with floor
				ctl.NextAttackAt = now() + math.max(0.25, 1.1 - 0.035 * run.Def.Floor) + ctl.Ctx.Rng:NextNumber() * 0.6
			end)
			return
		end
	end
	if dist > 5 then
		ctl.Humanoid:MoveTo(tpos)
	else
		ctl.Humanoid:MoveTo(pos)
	end
end

-- ===================================================================== encounter lifecycle
local function freeSlot(): number?
	for i = 1, GameConfig.Tower.MaxConcurrentArenas do
		if not slots[i] then
			return i
		end
	end
	return nil
end

local function startEncounter(floor: number, group: { Player })
	if #group == 0 then
		return false, "NoParticipants"
	end
	local slot = freeSlot()
	if not slot then
		return false, "TowerBusy"
	end
	local def = Bosses.List[floor]
	local o = GameConfig.Tower.ArenaOrigin
	local origin = Vector3.new(o.X + (slot - 1) * GameConfig.Tower.ArenaSlotSpacing, o.Y, o.Z)
	local run: any = {
		Slot = slot,
		Def = def,
		Origin = origin,
		Radius = def.Arena.Size / 2,
		Players = {},
		Bosses = {},
		Summons = {},
		StanceIndex = 1,
		StartedAt = os.clock(),
	}
	slots[slot] = run
	local uids = {}
	for _, plr in group do
		table.insert(uids, plr.UserId)
		run.Players[plr.UserId] = plr
	end
	run.Core = EncounterCore.new(HttpService:GenerateGUID(false), floor, uids, os.time())
	run.Arena = S.WorldBuilder.BuildArena(def, origin)
	run.Arena.Parent = workspace:FindFirstChild("Arenas")

	for i, plr in group do
		local rt = S.PlayerStateService.Get(plr)
		rt.Encounter = run
		plr:SetAttribute("ArenaFloor", floor)
		local ang = math.rad(-30 + 60 * ((i - 0.5) / #group))
		local p = origin + Vector3.new(math.sin(ang) * (run.Radius - 14), 4, math.cos(ang) * (run.Radius - 14))
		teleport(plr, CFrame.lookAt(p, Vector3.new(origin.X, p.Y, origin.Z)))
		S.PlayerStateService.FullRestore(plr)
	end

	local count = def.Mechanics.Twin and def.Mechanics.Twin.Count or 1
	for i = 1, count do
		table.insert(run.Bosses, spawnBoss(run, i, count))
	end
	broadcast(run, {
		Type = "Start",
		Floor = floor,
		Name = def.Name,
		Title = def.Title,
		Mechanic = def.Mechanic,
		Theme = { Fog = def.Arena.Fog, Light = def.Arena.Light },
		Bosses = bossSnapshot(run),
	})

	-- ambient hazards
	if def.Mechanics.Ambient then
		local anchor = Instance.new("Part")
		anchor.Name = "AmbientAnchor"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Transparency = 1
		anchor.CFrame = CFrame.new(origin + Vector3.new(0, 3, 0))
		anchor.Parent = run.Arena
		local amb = def.Mechanics.Ambient
		local first = run.Bosses[1]
		-- the arena itself casts ambient hazards: independent of any boss's stagger/death
		local arenaEntity = { Alive = true, Kind = "Arena", Target = CombatCore.newTarget(1, 1) }
		run.ArenaEntity = arenaEntity
		local ambient = {
			Entity = arenaEntity,
			Model = run.Arena,
			Root = anchor,
			BaseDamage = first.Attacker.BaseDamage,
			Floor = floor,
			GroundY = origin.Y,
			ArenaCenter = origin,
			ArenaRadius = run.Radius,
			Targets = first.Attacker.Targets,
			ArenaGone = first.Attacker.ArenaGone,
		}
		task.spawn(function()
			task.wait(6)
			local turn = 0
			while not run.Ended do
				local list = participants(run)
				turn += 1
				local victim = list[(turn - 1) % math.max(1, #list) + 1]
				pcall(S.AttackExecutor.Run, ambient, amb.Attack, victim)
				task.wait(amb.Interval)
			end
		end)
	end

	-- main loop
	task.spawn(function()
		task.wait(2.5) -- intro title card
		local lastUpdate = 0
		local lastStance = os.clock()
		while not run.Ended do
			task.wait(0.1)
			if def.Mechanics.Stances and os.clock() - lastStance >= def.Mechanics.Stances.Interval then
				lastStance = os.clock()
				run.StanceIndex += 1
			end
			for _, ctl in run.Bosses do
				local ok, err = pcall(bossThink, run, ctl)
				if not ok then
					warn("[BossService] think error: " .. tostring(err))
					ctl.Busy = false
				end
			end
			-- keep participants inside the arena
			for _, plr in participants(run) do
				local rt = S.PlayerStateService.Get(plr)
				if rt and rt.Root and rt.Combat and not rt.Combat.Dead then
					local p = rt.Root.Position
					if p.Y < origin.Y - 30 then
						S.DeathService.OnPlayerDeath(plr, "Fall")
					elseif Vector3.new(p.X - origin.X, 0, p.Z - origin.Z).Magnitude > run.Radius + 25 then
						teleport(plr, CFrame.new(origin + Vector3.new(0, 4, run.Radius - 14)))
					end
				end
			end
			if os.clock() - lastUpdate > 0.2 then
				lastUpdate = os.clock()
				sendUpdate(run)
			end
			if os.clock() - run.StartedAt > GameConfig.Tower.EncounterIdleTimeout then
				for _, plr in participants(run) do
					exitArena(run, plr)
				end
				defeat(run)
			end
		end
	end)
	return true, run.Core.Id
end

function BossService.Start()
	local lastEnter = {}
	S.RequestService.Register("EnterFloor", function(player, rt, floor)
		if rt.Encounter then
			return false, "AlreadyInside"
		end
		if not rt.Combat or rt.Combat.Dead then
			return false, "Dead"
		end
		if os.clock() - (lastEnter[player] or -1e9) < 5 then
			return false, "TooFast"
		end
		lastEnter[player] = os.clock()
		if not rt.Root or (rt.Root.Position - gatePos()).Magnitude > GameConfig.Party.GatherRadius then
			return false, "NotAtGate"
		end
		local ok, err = EncounterCore.canEnter(rt.Profile, floor)
		if not ok then
			return false, err
		end
		-- solo, or the whole party if the requester leads it
		local members = S.PartyService.Members(player)
		if #members > 1 and not S.PartyService.IsLeader(player) then
			return false, "OnlyLeaderStarts"
		end
		local group = {}
		for _, m in members do
			local mrt = S.PlayerStateService.Get(m)
			if mrt and mrt.Root and mrt.Combat and not mrt.Combat.Dead and not mrt.Encounter
				and (mrt.Root.Position - gatePos()).Magnitude <= GameConfig.Party.GatherRadius then
				local can, why = EncounterCore.canEnter(mrt.Profile, floor)
				if can then
					table.insert(group, m)
				elseif m ~= player then
					S.NotifyService.Toast(player, ("%s cannot enter floor %d (%s)."):format(m.DisplayName, floor, tostring(why)), "Warning")
					S.NotifyService.Toast(m, ("You have not unlocked floor %d."):format(floor), "Warning")
				end
			elseif m ~= player then
				S.NotifyService.Toast(m, "Your party entered the tower without you (gather at the gate to join).", "Warning")
			end
		end
		if not table.find(group, player) then
			return false, "NoParticipants"
		end
		return startEncounter(floor, group)
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		lastEnter[p] = nil
	end)

	S.RequestService.Register("LeaveArena", function(player, rt)
		local run = rt.Encounter
		if not run then
			return false, "NotInside"
		end
		if not run.Ended then
			removeParticipant(player)
		end
		exitArena(run, player)
		bossRemote:FireClient(player, { Type = "End" })
		return true, nil
	end)
end

function BossService.ActiveArenas(): number
	local n = 0
	for _ in slots do
		n += 1
	end
	return n
end

return BossService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">CheckpointService</string>
            <string name="Source"><![CDATA[--[[
	CheckpointService
	Ember Shrines: resting restores health, stamina, mana and flask charges, sets the respawn
	point, and opens the shrine menu (level up, fast travel). Enemies are NOT reset on rest -
	the world is shared with other players.
	Fast travel is allowed between shrines the player has kindled, outside combat only.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local World = require(Shared.Config.World)
local Net = require(Shared.Net)

local CheckpointService = {}
local S
local byId = {}

function CheckpointService.Init(services)
	S = services
	for _, cp in World.Checkpoints do
		byId[cp.Id] = cp
	end
end

local function cpPos(cp): Vector3
	return Vector3.new(cp.Position[1], cp.Position[2], cp.Position[3])
end

function CheckpointService.NearestShrine(player: Player, radius: number?)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Root then
		return nil
	end
	local best, bestD = nil, radius or (GameConfig.Checkpoint.InteractRadius + 4)
	for _, cp in World.Checkpoints do
		local d = (rt.Root.Position - cpPos(cp)).Magnitude
		if d <= bestD then
			best, bestD = cp, d
		end
	end
	return best
end

function CheckpointService.IsNearActivatedShrine(player: Player): boolean
	local rt = S.PlayerStateService.Get(player)
	local cp = CheckpointService.NearestShrine(player)
	return cp ~= nil and rt ~= nil and rt.Profile.Checkpoints.Activated[cp.Id] == true
end

local function rest(player: Player, cp)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Combat or rt.Combat.Dead or rt.Encounter then
		return
	end
	local p = rt.Profile
	if not p.Checkpoints.Activated[cp.Id] then
		p.Checkpoints.Activated[cp.Id] = true
		S.NotifyService.Banner(player, "SHRINE KINDLED", cp.Name, "Discovery")
	end
	p.Checkpoints.Last = cp.Id
	S.PlayerStateService.FullRestore(player)
	S.PlayerStateService.Sync(player)
	Net.event("OpenUI"):FireClient(player, { Menu = "Shrine", ShrineId = cp.Id })
	task.spawn(S.DataService.Save, player)
end

function CheckpointService.Start()
	local function hook(part: Instance)
		local id = part:GetAttribute("ShrineId")
		local cp = id and byId[id]
		if not cp then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Rest"
		prompt.ObjectText = cp.Name
		prompt.MaxActivationDistance = GameConfig.Checkpoint.InteractRadius
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			-- server-side distance validation (prompts can be spoofed by exploits)
			if CheckpointService.NearestShrine(player) == cp then
				rest(player, cp)
			end
		end)
	end
	for _, part in CollectionService:GetTagged("Shrine") do
		hook(part)
	end
	CollectionService:GetInstanceAddedSignal("Shrine"):Connect(hook)

	S.RequestService.Register("Travel", function(player, rt, targetId)
		local target = type(targetId) == "string" and byId[targetId]
		if not target then
			return false, "UnknownShrine"
		end
		if not rt.Profile.Checkpoints.Activated[targetId] then
			return false, "NotKindled"
		end
		if not CheckpointService.IsNearActivatedShrine(player) then
			return false, "RestAtShrine"
		end
		if rt.Encounter or not rt.Character then
			return false, "Busy"
		end
		local pos = cpPos(target) + Vector3.new(0, 4, 6)
		pcall(function()
			player:RequestStreamAroundAsync(pos, 5)
		end)
		S.AntiCheatService.AllowTeleport(player)
		rt.Character:PivotTo(CFrame.new(pos))
		rt.Profile.Checkpoints.Last = targetId
		S.PlayerStateService.Sync(player)
		return true, targetId
	end)
end

return CheckpointService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CombatService
	Server-authoritative combat. Clients send *intents* through the Action remote
	({ Kind = "Light" | "Heavy" | "Dodge" | "Parry" | "Block" | "Sprint" | "Ability" | "Flask" | "Item" }).
	The server validates state, timing, stamina/mana, ownership and cooldowns; computes all
	damage itself; and resolves hits using server positions. Clients never send damage numbers.

	Hostile hits are applied after LatencyGrace (see CombatCore) so a dodge/parry that left the
	client in time still counts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local WeaponTypes = require(Shared.Config.WeaponTypes)
local Abilities = require(Shared.Config.Abilities)
local Items = require(Shared.Config.Items)
local Formulas = require(Shared.Logic.Formulas)
local Geometry = require(Shared.Logic.Geometry)
local Net = require(Shared.Net)
local CombatCore = require(script.Parent.Parent.Core.CombatCore)
local InventoryCore = require(script.Parent.Parent.Core.InventoryCore)
local AchievementCore = require(script.Parent.Parent.Core.AchievementCore)

local C = GameConfig.Combat

local CombatService = {}

local S
local fx: RemoteEvent
local buckets = {}

local function now()
	return workspace:GetServerTimeNow()
end

function CombatService.Init(services)
	S = services
	fx = Net.event("Fx")
end

-- Token bucket: true if the player may perform another request.
local function allow(player: Player): boolean
	local b = buckets[player]
	local t = os.clock()
	if not b then
		b = { Tokens = GameConfig.Interaction.MaxRemoteRate, Last = t }
		buckets[player] = b
	end
	b.Tokens = math.min(GameConfig.Interaction.MaxRemoteRate, b.Tokens + (t - b.Last) * GameConfig.Interaction.MaxRemoteRate)
	b.Last = t
	if b.Tokens < 1 then
		return false
	end
	b.Tokens -= 1
	return true
end
CombatService.Allow = allow

local function validVector(v): boolean
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude > 0.01 and v.Magnitude < 1e4
end

local function inPvp(rt): boolean
	return rt.Region == "pvp"
end

local function playSlash(rt, heavy: boolean)
	local char = rt.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = if heavy then "Lunge" else "Slash"
		anim.Parent = tool
		game:GetService("Debris"):AddItem(anim, 0.5)
	end
end

function CombatService.SendFx(player: Player, payload)
	fx:FireClient(player, payload)
end

local function fxNear(position: Vector3, payload, radius: number)
	for _, plr in Players:GetPlayers() do
		local rt = S.PlayerStateService.Get(plr)
		if rt and rt.Root and (rt.Root.Position - position).Magnitude <= radius then
			fx:FireClient(plr, payload)
		end
	end
end
CombatService.FxNear = fxNear

-- ===================================================================== Outgoing damage
local function critFor(rt, e, attackerPos: Vector3, wtype): (number, string?)
	local bonus = (wtype.CritBonus or 0) + (rt.Stats.Bonuses.CritDamage or 0)
	local t = now()
	if CombatCore.isStaggered(e.Target, t) then
		return C.RiposteMultiplier + bonus, "Riposte"
	end
	if t < (rt.Combat.CritUntil or 0) then
		rt.Combat.CritUntil = 0
		return 1.5 + bonus, "Critical"
	end
	if e.Kind ~= "Boss" and e.Parent == nil and e.Root and e.Root.Parent then
		local look = e.Root.CFrame.LookVector
		local tp = e.Root.Position
		if Geometry.isBehind(tp.X, tp.Z, look.X, look.Z, attackerPos.X, attackerPos.Z, C.BackstabAngle) then
			return C.BackstabMultiplier + bonus, "Backstab"
		end
	end
	return 1, nil
end

local function statusFor(rt, base)
	local mult = 1 + Formulas.statusBonus(rt.Stats.Attributes.Arcane) + (rt.Stats.Bonuses.StatusBuildup or 0)
	local out = nil
	if base then
		out = {}
		for k, v in base do
			out[k] = v * mult
		end
	end
	local venom = CombatCore.buffAmount(rt.Combat, "Poison", now())
	if venom > 0 then
		out = out or {}
		out.Poison = (out.Poison or 0) + venom * mult
	end
	return out
end

local function damageOpts(rt, damageType: string)
	local t = now()
	local buff = CombatCore.buffAmount(rt.Combat, "Damage", t) + CombatCore.buffAmount(rt.Combat, "FireCoat", t)
	return {
		DamageBuff = buff,
		TypeBonus = rt.Stats.Bonuses[damageType .. "Damage"] or 0,
	}
end

-- Applies `motion`-scaled damage from `player` to entity `e`.
function CombatService.HitEntity(player: Player, rt, e, power: number, motion: number, poise: number, damageType: string, statusBase, kind: string)
	if not CombatService.CanHit(rt, e) then
		return { Damage = 0, Died = false, Staggered = false, Countered = false }
	end
	local pos = rt.Root.Position
	local wtype = WeaponTypes[rt.Stats.WeaponType] or WeaponTypes.Fist
	local critMult, critKind = 1, nil
	if kind == "Melee" then
		critMult, critKind = critFor(rt, e, pos, wtype)
	end
	local opts = damageOpts(rt, damageType)
	opts.CritMult = critMult
	opts.TargetDefense = e.Defense or 0
	local dmg = CombatCore.outgoing(power, motion, opts)
	local result = S.EntityService.Damage(e, dmg, player, {
		Poise = poise * (if critKind then 1.5 else 1),
		Status = statusFor(rt, statusBase),
		Kind = kind,
		DamageType = damageType,
		Crit = critKind,
	})
	if result.Damage > 0 or result.Countered then
		local epos = S.EntityService.Position(e) or pos
		fx:FireClient(player, {
			Type = "Damage",
			Position = epos + Vector3.new(0, 3, 0),
			Amount = result.Damage,
			Crit = critKind,
			Proc = result.Proc,
			WeakPoint = result.WeakPoint,
			Countered = result.Countered,
		})
		if rt.Encounter and S.BossService then
			S.BossService.RecordDamage(player, result.Damage)
		end
	end
	return result
end

-- Entities that belong to a boss encounter can only be hit by that encounter's participants;
-- entities owned by a player (sparring partner) only by that player.
function CombatService.CanHit(rt, e): boolean
	local root = e.Parent or e
	-- no attacking world enemies from inside safe zones (hub snipe protection)
	if rt.Player and rt.Player:GetAttribute("Safe") and root.Encounter == nil and root.Owner == nil and root.Kind ~= "Dummy" then
		return false
	end
	if root.Encounter ~= nil and rt.Encounter ~= root.Encounter then
		return false
	end
	if root.Owner ~= nil and root.Owner ~= rt.Player then
		return false
	end
	return true
end

local function pvpTargets(rt)
	local out = {}
	if not inPvp(rt) then
		return out
	end
	for _, plr in Players:GetPlayers() do
		local other = S.PlayerStateService.Get(plr)
		if other and other ~= rt and inPvp(other) and other.Root and other.Combat and not other.Combat.Dead then
			table.insert(out, plr)
		end
	end
	return out
end

local function hitPlayerPvp(attacker: Player, rt, victim: Player, power: number, motion: number, poise: number, damageType: string)
	local vrt = S.PlayerStateService.Get(victim)
	if not vrt or not vrt.Combat or vrt.Combat.Dead or not inPvp(vrt) or not inPvp(rt) then
		return
	end
	local opts = damageOpts(rt, damageType)
	opts.Pvp = true
	local raw = CombatCore.outgoing(power, motion, opts)
	CombatService.QueueHostileHit(victim, {
		Damage = raw, DamageType = damageType, Poise = poise, Parryable = true, Blockable = true,
		PvpAttacker = attacker,
	}, rt.Root.Position)
end

local function meleeSweep(player: Player, rt, range: number, arc: number, power: number, motion: number, poise: number, damageType: string, statusBase)
	local root = rt.Root
	local pos = root.Position
	local look = root.CFrame.LookVector
	local candidates = S.EntityService.Near(pos, range + C.MaxReachTolerance, 10)
	-- one hit per root entity per swing: a weak point (best multiplier) replaces its parent body
	local best = {} -- [rootEntity] = entity to hit
	local order = {}
	for _, e in candidates do
		local ep = S.EntityService.Position(e)
		if ep and CombatService.CanHit(rt, e) and Geometry.inCone(pos.X, pos.Z, look.X, look.Z, ep.X, ep.Z, range, arc, e.Radius) then
			local rootEntity = e.Parent or e
			local cur = best[rootEntity]
			if cur == nil then
				table.insert(order, rootEntity)
				best[rootEntity] = e
			elseif e.Parent and (cur == rootEntity or (e.WeakMultiplier or 0) > (cur.WeakMultiplier or 0)) then
				best[rootEntity] = e
			end
		end
	end
	local count = 0
	for _, rootEntity in order do
		if count < C.MaxHitsPerSwing then
			count += 1
			CombatService.HitEntity(player, rt, best[rootEntity], power, motion, poise, damageType, statusBase, "Melee")
		end
	end
	for _, victim in pvpTargets(rt) do
		local vrt = S.PlayerStateService.Get(victim)
		local vp = vrt.Root.Position
		if Geometry.inCone(pos.X, pos.Z, look.X, look.Z, vp.X, vp.Z, range, arc, 1.5) and math.abs(vp.Y - pos.Y) < 8 then
			hitPlayerPvp(player, rt, victim, power, motion, poise, damageType)
		end
	end
	return count
end

local function fireProjectile(player: Player, rt, aim: Vector3, speed: number, radius: number, range: number, power: number, motion: number, poise: number, damageType: string, statusBase, color: Color3, pierce: boolean?)
	local root = rt.Root
	local dir = if validVector(aim) then aim.Unit else root.CFrame.LookVector
	-- the server only accepts aim within 75 degrees of the character's facing (no shooting backwards)
	local look = root.CFrame.LookVector
	if dir:Dot(look) < math.cos(math.rad(75)) then
		dir = look
	end
	local pvp = pvpTargets(rt)
	S.ProjectileService.Fire({
		Origin = root.Position + look * 2 + Vector3.new(0, 1.5, 0),
		Direction = dir,
		Speed = speed,
		Radius = radius,
		Range = range,
		Color = color,
		Hostile = false,
		Owner = player,
		Pierce = pierce,
		PvpTargets = if #pvp > 0 then pvp else nil,
		OnHit = function(e)
			if rt.Combat and rt.Root and rt.Root.Parent then
				CombatService.HitEntity(player, rt, e, power, motion, poise, damageType, statusBase, "Projectile")
			end
		end,
		OnHitPlayer = function(victim)
			hitPlayerPvp(player, rt, victim, power, motion, poise, damageType)
		end,
	})
end

local DAMAGE_COLORS = {
	Physical = Color3.fromRGB(230, 220, 200),
	Magic = Color3.fromRGB(120, 140, 255),
	Fire = Color3.fromRGB(255, 120, 40),
	Holy = Color3.fromRGB(255, 230, 140),
}

-- ===================================================================== Actions
local function onAttack(player: Player, rt, kind: string, payload)
	local c = rt.Combat
	local stats = rt.Stats
	local t = now()
	-- heavy charge is measured on the server (HeavyStart -> Heavy); client values are ignored
	local charge = if kind == "Heavy" then CombatCore.takeCharge(c, t) else 0
	local ok, info = CombatCore.attack(c, kind, stats.WeaponType, t, charge)
	if not ok then
		return
	end
	local seq = c.AttackSeq or 0
	playSlash(rt, kind == "Heavy")
	local aim = payload.Aim
	task.delay(info.Windup, function()
		if c.Dead or (c.AttackSeq or 0) ~= seq or not rt.Root or not rt.Root.Parent then
			return
		end
		local wt = WeaponTypes[stats.WeaponType] or WeaponTypes.Fist
		local power = stats.AttackRating
		local dtype = stats.WeaponDamageType
		if wt.Ranged then
			fireProjectile(player, rt, aim, wt.ProjectileSpeed, wt.ProjectileRadius * (if kind == "Heavy" then 1.4 else 1), wt.MaxRange,
				power, info.Motion, info.Poise, dtype, stats.WeaponStatus, DAMAGE_COLORS[dtype] or DAMAGE_COLORS.Physical, kind == "Heavy" and wt.Catalyst)
		else
			meleeSweep(player, rt, wt.Range * (if kind == "Heavy" then 1.1 else 1), wt.Arc, power, info.Motion, info.Poise, dtype, stats.WeaponStatus)
		end
	end)
end

local function onDodge(player: Player, rt, payload)
	local ok, info = CombatCore.dodge(rt.Combat, now(), rt.Stats.DodgeCostMult)
	if ok then
		AchievementCore.increment(rt.Profile, "Dodges")
		fx:FireClient(player, { Type = "DodgeOk", IFrames = info.IFrames })
	else
		fx:FireClient(player, { Type = "ActionDenied", Action = "Dodge", Reason = info })
	end
end

local function onParry(player: Player, rt)
	local ok = CombatCore.parry(rt.Combat, now(), rt.Stats.ParryBonus)
	if ok then
		playSlash(rt, false)
	end
end

local function onBlock(player: Player, rt, payload)
	CombatCore.setBlocking(rt.Combat, payload.On == true, now())
	player:SetAttribute("Blocking", rt.Combat.Blocking)
	if rt.Combat.Blocking then
		S.PlayerStateService.SetSprinting(player, false)
	end
end

local function useFlask(player: Player, rt)
	local c = rt.Combat
	local t = now()
	local p = rt.Profile
	if p.Flask.Charges <= 0 or not CombatCore.canAct(c, t, 0.05) then
		return
	end
	if t < (c.Cooldowns.Flask or 0) then
		return
	end
	p.Flask.Charges -= 1
	c.Cooldowns.Flask = t + GameConfig.Flask.Cooldown
	c.ActionLockUntil = t + GameConfig.Flask.UseTime
	-- committed until the heal lands: no dodge-cancelling the drink
	c.DodgeCancelFrom = t + GameConfig.Flask.UseTime * 0.6
	c.Blocking = false
	local amount = math.floor(c.MaxHealth * GameConfig.Flask.HealFraction * (1 + (rt.Stats.Bonuses.HealingPower or 0)))
	-- heal lands at the end of the drinking animation (punishable, like the genre)
	task.delay(GameConfig.Flask.UseTime * 0.6, function()
		if not c.Dead and rt.Combat == c and c.LastDodge < t then
			CombatCore.heal(c, amount)
			S.PlayerStateService.PushVitals(player)
			fx:FireClient(player, { Type = "Heal", Amount = amount })
		end
	end)
	S.PlayerStateService.PushVitals(player)
end

local function useItem(player: Player, rt, itemId)
	if type(itemId) ~= "string" then
		return
	end
	local def = Items[itemId]
	if not def or def.Kind ~= "Consumable" or not def.Effect then
		return
	end
	local c = rt.Combat
	local t = now()
	if not CombatCore.canAct(c, t, 0.05) or t < (c.Cooldowns.Item or 0) or t < (c.Cooldowns[itemId] or 0) then
		return
	end
	local effect = def.Effect
	if effect.Type == "FlaskUpgrade" then
		if rt.Profile.Flask.MaxCharges >= GameConfig.Flask.MaxCharges then
			S.NotifyService.Toast(player, "Your Ember Flask cannot hold more charges.", "Warning")
			return
		end
	end
	if not InventoryCore.removeStack(rt.Profile, itemId, 1) then
		return
	end
	c.Cooldowns.Item = t + GameConfig.Consumables.SharedCooldown
	c.Cooldowns[itemId] = t + (effect.Cooldown or 0)
	c.ActionLockUntil = t + 0.6
	if effect.Type == "Heal" then
		CombatCore.heal(c, c.MaxHealth * effect.Fraction)
	elseif effect.Type == "Mana" then
		c.Mana = math.min(c.MaxMana, c.Mana + c.MaxMana * effect.Fraction)
	elseif effect.Type == "Buff" then
		CombatCore.addBuff(c, effect.Buff, effect.Amount, effect.Duration, t)
		fx:FireClient(player, { Type = "Buff", Buff = effect.Buff, Duration = effect.Duration })
	elseif effect.Type == "Cure" then
		CombatCore.cureStatus(c.Status, effect.Status)
	elseif effect.Type == "FlaskUpgrade" then
		rt.Profile.Flask.MaxCharges += 1
		rt.Profile.Flask.Charges = math.min(rt.Profile.Flask.Charges + 1, rt.Profile.Flask.MaxCharges)
		S.NotifyService.Toast(player, ("Ember Flask strengthened: %d charges."):format(rt.Profile.Flask.MaxCharges), "Reward")
	end
	S.PlayerStateService.PushVitals(player)
	S.PlayerStateService.Sync(player)
end

local function onAbility(player: Player, rt, payload)
	local slot = payload.Slot
	if slot ~= "Slot1" and slot ~= "Slot2" then
		return
	end
	local id = rt.Profile.Abilities[slot]
	local def = id and Abilities[id]
	if not def or not rt.Profile.Abilities.Unlocked[id] then
		return
	end
	local c = rt.Combat
	local t = now()
	if not CombatCore.canAct(c, t, 0.05) then
		return
	end
	if t < (c.Cooldowns[id] or 0) then
		fx:FireClient(player, { Type = "ActionDenied", Action = "Ability", Reason = "Cooldown" })
		return
	end
	if c.Mana < (def.Mana or 0) then
		fx:FireClient(player, { Type = "ActionDenied", Action = "Ability", Reason = "NoMana" })
		return
	end
	if (def.Stamina or 0) > 0 and c.Stamina <= 0 then
		fx:FireClient(player, { Type = "ActionDenied", Action = "Ability", Reason = "NoStamina" })
		return
	end
	-- ShadowStep needs a valid target before paying costs
	local target
	if def.Type == "ShadowStep" then
		local entityId = payload.TargetId
		for _, e in S.EntityService.All() do
			if e.Id == entityId and e.Parent == nil and e.Kind ~= "Dummy" and CombatService.CanHit(rt, e) then
				target = e
			end
		end
		local tp = target and S.EntityService.Position(target)
		if not tp or (tp - rt.Root.Position).Magnitude > def.Range + C.MaxReachTolerance then
			fx:FireClient(player, { Type = "ActionDenied", Action = "Ability", Reason = "NoTarget" })
			return
		end
	end
	c.Mana -= def.Mana or 0
	if (def.Stamina or 0) > 0 then
		CombatCore.spendStamina(c, def.Stamina, t)
	end
	c.Cooldowns[id] = t + def.Cooldown
	local windup = def.Windup or 0.2
	c.ActionLockUntil = t + windup + 0.25
	c.DodgeCancelFrom = t + windup
	c.Blocking = false
	fx:FireClient(player, { Type = "AbilityCast", Ability = id, Windup = windup, Cooldown = def.Cooldown })
	playSlash(rt, true)
	local seq = c.AttackSeq or 0
	local attrs = rt.Stats.Attributes
	local power = Formulas.abilityPower(def, attrs, rt.Profile.Level)

	if def.Type == "Buff" then
		CombatCore.addBuff(c, def.Buff, def.Amount, def.Duration, t)
		if def.Poise then
			CombatCore.addBuff(c, "Poise", def.Poise, def.Duration, t)
		end
		fx:FireClient(player, { Type = "Buff", Buff = def.Buff, Duration = def.Duration })
		return
	elseif def.Type == "ShadowStep" then
		local tp = S.EntityService.Position(target)
		if tp and target.Root then
			local behind = tp - target.Root.CFrame.LookVector * (target.Radius + 3)
			S.AntiCheatService.AllowTeleport(player)
			rt.Character:PivotTo(CFrame.lookAt(Vector3.new(behind.X, rt.Root.Position.Y, behind.Z), Vector3.new(tp.X, rt.Root.Position.Y, tp.Z)))
			c.CritUntil = t + def.CritDuration
			fxNear(rt.Root.Position, { Type = "Blink", Position = rt.Root.Position }, 120)
		end
		return
	end

	task.delay(windup, function()
		if c.Dead or (c.AttackSeq or 0) ~= seq or not rt.Root or not rt.Root.Parent then
			return
		end
		local root = rt.Root
		local pos = root.Position
		local look = root.CFrame.LookVector
		local dtype = def.DamageType
		local poise = def.Poise or 20
		local function applySlow(e)
			if def.Slow then
				e.Target.SlowUntil = now() + def.Slow.Duration
				e.Target.SlowAmount = def.Slow.Amount
			end
		end
		if def.Type == "Heal" then
			local amount = Formulas.healAmount(def, attrs, c.MaxHealth, rt.Stats.Bonuses.HealingPower)
			CombatCore.heal(c, amount)
			fx:FireClient(player, { Type = "Heal", Amount = amount })
			-- allies = party members (never opponents in the PvP pit)
			for _, plr in S.PartyService.Members(player) do
				local ort = S.PlayerStateService.Get(plr)
				if ort and ort ~= rt and ort.Root and ort.Combat and not ort.Combat.Dead and (ort.Root.Position - pos).Magnitude <= def.AllyRadius then
					local a = math.floor(ort.Combat.MaxHealth * (amount / c.MaxHealth) * def.AllyFraction)
					CombatCore.heal(ort.Combat, a)
					S.PlayerStateService.PushVitals(plr)
					fx:FireClient(plr, { Type = "Heal", Amount = a, From = player.Name })
				end
			end
			fxNear(pos, { Type = "AbilityFx", Ability = id, Position = pos, Radius = def.AllyRadius }, 150)
			S.PlayerStateService.PushVitals(player)
		elseif def.Type == "Projectile" then
			fireProjectile(player, rt, payload.Aim, def.Speed, def.Radius, def.Range, power, 1, poise, dtype, def.Status, DAMAGE_COLORS[dtype] or DAMAGE_COLORS.Physical)
		elseif def.Type == "Circle" then
			fxNear(pos, { Type = "AbilityFx", Ability = id, Position = pos, Radius = def.Radius }, 150)
			for _, e in S.EntityService.Near(pos, def.Radius, 10) do
				if not e.Parent then
					CombatService.HitEntity(player, rt, e, power, 1, poise, dtype, def.Status, "Ability")
					applySlow(e)
				end
			end
			for _, victim in pvpTargets(rt) do
				local vrt = S.PlayerStateService.Get(victim)
				if (vrt.Root.Position - pos).Magnitude <= def.Radius then
					hitPlayerPvp(player, rt, victim, power, 1, poise, dtype)
				end
			end
		elseif def.Type == "Cone" or def.Type == "Line" then
			if def.Dash then
				fx:FireClient(player, { Type = "Dash", Distance = def.Length })
			end
			fxNear(pos, { Type = "AbilityFx", Ability = id, Position = pos, Direction = look, Length = def.Length or def.Range, Width = def.Width, Arc = def.Arc }, 150)
			for _, e in S.EntityService.Near(pos, (def.Length or def.Range) + 2, 12) do
				local ep = S.EntityService.Position(e)
				local inside = if def.Type == "Cone"
					then Geometry.inCone(pos.X, pos.Z, look.X, look.Z, ep.X, ep.Z, def.Range, def.Arc, e.Radius)
					else Geometry.inLine(pos.X, pos.Z, look.X, look.Z, ep.X, ep.Z, def.Length, def.Width, e.Radius)
				if inside and not e.Parent then
					CombatService.HitEntity(player, rt, e, power, 1, poise, dtype, def.Status, "Ability")
					applySlow(e)
				end
			end
		end
	end)
end

local function onAction(player: Player, payload)
	if type(payload) ~= "table" or type(payload.Kind) ~= "string" then
		return
	end
	if not allow(player) then
		return
	end
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Combat or not rt.Root or rt.Combat.Dead or rt.Profile.Class == "" then
		return
	end
	local kind = payload.Kind
	if kind == "Light" or kind == "Heavy" then
		onAttack(player, rt, kind, payload)
	elseif kind == "HeavyStart" then
		CombatCore.beginCharge(rt.Combat, workspace:GetServerTimeNow())
	elseif kind == "Dodge" then
		onDodge(player, rt, payload)
	elseif kind == "Parry" then
		onParry(player, rt)
	elseif kind == "Block" then
		onBlock(player, rt, payload)
	elseif kind == "Sprint" then
		S.PlayerStateService.SetSprinting(player, payload.On == true)
	elseif kind == "Ability" then
		onAbility(player, rt, payload)
	elseif kind == "Flask" then
		useFlask(player, rt)
	elseif kind == "Item" then
		useItem(player, rt, payload.ItemId)
	elseif kind == "Rep" then
		if S.TrainingService then
			S.TrainingService.OnRep(player)
		end
	end
end

-- ===================================================================== Incoming hostile hits
--[[
	spec = { Damage, DamageType, Poise, Parryable, Blockable, Status, Attacker?, PvpAttacker?, Tick? }
	sourcePos = where the hit came from (for block/parry facing)
]]
function CombatService.QueueHostileHit(player: Player, spec, sourcePos: Vector3)
	local hitTime = now()
	task.delay(C.LatencyGrace, function()
		local rt = S.PlayerStateService.Get(player)
		if not rt or not rt.Combat or not rt.Root or not rt.Root.Parent then
			return
		end
		local c = rt.Combat
		local root = rt.Root
		local toSource = Vector3.new(sourcePos.X - root.Position.X, 0, sourcePos.Z - root.Position.Z)
		local look = root.CFrame.LookVector
		local facing = toSource.Magnitude < 0.5
			or Geometry.angleTo(0, 0, look.X, look.Z, toSource.X, toSource.Z) <= C.BlockAngle / 2
		local wasSeq = c.AttackSeq or 0
		local r = CombatCore.resolveIncoming(c, spec, hitTime, rt.Stats, facing)
		if r.Staggered or r.GuardBroken or r.Died then
			c.AttackSeq = wasSeq + 1 -- cancels any pending swing
		end
		if r.Outcome == "Ignored" or r.Outcome == "Immune" then
			return
		end
		if spec.Attacker and spec.Attacker.OnHitPlayer then
			task.spawn(spec.Attacker.OnHitPlayer, player, r.Outcome)
		end
		if r.Outcome == "Parried" then
			AchievementCore.increment(rt.Profile, "Parries")
			CombatService.OnParried(player, spec)
			fxNear(root.Position, { Type = "Parry", Position = root.Position + look * 2 }, 120)
			return
		elseif r.Outcome == "Dodged" then
			fx:FireClient(player, { Type = "Dodged" })
			return
		end
		if r.Damage > 0 and rt.Encounter and S.BossService then
			S.BossService.RecordHitTaken(player)
		end
		S.PlayerStateService.PushVitals(player)
		fx:FireClient(player, {
			Type = "Hurt",
			Amount = r.Damage,
			Outcome = r.Outcome,
			Staggered = r.Staggered,
			GuardBroken = r.GuardBroken,
			Procs = r.StatusProcs,
			Source = sourcePos,
		})
		player:SetAttribute("Blocking", c.Blocking)
		for _, proc in r.StatusProcs do
			if proc == "Bleed" then
				CombatCore.applyDamage(c, math.floor(c.MaxHealth * CombatCore.bleedFraction("Player")))
				S.PlayerStateService.PushVitals(player)
			end
		end
		if c.Dead then
			local killer = spec.PvpAttacker
			if killer then
				local krt = S.PlayerStateService.Get(killer)
				if krt then
					AchievementCore.increment(krt.Profile, "PvPWins")
				end
			end
			S.DeathService.OnPlayerDeath(player, if killer then "PvP" else "Combat")
		end
	end)
end

-- A parried attacker is staggered (non-bosses) or loses a big chunk of poise (bosses).
function CombatService.OnParried(player: Player, spec)
	local attacker = spec.Attacker
	if spec.PvpAttacker then
		local art = S.PlayerStateService.Get(spec.PvpAttacker)
		if art and art.Combat then
			local t = now()
			art.Combat.StaggeredUntil = t + C.StaggerDuration * 2
			art.Combat.ActionLockUntil = math.max(art.Combat.ActionLockUntil, art.Combat.StaggeredUntil)
			art.Combat.AttackSeq = (art.Combat.AttackSeq or 0) + 1
			fx:FireClient(spec.PvpAttacker, { Type = "Hurt", Amount = 0, Staggered = true, Outcome = "Parried" })
		end
		return
	end
	if not attacker or not attacker.Entity then
		return
	end
	local e = attacker.Entity
	local t = now()
	if e.Kind == "Boss" then
		local reward = attacker.ParryReward or 1
		local r = CombatCore.damageTarget(e.Target, 0, e.Target.MaxPoise * 0.34 * reward, t)
		if r.Staggered then
			fxNear(S.EntityService.Position(e) or Vector3.zero, { Type = "Stagger", EntityId = e.Id }, 200)
		end
	else
		e.Target.StaggeredUntil = t + C.EnemyStaggerDuration
		fxNear(S.EntityService.Position(e) or Vector3.zero, { Type = "Stagger", EntityId = e.Id }, 200)
	end
end

function CombatService.UseItemFromMenu(player: Player, itemId)
	local rt = S.PlayerStateService.Get(player)
	if rt and rt.Combat and not rt.Combat.Dead and rt.Profile.Class ~= "" then
		useItem(player, rt, itemId)
	end
end

function CombatService.Start()
	Net.event("Action").OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--[[
	CosmeticService
	Purely visual: auras (particles), weapon finishes, armour dyes and the overhead title.
	Nothing here reads or writes combat statistics.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Config.Cosmetics)
local Classes = require(Shared.Config.Classes)

local CosmeticService = {}
local S

function CosmeticService.Init(services)
	S = services
end

function CosmeticService.Refresh(player: Player)
	local rt = S.PlayerStateService.Get(player)
	local char = rt and rt.Character
	if not char or not rt.Root then
		return
	end
	local eq = rt.Profile.Cosmetics.Equipped
	-- aura
	local old = rt.Root:FindFirstChild("CosmeticAura")
	if old then
		old:Destroy()
	end
	local aura = Cosmetics[eq.Aura]
	if aura and aura.Type == "Aura" and rt.Profile.Cosmetics.Owned[eq.Aura] then
		local e = Instance.new("ParticleEmitter")
		e.Name = "CosmeticAura"
		e.Color = ColorSequence.new(aura.Color)
		e.LightEmission = 0.6
		e.Rate = 12
		e.Lifetime = NumberRange.new(1, 1.6)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new(0.5, 0)
		e.Transparency = NumberSequence.new(0.3, 1)
		e.Parent = rt.Root
	end
	-- armour dye tints body colors (cosmetic only)
	local dye = Cosmetics[eq.ArmorDye]
	local bc = char:FindFirstChildOfClass("BodyColors")
	if bc and dye and dye.Type == "ArmorDye" and rt.Profile.Cosmetics.Owned[eq.ArmorDye] then
		bc.TorsoColor3 = dye.Color
		bc.LeftLegColor3 = dye.Color
		bc.RightLegColor3 = dye.Color
	end
	-- overhead title
	local head = char:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("TitleTag") :: BillboardGui?
		if not tag then
			local b = Instance.new("BillboardGui")
			b.Name = "TitleTag"
			b.Size = UDim2.fromOffset(220, 46)
			b.StudsOffset = Vector3.new(0, 2.6, 0)
			b.MaxDistance = 80
			b.AlwaysOnTop = false
			local name = Instance.new("TextLabel")
			name.Name = "NameLabel"
			name.BackgroundTransparency = 1
			name.Size = UDim2.new(1, 0, 0.55, 0)
			name.Font = Enum.Font.Garamond
			name.TextScaled = true
			name.TextColor3 = Color3.fromRGB(235, 225, 200)
			name.TextStrokeTransparency = 0.4
			name.Parent = b
			local title = Instance.new("TextLabel")
			title.Name = "TitleLabel"
			title.BackgroundTransparency = 1
			title.Position = UDim2.new(0, 0, 0.55, 0)
			title.Size = UDim2.new(1, 0, 0.45, 0)
			title.Font = Enum.Font.Garamond
			title.TextScaled = true
			title.TextColor3 = Color3.fromRGB(230, 180, 90)
			title.TextStrokeTransparency = 0.5
			title.Parent = b
			b.Parent = head
			tag = b
		end
		local class = Classes[rt.Profile.Class]
		local nameLabel = (tag :: BillboardGui):FindFirstChild("NameLabel") :: TextLabel
		local titleLabel = (tag :: BillboardGui):FindFirstChild("TitleLabel") :: TextLabel
		nameLabel.Text = ("%s  Lv.%d"):format(player.DisplayName, rt.Profile.Level)
		local t = rt.Profile.ActiveTitle
		titleLabel.Text = if t ~= "" then ("<%s>"):format(t) elseif class then class.Name else ""
		local hum = rt.Humanoid
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
end

function CosmeticService.Start()
	S.PlayerStateService.CharacterReady:Connect(function(player)
		task.delay(0.5, CosmeticService.Refresh, player)
	end)
	S.RequestService.Register("EquipCosmetic", function(player, rt, payload)
		if type(payload) ~= "table" or type(payload.Slot) ~= "string" then
			return false, "BadRequest"
		end
		local slot = payload.Slot
		if rt.Profile.Cosmetics.Equipped[slot] == nil then
			return false, "BadSlot"
		end
		local id = payload.Id
		if id ~= "" then
			local c = Cosmetics[id]
			local typeForSlot = { Aura = "Aura", WeaponSkin = "WeaponSkin", ArmorDye = "ArmorDye" }
			if not c or c.Type ~= typeForSlot[slot] or not rt.Profile.Cosmetics.Owned[id] then
				return false, "NotOwned"
			end
		end
		rt.Profile.Cosmetics.Equipped[slot] = id
		CosmeticService.Refresh(player)
		if slot == "WeaponSkin" then
			S.InventoryService.ApplyWeaponVisual(player)
		end
		S.PlayerStateService.Sync(player)
		return true, id
	end)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService
	Persistent player data with DataStoreService.

	Session locking (prevents duplication across servers):
	  Stored value = { Data = profile, Lock = { JobId, Time } }
	  * Load: UpdateAsync acquires the lock if it is free, ours, or stale (> LockStaleSeconds).
	    If another live server holds it we retry LockAcquireAttempts times, then take it over.
	    Taking over is safe because every later save from the old server checks the lock and
	    refuses to write once it no longer owns it.
	  * Save: UpdateAsync writes only while we own the lock (and refreshes Lock.Time).
	  * Release: on leave, final save clears the lock.

	Failure handling:
	  * Load failures retry with backoff. In a live game, if loading ultimately fails the player
	    is kicked with an explanation - we never let them play on a blank profile that could
	    overwrite real progress.
	  * In Studio without API access the service falls back to in-memory data and marks the
	    player with attribute DataUnsaved = true so the HUD shows a visible warning.
	  * Save failures retry; persistent failures set DataSaveFailing = true (HUD warning).
	  * BindToClose saves every loaded profile in parallel before shutdown.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)
local ProfileSchema = require(script.Parent.Parent.Core.ProfileSchema)

local SaveCfg = GameConfig.Save

local DataService = {
	ProfileLoaded = Signal.new(), -- (player, profile)
	BeforeSave = Signal.new(),
}

local profiles: { [Player]: any } = {}
local saving: { [Player]: boolean } = {}
local released: { [Player]: boolean } = {}
local store: DataStore? = nil
local memoryMode = false
local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

local function keyFor(player: Player): string
	return SaveCfg.KeyPrefix .. player.UserId
end

local function retry(label: string, fn: () -> any)
	local lastErr
	for attempt = 1, SaveCfg.MaxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(("[DataService] %s failed (attempt %d): %s"):format(label, attempt, tostring(result)))
		task.wait(SaveCfg.RetryBaseDelay * attempt)
	end
	return false, lastErr
end

function DataService.Init(_services)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(SaveCfg.StoreName)
	end)
	if ok then
		store = result
		-- In Studio, probe access once; without "Enable Studio Access to API Services" this errors.
		if RunService:IsStudio() then
			local probeOk = pcall(function()
				(result :: DataStore):GetAsync("__probe")
			end)
			if not probeOk then
				memoryMode = true
				warn("[DataService] DataStore unavailable in Studio: using in-memory data (progress will NOT be saved).")
			end
		end
	else
		memoryMode = true
		warn("[DataService] Could not open DataStore: " .. tostring(result))
	end
end

local function acquire(player: Player)
	if memoryMode or not store then
		return true, nil
	end
	local key = keyFor(player)
	for attempt = 1, SaveCfg.LockAcquireAttempts do
		local force = attempt == SaveCfg.LockAcquireAttempts
		local blocked = false
		local ok, value = retry("load " .. key, function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				old = old or {}
				local lock = old.Lock
				local now = os.time()
				if lock and lock.JobId ~= jobId and now - (lock.Time or 0) < SaveCfg.LockStaleSeconds and not force then
					blocked = true
					return nil -- abort write, keep their lock
				end
				old.Lock = { JobId = jobId, Time = now }
				return old
			end)
		end)
		if not ok then
			return false, value
		end
		if not blocked then
			return true, value and value.Data or nil
		end
		warn(("[DataService] %s locked by another server; retrying (%d/%d)"):format(key, attempt, SaveCfg.LockAcquireAttempts))
		task.wait(SaveCfg.LockRetryWait)
		if not player.Parent then
			return false, "left"
		end
	end
	return false, "lock"
end

-- Clears our session lock without writing data (player left while loading).
local function releaseLockOnly(player: Player)
	if memoryMode or not store then
		return
	end
	pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if old and old.Lock and old.Lock.JobId == jobId then
				old.Lock = nil
				return old
			end
			return nil
		end)
	end)
end

function DataService.Load(player: Player)
	local ok, raw = acquire(player)
	if not player.Parent then
		if ok then
			releaseLockOnly(player)
		end
		return nil
	end
	if not ok then
		if RunService:IsStudio() then
			memoryMode = true
			raw = nil
		else
			player:Kick("Tower of the Fallen could not load your save data safely. Your progress is untouched - please rejoin in a minute.")
			return nil
		end
	end
	local profile, corrections = ProfileSchema.reconcile(raw or ProfileSchema.default())
	if raw == nil then
		profile.CreatedAt = os.time()
	end
	if #corrections > 0 then
		warn(("[DataService] %d data corrections for %d: %s"):format(#corrections, player.UserId, table.concat(corrections, "; ")))
	end
	profiles[player] = profile
	player:SetAttribute("DataUnsaved", memoryMode)
	player:SetAttribute("DataSaveFailing", false)
	DataService.ProfileLoaded:Fire(player, profile)
	return profile
end

function DataService.Get(player: Player)
	return profiles[player]
end

-- Saves the profile. `release` clears the session lock (used on leave/shutdown).
function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or released[player] then
		return false
	end
	if memoryMode or not store then
		return true
	end
	while saving[player] do
		task.wait(0.1)
	end
	-- re-check after waiting: a release may have completed meanwhile, and a late autosave
	-- must never re-acquire the lock for a player who already left
	if released[player] or profiles[player] ~= profile then
		return false
	end
	if not release and not player.Parent then
		return false
	end
	saving[player] = true
	DataService.BeforeSave:Fire(player, profile)
	profile.LastSaved = os.time()
	local lostLock = false
	local key = keyFor(player)
	local ok, err = retry("save " .. key, function()
		return (store :: DataStore):UpdateAsync(key, function(old)
			old = old or {}
			local lock = old.Lock
			if lock and lock.JobId ~= jobId then
				lostLock = true
				return nil -- another server owns this profile now; never overwrite it
			end
			local corrections = profile.Corrections
			profile.Corrections = nil
			old.Data = profile
			local copy = table.clone(old)
			profile.Corrections = corrections
			copy.Lock = if release then nil else { JobId = jobId, Time = os.time() }
			return copy
		end)
	end)
	saving[player] = nil
	if lostLock then
		warn("[DataService] session lock lost for " .. key .. "; stopping saves for this session")
		released[player] = true
		if player.Parent then
			player:Kick("Your character was loaded on another server. Please rejoin.")
		end
		return false
	end
	if player.Parent then
		player:SetAttribute("DataSaveFailing", not ok)
	end
	if not ok then
		warn("[DataService] save failed for " .. key .. ": " .. tostring(err))
	end
	return ok
end

function DataService.Release(player: Player)
	if profiles[player] then
		DataService.Save(player, true)
		released[player] = true
		profiles[player] = nil
	end
	saving[player] = nil
	task.delay(5, function()
		released[player] = nil
	end)
end

function DataService.IsMemoryMode(): boolean
	return memoryMode
end

function DataService.Start()
	-- Autosave loop
	task.spawn(function()
		while true do
			task.wait(SaveCfg.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				released[player] = true -- no later autosave may re-lock during shutdown
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.Release(player)
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">DeathService</string>
            <string name="Source"><![CDATA[--[[
	DeathService
	Handles every player death: currency drop via DeathCore, recovery markers, encounter
	removal, statistics, saving and respawning at the last rested shrine.

	Marker placement rules:
	  * normal death: where the player died
	  * fell out of the world: last position the player stood on solid ground
	  * death inside a tower arena: in front of the Tower Gate (arenas are temporary instances)
	  * PvP arena deaths cost nothing (DeathCore NoLoss)
	Recovery is automatic when the OWNER walks within RecoveryRadius. The marker is visible
	only to its owner (clients hide other players' markers) and shows no personal data.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local World = require(Shared.Config.World)
local Net = require(Shared.Net)
local DeathCore = require(script.Parent.Parent.Core.DeathCore)
local AchievementCore = require(script.Parent.Parent.Core.AchievementCore)

local DeathService = {}
local S
local folder: Folder
local markers: { [number]: BasePart } = {}

function DeathService.Init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "LostEmbers"
	folder.Parent = workspace
end

local function removeMarker(userId: number)
	local m = markers[userId]
	if m then
		m:Destroy()
		markers[userId] = nil
	end
end

function DeathService.RefreshMarker(player: Player)
	local rt = S.PlayerStateService.Get(player)
	removeMarker(player.UserId)
	if not rt then
		return
	end
	local lost = rt.Profile.LostCurrency
	if not lost then
		return
	end
	local p = Instance.new("Part")
	p.Name = "LostEmbers"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2, 2, 2)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 120, 40)
	p.CFrame = CFrame.new(lost.X, lost.Y + 2, lost.Z)
	p:SetAttribute("OwnerUserId", player.UserId)
	p:SetAttribute("Amount", lost.Amount)
	p:SetAttribute("ExpiresAt", lost.CreatedAt + GameConfig.Death.RecoveryExpirySeconds)
	local light = Instance.new("PointLight")
	light.Color = p.Color
	light.Range = 14
	light.Brightness = 2
	light.Parent = p
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60), Color3.fromRGB(255, 60, 20))
	fire.Rate = 20
	fire.Lifetime = NumberRange.new(0.8, 1.4)
	fire.Speed = NumberRange.new(2, 4)
	fire.Size = NumberSequence.new(0.6, 0)
	fire.LightEmission = 1
	fire.Parent = p
	-- a tall beam so the marker can be found from a distance
	local beam = Instance.new("Part")
	beam.Name = "Beacon"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = p.Color
	beam.Transparency = 0.6
	beam.Size = Vector3.new(0.4, 60, 0.4)
	beam.CFrame = p.CFrame * CFrame.new(0, 30, 0)
	beam.Parent = p
	p.Parent = folder
	markers[player.UserId] = p
end

local function spawnPoint(): Vector3
	local sp = World.SpawnPoint
	return Vector3.new(sp[1], sp[2], sp[3])
end

function DeathService.OnPlayerDeath(player: Player, cause: string)
	local rt = S.PlayerStateService.Get(player)
	if not rt or rt.DeathHandled then
		return
	end
	rt.DeathHandled = true
	local c = rt.Combat
	if c then
		c.Dead = true
		c.Health = 0
	end
	if rt.Humanoid and rt.Humanoid.Health > 0 then
		rt.Humanoid.Health = 0
	end
	local profile = rt.Profile
	AchievementCore.increment(profile, "Deaths")

	-- where should the recovery marker go?
	local pos
	if rt.Encounter then
		local g = World.Tower.GatePosition
		pos = Vector3.new(g[1] + math.random(-6, 6), g[2], g[3] + 14)
	elseif rt.Root and rt.Root.Position.Y > -40 then
		pos = rt.Root.Position - Vector3.new(0, 2.5, 0)
	else
		pos = rt.LastGroundPos or spawnPoint()
	end
	local noLoss = rt.Region == "pvp" or cause == "PvP" or (rt.Training ~= nil and rt.Training.Def.Kind == "Spar")
	local r = DeathCore.onDeath(profile, pos.X, pos.Y, pos.Z, os.time(), { NoLoss = noLoss })

	if rt.Encounter then
		S.BossService.OnParticipantDied(player)
	end
	if S.TrainingService then
		S.TrainingService.OnPlayerDied(player)
	end

	local sub
	if noLoss then
		sub = "No embers were lost."
	elseif r.Dropped > 0 then
		sub = ("%d %s lie where you fell."):format(r.Dropped, GameConfig.Currency.Name)
	else
		sub = "You carried no embers."
	end
	if r.LostForever > 0 then
		sub ..= (" Your previous %d %s are gone."):format(r.LostForever, GameConfig.Currency.Name)
	end
	Net.event("Notify"):FireClient(player, { Banner = true, Death = true, Text = "YOU DIED", Subtitle = sub, Kind = "Death" })
	DeathService.RefreshMarker(player)
	S.PlayerStateService.Sync(player)
	task.spawn(S.DataService.Save, player)

	task.delay(Players.RespawnTime, function()
		if player.Parent and S.PlayerStateService.Get(player) == rt then
			player:LoadCharacter()
		end
	end)
end

function DeathService.Start()
	S.PlayerStateService.CharacterReady:Connect(function(player)
		DeathService.RefreshMarker(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeMarker(player.UserId)
	end)
	-- recovery + expiry + last-ground tracking loop
	task.spawn(function()
		while true do
			task.wait(0.3)
			local t = os.time()
			for player, rt in S.PlayerStateService.All() do
				local root = rt.Root
				local hum = rt.Humanoid
				if root and root.Parent and rt.Combat and not rt.Combat.Dead then
					-- safety net: falling out of the open world returns you to solid ground instead
					-- of killing you (arenas handle their own falls)
					if root.Position.Y < -60 and rt.Encounter == nil and rt.Character then
						local back = (rt.LastGroundPos or S.PlayerStateService.RespawnPosition(player)) + Vector3.new(0, 6, 0)
						S.AntiCheatService.AllowTeleport(player)
						root.AssemblyLinearVelocity = Vector3.zero
						rt.Character:PivotTo(CFrame.new(back))
						S.NotifyService.Toast(player, "The abyss rejects you.", "Warning")
					end
					if hum and hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > -40 and rt.Encounter == nil then
						rt.LastGroundPos = root.Position - Vector3.new(0, 2.5, 0)
					end
					local lost = rt.Profile.LostCurrency
					if lost then
						if DeathCore.expire(rt.Profile, t) > 0 then
							removeMarker(player.UserId)
							S.NotifyService.Toast(player, "Your lost embers have faded away.", "Warning")
							S.PlayerStateService.Sync(player)
						else
							local p = root.Position
							local ok, amount = DeathCore.recover(rt.Profile, p.X, p.Y - 2.5, p.Z, t)
							if ok then
								removeMarker(player.UserId)
								AchievementCore.increment(rt.Profile, "Recoveries")
								S.NotifyService.Banner(player, "EMBERS RECOVERED", ("+%d %s"):format(amount, GameConfig.Currency.Name), "Reward")
								S.ProgressionService.EvaluateAchievements(player)
								S.PlayerStateService.PushVitals(player)
								S.PlayerStateService.Sync(player)
								task.spawn(S.DataService.Save, player)
							end
						end
					end
				end
			end
		end
	end)
end

return DeathService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--[[
	EnemyService
	Controlled spawning and AI for Wildlands enemies, elites, mini-bosses, boss summons and
	training sparring partners.

	AI states: Idle -> Patrol -> Chase (detect) -> Attack -> Recover -> Stagger -> Return -> Dead
	* One loop updates every enemy at GameConfig.Enemy.TickRate; enemies with no player within
	  ActivationRadius sleep (cheap) and are only re-checked once per second.
	* Leash: an enemy pulled too far from home returns, fully heals and forgets contributors
	  (prevents kiting/farming exploits).
	* Stuck handling: jump, then a PathfindingService path; if no path, return home.
	* Spawn zones keep at most `Count` alive and respawn on a timer (no uncontrolled spawning).
	* Rewards: every player who dealt >= ContributionThreshold of max HP (or landed the kill)
	  gets their own XP, currency and loot roll. Nothing drops on the ground to be stolen.
]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Enemies = require(Shared.Config.Enemies)
local World = require(Shared.Config.World)
local Rng = require(Shared.Util.Rng)
local Core = script.Parent.Parent.Core
local BossBrain = require(Core.BossBrain)
local LootCore = require(Core.LootCore)
local EntityModels = require(script.Parent.EntityModels)

local EnemyService = {}
local S
local folder: Folder
local ais = {} -- [ai] = true
local zones = {}
local rng = Rng.new()

local function now()
	return workspace:GetServerTimeNow()
end

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

function EnemyService.Init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Entities"
	folder.Parent = workspace
end

function EnemyService.Folder()
	return folder
end

local function validTarget(ai, player: Player): boolean
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Root or not rt.Root.Parent or not rt.Combat or rt.Combat.Dead then
		return false
	end
	if ai.Restrict then
		return ai.Restrict(player)
	end
	-- world enemies never follow players into safe zones or tower arenas
	return not player:GetAttribute("Safe") and rt.Encounter == nil
end

local function targetsFor(ai)
	if ai.TargetsFn then
		return ai.TargetsFn()
	end
	local out = {}
	local pos = ai.Root.Position
	for _, plr in Players:GetPlayers() do
		if validTarget(ai, plr) then
			local rt = S.PlayerStateService.Get(plr)
			if (rt.Root.Position - pos).Magnitude <= 120 then
				table.insert(out, plr)
			end
		end
	end
	return out
end

local function grantRewards(ai, killer: Player?)
	local def = ai.Def
	if ai.NoRewards or def.Tier == "Summon" then
		return
	end
	local e = ai.Entity
	local threshold = e.Target.MaxHealth * GameConfig.Enemy.ContributionThreshold
	for userId, dmg in e.Contributors do
		local plr = Players:GetPlayerByUserId(userId)
		if plr and (dmg >= threshold or plr == killer) then
			local loot = LootCore.roll(def.Loot, rng)
			local currency = LootCore.rollRange(def.Currency, rng)
			S.ProgressionService.OnEnemyKilled(plr, def)
			S.ProgressionService.GrantXp(plr, def.Xp, def.Name)
			S.ProgressionService.GrantCurrency(plr, currency)
			if next(loot) then
				S.ProgressionService.GrantItems(plr, loot, def.Name)
			end
			if def.Tier == "MiniBoss" then
				S.NotifyService.Banner(plr, "FOE VANQUISHED", def.Name, "Victory")
			end
			S.CombatService.SendFx(plr, { Type = "Reward", Xp = def.Xp, Currency = currency, Position = ai.Root and ai.Root.Position })
			S.ProgressionService.EvaluateAchievements(plr)
			S.PlayerStateService.Sync(plr)
			S.PlayerStateService.PushVitals(plr)
		end
	end
end

function EnemyService.Despawn(ai, fade: boolean?)
	ais[ai] = nil
	ai.Dead = true
	if ai.Entity and ai.Entity.Alive then
		S.EntityService.Unregister(ai.Entity)
	end
	local model = ai.Model
	if not model or not model.Parent then
		return
	end
	if fade then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") and p.Transparency < 1 then
				TweenService:Create(p, TweenInfo.new(1.2), { Transparency = 1 }):Play()
			end
		end
		task.delay(1.3, function()
			model:Destroy()
		end)
	else
		model:Destroy()
	end
end

--[[
	opts = { Zone?, Home?: Vector3, TargetsFn?, Restrict?, BaseDamage?, HealthScale?, Floor?,
	         Leash?, NoRewards?, OnDeath?, ArenaCenter?, ArenaRadius?, Name? }
]]
function EnemyService.Spawn(enemyId: string, position: Vector3, opts)
	local def = Enemies[enemyId]
	if not def then
		warn("[EnemyService] unknown enemy " .. tostring(enemyId))
		return nil
	end
	opts = opts or {}
	local model, root, humanoid, radius, height, shoulder = EntityModels.build(opts.Name or def.Name, def.Model, "Enemy")
	local groundY = S.AttackExecutor.GroundY(position, position.Y)
	model:PivotTo(CFrame.new(position.X, groundY + humanoid.HipHeight + root.Size.Y / 2, position.Z))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	humanoid.WalkSpeed = def.WalkSpeed
	local maxHp = math.floor(def.Health * (opts.HealthScale or 1))
	local ai = {
		Def = def,
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Shoulder = shoulder,
		Home = opts.Home or position,
		Zone = opts.Zone,
		State = "Idle",
		Target = nil,
		Busy = false,
		NextAttackAt = 0,
		Cooldowns = {},
		History = {},
		Rng = Rng.new(math.floor(os.clock() * 1000) + math.random(1, 1e6)),
		LastPos = root.Position,
		StuckSince = nil,
		Leash = opts.Leash or def.Leash or GameConfig.Enemy.DefaultLeash,
		TargetsFn = opts.TargetsFn,
		Restrict = opts.Restrict,
		NoRewards = opts.NoRewards,
		Floor = opts.Floor,
		ArenaCenter = opts.ArenaCenter,
		ArenaRadius = opts.ArenaRadius,
	}
	ai.Attacker = {
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Shoulder = shoulder,
		BaseDamage = opts.BaseDamage or def.Damage,
		Floor = opts.Floor,
		ArenaCenter = opts.ArenaCenter,
		ArenaRadius = opts.ArenaRadius,
		Targets = function()
			return targetsFor(ai)
		end,
		OnHitPlayer = opts.OnHitPlayer,
	}
	ai.Entity = S.EntityService.Register({
		Kind = if def.Tier == "MiniBoss" then "MiniBoss" else "Enemy",
		Encounter = opts.Encounter,
		Owner = opts.Owner,
		Model = model,
		Root = root,
		Name = opts.Name or def.Name,
		Level = def.Level,
		MaxHealth = maxHp,
		Poise = def.Poise,
		Defense = def.Defense,
		Radius = radius,
		Def = def,
		OnDeath = function(e, killer)
			ai.Dead = true
			ais[ai] = nil
			grantRewards(ai, killer)
			if opts.OnDeath then
				opts.OnDeath(ai, killer)
			end
			if ai.Zone then
				ai.Zone.Alive -= 1
				ai.Zone.NextSpawn[#ai.Zone.NextSpawn + 1] = os.clock() + (ai.Zone.RespawnTime or def.RespawnTime)
			end
			EnemyService.Despawn(ai, true)
		end,
	})
	ai.Attacker.Entity = ai.Entity
	-- being hit always provokes a reaction: chase the attacker if reachable, otherwise retreat
	-- home and fully heal (prevents risk-free sniping from beyond aggro/leash range)
	ai.Entity.OnDamaged = function(_, player)
		if not player or ai.Dead or ai.Target == player then
			return
		end
		local prt = S.PlayerStateService.Get(player)
		local reachable = prt ~= nil and prt.Root ~= nil and validTarget(ai, player)
			and (Vector3.new(prt.Root.Position.X, 0, prt.Root.Position.Z) - Vector3.new(ai.Home.X, 0, ai.Home.Z)).Magnitude <= ai.Leash
		if reachable then
			ai.Target = player
		elseif not ai.Target then
			ai.State = "Return"
			ai.ForceReset = true
		end
	end
	model:SetAttribute("Height", height)
	model:SetAttribute("Tier", def.Tier)
	ais[ai] = true
	return ai
end

local function nearestPlayer(ai, radius: number): Player?
	local best, bestD = nil, radius
	local pos = ai.Root.Position
	for _, plr in Players:GetPlayers() do
		if validTarget(ai, plr) then
			local d = (S.PlayerStateService.Get(plr).Root.Position - pos).Magnitude
			if d < bestD then
				best, bestD = plr, d
			end
		end
	end
	return best
end

local function anyPlayerNear(pos: Vector3, radius: number): boolean
	for _, rt in S.PlayerStateService.All() do
		if rt.Root and rt.Root.Parent and (rt.Root.Position - pos).Magnitude <= radius then
			return true
		end
	end
	return false
end

local function followPath(ai, goal: Vector3)
	if ai.Pathing then
		return
	end
	ai.Pathing = true
	task.spawn(function()
		local path = PathfindingService:CreatePath({ AgentRadius = math.min(4, ai.Entity.Radius), AgentHeight = 5, AgentCanJump = true })
		local ok = pcall(function()
			path:ComputeAsync(ai.Root.Position, goal)
		end)
		if not ok or path.Status ~= Enum.PathStatus.Success then
			ai.Pathing = false
			ai.State = "Return"
			return
		end
		for _, wp in path:GetWaypoints() do
			if ai.Dead or ai.State ~= "Chase" or ai.Busy then
				break
			end
			if wp.Action == Enum.PathWaypointAction.Jump then
				ai.Humanoid.Jump = true
			end
			ai.Humanoid:MoveTo(wp.Position)
			local reached = ai.Humanoid.MoveToFinished:Wait()
			if not reached then
				break
			end
		end
		ai.Pathing = false
		ai.StuckSince = nil
	end)
end

local function think(ai, dt: number)
	if ai.Dead or not ai.Root.Parent then
		ais[ai] = nil
		return
	end
	local t = now()
	local e = ai.Entity
	local hum = ai.Humanoid
	local pos = ai.Root.Position
	S.EntityService.TickStatus(e, dt, t)
	if ai.Dead then
		return
	end
	-- slow debuff
	local slow = if t < e.Target.SlowUntil then e.Target.SlowAmount else 0
	hum.WalkSpeed = ai.Def.WalkSpeed * (1 - slow) * (ai.SpeedMult or 1)
	if pos.Y < -60 then
		-- fell out of the world (or was flung): no rewards for anyone
		ai.NoRewards = true
		S.EntityService.Kill(e, nil)
		return
	end
	if ai.Busy then
		return
	end
	if t < e.Target.StaggeredUntil then
		ai.State = "Stagger"
		hum:MoveTo(pos)
		return
	end

	local distHome = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(ai.Home.X, 0, ai.Home.Z)).Magnitude
	if ai.State == "Return" then
		hum:MoveTo(ai.Home)
		if distHome < 6 or ai.ForceReset then
			ai.ForceReset = false
			ai.State = "Idle"
			e.Target.Health = e.Target.MaxHealth
			e.Contributors = {}
			S.EntityService.PushHealth(e)
		end
		return
	end

	if ai.Target and not validTarget(ai, ai.Target) then
		ai.Target = nil
	end
	if not ai.Target then
		ai.Target = nearestPlayer(ai, ai.Def.AggroRadius)
		if not ai.Target then
			if distHome > 8 then
				ai.State = "Return"
			elseif ai.State ~= "Patrol" or math.random() < 0.02 then
				ai.State = "Patrol"
				if math.random() < 0.3 then
					local ang = math.random() * math.pi * 2
					hum:MoveTo(ai.Home + Vector3.new(math.cos(ang), 0, math.sin(ang)) * math.random(3, 12))
				end
			end
			return
		end
	end

	ai.State = "Chase"
	if distHome > ai.Leash then
		ai.Target = nil
		ai.State = "Return"
		return
	end
	local trt = S.PlayerStateService.Get(ai.Target)
	local tpos = trt.Root.Position
	local dist = (Vector3.new(tpos.X, 0, tpos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude - e.Radius
	if t >= ai.NextAttackAt then
		local attack = BossBrain.choose(ai.Def.Attacks, { Distance = dist, Now = t, Cooldowns = ai.Cooldowns, History = ai.History, Rng = ai.Rng })
		if attack then
			BossBrain.recordChoice({ Cooldowns = ai.Cooldowns, History = ai.History }, attack, t)
			ai.Busy = true
			ai.State = "Attack"
			local target = ai.Target
			task.spawn(function()
				S.AttackExecutor.Run(ai.Attacker, attack, target)
				ai.Busy = false
				ai.State = "Recover"
				ai.NextAttackAt = now() + 0.4 + ai.Rng:NextNumber() * 1.0
			end)
			return
		end
	end
	-- approach
	if not ai.Pathing then
		local keep = math.max(2, (ai.Def.Attacks[1].MaxRange or 6) * 0.6)
		if dist > keep then
			hum:MoveTo(tpos)
		else
			hum:MoveTo(pos)
			ai.Root.CFrame = CFrame.lookAt(pos, Vector3.new(tpos.X, pos.Y, tpos.Z))
		end
		-- stuck detection
		if (pos - ai.LastPos).Magnitude < 0.3 and dist > keep + 2 then
			ai.StuckSince = ai.StuckSince or os.clock()
			local stuckFor = os.clock() - ai.StuckSince
			if stuckFor > 1.2 then
				hum.Jump = true
			end
			if stuckFor > 2.5 then
				followPath(ai, tpos)
			end
		else
			ai.StuckSince = nil
		end
	end
	ai.LastPos = pos
end

local function spawnInZone(zone)
	local def = Enemies[zone.Def.Enemy]
	local ang = rng:NextNumber() * math.pi * 2
	local r = rng:NextNumber() * zone.Def.Radius
	local c = v3(zone.Def.Center)
	local pos = c + Vector3.new(math.cos(ang) * r, 10, math.sin(ang) * r)
	local ai = EnemyService.Spawn(zone.Def.Enemy, pos, { Zone = zone, Home = Vector3.new(pos.X, c.Y, pos.Z) })
	if ai then
		zone.Alive += 1
	end
	return def
end

function EnemyService.ActiveCount(): number
	local n = 0
	for _ in ais do
		n += 1
	end
	return n
end

function EnemyService.Start()
	for _, z in World.SpawnZones do
		local zone = { Def = z, Alive = 0, NextSpawn = {}, RespawnTime = z.RespawnTime }
		table.insert(zones, zone)
		for _ = 1, z.Count do
			table.insert(zone.NextSpawn, 0)
		end
	end

	-- spawn manager (1 Hz)
	task.spawn(function()
		while true do
			local clock = os.clock()
			for _, zone in zones do
				for i = #zone.NextSpawn, 1, -1 do
					if clock >= zone.NextSpawn[i] and zone.Alive < zone.Def.Count and EnemyService.ActiveCount() < GameConfig.Enemy.MaxActive then
						-- don't pop enemies into existence right next to a player
						if not anyPlayerNear(v3(zone.Def.Center), 25) then
							table.remove(zone.NextSpawn, i)
							spawnInZone(zone)
						end
					end
				end
			end
			task.wait(1)
		end
	end)

	-- AI loop
	task.spawn(function()
		local sleepCheck = 0
		while true do
			local dt = task.wait(GameConfig.Enemy.TickRate)
			sleepCheck += dt
			local checkSleep = sleepCheck >= 1
			if checkSleep then
				sleepCheck = 0
			end
			for ai in ais do
				if checkSleep and not ai.TargetsFn then
					ai.Asleep = not anyPlayerNear(ai.Root.Position, GameConfig.Enemy.ActivationRadius)
				end
				if not ai.Asleep then
					local ok, err = pcall(think, ai, dt)
					if not ok then
						warn("[EnemyService] AI error: " .. tostring(err))
						ai.Busy = false
					end
				end
			end
		end
	end)
end

return EnemyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">EntityModels</string>
            <string name="Source"><![CDATA[--[[
	EntityModels
	Procedural, original silhouettes for enemies, bosses and player weapons, built from parts.
	No external assets are required. Each model has:
	  HumanoidRootPart (collidable, invisible), Humanoid (movement only; HP is custom),
	  body parts welded to the root, and an "Arm" Motor6D used for simple swing animations.

	Styles: Humanoid, Brute, Beast, Crawler, Caster, Colossus, Golem, Winged, Serpent
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Cosmetics = require(Shared.Config.Cosmetics)

local EntityModels = {}

local function darker(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function addGlow(part: BasePart, color: Color3, range: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = 1.4
	light.Parent = part
end

-- Weapon mesh made of parts, attached to `hand` facing forward/down.
local function buildWeapon(model: Model, hand: BasePart, kind: string, s: number, color: Color3)
	local base = hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, 0)
	local metal = Color3.fromRGB(150, 150, 155)
	local parts = {}
	if kind == "Sword" or kind == "Rapier" or kind == "Greatsword" then
		local len = (if kind == "Greatsword" then 7 elseif kind == "Rapier" then 4.5 else 5) * s
		local width = (if kind == "Greatsword" then 0.9 elseif kind == "Rapier" then 0.25 else 0.5) * s
		table.insert(parts, newPart(model, "Blade", Vector3.new(0.2 * s, len, width), base * CFrame.new(0, -len / 2 - 0.4 * s, 0), metal, Enum.Material.Metal))
		table.insert(parts, newPart(model, "Guard", Vector3.new(0.3 * s, 0.3 * s, 1.6 * s * width + 0.6 * s), base * CFrame.new(0, -0.3 * s, 0), color, Enum.Material.Metal))
	elseif kind == "Axe" or kind == "Cleaver" then
		table.insert(parts, newPart(model, "Haft", Vector3.new(0.3 * s, 4 * s, 0.3 * s), base * CFrame.new(0, -2 * s, 0), Color3.fromRGB(70, 50, 35), Enum.Material.Wood))
		local headSize = if kind == "Cleaver" then Vector3.new(0.3 * s, 2.6 * s, 2.4 * s) else Vector3.new(0.3 * s, 1.6 * s, 1.6 * s)
		table.insert(parts, newPart(model, "Head", headSize, base * CFrame.new(0, -3.5 * s, 0.8 * s), metal, Enum.Material.Metal))
	elseif kind == "Hammer" or kind == "Club" then
		table.insert(parts, newPart(model, "Haft", Vector3.new(0.35 * s, 4.5 * s, 0.35 * s), base * CFrame.new(0, -2.2 * s, 0), Color3.fromRGB(70, 50, 35), Enum.Material.Wood))
		table.insert(parts, newPart(model, "Head", Vector3.new(1.4 * s, 1.4 * s, 2.2 * s), base * CFrame.new(0, -4.6 * s, 0), if kind == "Club" then Color3.fromRGB(90, 70, 50) else metal, if kind == "Club" then Enum.Material.Wood else Enum.Material.Metal))
	elseif kind == "Spear" or kind == "Scythe" then
		table.insert(parts, newPart(model, "Haft", Vector3.new(0.3 * s, 8 * s, 0.3 * s), base * CFrame.new(0, -3 * s, 0), Color3.fromRGB(60, 45, 35), Enum.Material.Wood))
		local tip = if kind == "Scythe" then Vector3.new(0.2 * s, 0.6 * s, 3.4 * s) else Vector3.new(0.3 * s, 1.6 * s, 0.6 * s)
		table.insert(parts, newPart(model, "Tip", tip, base * CFrame.new(0, -7.2 * s, if kind == "Scythe" then 1.5 * s else 0), metal, Enum.Material.Metal))
	elseif kind == "Bow" then
		table.insert(parts, newPart(model, "Bow", Vector3.new(0.3 * s, 4.5 * s, 0.3 * s), base * CFrame.new(0, -1.2 * s, 0.6 * s), Color3.fromRGB(80, 60, 40), Enum.Material.Wood))
	end
	for _, p in parts do
		weld(hand, p)
	end
end

-- Builds an entity model. Returns model, root, humanoid, hitRadius, height.
function EntityModels.build(name: string, def, kind: string?)
	local s = def.Scale or 1
	local color = def.Color or Color3.fromRGB(120, 120, 120)
	local glow = def.Glow
	local style = def.Style or "Humanoid"

	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local hipHeight, radius, height = 2 * s, 1.5 * s, 5 * s
	local arm: BasePart? = nil
	local shoulder: Motor6D? = nil
	local rootCf = root.CFrame

	local function attachArm(torso: BasePart, side: number, size: Vector3, offset: Vector3)
		local a = newPart(model, if side > 0 then "RightArm" else "LeftArm", size, torso.CFrame * CFrame.new(offset), darker(color, 0.85))
		if side > 0 then
			local m = Instance.new("Motor6D")
			m.Name = "Shoulder"
			m.Part0 = torso
			m.Part1 = a
			-- joint at the top of the arm
			m.C0 = CFrame.new(offset + Vector3.new(0, size.Y / 2, 0))
			m.C1 = CFrame.new(0, size.Y / 2, 0)
			m.Parent = torso
			arm = a
			shoulder = m
		else
			weld(torso, a)
		end
		return a
	end

	if style == "Humanoid" or style == "Brute" or style == "Colossus" or style == "Golem" or style == "Winged" then
		local bulk = if style == "Brute" then 1.5 elseif style == "Colossus" then 1.8 elseif style == "Golem" then 1.7 else 1
		local legLen = (if style == "Brute" or style == "Golem" then 1.6 else 2) * s
		root.Size = Vector3.new(2 * s * bulk, 2 * s, 1 * s * bulk)
		hipHeight = legLen
		if style == "Winged" then
			hipHeight = legLen + 14
		end
		local mat = if style == "Golem" then Enum.Material.Slate elseif style == "Colossus" then Enum.Material.Ground else Enum.Material.SmoothPlastic
		local torso = newPart(model, "Torso", Vector3.new(2 * s * bulk, 2.2 * s, 1.1 * s * bulk), rootCf, color, mat)
		weld(root, torso)
		local head = newPart(model, "Head", Vector3.new(1.1 * s, 1.1 * s, 1.1 * s) * (if bulk > 1 then 0.9 else 1), rootCf * CFrame.new(0, 1.7 * s, 0), darker(color, 0.9), mat, Enum.PartType.Ball)
		weld(torso, head)
		if glow then
			local eyes = newPart(model, "Eyes", Vector3.new(0.7 * s, 0.15 * s, 0.1 * s), head.CFrame * CFrame.new(0, 0.1 * s, -0.5 * s), glow, Enum.Material.Neon)
			weld(head, eyes)
		end
		local armSize = Vector3.new(0.9 * s * bulk, 2.2 * s, 0.9 * s * bulk)
		local ax = (1 * bulk + 0.5 * bulk) * s
		attachArm(torso, 1, armSize, Vector3.new(ax, 0, 0))
		attachArm(torso, -1, armSize, Vector3.new(-ax, 0, 0))
		for side = -1, 1, 2 do
			local leg = newPart(model, "Leg", Vector3.new(0.95 * s * bulk, legLen, 0.95 * s * bulk), rootCf * CFrame.new(side * 0.55 * s * bulk, -1.1 * s - legLen / 2, 0), darker(color, 0.7), mat)
			weld(torso, leg)
		end
		if def.Hood then
			local hood = newPart(model, "Hood", Vector3.new(1.4 * s, 1.4 * s, 1.4 * s), head.CFrame * CFrame.new(0, 0.2 * s, 0.1 * s), darker(color, 0.5), Enum.Material.Fabric, Enum.PartType.Ball)
			weld(head, hood)
		end
		if def.Crown then
			local crown = newPart(model, "Crown", Vector3.new(1.2 * s, 0.4 * s, 1.2 * s), head.CFrame * CFrame.new(0, 0.7 * s, 0), Color3.fromRGB(200, 170, 60), Enum.Material.Foil)
			weld(head, crown)
		end
		if def.Cape then
			local cape = newPart(model, "Cape", Vector3.new(2 * s * bulk, 3.5 * s, 0.15 * s), torso.CFrame * CFrame.new(0, -0.6 * s, 0.65 * s * bulk), darker(glow or color, 0.4), Enum.Material.Fabric)
			weld(torso, cape)
		end
		if def.Shield then
			local sh = newPart(model, "Shield", Vector3.new(0.3 * s, 2.6 * s, 2 * s), torso.CFrame * CFrame.new(-ax - 0.6 * s, 0, -0.3 * s), Color3.fromRGB(90, 95, 110), Enum.Material.Metal)
			weld(torso, sh)
		end
		if style == "Golem" then
			for i, off in { Vector3.new(0, 0.3, -0.7), Vector3.new(0.9, 0.9, 0), Vector3.new(-0.9, 0.9, 0) } do
				local plate = newPart(model, "ArmorPlate", Vector3.new(1.4, 1, 0.4) * s * bulk, torso.CFrame * CFrame.new(off * s * bulk), Color3.fromRGB(110, 110, 120), Enum.Material.DiamondPlate)
				plate:SetAttribute("Plate", i)
				weld(torso, plate)
			end
			if glow then
				local core = newPart(model, "Core", Vector3.new(0.9, 0.9, 0.9) * s, torso.CFrame * CFrame.new(0, 0, -0.6 * s * bulk), glow, Enum.Material.Neon, Enum.PartType.Ball)
				weld(torso, core)
				addGlow(core, glow, 18)
			end
		end
		if style == "Winged" then
			for side = -1, 1, 2 do
				local wing = newPart(model, "Wing", Vector3.new(7 * s, 0.2 * s, 3 * s), torso.CFrame * CFrame.new(side * 4.2 * s, 0.6 * s, 0.6 * s) * CFrame.Angles(0, 0, side * math.rad(18)), darker(color, 0.8), Enum.Material.Fabric)
				weld(torso, wing)
			end
		end
		radius = 1.4 * s * bulk
		height = (2.2 + 1.1) * s + legLen
	elseif style == "Beast" then
		local legLen = 1.6 * s
		root.Size = Vector3.new(2.2 * s, 1.6 * s, 4 * s)
		hipHeight = legLen
		local body = newPart(model, "Torso", Vector3.new(2.2 * s, 1.6 * s, 4 * s), rootCf, color, Enum.Material.Fabric)
		weld(root, body)
		local head = newPart(model, "Head", Vector3.new(1.4 * s, 1.3 * s, 1.8 * s), rootCf * CFrame.new(0, 0.6 * s, -2.6 * s), darker(color, 0.9), Enum.Material.Fabric)
		weld(body, head)
		local jaw = newPart(model, "RightArm", Vector3.new(1.2 * s, 0.4 * s, 1.4 * s), head.CFrame * CFrame.new(0, -0.6 * s, -0.4 * s), darker(color, 0.6))
		local m = Instance.new("Motor6D")
		m.Name = "Shoulder"
		m.Part0 = head
		m.Part1 = jaw
		m.C0 = CFrame.new(0, -0.6 * s, 0.3 * s)
		m.C1 = CFrame.new(0, 0, 0.7 * s)
		m.Parent = head
		arm, shoulder = jaw, m
		if glow then
			local eyes = newPart(model, "Eyes", Vector3.new(1 * s, 0.15 * s, 0.1 * s), head.CFrame * CFrame.new(0, 0.25 * s, -0.9 * s), glow, Enum.Material.Neon)
			weld(head, eyes)
			addGlow(body, glow, 14)
		end
		for _, off in { Vector3.new(0.8, 0, -1.4), Vector3.new(-0.8, 0, -1.4), Vector3.new(0.8, 0, 1.4), Vector3.new(-0.8, 0, 1.4) } do
			local leg = newPart(model, "Leg", Vector3.new(0.6 * s, legLen, 0.6 * s), rootCf * CFrame.new(off.X * s, -0.8 * s - legLen / 2, off.Z * s), darker(color, 0.7))
			weld(body, leg)
		end
		local tail = newPart(model, "Tail", Vector3.new(0.4 * s, 0.4 * s, 2 * s), rootCf * CFrame.new(0, 0.4 * s, 2.8 * s) * CFrame.Angles(math.rad(25), 0, 0), darker(color, 0.8))
		weld(body, tail)
		radius = 2 * s
		height = 2.6 * s + legLen
	elseif style == "Crawler" then
		local legLen = 0.8 * s
		root.Size = Vector3.new(3 * s, 1 * s, 3 * s)
		hipHeight = legLen
		local body = newPart(model, "Torso", Vector3.new(3 * s, 1.2 * s, 3.4 * s), rootCf, color, Enum.Material.Slate)
		weld(root, body)
		local head = newPart(model, "Head", Vector3.new(1.4 * s, 0.9 * s, 1.2 * s), rootCf * CFrame.new(0, 0.2 * s, -2.1 * s), darker(color, 0.85), Enum.Material.Slate)
		weld(body, head)
		local pincer = newPart(model, "RightArm", Vector3.new(0.5 * s, 0.5 * s, 2 * s), head.CFrame * CFrame.new(0.9 * s, 0, -1 * s), darker(color, 0.6))
		local m = Instance.new("Motor6D")
		m.Name = "Shoulder"
		m.Part0 = head
		m.Part1 = pincer
		m.C0 = CFrame.new(0.9 * s, 0, -0.2 * s)
		m.C1 = CFrame.new(0, 0, 0.8 * s)
		m.Parent = head
		arm, shoulder = pincer, m
		for i = -1, 1 do
			for side = -1, 1, 2 do
				local leg = newPart(model, "Leg", Vector3.new(2 * s, 0.25 * s, 0.25 * s), rootCf * CFrame.new(side * 2 * s, -0.4 * s, i * 1.1 * s) * CFrame.Angles(0, 0, side * math.rad(-25)), darker(color, 0.6))
				weld(body, leg)
			end
		end
		if glow then
			addGlow(body, glow, 12)
		end
		radius = 2 * s
		height = 2 * s
	elseif style == "Caster" then
		root.Size = Vector3.new(2 * s, 2 * s, 1 * s)
		hipHeight = 1.6 * s
		local robe = newPart(model, "Torso", Vector3.new(2.4 * s, 4 * s, 2.4 * s), rootCf * CFrame.new(0, -0.6 * s, 0), color, Enum.Material.Fabric, Enum.PartType.Cylinder)
		robe.CFrame = rootCf * CFrame.new(0, -0.6 * s, 0) * CFrame.Angles(0, 0, math.rad(90))
		robe.Size = Vector3.new(4 * s, 2.2 * s, 2.2 * s)
		weld(root, robe)
		local chest = newPart(model, "Chest", Vector3.new(2 * s, 1.6 * s, 1.2 * s), rootCf * CFrame.new(0, 1.2 * s, 0), darker(color, 0.85), Enum.Material.Fabric)
		weld(root, chest)
		local head = newPart(model, "Head", Vector3.new(1.1 * s, 1.1 * s, 1.1 * s), rootCf * CFrame.new(0, 2.5 * s, 0), darker(color, 0.5), Enum.Material.Fabric, Enum.PartType.Ball)
		weld(chest, head)
		attachArm(chest, 1, Vector3.new(0.7 * s, 2 * s, 0.7 * s), Vector3.new(1.4 * s, 0, 0))
		attachArm(chest, -1, Vector3.new(0.7 * s, 2 * s, 0.7 * s), Vector3.new(-1.4 * s, 0, 0))
		if glow then
			for i = 1, 2 do
				local orb = newPart(model, "Orb", Vector3.new(0.7, 0.7, 0.7) * s, rootCf * CFrame.new((i == 1 and 1 or -1) * 2.2 * s, 2.6 * s, -0.6 * s), glow, Enum.Material.Neon, Enum.PartType.Ball)
				weld(chest, orb)
			end
			local eyes = newPart(model, "Eyes", Vector3.new(0.6 * s, 0.12 * s, 0.1 * s), head.CFrame * CFrame.new(0, 0, -0.5 * s), glow, Enum.Material.Neon)
			weld(head, eyes)
			addGlow(chest, glow, 16)
		end
		radius = 1.4 * s
		height = 5.5 * s
	elseif style == "Serpent" then
		root.Size = Vector3.new(3 * s, 3 * s, 3 * s)
		hipHeight = 6 * s
		local prev: BasePart = root
		for i = 0, 6 do
			local r = (3.2 - i * 0.3) * s
			local seg = newPart(model, if i == 0 then "Torso" else "Segment", Vector3.new(r, r, r), rootCf * CFrame.new(0, -i * 0.9 * s, i * 2.4 * s), if i % 2 == 0 then color else darker(color, 0.8), Enum.Material.Slate, Enum.PartType.Ball)
			weld(prev, seg)
			prev = seg
		end
		local head = newPart(model, "Head", Vector3.new(2.6 * s, 2 * s, 3.6 * s), rootCf * CFrame.new(0, 0.8 * s, -2.6 * s), darker(color, 0.9), Enum.Material.Slate)
		weld(root, head)
		local jaw = newPart(model, "RightArm", Vector3.new(2.2 * s, 0.6 * s, 3 * s), head.CFrame * CFrame.new(0, -1.2 * s, -0.3 * s), darker(color, 0.6), Enum.Material.Slate)
		local m = Instance.new("Motor6D")
		m.Name = "Shoulder"
		m.Part0 = head
		m.Part1 = jaw
		m.C0 = CFrame.new(0, -1.1 * s, 1.2 * s)
		m.C1 = CFrame.new(0, 0, 1.5 * s)
		m.Parent = head
		arm, shoulder = jaw, m
		if glow then
			local eyes = newPart(model, "Eyes", Vector3.new(2 * s, 0.3 * s, 0.2 * s), head.CFrame * CFrame.new(0, 0.5 * s, -1.8 * s), glow, Enum.Material.Neon)
			weld(head, eyes)
		end
		radius = 3 * s
		height = 8 * s
	end

	if def.Weapon and arm then
		buildWeapon(model, arm, def.Weapon, s, glow or color)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = hipHeight
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = 1e6
	humanoid.Health = 1e6
	humanoid.AutoJumpEnabled = true
	humanoid.Parent = model

	model:SetAttribute("Kind", kind or "Enemy")
	model:SetAttribute("Radius", radius)
	model:SetAttribute("Height", height)
	return model, root, humanoid, radius, height, shoulder
end

-- Simple swing animation on the "Shoulder" motor: raise during windup, strike on resolve.
function EntityModels.windup(motor: Motor6D?, duration: number)
	if not motor or not motor.Parent then
		return
	end
	local shoulder = motor :: Motor6D
	local base = shoulder:GetAttribute("BaseC0") or shoulder.C0
	shoulder:SetAttribute("BaseC0", base)
	TweenService:Create(shoulder, TweenInfo.new(math.max(0.05, duration * 0.8), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		C0 = base * CFrame.Angles(math.rad(150), 0, 0),
	}):Play()
end

function EntityModels.strike(motor: Motor6D?)
	if not motor or not motor.Parent then
		return
	end
	local shoulder = motor :: Motor6D
	local base = shoulder:GetAttribute("BaseC0") or shoulder.C0
	local t = TweenService:Create(shoulder, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		C0 = base * CFrame.Angles(math.rad(-40), 0, 0),
	})
	t:Play()
	task.delay(0.35, function()
		if shoulder.Parent then
			TweenService:Create(shoulder, TweenInfo.new(0.3), { C0 = base }):Play()
		end
	end)
end

-- Player weapon as a Tool (gives the default character animations a held item and a slash anim).
function EntityModels.buildWeaponTool(itemId: string?, skinId: string?): Tool?
	local def = itemId and Items[itemId]
	if not def then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ManualActivationOnly = true
	tool:SetAttribute("ItemId", itemId)
	local wtype = def.WeaponType
	local skin = skinId and Cosmetics[skinId]
	local color = skin and skin.Color or def.Color or Color3.fromRGB(160, 160, 165)
	local material = skin and Enum.Material[skin.Material] or Enum.Material.Metal
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.Massless = true
	handle.CanQuery = false
	handle.Color = Color3.fromRGB(60, 45, 35)
	handle.Material = Enum.Material.Wood
	handle.Size = Vector3.new(0.3, 1.2, 0.3)
	handle.Parent = tool
	local length, width, thick = 4, 0.4, 0.15
	if wtype == "Greatsword" then
		length, width = 6, 0.8
	elseif wtype == "Dagger" then
		length, width = 1.8, 0.3
	elseif wtype == "Axe" then
		length, width = 3, 0.3
	elseif wtype == "Hammer" then
		length, width = 3.2, 0.35
	elseif wtype == "Spear" then
		length, width = 7, 0.25
	elseif wtype == "Staff" or wtype == "Seal" then
		length, width = if wtype == "Staff" then 5 else 1.2, 0.3
	elseif wtype == "Bow" then
		length, width = 4, 0.25
	end
	local blade = Instance.new("Part")
	blade.Name = "Blade"
	blade.CanCollide = false
	blade.Massless = true
	blade.CanQuery = false
	blade.Size = Vector3.new(thick, length, width)
	blade.Color = color
	blade.Material = material
	blade.CFrame = handle.CFrame * CFrame.new(0, 0.6 + length / 2, 0)
	blade.Parent = tool
	weld(handle, blade)
	if wtype == "Axe" or wtype == "Hammer" then
		local head = Instance.new("Part")
		head.Name = "WeaponHead"
		head.CanCollide = false
		head.Massless = true
		head.CanQuery = false
		head.Size = if wtype == "Axe" then Vector3.new(0.25, 1.2, 1.4) else Vector3.new(1.2, 1.2, 1.8)
		head.Color = color
		head.Material = material
		head.CFrame = blade.CFrame * CFrame.new(0, length / 2 - 0.5, if wtype == "Axe" then 0.6 else 0)
		head.Parent = tool
		weld(blade, head)
	elseif wtype == "Staff" or wtype == "Seal" then
		local gem = Instance.new("Part")
		gem.Name = "Gem"
		gem.Shape = Enum.PartType.Ball
		gem.CanCollide = false
		gem.Massless = true
		gem.CanQuery = false
		gem.Size = Vector3.new(0.7, 0.7, 0.7)
		gem.Material = Enum.Material.Neon
		gem.Color = if def.DamageType == "Holy" then Color3.fromRGB(255, 230, 150) else Color3.fromRGB(120, 150, 255)
		gem.CFrame = blade.CFrame * CFrame.new(0, length / 2 + 0.3, 0)
		gem.Parent = tool
		weld(blade, gem)
	end
	tool.Grip = CFrame.new(0, -0.3, 0)
	return tool
end

return EntityModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">EntityService</string>
            <string name="Source"><![CDATA[--[[
	EntityService
	Registry of every damageable non-player entity (enemies, bosses, weak points, training
	dummies, summons). Applies player damage with all entity-specific rules:
	  * counter stances (damage reduced + counterattack triggered)
	  * armour (reduced damage until poise is broken)
	  * weak points (forward damage to their parent boss with a multiplier)
	  * damage contribution tracking (for fair, individual rewards)
	Health is replicated through model attributes for client health bars.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local CombatCore = require(script.Parent.Parent.Core.CombatCore)

local EntityService = {
	Died = Signal.new(), -- (entity, killerPlayer?)
	Damaged = Signal.new(), -- (entity, player, amount, info)
}

local entities = {} -- [id] = entity
local byModel = {} -- [Model] = entity
local nextId = 0

function EntityService.Init(_services) end
function EntityService.Start() end

--[[
	spec = { Kind, Model, Root, Humanoid?, Name, Level?, MaxHealth, Poise, Defense, Radius,
	         Def?, OnDeath?, Parent?, Encounter?, BaseDamage?, NoRewards? }
]]
function EntityService.Register(spec)
	nextId += 1
	local e = spec
	e.Id = nextId
	e.Target = CombatCore.newTarget(spec.MaxHealth, spec.Poise or 50)
	e.Contributors = {}
	e.DamageMultiplier = spec.DamageMultiplier or 1
	e.Alive = true
	e.Radius = spec.Radius or 2
	entities[e.Id] = e
	if e.Model then
		byModel[e.Model] = e
		e.Model:SetAttribute("EntityId", e.Id)
		e.Model:SetAttribute("DisplayName", spec.Name)
		e.Model:SetAttribute("Level", spec.Level or 1)
		e.Model:SetAttribute("Kind", spec.Kind)
		CollectionService:AddTag(e.Model, "Entity")
		EntityService.PushHealth(e)
	end
	return e
end

function EntityService.Unregister(e)
	if not e then
		return
	end
	entities[e.Id] = nil
	if e.Model then
		byModel[e.Model] = nil
		CollectionService:RemoveTag(e.Model, "Entity")
	end
	e.Alive = false
end

function EntityService.FromModel(model: Instance)
	return byModel[model]
end

function EntityService.All()
	return entities
end

function EntityService.PushHealth(e)
	if e.Model and e.Model.Parent then
		e.Model:SetAttribute("Health", math.floor(e.Target.Health))
		e.Model:SetAttribute("MaxHealth", e.Target.MaxHealth)
	end
end

function EntityService.Position(e): Vector3?
	local root = e.Root
	if root and root.Parent then
		return root.Position
	end
	return nil
end

-- Entities whose position is within `radius` (+ entity radius) of `pos` (XZ plane, with vertical limit).
function EntityService.Near(pos: Vector3, radius: number, verticalLimit: number?)
	local out = {}
	local vlim = verticalLimit or 30
	for _, e in entities do
		if e.Alive and not e.Target.Dead then
			local p = EntityService.Position(e)
			if p then
				local dx, dz = p.X - pos.X, p.Z - pos.Z
				if math.sqrt(dx * dx + dz * dz) <= radius + e.Radius and math.abs(p.Y - pos.Y) <= vlim + (e.Model and e.Model:GetAttribute("Height") or 0) then
					table.insert(out, e)
				end
			end
		end
	end
	return out
end

--[[
	Applies damage from a player (or nil for environmental).
	info = { Poise, Status = {...}, Crit, Kind = "Melee"|"Projectile"|"Ability", DamageType }
	Returns { Damage, Died, Staggered, Countered, Blocked }
]]
function EntityService.Damage(e, amount: number, player: Player?, info)
	info = info or {}
	local result = { Damage = 0, Died = false, Staggered = false, Countered = false }
	if not e or not e.Alive or e.Target.Dead then
		return result
	end
	local now = workspace:GetServerTimeNow()

	-- weak points forward to their parent
	if e.Parent then
		local parent = e.Parent
		local fwd = EntityService.Damage(parent, amount * (e.WeakMultiplier or 1.5) / math.max(0.01, parent.DamageMultiplier), player, info)
		fwd.WeakPoint = true
		return fwd
	end

	if e.Invulnerable then
		return result
	end
	local mult = e.DamageMultiplier or 1
	if e.ArmorUp then
		mult *= 1 - (e.ArmorReduction or 0.5)
	end
	if e.CounterStance and now < e.CounterStance.Until and not e.CounterStance.Fired then
		mult *= 1 - (e.CounterStance.Reduction or 0.85)
		e.CounterStance.Fired = true
		result.Countered = true
		if e.CounterStance.OnCounter then
			task.spawn(e.CounterStance.OnCounter, player)
		end
	end
	if e.Airborne and info.Kind == "Melee" then
		return result -- out of reach while flying
	end

	local dmg = math.max(1, math.floor(amount * mult + 0.5))
	local poise = (info.Poise or 0) * (if e.ArmorUp then 1.4 else 1)
	local r = CombatCore.damageTarget(e.Target, dmg, poise, now)
	result.Damage, result.Died, result.Staggered = r.Damage, r.Died, r.Staggered

	-- status build-up
	if info.Status and not r.Died then
		for kind, buildup in info.Status do
			if CombatCore.addBuildup(e.Target.Status, kind, buildup, now) then
				if kind == "Bleed" then
					local frac = CombatCore.bleedFraction(if e.Kind == "Boss" then "Boss" else "Enemy")
					local extra = CombatCore.damageTarget(e.Target, math.floor(e.Target.MaxHealth * frac), 0, now)
					result.Damage += extra.Damage
					result.Died = result.Died or extra.Died
				end
				result.Proc = kind
			end
		end
	end

	if player then
		e.Contributors[player.UserId] = (e.Contributors[player.UserId] or 0) + result.Damage
	end
	EntityService.PushHealth(e)
	if e.OnDamaged then
		task.spawn(e.OnDamaged, e, player, result, info)
	end
	EntityService.Damaged:Fire(e, player, result.Damage, info)
	if result.Died then
		EntityService.Kill(e, player)
	end
	return result
end

function EntityService.Kill(e, killer: Player?)
	if not e.Alive then
		return
	end
	e.Target.Dead = true
	e.Target.Health = 0
	EntityService.PushHealth(e)
	EntityService.Unregister(e)
	if e.OnDeath then
		task.spawn(e.OnDeath, e, killer)
	end
	EntityService.Died:Fire(e, killer)
end

-- Status damage-over-time for entities.
function EntityService.TickStatus(e, dt: number, now: number)
	if not e.Alive then
		return
	end
	local frac = CombatCore.tickStatus(e.Target.Status, dt, now, if e.Kind == "Boss" then "Boss" else "Enemy")
	if frac > 0 then
		local r = CombatCore.damageTarget(e.Target, math.max(1, math.floor(e.Target.MaxHealth * frac)), 0, now)
		EntityService.PushHealth(e)
		if r.Died then
			-- credit the top contributor
			local best, bestDmg = nil, 0
			for uid, d in e.Contributors do
				if d > bestDmg then
					best, bestDmg = uid, d
				end
			end
			EntityService.Kill(e, best and game:GetService("Players"):GetPlayerByUserId(best) or nil)
		end
	end
	CombatCore.regenTargetPoise(e.Target, dt, now)
end

return EntityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ExplorationService</string>
            <string name="Source"><![CDATA[--[[
	ExplorationService
	* Region tracking (Player attribute "Region"; used for PvP, safe zones, ambience).
	* Location discovery: XP once per location per character.
	* Treasure chests: once per character, server-validated distance, server-rolled loot.
	* Hollow Vale gate: the hidden late-game region requires tower floor 10.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Config.World)
local Rng = require(Shared.Util.Rng)
local LootCore = require(script.Parent.Parent.Core.LootCore)

local ExplorationService = {}
local S
local rng = Rng.new()
local chests = {}

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

function ExplorationService.Init(services)
	S = services
	for _, c in World.Chests do
		chests[c.Id] = c
	end
end

local function regionAt(pos: Vector3)
	local best, bestD = nil, math.huge
	for _, r in World.Regions do
		local c = v3(r.Center)
		local d = Vector3.new(pos.X - c.X, 0, pos.Z - c.Z).Magnitude
		if d <= r.Radius and d < bestD then
			best, bestD = r, d
		end
	end
	return best
end
ExplorationService.RegionAt = regionAt

local function openChest(player: Player, chest)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Root or rt.Profile.Class == "" then
		return
	end
	if (rt.Root.Position - v3(chest.Position)).Magnitude > 14 then
		return
	end
	if rt.Profile.OpenedChests[chest.Id] then
		S.NotifyService.Toast(player, "You have already looted this chest.", "Info")
		return
	end
	rt.Profile.OpenedChests[chest.Id] = true
	local loot = LootCore.roll(chest.Loot, rng)
	S.ProgressionService.GrantBundle(player, { Items = loot, Currency = rng:NextInteger(50, 150) * (1 + rt.Profile.Tower.HighestCleared // 4) }, "Chest")
	task.spawn(S.DataService.Save, player)
end

function ExplorationService.Start()
	local function hookChest(part: Instance)
		local id = part:GetAttribute("ChestId")
		local chest = id and chests[id]
		if not chest then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Open"
		prompt.ObjectText = "Chest"
		prompt.MaxActivationDistance = 10
		prompt.HoldDuration = 0.6
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			openChest(player, chest)
		end)
	end
	for _, p in CollectionService:GetTagged("Chest") do
		hookChest(p)
	end
	CollectionService:GetInstanceAddedSignal("Chest"):Connect(hookChest)

	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, rt in S.PlayerStateService.All() do
				local root = rt.Root
				if root and root.Parent and rt.Profile.Class ~= "" and not rt.Encounter then
					local pos = root.Position
					local region = regionAt(pos)
					local id = region and region.Id or "wilds"
					-- Hollow Vale requires tower floor 10
					if region and region.RequiresFloor and rt.Profile.Tower.HighestCleared < region.RequiresFloor then
						local c = v3(region.Center)
						local out = Vector3.new(pos.X - c.X, 0, pos.Z - c.Z)
						out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, 1)
						S.AntiCheatService.AllowTeleport(player)
						rt.Character:PivotTo(CFrame.new(c + out * (region.Radius + 12) + Vector3.new(0, 5, 0)))
						S.NotifyService.Toast(player, ("An ancient seal bars the way. (Clear tower floor %d)"):format(region.RequiresFloor), "Warning")
						continue
					end
					if rt.Region ~= id then
						rt.Region = id
						player:SetAttribute("Region", id)
						player:SetAttribute("Safe", region ~= nil and region.Safe == true)
						player:SetAttribute("PvP", region ~= nil and region.PvP == true)
					end
					for _, loc in World.Locations do
						if not rt.Profile.Discovered[loc.Id] and (pos - v3(loc.Position)).Magnitude <= loc.Radius then
							rt.Profile.Discovered[loc.Id] = true
							S.NotifyService.Banner(player, if loc.Secret then "SECRET DISCOVERED" else "LOCATION DISCOVERED", loc.Name, "Discovery")
							if loc.Xp > 0 then
								S.ProgressionService.GrantXp(player, loc.Xp, "Discovery")
							end
							S.ProgressionService.EvaluateAchievements(player)
							S.PlayerStateService.Sync(player)
						end
					end
				end
			end
		end
	end)
end

return ExplorationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--[[
	InteractionService
	Hub NPC interactions. WorldBuilder creates NPC models tagged "NPC" with attribute NpcId.
	Each gets a ProximityPrompt; triggering it (server-validated distance) tells the client to
	open the matching menu. Menu actions (buy/sell/upgrade/quests) re-check proximity on the
	server, so a modified client cannot shop from across the map.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local World = require(Shared.Config.World)
local Net = require(Shared.Net)

local InteractionService = {}
local S
local npcs = {}

local ACTIONS = {
	Shop = "Trade",
	Blacksmith = "Upgrade",
	Quest = "Talk",
	Wardrobe = "Wardrobe",
	Party = "Fellowship",
	Tutorial = "Ask",
}

function InteractionService.Init(services)
	S = services
	for _, n in World.NPCs do
		npcs[n.Id] = n
	end
end

local function npcPos(n): Vector3
	return Vector3.new(n.Position[1], n.Position[2], n.Position[3])
end

function InteractionService.IsNear(player: Player, npcId: string): boolean
	local rt = S.PlayerStateService.Get(player)
	local n = npcs[npcId]
	if not rt or not rt.Root or not n then
		return false
	end
	return (rt.Root.Position - npcPos(n)).Magnitude <= GameConfig.Shop.InteractRadius + 4
end

function InteractionService.IsNearRole(player: Player, role: string): boolean
	for id, n in npcs do
		if n.Role == role and InteractionService.IsNear(player, id) then
			return true
		end
	end
	return false
end

function InteractionService.IsNearShop(player: Player, shopId: string): boolean
	for id, n in npcs do
		if n.Role == "Shop" and n.Shop == shopId and InteractionService.IsNear(player, id) then
			return true
		end
	end
	return false
end

function InteractionService.Start()
	local openUI = Net.event("OpenUI")
	local function hook(model: Instance)
		local id = model:GetAttribute("NpcId")
		local n = id and npcs[id]
		if not n then
			return
		end
		local anchor = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
		if not anchor then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = ACTIONS[n.Role] or "Talk"
		prompt.ObjectText = n.Name
		prompt.MaxActivationDistance = GameConfig.Shop.InteractRadius
		prompt.RequiresLineOfSight = false
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			if not InteractionService.IsNear(player, id) then
				return
			end
			local rt = S.PlayerStateService.Get(player)
			if not rt or rt.Profile.Class == "" then
				return
			end
			openUI:FireClient(player, { Menu = n.Role, NpcId = id, Shop = n.Shop, Quests = n.Quests, Name = n.Name })
		end)
	end
	for _, m in CollectionService:GetTagged("NPC") do
		hook(m)
	end
	CollectionService:GetInstanceAddedSignal("NPC"):Connect(hook)
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	InventoryService
	Equipment, consumable use (outside combat actions), selling, blacksmith upgrades,
	build presets and the held-weapon visual. All operations go through InventoryCore,
	which validates before mutating.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Core = script.Parent.Parent.Core
local InventoryCore = require(Core.InventoryCore)
local CombatCore = require(Core.CombatCore)
local QuestCore = require(Core.QuestCore)
local EntityModels = require(script.Parent.EntityModels)

local InventoryService = {}
local S

function InventoryService.Init(services)
	S = services
end

-- Rebuilds the held weapon Tool to match the equipped weapon and weapon skin.
function InventoryService.ApplyWeaponVisual(player: Player)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Character or not rt.Humanoid then
		return
	end
	for _, child in rt.Character:GetChildren() do
		if child:IsA("Tool") then
			child:Destroy()
		end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		backpack:ClearAllChildren()
	end
	local uid = rt.Profile.Equipped.Weapon
	local inst = uid and rt.Profile.Inventory.Items[uid]
	local skin = rt.Profile.Cosmetics.Equipped.WeaponSkin
	local tool = EntityModels.buildWeaponTool(inst and inst.Id, if skin ~= "" then skin else nil)
	if tool then
		tool.Parent = backpack or rt.Character
		rt.Humanoid:EquipTool(tool)
	end
end

local function canChangeGear(rt): (boolean, string?)
	local c = rt.Combat
	if not c or c.Dead then
		return false, "Dead"
	end
	if not CombatCore.canAct(c, workspace:GetServerTimeNow(), 0.05) then
		return false, "Busy"
	end
	return true, nil
end

local function afterGearChange(player: Player)
	S.PlayerStateService.RecomputeStats(player)
	InventoryService.ApplyWeaponVisual(player)
	S.PlayerStateService.Sync(player)
end

function InventoryService.Start()
	local R = S.RequestService

	S.PlayerStateService.CharacterReady:Connect(function(player)
		task.defer(InventoryService.ApplyWeaponVisual, player)
	end)

	R.Register("Equip", function(player, rt, payload)
		if type(payload) ~= "table" then
			return false, "BadRequest"
		end
		local ok, err = canChangeGear(rt)
		if not ok then
			return false, err
		end
		local okEq, res = InventoryCore.equip(rt.Profile, payload.Uid, payload.Slot)
		if not okEq then
			return false, res
		end
		afterGearChange(player)
		return true, res
	end)

	R.Register("Unequip", function(player, rt, slot)
		local ok, err = canChangeGear(rt)
		if not ok then
			return false, err
		end
		local okU, res = InventoryCore.unequip(rt.Profile, slot)
		if not okU then
			return false, res
		end
		afterGearChange(player)
		return true, res
	end)

	R.Register("Sell", function(player, rt, payload)
		if type(payload) ~= "table" then
			return false, "BadRequest"
		end
		if not S.InteractionService.IsNearRole(player, "Shop") then
			return false, "NotAtMerchant"
		end
		local ok, res = InventoryCore.sell(rt.Profile, payload.Key, payload.Amount)
		if not ok then
			return false, res
		end
		S.PlayerStateService.Sync(player)
		S.PlayerStateService.PushVitals(player)
		return true, res
	end)

	R.Register("UpgradePreview", function(player, rt, uid)
		if type(uid) ~= "string" then
			return false, "BadRequest"
		end
		local preview, err = InventoryCore.upgradePreview(rt.Profile, uid, rt.Stats.Attributes)
		if not preview then
			return false, err
		end
		return true, preview
	end)

	R.Register("Upgrade", function(player, rt, uid)
		if not S.InteractionService.IsNearRole(player, "Blacksmith") then
			return false, "NotAtBlacksmith"
		end
		local ok, res = InventoryCore.upgrade(rt.Profile, uid, rt.Stats.Attributes)
		if not ok then
			return false, res
		end
		local inst = rt.Profile.Inventory.Items[uid]
		S.NotifyService.Toast(player, ("%s upgraded to +%d"):format(Items[inst.Id].Name, inst.Upgrade), "Reward")
		S.PlayerStateService.RecomputeStats(player)
		S.ProgressionService.EvaluateAchievements(player)
		for qid in rt.Profile.Quests.Active do
			if QuestCore.isComplete(rt.Profile, qid) then
				S.NotifyService.Toast(player, "Quest ready to turn in.", "Quest")
			end
		end
		S.PlayerStateService.Sync(player)
		S.PlayerStateService.PushVitals(player)
		task.spawn(S.DataService.Save, player)
		return true, res
	end)

	-- Consumables usable from the inventory menu go through the combat path (cooldowns, locks)
	R.Register("UseItem", function(player, rt, itemId)
		S.CombatService.UseItemFromMenu(player, itemId)
		return true, itemId
	end)

	R.Register("SavePreset", function(player, rt, index)
		local max = if rt.HasWardrobePass then GameConfig.Inventory.BuildPresetsWithPass else GameConfig.Inventory.BuildPresetsFree
		if type(index) ~= "number" or index ~= index or index < 1 or index > max or math.floor(index) ~= index then
			return false, "InvalidSlot"
		end
		rt.Profile.BuildPresets[tostring(index)] = {
			Equipped = table.clone(rt.Profile.Equipped),
			Slot1 = rt.Profile.Abilities.Slot1,
			Slot2 = rt.Profile.Abilities.Slot2,
		}
		S.PlayerStateService.Sync(player)
		return true, index
	end)

	R.Register("LoadPreset", function(player, rt, index)
		local preset = type(index) == "number" and rt.Profile.BuildPresets[tostring(index)]
		if not preset then
			return false, "EmptySlot"
		end
		local ok, err = canChangeGear(rt)
		if not ok then
			return false, err
		end
		if rt.Encounter then
			return false, "InCombat"
		end
		-- equip each still-owned item; silently skip anything sold since
		for slot, uid in preset.Equipped do
			if rt.Profile.Inventory.Items[uid] then
				InventoryCore.equip(rt.Profile, uid, slot)
			end
		end
		for _, slot in { "Head", "Chest", "Hands", "Feet", "Offhand", "Accessory1", "Accessory2", "Weapon" } do
			if preset.Equipped[slot] == nil then
				rt.Profile.Equipped[slot] = nil
			end
		end
		for _, s in { "Slot1", "Slot2" } do
			local id = preset[s]
			if id == "" or rt.Profile.Abilities.Unlocked[id] then
				rt.Profile.Abilities[s] = id
			end
		end
		afterGearChange(player)
		return true, index
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService
	In-server leaderstats (Level, Floor) and global boards via OrderedDataStore
	(highest floor, level). Hub boards (parts tagged "Leaderboard") show the top 10.
	All DataStore calls are pcall-wrapped; failures only delay board refreshes.
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local LeaderboardService = {}
local S
local floorStore, levelStore
local pending = {}

function LeaderboardService.Init(services)
	S = services
	pcall(function()
		floorStore = DataStoreService:GetOrderedDataStore(GameConfig.Save.LeaderboardStore .. "_Floor")
		levelStore = DataStoreService:GetOrderedDataStore(GameConfig.Save.LeaderboardStore .. "_Level")
	end)
end

function LeaderboardService.Update(player: Player)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		(ls:FindFirstChild("Level") :: IntValue).Value = rt.Profile.Level;
		(ls:FindFirstChild("Floor") :: IntValue).Value = rt.Profile.Tower.HighestCleared
	end
	pending[player.UserId] = { Floor = rt.Profile.Tower.HighestCleared, Level = rt.Profile.Level }
end

local function flush()
	if S.DataService.IsMemoryMode() then
		return
	end
	for uid, v in pending do
		pending[uid] = nil
		pcall(function()
			floorStore:SetAsync(tostring(uid), v.Floor)
			levelStore:SetAsync(tostring(uid), v.Level)
		end)
	end
end

local function refreshBoards()
	if S.DataService.IsMemoryMode() or not floorStore then
		return
	end
	local ok, pages = pcall(function()
		return floorStore:GetSortedAsync(false, 10)
	end)
	if not ok then
		return
	end
	local rows = {}
	for rank, entry in pages:GetCurrentPage() do
		local name = "Player"
		pcall(function()
			name = Players:GetNameFromUserIdAsync(tonumber(entry.key))
		end)
		table.insert(rows, ("%d. %s - Floor %d"):format(rank, name, entry.value))
	end
	for _, board in CollectionService:GetTagged("Leaderboard") do
		local label = board:FindFirstChild("Rows", true)
		if label and label:IsA("TextLabel") then
			label.Text = if #rows > 0 then table.concat(rows, "\n") else "No climbers yet."
		end
	end
end

function LeaderboardService.Start()
	S.DataService.ProfileLoaded:Connect(function(player, profile)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local lv = Instance.new("IntValue")
		lv.Name = "Level"
		lv.Value = profile.Level
		lv.Parent = ls
		local fl = Instance.new("IntValue")
		fl.Name = "Floor"
		fl.Value = profile.Tower.HighestCleared
		fl.Parent = ls
		ls.Parent = player
	end)
	Players.PlayerRemoving:Connect(function(player)
		LeaderboardService.Update(player)
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			flush()
		end
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			refreshBoards()
			task.wait(GameConfig.Save.LeaderboardRefresh)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">NotifyService</string>
            <string name="Source"><![CDATA[--[[
	NotifyService
	Toasts and banners sent to clients. Kinds: Info, Reward, Warning, Error, Banner, Discovery.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local NotifyService = {}
local remote: RemoteEvent

function NotifyService.Init(_services)
	remote = Net.event("Notify")
end
function NotifyService.Start() end

function NotifyService.Toast(player: Player, text: string, kind: string?)
	remote:FireClient(player, { Text = text, Kind = kind or "Info" })
end

function NotifyService.Banner(player: Player, title: string, subtitle: string?, kind: string?)
	remote:FireClient(player, { Banner = true, Text = title, Subtitle = subtitle, Kind = kind or "Banner" })
end

function NotifyService.All(text: string, kind: string?)
	remote:FireAllClients({ Text = text, Kind = kind or "Info" })
end

return NotifyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--[[
	PartyService
	Server-side parties (per server) using PartyCore. Pushes party state to members and invites
	to targets. Parties are optional: everything in the game is completable solo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local PartyCore = require(script.Parent.Parent.Core.PartyCore)

local PartyService = {}
local S
local state = PartyCore.newState()
local remote: RemoteEvent

function PartyService.Init(services)
	S = services
	remote = Net.event("Party")
end

local function playerById(uid)
	return Players:GetPlayerByUserId(uid)
end

function PartyService.Members(player: Player): { Player }
	local out = {}
	for _, uid in PartyCore.members(state, player.UserId) do
		local p = playerById(uid)
		if p then
			table.insert(out, p)
		end
	end
	return out
end

function PartyService.IsLeader(player: Player): boolean
	local party = PartyCore.get(state, player.UserId)
	return party == nil or party.Leader == player.UserId
end

local function pushState(uid)
	local plr = playerById(uid)
	if not plr then
		return
	end
	local party = PartyCore.get(state, uid)
	local payload = { Type = "State", Members = {}, Leader = nil }
	if party then
		payload.Leader = party.Leader
		for _, m in party.Members do
			local mp = playerById(m)
			local rt = mp and S.PlayerStateService.Get(mp)
			table.insert(payload.Members, {
				UserId = m,
				Name = mp and mp.DisplayName or "?",
				Level = rt and rt.Profile.Level or 0,
				Class = rt and rt.Profile.Class or "",
				Floor = rt and rt.Profile.Tower.HighestCleared or 0,
			})
		end
	end
	remote:FireClient(plr, payload)
end

local function pushParty(uid)
	for _, m in PartyCore.members(state, uid) do
		pushState(m)
	end
end

function PartyService.Start()
	local R = S.RequestService

	R.Register("PartyInvite", function(player, rt, targetUserId)
		local target = type(targetUserId) == "number" and playerById(targetUserId)
		if not target or not S.PlayerStateService.Get(target) then
			return false, "PlayerNotFound"
		end
		local ok, err = PartyCore.invite(state, player.UserId, target.UserId, os.time())
		if not ok then
			return false, err
		end
		remote:FireClient(target, { Type = "Invite", From = player.UserId, FromName = player.DisplayName })
		pushParty(player.UserId)
		return true, nil
	end)

	R.Register("PartyRespond", function(player, rt, accept)
		if accept == true then
			local ok, err = PartyCore.accept(state, player.UserId, os.time())
			if not ok then
				return false, err
			end
			pushParty(player.UserId)
			for _, m in PartyService.Members(player) do
				if m ~= player then
					S.NotifyService.Toast(m, player.DisplayName .. " joined the party.", "Info")
				end
			end
			return true, nil
		end
		return PartyCore.decline(state, player.UserId)
	end)

	R.Register("PartyLeave", function(player)
		local before = PartyCore.members(state, player.UserId)
		local ok, err = PartyCore.leave(state, player.UserId)
		for _, uid in before do
			pushState(uid)
		end
		return ok, err
	end)

	R.Register("PartyKick", function(player, rt, targetUserId)
		local before = PartyCore.members(state, player.UserId)
		local ok, err = PartyCore.kick(state, player.UserId, targetUserId)
		for _, uid in before do
			pushState(uid)
		end
		return ok, err
	end)

	R.Register("PartyPromote", function(player, rt, targetUserId)
		local ok, err = PartyCore.promote(state, player.UserId, targetUserId)
		pushParty(player.UserId)
		return ok, err
	end)

	Players.PlayerRemoving:Connect(function(player)
		local before = PartyCore.members(state, player.UserId)
		PartyCore.leave(state, player.UserId)
		for _, uid in before do
			if uid ~= player.UserId then
				pushState(uid)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(10)
			PartyCore.pruneInvites(state, os.time())
		end
	end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[--[[
	PlayerStateService
	Owns each player's runtime state: loaded profile, derived stats, combat state, region,
	encounter membership. Spawns characters at checkpoints, mirrors health into the Humanoid,
	regenerates stamina/mana, applies status damage over time and syncs a sanitized profile
	snapshot to the owning client.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local World = require(Shared.Config.World)
local Stats = require(Shared.Logic.Stats)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)
local CombatCore = require(script.Parent.Parent.Core.CombatCore)
local DeathCore = require(script.Parent.Parent.Core.DeathCore)

local PlayerStateService = {
	CharacterReady = Signal.new(), -- (player, runtime)
	StatsChanged = Signal.new(), -- (player, runtime)
}

local S -- services
local runtimes: { [Player]: any } = {}
local profileRemote: RemoteEvent

local TICK = 0.1

local function toVector(t)
	return Vector3.new(t[1], t[2], t[3])
end

function PlayerStateService.Init(services)
	S = services
	profileRemote = Net.event("Profile")
end

function PlayerStateService.Get(player: Player)
	return runtimes[player]
end

function PlayerStateService.All()
	return runtimes
end

function PlayerStateService.Profile(player: Player)
	local rt = runtimes[player]
	return rt and rt.Profile
end

-- Sanitized snapshot for the owning client (nothing secret; the client never writes it back).
function PlayerStateService.Sync(player: Player)
	local rt = runtimes[player]
	if not rt then
		return
	end
	local p = rt.Profile
	profileRemote:FireClient(player, {
		Class = p.Class,
		Level = p.Level,
		Xp = p.Xp,
		UnspentPoints = p.UnspentPoints,
		Attributes = p.Attributes,
		TrainingBonus = p.TrainingBonus,
		TrainingPoints = p.TrainingPoints,
		Currency = p.Currency,
		Inventory = p.Inventory,
		Equipped = p.Equipped,
		Abilities = p.Abilities,
		Flask = p.Flask,
		Tower = { HighestCleared = p.Tower.HighestCleared, Clears = p.Tower.Clears },
		Checkpoints = p.Checkpoints,
		Discovered = p.Discovered,
		OpenedChests = p.OpenedChests,
		Quests = p.Quests,
		Stats = p.Stats,
		Achievements = p.Achievements,
		Titles = p.Titles,
		ActiveTitle = p.ActiveTitle,
		Cosmetics = p.Cosmetics,
		Settings = p.Settings,
		LostCurrency = p.LostCurrency,
		ShopPurchases = p.ShopPurchases,
		BuildPresets = p.BuildPresets,
		Admin = p.Admin,
		Derived = rt.Stats,
		HasWardrobePass = rt.HasWardrobePass == true,
		ServerTime = workspace:GetServerTimeNow(),
	})
end

function PlayerStateService.RecomputeStats(player: Player)
	local rt = runtimes[player]
	if not rt then
		return
	end
	rt.Stats = Stats.compute(rt.Profile)
	if rt.Combat then
		CombatCore.refreshMax(rt.Combat, rt.Stats)
		PlayerStateService.PushVitals(player)
	end
	local hum = rt.Humanoid
	if hum then
		hum.WalkSpeed = GameConfig.Stamina.WalkSpeed * rt.Stats.SpeedMult
	end
	PlayerStateService.StatsChanged:Fire(player, rt)
end

-- Mirrors combat vitals into the Humanoid and player attributes (replicated to all clients).
function PlayerStateService.PushVitals(player: Player)
	local rt = runtimes[player]
	if not rt or not rt.Combat then
		return
	end
	local c = rt.Combat
	local hum = rt.Humanoid
	if hum and hum.Parent then
		hum.MaxHealth = c.MaxHealth
		if not c.Dead then
			hum.Health = math.max(1, c.Health)
		end
	end
	player:SetAttribute("Health", math.floor(c.Health))
	player:SetAttribute("MaxHealth", c.MaxHealth)
	player:SetAttribute("Stamina", math.floor(c.Stamina))
	player:SetAttribute("MaxStamina", c.MaxStamina)
	player:SetAttribute("Mana", math.floor(c.Mana))
	player:SetAttribute("MaxMana", c.MaxMana)
	player:SetAttribute("FlaskCharges", rt.Profile.Flask.Charges)
	player:SetAttribute("FlaskMax", rt.Profile.Flask.MaxCharges)
	player:SetAttribute("Currency", rt.Profile.Currency)
	player:SetAttribute("Level", rt.Profile.Level)
	player:SetAttribute("Poisoned", workspace:GetServerTimeNow() < c.Status.PoisonUntil)
	player:SetAttribute("Burning", workspace:GetServerTimeNow() < c.Status.BurnUntil)
end

function PlayerStateService.RespawnPosition(player: Player): Vector3
	local rt = runtimes[player]
	local cpId = rt and rt.Profile.Checkpoints.Last or "sanctuary"
	for _, cp in World.Checkpoints do
		if cp.Id == cpId then
			return toVector(cp.Position) + Vector3.new(0, 4, 6)
		end
	end
	return toVector(World.SpawnPoint)
end

local function onCharacter(player: Player, character: Model)
	local rt = runtimes[player]
	if not rt then
		return
	end
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end
	rt.Character = character
	rt.Humanoid = humanoid
	rt.Root = root
	rt.Stats = Stats.compute(rt.Profile)
	local now = workspace:GetServerTimeNow()
	rt.Combat = CombatCore.newPlayerState(rt.Stats, now)
	rt.Combat.GodMode = rt.Profile.Admin.Granted and rt.Profile.Admin.GodMode
	-- respawning at a shrine counts as resting there: flask charges refill
	rt.Profile.Flask.Charges = rt.Profile.Flask.MaxCharges
	rt.Sprinting = false
	rt.Encounter = nil
	rt.DeathHandled = false
	humanoid.BreakJointsOnDeath = false
	humanoid.WalkSpeed = GameConfig.Stamina.WalkSpeed * rt.Stats.SpeedMult
	humanoid.MaxHealth = rt.Combat.MaxHealth
	humanoid.Health = rt.Combat.Health

	-- place at checkpoint
	task.defer(function()
		if character.Parent then
			local pos = PlayerStateService.RespawnPosition(player)
			pcall(function()
				player:RequestStreamAroundAsync(pos, 5)
			end)
			character:PivotTo(CFrame.new(pos))
		end
	end)

	humanoid.Died:Connect(function()
		-- falls into the void or other engine deaths route through the same death logic
		if rt.Character == character and not rt.DeathHandled then
			rt.Combat.Dead = true
			S.DeathService.OnPlayerDeath(player, "Engine")
		end
	end)

	PlayerStateService.PushVitals(player)
	PlayerStateService.CharacterReady:Fire(player, rt)
end

local function onPlayerAdded(player: Player)
	local profile = S.DataService.Load(player)
	if not profile or not player.Parent then
		return
	end
	runtimes[player] = {
		Player = player,
		Profile = profile,
		Stats = Stats.compute(profile),
		Region = "sanctuary",
		JoinedAt = os.time(),
	}
	DeathCore.expire(profile, os.time())
	PlayerStateService.Sync(player)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:LoadCharacter()
end

function PlayerStateService.Start()
	Players.CharacterAutoLoads = false
	Players.RespawnTime = 4
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local rt = runtimes[player]
		if rt and rt.Encounter then
			S.BossService.OnParticipantLeft(player)
		end
		runtimes[player] = nil
	end)

	-- Regeneration / status / sprint loop
	task.spawn(function()
		local acc = 0
		while true do
			local dt = task.wait(TICK)
			acc += dt
			local now = workspace:GetServerTimeNow()
			for player, rt in runtimes do
				local c = rt.Combat
				if c and not c.Dead and rt.Humanoid then
					-- sprint drain
					local moving = rt.Humanoid.MoveDirection.Magnitude > 0.1
					if rt.Sprinting and moving then
						if c.Stamina > 0 then
							c.Stamina = math.max(0, c.Stamina - GameConfig.Stamina.SprintCostPerSecond * dt)
							c.LastStaminaSpend = now
							rt.Humanoid.WalkSpeed = GameConfig.Stamina.SprintSpeed * rt.Stats.SpeedMult
						else
							rt.Sprinting = false
							rt.Humanoid.WalkSpeed = GameConfig.Stamina.WalkSpeed * rt.Stats.SpeedMult
						end
					end
					CombatCore.regen(c, dt, now, rt.Stats)
					local dotFraction = CombatCore.tickStatus(c.Status, dt, now, "Player")
					if dotFraction > 0 then
						local died = CombatCore.applyDamage(c, math.max(1, math.floor(c.MaxHealth * dotFraction)))
						if died then
							S.DeathService.OnPlayerDeath(player, "Status")
						end
					end
					PlayerStateService.PushVitals(player)
				end
			end
		end
	end)
end

function PlayerStateService.SetSprinting(player: Player, on: boolean)
	local rt = runtimes[player]
	if not rt or not rt.Humanoid or not rt.Combat then
		return
	end
	rt.Sprinting = on and rt.Combat.Stamina > 0 and not rt.Combat.Blocking
	rt.Humanoid.WalkSpeed = (if rt.Sprinting then GameConfig.Stamina.SprintSpeed else GameConfig.Stamina.WalkSpeed) * rt.Stats.SpeedMult
end

-- Restores HP/stamina/mana/flask (checkpoint rest).
function PlayerStateService.FullRestore(player: Player)
	local rt = runtimes[player]
	if not rt or not rt.Combat or rt.Combat.Dead then
		return
	end
	local c = rt.Combat
	c.Health, c.Stamina, c.Mana = c.MaxHealth, c.MaxStamina, c.MaxMana
	c.Status = CombatCore.newStatus()
	rt.Profile.Flask.Charges = rt.Profile.Flask.MaxCharges
	PlayerStateService.PushVitals(player)
end

return PlayerStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	ProgressionService
	Grants XP / currency / items / abilities / titles (the only path rewards take), tracks kill
	statistics, forwards quest events, evaluates achievements, and handles character requests:
	class selection, attribute allocation, ability slots, titles and settings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Abilities = require(Shared.Config.Abilities)
local Achievements = require(Shared.Config.Achievements)
local Cosmetics = require(Shared.Config.Cosmetics)
local Core = script.Parent.Parent.Core
local ProgressionCore = require(Core.ProgressionCore)
local InventoryCore = require(Core.InventoryCore)
local EconomyCore = require(Core.EconomyCore)
local AchievementCore = require(Core.AchievementCore)
local QuestCore = require(Core.QuestCore)

local ProgressionService = {}
local S

function ProgressionService.Init(services)
	S = services
end

function ProgressionService.EvaluateAchievements(player: Player)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	for _, a in AchievementCore.evaluate(rt.Profile) do
		local def = Achievements[a.Id]
		local extra = ""
		if a.Reward and a.Reward.Title then
			extra = " - Title: " .. a.Reward.Title
		elseif a.Reward and a.Reward.Cosmetic then
			extra = " - Cosmetic: " .. (Cosmetics[a.Reward.Cosmetic] and Cosmetics[a.Reward.Cosmetic].Name or a.Reward.Cosmetic)
		end
		S.NotifyService.Banner(player, "Achievement: " .. def.Name, def.Description .. extra, "Achievement")
	end
end

function ProgressionService.GrantXp(player: Player, amount: number, reason: string?)
	local rt = S.PlayerStateService.Get(player)
	if not rt or amount <= 0 then
		return
	end
	local r = ProgressionCore.grantXp(rt.Profile, amount)
	if r.Levels > 0 then
		S.NotifyService.Banner(player, "Level " .. rt.Profile.Level, ("+%d attribute point%s - rest at an Ember Shrine to spend them."):format(r.Levels, r.Levels > 1 and "s" or ""), "Level")
		for _, id in r.NewAbilities do
			S.NotifyService.Toast(player, "New ability unlocked: " .. Abilities[id].Name, "Reward")
		end
		if S.LeaderboardService then
			S.LeaderboardService.Update(player)
		end
	end
	return r
end

function ProgressionService.GrantCurrency(player: Player, amount: number)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return 0
	end
	return EconomyCore.addCurrency(rt.Profile, amount)
end

function ProgressionService.GrantItems(player: Player, items, source: string?)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	for itemId, n in items do
		if Items[itemId] and n > 0 then
			local ok, res = InventoryCore.addItem(rt.Profile, itemId, n, true)
			if ok and res.Added > 0 then
				S.NotifyService.Toast(player, ("%s%s x%d"):format(source and (source .. ": ") or "", Items[itemId].Name, res.Added), "Loot")
			elseif ok then
				S.NotifyService.Toast(player, "Inventory full: " .. Items[itemId].Name .. " was lost.", "Warning")
			end
		end
	end
end

-- bundle = { Xp, Currency, Items, Ability, Title, Cosmetic }
function ProgressionService.GrantBundle(player: Player, bundle, source: string?)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not bundle then
		return
	end
	if (bundle.Currency or 0) > 0 then
		local got = ProgressionService.GrantCurrency(player, bundle.Currency)
		S.NotifyService.Toast(player, ("+%d %s"):format(got, GameConfig.Currency.Name), "Currency")
	end
	if bundle.Items then
		ProgressionService.GrantItems(player, bundle.Items, source)
	end
	if bundle.Ability and ProgressionCore.unlockAbility(rt.Profile, bundle.Ability) then
		S.NotifyService.Toast(player, "Ability learned: " .. Abilities[bundle.Ability].Name, "Reward")
	end
	if bundle.Title then
		rt.Profile.Titles[bundle.Title] = true
		S.NotifyService.Toast(player, "Title earned: " .. bundle.Title, "Reward")
	end
	if bundle.Cosmetic and Cosmetics[bundle.Cosmetic] then
		rt.Profile.Cosmetics.Owned[bundle.Cosmetic] = true
		S.NotifyService.Toast(player, "Cosmetic unlocked: " .. Cosmetics[bundle.Cosmetic].Name, "Reward")
	end
	if (bundle.Xp or 0) > 0 then
		ProgressionService.GrantXp(player, bundle.Xp, source)
		S.NotifyService.Toast(player, ("+%d XP"):format(bundle.Xp), "Xp")
	end
	ProgressionService.EvaluateAchievements(player)
	S.PlayerStateService.Sync(player)
	S.PlayerStateService.PushVitals(player)
end

function ProgressionService.QuestEvent(player: Player, event)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	local changed = QuestCore.onEvent(rt.Profile, event)
	for _, qid in changed do
		if QuestCore.isComplete(rt.Profile, qid) then
			S.NotifyService.Toast(player, "Quest ready to turn in.", "Quest")
		end
	end
end

function ProgressionService.OnEnemyKilled(player: Player, enemyDef)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	AchievementCore.increment(rt.Profile, "Kills")
	rt.Profile.KillsByEnemy[enemyDef.Id] = (rt.Profile.KillsByEnemy[enemyDef.Id] or 0) + 1
	ProgressionService.QuestEvent(player, { Type = "Kill", Enemy = enemyDef.Id })
end

-- ===================================================================== requests
local function outOfCombat(rt): boolean
	return workspace:GetServerTimeNow() - (rt.Combat and rt.Combat.LastDamagedAt or -1e9) > GameConfig.Combat.CombatTagSeconds
		and rt.Encounter == nil
end

function ProgressionService.Start()
	local R = S.RequestService

	R.Register("ChooseClass", function(player, rt, className)
		local ok, err = ProgressionCore.chooseClass(rt.Profile, className)
		if not ok then
			return false, err
		end
		S.PlayerStateService.RecomputeStats(player)
		S.PlayerStateService.FullRestore(player)
		S.CosmeticService.Refresh(player)
		S.PlayerStateService.Sync(player)
		S.DataService.Save(player)
		S.NotifyService.Banner(player, "The " .. className .. " awakens", "Speak to Ilya the Guide, or climb the tower when ready.", "Banner")
		return true, className
	end)

	R.Register("AllocateAttributes", function(player, rt, allocations)
		if not S.CheckpointService.IsNearActivatedShrine(player) then
			return false, "RestAtShrine"
		end
		if not outOfCombat(rt) then
			return false, "InCombat"
		end
		local ok, err = ProgressionCore.allocate(rt.Profile, allocations)
		if not ok then
			return false, err
		end
		S.PlayerStateService.RecomputeStats(player)
		ProgressionService.EvaluateAchievements(player)
		S.PlayerStateService.Sync(player)
		return true, err
	end)

	R.Register("SetAbilitySlot", function(player, rt, payload)
		if type(payload) ~= "table" then
			return false, "BadRequest"
		end
		if not outOfCombat(rt) then
			return false, "InCombat"
		end
		local ok, err = ProgressionCore.setAbilitySlot(rt.Profile, payload.Slot, payload.Ability)
		S.PlayerStateService.Sync(player)
		return ok, err
	end)

	R.Register("SetTitle", function(player, rt, title)
		if title ~= "" and (type(title) ~= "string" or not rt.Profile.Titles[title]) then
			return false, "NotOwned"
		end
		rt.Profile.ActiveTitle = title
		S.CosmeticService.Refresh(player)
		S.PlayerStateService.Sync(player)
		return true, title
	end)

	R.Register("SaveSettings", function(player, rt, settings)
		if type(settings) ~= "table" then
			return false, "BadRequest"
		end
		local cur = rt.Profile.Settings
		for k, v in settings do
			local old = cur[k]
			if old ~= nil and type(v) == type(old) then
				if type(v) == "number" then
					if v == v then
						cur[k] = math.clamp(v, 0, 3)
					end
				else
					cur[k] = v
				end
			end
		end
		return true, cur
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">ProjectileService</string>
            <string name="Source"><![CDATA[--[[
	ProjectileService
	Server-simulated projectiles (arrows, spells, boss volleys). Each projectile is an anchored
	part moved every Heartbeat; collision is a sphere test against targets plus a raycast
	against world geometry. Projectiles are capped and always cleaned up.

	spec = {
	  Origin: Vector3, Direction: Vector3, Speed, Radius, Range, Color,
	  Hostile: bool          -- true = hits players, false = hits entities
	  Owner: Player?         -- for player projectiles
	  HomingTarget: BasePart?, Homing: number (0..1 turn rate)
	  OnHit(target, position) -- target = Player (hostile) or entity (friendly)
	  Pierce: bool
	}
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local ProjectileService = {}

local S
local active = {}
local folder: Folder
local MAX_ACTIVE = 300


function ProjectileService.Init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Projectiles"
	folder.Parent = workspace
end

function ProjectileService.Fire(spec)
	if #active >= MAX_ACTIVE then
		return nil
	end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = spec.Color or Color3.fromRGB(255, 160, 80)
	p.Size = Vector3.new(1, 1, 1) * math.max(0.6, spec.Radius * 1.2)
	p.CFrame = CFrame.new(spec.Origin)
	local light = Instance.new("PointLight")
	light.Color = p.Color
	light.Range = 8
	light.Parent = p
	p.Parent = folder
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { folder, workspace:FindFirstChild("Telegraphs"), workspace:FindFirstChild("Entities") }
	if spec.Owner and spec.Owner.Character then
		table.insert(ignore, spec.Owner.Character)
	end
	if spec.IgnoreCharacters then
		for _, plr in Players:GetPlayers() do
			if plr.Character then
				table.insert(ignore, plr.Character)
			end
		end
	end
	params.FilterDescendantsInstances = ignore
	local proj = {
		Params = params,
		Part = p,
		Pos = spec.Origin,
		Dir = if spec.Direction.Magnitude > 0 then spec.Direction.Unit else Vector3.new(0, 0, -1),
		Travelled = 0,
		Spec = spec,
		Hit = {},
	}
	table.insert(active, proj)
	return proj
end

local function finish(i: number)
	local proj = active[i]
	if proj.Part then
		proj.Part:Destroy()
	end
	table.remove(active, i)
end

local function step(dt: number)
	for i = #active, 1, -1 do
		local proj = active[i]
		local spec = proj.Spec
		if not proj.Part.Parent then
			table.remove(active, i)
			continue
		end
		if spec.HomingTarget and spec.HomingTarget.Parent and (spec.Homing or 0) > 0 then
			local want = (spec.HomingTarget.Position - proj.Pos)
			if want.Magnitude > 0.1 then
				proj.Dir = proj.Dir:Lerp(want.Unit, math.clamp(spec.Homing * dt * 3, 0, 1)).Unit
			end
		end
		local move = proj.Dir * spec.Speed * dt
		local hitWorld = workspace:Raycast(proj.Pos, move, proj.Params)
		local nextPos = if hitWorld then hitWorld.Position else proj.Pos + move
		proj.Travelled += (nextPos - proj.Pos).Magnitude
		proj.Pos = nextPos
		proj.Part.CFrame = CFrame.new(nextPos)

		local done = false
		if spec.Hostile then
			for _, plr in Players:GetPlayers() do
				local rt = S.PlayerStateService.Get(plr)
				if rt and rt.Root and rt.Combat and not rt.Combat.Dead and not proj.Hit[plr] then
					if (rt.Root.Position - nextPos).Magnitude <= spec.Radius + 2 then
						proj.Hit[plr] = true
						task.spawn(spec.OnHit, plr, nextPos)
						if not spec.Pierce then
							done = true
							break
						end
					end
				end
			end
		else
			for _, e in S.EntityService.Near(nextPos, spec.Radius, 10) do
				if not proj.Hit[e] then
					proj.Hit[e] = true
					task.spawn(spec.OnHit, e, nextPos)
					if not spec.Pierce then
						done = true
						break
					end
				end
			end
			-- PvP projectiles
			if not done and spec.PvpTargets then
				for _, plr in spec.PvpTargets do
					local rt = S.PlayerStateService.Get(plr)
					if rt and rt.Root and not proj.Hit[plr] and (rt.Root.Position - nextPos).Magnitude <= spec.Radius + 2 then
						proj.Hit[plr] = true
						task.spawn(spec.OnHitPlayer, plr, nextPos)
						done = true
						break
					end
				end
			end
		end
		if done or hitWorld or proj.Travelled >= spec.Range then
			if spec.OnExpire then
				task.spawn(spec.OnExpire, nextPos)
			end
			finish(i)
		end
	end
end

function ProjectileService.Start()
	RunService.Heartbeat:Connect(step)
end

function ProjectileService.Count(): number
	return #active
end

return ProjectileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">PromoService</string>
            <string name="Source"><![CDATA[--[[
	PromoService
	Promo-code redemption and the admin panel.

	* Codes live in ServerScriptService.Server.Config.PromoCodes (never sent to clients).
	* Each code works once per character (profile.RedeemedCodes).
	* MaxUses is a GLOBAL limit across all servers, enforced with an atomic UpdateAsync counter
	  BEFORE anything is granted, so two players redeeming at the same moment can't exceed it.
	* Failed attempts are throttled (5 per minute) to stop guessing.
	* Admin codes unlock the admin panel: Never Die toggle, Unlock All, Max Upgrades,
	  All Items, All Customisations. Every admin action re-checks profile.Admin.Granted.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local PromoCodes = require(script.Parent.Parent.Config.PromoCodes)
local PromoCore = require(script.Parent.Parent.Core.PromoCore)

local PromoService = {}
local S
local store: DataStore? = nil
local memoryUses = {} -- Studio fallback when DataStores are unavailable
local failures = {}
local inFlight = {} -- one redemption at a time per player

function PromoService.Init(services)
	S = services
	pcall(function()
		store = DataStoreService:GetDataStore("TOTF_PromoCodes_v1")
	end)
end

-- Atomically reserves one global use. Returns true if a use was available.
local function claimGlobalUse(def): (boolean, string?)
	if not def.MaxUses then
		return true, nil
	end
	if S.DataService.IsMemoryMode() or not store then
		local used = memoryUses[def.Id] or 0
		if used >= def.MaxUses then
			return false, "CodeUsedUp"
		end
		memoryUses[def.Id] = used + 1
		return true, nil
	end
	local granted = false
	local ok = pcall(function()
		(store :: DataStore):UpdateAsync("uses_" .. def.Id, function(old)
			local used = tonumber(old) or 0
			if used >= def.MaxUses then
				granted = false
				return nil -- abort: no uses left
			end
			granted = true
			return used + 1
		end)
	end)
	if not ok then
		return false, "TryAgainLater"
	end
	return granted, if granted then nil else "CodeUsedUp"
end

local function throttled(player: Player): boolean
	local f = failures[player]
	local t = os.clock()
	if f and t - f.Since > 60 then
		f = nil
		failures[player] = nil
	end
	return f ~= nil and f.Count >= 5
end

local function noteFailure(player: Player)
	local f = failures[player] or { Count = 0, Since = os.clock() }
	f.Count += 1
	failures[player] = f
end

local function refresh(player: Player, statsChanged: boolean?)
	if statsChanged then
		S.PlayerStateService.RecomputeStats(player)
		S.InventoryService.ApplyWeaponVisual(player)
	end
	S.CosmeticService.Refresh(player)
	S.PlayerStateService.Sync(player)
	S.PlayerStateService.PushVitals(player)
	task.spawn(S.DataService.Save, player)
end

function PromoService.Start()
	local R = S.RequestService

	R.Register("RedeemCode", function(player, rt, text)
		if throttled(player) then
			return false, "TooManyAttempts"
		end
		if inFlight[player] then
			return false, "Busy"
		end
		local def = PromoCore.find(PromoCodes, text)
		local ok, err = PromoCore.check(rt.Profile, def, os.time())
		if not ok then
			noteFailure(player)
			return false, err
		end
		inFlight[player] = true
		local claimed, why = claimGlobalUse(def)
		inFlight[player] = nil
		if not claimed then
			return false, why
		end
		-- the player may have left while the counter was updating
		if not player.Parent or S.PlayerStateService.Get(player) ~= rt then
			return false, "NotLoaded"
		end
		PromoCore.markRedeemed(rt.Profile, def)
		if def.Kind == "Admin" then
			S.NotifyService.Banner(player, "ADMIN ACCESS GRANTED", "Open the menu -> Codes to use the admin panel.", "Reward")
			warn(("[PromoService] admin code %s redeemed by %s (%d)"):format(def.Id, player.Name, player.UserId))
			refresh(player)
		else
			S.ProgressionService.GrantBundle(player, def.Reward, "Promo code")
			task.spawn(S.DataService.Save, player)
		end
		return true, def.Kind
	end)

	R.Register("AdminAction", function(player, rt, payload)
		local admin = rt.Profile.Admin
		if not admin.Granted then
			return false, "NotAdmin"
		end
		if type(payload) ~= "table" or type(payload.Action) ~= "string" then
			return false, "BadRequest"
		end
		local a = payload.Action
		if a == "GodMode" then
			admin.GodMode = payload.On == true
			if rt.Combat then
				rt.Combat.GodMode = admin.GodMode
			end
			S.NotifyService.Toast(player, if admin.GodMode then "Never Die: ON" else "Never Die: OFF", "Reward")
			refresh(player)
		elseif a == "UnlockAll" then
			PromoCore.unlockAll(rt.Profile)
			S.NotifyService.Toast(player, "Unlocked all floors, shrines, locations and abilities.", "Reward")
			refresh(player, true)
		elseif a == "MaxUpgrades" then
			local n = PromoCore.maxUpgrades(rt.Profile)
			S.NotifyService.Toast(player, ("Upgraded %d items to maximum."):format(n), "Reward")
			refresh(player, true)
		elseif a == "AllItems" then
			local n = PromoCore.allItems(rt.Profile)
			S.NotifyService.Toast(player, ("Added %d items."):format(n), "Reward")
			refresh(player, true)
		elseif a == "AllCosmetics" then
			PromoCore.allCosmetics(rt.Profile)
			S.NotifyService.Toast(player, "All cosmetics and titles unlocked.", "Reward")
			refresh(player)
		else
			return false, "BadRequest"
		end
		return true, a
	end)

	Players.PlayerRemoving:Connect(function(p)
		failures[p] = nil
		inFlight[p] = nil
	end)
end

return PromoService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--[[
	PurchaseService
	Monetisation (cosmetic / convenience only) through Roblox-supported flows.

	Developer Products: MarketplaceService.ProcessReceipt -> ReceiptCore (idempotent by
	PurchaseId). We only return PurchaseGranted after the grant is SAVED; if the save fails we
	return NotProcessedYet and Roblox retries later - the receipt id is already recorded in the
	profile, so the retry cannot grant twice.
	Game Passes: ownership checked with UserOwnsGamePassAsync on join and after
	PromptGamePassPurchaseFinished. Products with Id = 0 are disabled.
	Clients may only *request a prompt*; they can never grant anything.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)
local ReceiptCore = require(script.Parent.Parent.Core.ReceiptCore)

local PurchaseService = {}
local S

function PurchaseService.Init(services)
	S = services
end

local function checkPasses(player: Player)
	local rt = S.PlayerStateService.Get(player)
	if not rt then
		return
	end
	local pass = Products.GamePasses.wardrobe_plus
	if pass.Id ~= 0 then
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
		end)
		rt.HasWardrobePass = ok and owns == true
	end
	S.PlayerStateService.Sync(player)
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- wait briefly for the profile if the player just joined
	local rt
	for _ = 1, 20 do
		rt = S.PlayerStateService.Get(player)
		if rt then
			break
		end
		task.wait(0.5)
	end
	if not rt then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local status, granted = ReceiptCore.process(rt.Profile, receipt)
	if status == "Unknown" then
		warn("[PurchaseService] unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if status == "Granted" then
		S.NotifyService.Banner(player, "THANK YOU", "Cosmetic unlocked: " .. table.concat(granted or {}, ", "), "Reward")
		S.PlayerStateService.Sync(player)
	end
	-- persist before acknowledging
	if not S.DataService.Save(player) and not S.DataService.IsMemoryMode() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	S.PlayerStateService.CharacterReady:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			checkPasses(player)
		end
	end)
	S.RequestService.Register("PromptProduct", function(player, rt, key)
		local p = type(key) == "string" and Products.DevProducts[key]
		if not p or p.Id == 0 then
			return false, "Unavailable"
		end
		MarketplaceService:PromptProductPurchase(player, p.Id)
		return true, nil
	end)
	S.RequestService.Register("PromptPass", function(player, rt, key)
		local p = type(key) == "string" and Products.GamePasses[key]
		if not p or p.Id == 0 then
			return false, "Unavailable"
		end
		MarketplaceService:PromptGamePassPurchase(player, p.Id)
		return true, nil
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	QuestService
	Accept / abandon / turn in quests at the giving NPC. Rewards go through ProgressionService.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local Core = script.Parent.Parent.Core
local QuestCore = require(Core.QuestCore)
local AchievementCore = require(Core.AchievementCore)

local QuestService = {}
local S

function QuestService.Init(services)
	S = services
end

function QuestService.Start()
	local R = S.RequestService

	R.Register("AcceptQuest", function(player, rt, questId)
		local q = type(questId) == "string" and Quests[questId]
		if not q then
			return false, "UnknownQuest"
		end
		if not S.InteractionService.IsNear(player, q.Giver) then
			return false, "TooFar"
		end
		local ok, err = QuestCore.accept(rt.Profile, questId)
		if ok then
			S.NotifyService.Toast(player, "Quest accepted: " .. q.Name, "Quest")
			S.PlayerStateService.Sync(player)
		end
		return ok, err
	end)

	R.Register("AbandonQuest", function(player, rt, questId)
		local ok, err = QuestCore.abandon(rt.Profile, questId)
		S.PlayerStateService.Sync(player)
		return ok, err
	end)

	R.Register("TurnInQuest", function(player, rt, questId)
		local q = type(questId) == "string" and Quests[questId]
		if not q then
			return false, "UnknownQuest"
		end
		if not S.InteractionService.IsNear(player, q.Giver) then
			return false, "TooFar"
		end
		local ok, rewards = QuestCore.turnIn(rt.Profile, questId)
		if not ok then
			return false, rewards
		end
		AchievementCore.increment(rt.Profile, "QuestsDone")
		S.NotifyService.Banner(player, "QUEST COMPLETE", q.Name, "Quest")
		S.ProgressionService.GrantBundle(player, rewards, q.Name)
		task.spawn(S.DataService.Save, player)
		return true, questId
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">RequestService</string>
            <string name="Source"><![CDATA[--[[
	RequestService
	Single RemoteFunction router for menu/interaction requests:
	  client: Request:InvokeServer(name, payload) -> { Ok = bool, Result = any, Error = string? }
	Handlers are registered by services. Every call is rate limited and wrapped in pcall so a
	bad payload can never error the remote or leak a stack trace to the client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local RequestService = {}

local S
local handlers = {}

function RequestService.Init(services)
	S = services
end

function RequestService.Register(name: string, handler)
	assert(handlers[name] == nil, "duplicate request handler " .. name)
	handlers[name] = handler
end

function RequestService.Start()
	Net.func("Request").OnServerInvoke = function(player: Player, name, payload)
		if type(name) ~= "string" then
			return { Ok = false, Error = "BadRequest" }
		end
		local handler = handlers[name]
		if not handler then
			return { Ok = false, Error = "UnknownRequest" }
		end
		if not S.CombatService.Allow(player) then
			return { Ok = false, Error = "TooFast" }
		end
		local rt = S.PlayerStateService.Get(player)
		if not rt then
			return { Ok = false, Error = "NotLoaded" }
		end
		local ok, success, result = pcall(handler, player, rt, payload)
		if not ok then
			warn(("[RequestService] %s from %s errored: %s"):format(name, player.Name, tostring(success)))
			return { Ok = false, Error = "ServerError" }
		end
		if success then
			return { Ok = true, Result = result }
		end
		return { Ok = false, Error = tostring(result) }
	end
end

return RequestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService
	Merchant purchases. Validation: the player must be near the NPC that runs `shopId`, and
	EconomyCore validates price, stock visibility, limits, quantity and balance atomically.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Shops = require(Shared.Config.Shops)
local EconomyCore = require(script.Parent.Parent.Core.EconomyCore)

local ShopService = {}
local S

function ShopService.Init(services)
	S = services
end

function ShopService.Start()
	S.RequestService.Register("Buy", function(player, rt, payload)
		if type(payload) ~= "table" or type(payload.Shop) ~= "string" or not Shops[payload.Shop] then
			return false, "BadRequest"
		end
		if not S.InteractionService.IsNearShop(player, payload.Shop) then
			return false, "NotAtMerchant"
		end
		local ok, res = EconomyCore.buy(rt.Profile, payload.Shop, payload.Item, payload.Quantity)
		if not ok then
			return false, res
		end
		S.NotifyService.Toast(player, ("Bought %s x%d"):format(Items[res.Item].Name, res.Quantity), "Loot")
		S.PlayerStateService.Sync(player)
		S.PlayerStateService.PushVitals(player)
		return true, res
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">TelegraphService</string>
            <string name="Source"><![CDATA[--[[
	TelegraphService
	Ground indicators for hostile attacks and persistent hazard zones.

	Colour language (clients may remap for high-contrast accessibility):
	  Gold   = parryable          (Attribute Telegraph = "Parry")
	  White  = blockable          (Attribute Telegraph = "Block")
	  Red    = unblockable        (Attribute Telegraph = "Danger")
	  Green  = safe zone          (Attribute Telegraph = "Safe")
	  Purple = lingering hazard   (Attribute Telegraph = "Hazard")
	A filling inner shape shows exactly when the attack lands.
]]

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local TelegraphService = {}

local folder: Folder

TelegraphService.Colors = {
	Parry = Color3.fromRGB(255, 196, 60),
	Block = Color3.fromRGB(235, 235, 235),
	Danger = Color3.fromRGB(225, 40, 40),
	Safe = Color3.fromRGB(70, 220, 110),
	Hazard = Color3.fromRGB(150, 70, 220),
}

function TelegraphService.Init(_services)
	folder = Instance.new("Folder")
	folder.Name = "Telegraphs"
	folder.Parent = workspace
end

function TelegraphService.Start() end

function TelegraphService.KindFor(attack): string
	if attack.Parryable then
		return "Parry"
	elseif attack.Blockable then
		return "Block"
	end
	return "Danger"
end

local function flat(name: string, size: Vector3, cf: CFrame, kind: string, transparency: number, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = TelegraphService.Colors[kind] or TelegraphService.Colors.Danger
	p.Transparency = transparency
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.CFrame = cf
	p:SetAttribute("Telegraph", kind)
	p.Parent = folder
	return p
end

local function disc(name, center: Vector3, radius: number, kind, transparency, yOff: number?)
	return flat(name, Vector3.new(0.2, radius * 2, radius * 2), CFrame.new(center + Vector3.new(0, 0.15 + (yOff or 0), 0)) * CFrame.Angles(0, 0, math.rad(90)), kind, transparency, Enum.PartType.Cylinder)
end

-- Triangle on the ground from two wedges.
local function triangle(model: Instance, a: Vector3, b: Vector3, c: Vector3, kind: string, transparency: number)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	for i = 1, 2 do
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.CastShadow = false
		w.Material = Enum.Material.Neon
		w.Color = TelegraphService.Colors[kind]
		w.Transparency = transparency
		w:SetAttribute("Telegraph", kind)
		if i == 1 then
			w.Size = Vector3.new(0.2, height, math.abs(ab:Dot(back)))
			w.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
		else
			w.Size = Vector3.new(0.2, height, math.abs(ac:Dot(back)))
			w.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
		end
		w.Parent = model
	end
end

--[[
	Shows a telegraph for `duration` seconds and removes it afterwards.
	shape: Circle(Center, Radius) | Ring(Center, Inner, Outer) | Line(Origin, Dir, Length, Width)
	       | Cone(Origin, Dir, Range, Arc) | Pulse(Center, Radius, SafeZones = {Vector3}, SafeRadius)
]]
function TelegraphService.Show(spec, duration: number)
	local kind = spec.Kind or "Danger"
	local container = Instance.new("Model")
	container.Name = "Telegraph"
	container.Parent = folder
	local y = spec.GroundY or (spec.Center and spec.Center.Y) or (spec.Origin and spec.Origin.Y) or 0
	local fillTween
	if spec.Shape == "Circle" or spec.Shape == "Hazard" then
		local outer = disc("Outer", spec.Center, spec.Radius, kind, 0.65)
		outer.Parent = container
		local inner = disc("Fill", spec.Center, 0.1, kind, 0.35, 0.02)
		inner.Parent = container
		fillTween = TweenService:Create(inner, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, spec.Radius * 2, spec.Radius * 2) })
	elseif spec.Shape == "Ring" then
		local outer = disc("Outer", spec.Center, spec.Outer, kind, 0.55)
		outer.Parent = container
		local safe = disc("Safe", spec.Center, spec.Inner, "Safe", 0.45, 0.03)
		safe.Parent = container
	elseif spec.Shape == "Line" then
		local dir = Vector3.new(spec.Dir.X, 0, spec.Dir.Z).Unit
		local origin = Vector3.new(spec.Origin.X, y, spec.Origin.Z)
		local cf = CFrame.lookAt(origin, origin + dir)
		local outer = flat("Outer", Vector3.new(spec.Width, 0.2, spec.Length), cf * CFrame.new(0, 0.15, -spec.Length / 2), kind, 0.65)
		outer.Parent = container
		local inner = flat("Fill", Vector3.new(spec.Width, 0.22, 0.1), cf * CFrame.new(0, 0.17, -0.05), kind, 0.35)
		inner.Parent = container
		fillTween = TweenService:Create(inner, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			Size = Vector3.new(spec.Width, 0.22, spec.Length),
			CFrame = cf * CFrame.new(0, 0.17, -spec.Length / 2),
		})
	elseif spec.Shape == "Cone" then
		local dir = Vector3.new(spec.Dir.X, 0, spec.Dir.Z).Unit
		local origin = Vector3.new(spec.Origin.X, y + 0.15, spec.Origin.Z)
		local half = math.rad(math.min(spec.Arc, 359)) / 2
		local segments = math.clamp(math.ceil(spec.Arc / 30), 2, 8)
		local base = math.atan2(dir.X, dir.Z)
		local prev
		for i = 0, segments do
			local ang = base - half + (2 * half) * (i / segments)
			local pt = origin + Vector3.new(math.sin(ang), 0, math.cos(ang)) * spec.Range
			if prev then
				triangle(container, origin, prev, pt, kind, 0.55)
			end
			prev = pt
		end
	elseif spec.Shape == "Pulse" then
		local outer = disc("Outer", spec.Center, spec.Radius, "Danger", 0.75)
		outer.Parent = container
		for _, z in spec.SafeZones or {} do
			local s = disc("Safe", z, spec.SafeRadius, "Safe", 0.3, 0.04)
			s.Parent = container
		end
	end
	if fillTween then
		fillTween:Play()
	end
	Debris:AddItem(container, duration + 0.05)
	return container
end

-- A lingering hazard zone (purple disc) for `duration` seconds.
function TelegraphService.Hazard(center: Vector3, radius: number, duration: number)
	local p = disc("Hazard", center, radius, "Hazard", 0.55)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(TelegraphService.Colors.Hazard)
	smoke.Rate = math.clamp(radius * 2, 5, 30)
	smoke.Lifetime = NumberRange.new(1, 2)
	smoke.Speed = NumberRange.new(1, 3)
	smoke.Size = NumberSequence.new(2, 4)
	smoke.Transparency = NumberSequence.new(0.6, 1)
	smoke.Parent = p
	Debris:AddItem(p, duration)
	return p
end

-- Brief impact flash at a position.
function TelegraphService.Impact(center: Vector3, radius: number, color: Color3?)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(255, 200, 150)
	p.Transparency = 0.4
	p.Size = Vector3.new(1, 1, 1) * math.max(1, radius * 0.6)
	p.CFrame = CFrame.new(center)
	p.Parent = folder
	TweenService:Create(p, TweenInfo.new(0.3), { Size = Vector3.new(1, 1, 1) * radius * 2, Transparency = 1 }):Play()
	Debris:AddItem(p, 0.35)
end

return TelegraphService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">TrainingService</string>
            <string name="Source"><![CDATA[--[[
	TrainingService
	Training Grounds challenges. The server observes everything itself:
	  Reps     - rep presses timed by the server, stamina spent per rep
	  Hits     - valid weapon hits on training dummies (EntityService)
	  Avoid    - the drill master's telegraphed attacks: dodged or stepped out of = avoided
	  Parry    - only parries count
	  Course   - posts touched in order (server distance checks)
	  Spar     - defeat a sparring partner that only targets you; dying costs nothing
	Rewards are capped by TrainingCore (cooldowns, daily cap, +5 per-attribute bonus cap).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Training = require(Shared.Config.Training)
local Attacks = require(Shared.Config.Attacks)
local Net = require(Shared.Net)
local Core = script.Parent.Parent.Core
local TrainingCore = require(Core.TrainingCore)
local CombatCore = require(Core.CombatCore)
local AchievementCore = require(Core.AchievementCore)
local EntityModels = require(script.Parent.EntityModels)

local TrainingService = {}
local S
local remote: RemoteEvent
local stations = {} -- [challengeId] = BasePart
local posts = {} -- [index] = BasePart

local function now()
	return workspace:GetServerTimeNow()
end

function TrainingService.Init(services)
	S = services
	remote = Net.event("Training")
end

local function send(player: Player, payload)
	remote:FireClient(player, payload)
end

local function finish(player: Player, rt, session)
	if rt.Training ~= session then
		return
	end
	rt.Training = nil
	if session.Cleanup then
		session.Cleanup()
	end
	if session.State == "Success" then
		local r = TrainingCore.reward(rt.Profile, session, os.time())
		AchievementCore.increment(rt.Profile, "TrainingDone")
		S.ProgressionService.QuestEvent(player, { Type = "Training" })
		S.ProgressionService.GrantXp(player, r.Xp, "Training")
		local msg = ("+%d XP"):format(r.Xp)
		if r.Points > 0 then
			msg ..= (", +%d %s training"):format(r.Points, session.Def.Attribute)
		end
		if r.BonusGained > 0 then
			msg ..= (" - %s +%d!"):format(session.Def.Attribute, r.BonusGained)
			S.PlayerStateService.RecomputeStats(player)
		end
		if r.Capped then
			msg ..= " (daily/attribute training cap reached)"
		end
		S.NotifyService.Banner(player, "TRAINING COMPLETE", session.Def.Name .. " - " .. msg, "Reward")
		S.ProgressionService.EvaluateAchievements(player)
		S.PlayerStateService.Sync(player)
	else
		S.NotifyService.Toast(player, session.Def.Name .. " failed. " .. (session.Reason or ""), "Warning")
	end
	send(player, { Type = "End", State = session.State })
end

local function runDrill(player: Player, rt, session, station: BasePart)
	local def = session.Def
	local base = station.Position + Vector3.new(0, 0, -8)
	local model, root, humanoid, _, _, shoulder = EntityModels.build("Drill Master", { Style = "Humanoid", Scale = 1.15, Color = Color3.fromRGB(120, 110, 90), Weapon = "Sword" }, "Dummy")
	model:PivotTo(CFrame.new(base + Vector3.new(0, 5, 0)))
	root.Anchored = true
	model.Parent = workspace
	local entity = { Alive = true, Target = CombatCore.newTarget(1e9, 1e9), Kind = "Dummy" }
	local attacker = {
		Entity = entity,
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Shoulder = shoulder,
		BaseDamage = 6, -- drills are safe
		Targets = function()
			return { player }
		end,
	}
	session.Cleanup = function()
		entity.Alive = false
		model:Destroy()
	end
	task.spawn(function()
		task.wait(2)
		for i = 1, def.Attacks do
			if rt.Training ~= session or session.State ~= "Running" then
				return
			end
			local outcome
			attacker.OnHitPlayer = function(_, o)
				outcome = o
			end
			local attack = if i % 2 == 0
				then Attacks.Circle({ Name = "Drill Slam", Windup = def.Windup, Recovery = 0.4, Damage = 1, Radius = 7, Offset = 3, Parryable = def.Kind == "Parry" })
				else Attacks.Cone({ Name = "Drill Cut", Windup = def.Windup, Recovery = 0.4, Damage = 1, Range = 12, Arc = 100, Parryable = true })
			-- the trainee must actually be within reach when the attack begins; standing far away
			-- (AFK) counts as a miss, not an avoid
			local prt = S.PlayerStateService.Get(player)
			local engaged = prt ~= nil and prt.Root ~= nil and (prt.Root.Position - root.Position).Magnitude <= 13
			S.AttackExecutor.Run(attacker, attack, player)
			task.wait(0.25)
			local result = outcome
			if not engaged then
				result = "Miss"
				S.NotifyService.Toast(player, "Stay close to the drill master!", "Warning")
			elseif result == nil or result == "Dodged" then
				result = if def.Kind == "Avoid" then "Avoided" else "Miss"
			end
			local state = TrainingCore.drillAttack(session, result)
			send(player, { Type = "Progress", Count = session.Count, Goal = def.Required, Failures = session.Failures })
			if state ~= "Running" then
				finish(player, rt, session)
				return
			end
			task.wait(math.max(0.5, def.Interval - def.Windup))
		end
		if session.State == "Running" then
			session.State = "Failed"
			finish(player, rt, session)
		end
	end)
end

local function start(player: Player, challengeId: string, station: BasePart)
	local rt = S.PlayerStateService.Get(player)
	if not rt or not rt.Root or not rt.Combat or rt.Combat.Dead then
		return
	end
	if rt.Training then
		S.NotifyService.Toast(player, "Finish your current training first.", "Warning")
		return
	end
	if (rt.Root.Position - station.Position).Magnitude > 16 then
		return
	end
	local session, err = TrainingCore.start(rt.Profile, challengeId, os.time())
	if not session then
		if err == "Cooldown" then
			S.NotifyService.Toast(player, ("Rest first: available in %ds."):format(math.ceil(TrainingCore.cooldownRemaining(rt.Profile, challengeId, os.time()))), "Warning")
		end
		return
	end
	-- sessions are timed with the server clock
	session.StartedAt = now()
	session.Station = station
	rt.Training = session
	local def = session.Def
	send(player, { Type = "Start", Id = challengeId, Name = def.Name, Description = def.Description, Kind = def.Kind,
		Goal = def.Reps or def.Hits or def.Required or def.Posts or 1, TimeLimit = def.TimeLimit })
	if def.Kind == "Avoid" or def.Kind == "Parry" then
		runDrill(player, rt, session, station)
	elseif def.Kind == "Spar" then
		local ai = S.EnemyService.Spawn(def.Enemy, station.Position + Vector3.new(0, 4, -12), {
			Name = "Sparring Partner",
			Owner = player, -- only the trainee can damage it
			HealthScale = def.HealthMult,
			NoRewards = true,
			Leash = 60,
			Restrict = function(plr)
				return plr == player
			end,
			OnDeath = function(_, killer)
				if rt.Training == session and killer == player then
					TrainingCore.spar(session, true)
					finish(player, rt, session)
				end
			end,
		})
		session.Cleanup = function()
			if ai and not ai.Dead then
				S.EnemyService.Despawn(ai, true)
			end
		end
	end
end

function TrainingService.OnRep(player: Player)
	local rt = S.PlayerStateService.Get(player)
	local session = rt and rt.Training
	if not session or session.Def.Kind ~= "Reps" then
		return
	end
	local c = rt.Combat
	local has = c and c.Stamina >= session.Def.StaminaPerRep
	if has then
		c.Stamina -= session.Def.StaminaPerRep
		c.LastStaminaSpend = now()
	end
	local state = TrainingCore.rep(session, now(), has)
	send(player, { Type = "Progress", Count = session.Count, Goal = session.Def.Reps })
	if state ~= "Running" then
		session.Reason = if not has then "Out of stamina." else "Keep a steady rhythm."
		finish(player, rt, session)
	end
end

function TrainingService.OnPlayerDied(player: Player)
	local rt = S.PlayerStateService.Get(player)
	local session = rt and rt.Training
	if session then
		session.State = "Failed"
		session.Reason = "You were defeated."
		finish(player, rt, session)
	end
end

function TrainingService.Start()
	local function hookStation(part: Instance)
		local id = part:GetAttribute("Challenge")
		local def = id and Training[id]
		if not def or not part:IsA("BasePart") then
			return
		end
		stations[id] = part
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Begin"
		prompt.ObjectText = def.Name
		prompt.MaxActivationDistance = 12
		prompt.HoldDuration = 0.4
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			start(player, id, part :: BasePart)
		end)
	end
	for _, p in CollectionService:GetTagged("TrainingStation") do
		hookStation(p)
	end
	CollectionService:GetInstanceAddedSignal("TrainingStation"):Connect(hookStation)
	for _, p in CollectionService:GetTagged("TrainingPost") do
		posts[p:GetAttribute("Index")] = p :: BasePart
	end
	CollectionService:GetInstanceAddedSignal("TrainingPost"):Connect(function(p)
		posts[p:GetAttribute("Index")] = p :: BasePart
	end)

	-- training dummies are permanent, unkillable entities
	local function hookDummy(inst: Instance)
		if not inst:IsA("Model") then
			return
		end
		local model = inst :: Model
		local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		S.EntityService.Register({ Kind = "Dummy", Model = model, Root = root, Name = "Training Dummy", Level = 1, MaxHealth = 1e7, Poise = 1e7, Defense = 0, Radius = 1.6 })
	end
	for _, m in CollectionService:GetTagged("TrainingDummy") do
		hookDummy(m)
	end
	CollectionService:GetInstanceAddedSignal("TrainingDummy"):Connect(hookDummy)

	S.EntityService.Damaged:Connect(function(e, player, _amount, info)
		if not player or e.Kind ~= "Dummy" then
			return
		end
		-- only weapon swings count, and one swing that clips several dummies counts once
		if not info or info.Kind ~= "Melee" then
			e.Target.Health = e.Target.MaxHealth
			S.EntityService.PushHealth(e)
			return
		end
		e.Target.Health = e.Target.MaxHealth
		S.EntityService.PushHealth(e)
		local rt = S.PlayerStateService.Get(player)
		local session = rt and rt.Training
		if session and session.Def.Kind == "Hits" then
			local t = now()
			if t - (session.LastHitAt or -1e9) < 0.12 then
				return
			end
			session.LastHitAt = t
			local state = TrainingCore.hit(session, t)
			send(player, { Type = "Progress", Count = session.Count, Goal = session.Def.Hits })
			if state ~= "Running" then
				finish(player, rt, session)
			end
		end
	end)

	-- session watchdog: timeouts, leaving the station, course posts
	task.spawn(function()
		while true do
			task.wait(0.2)
			local t = now()
			for player, rt in S.PlayerStateService.All() do
				local session = rt.Training
				if session and session.State == "Running" and rt.Root then
					local def = session.Def
					if def.Kind == "Course" then
						local nextPost = posts[session.Count + 1]
						if nextPost and (rt.Root.Position - nextPost.Position).Magnitude < 8 then
							TrainingCore.post(session, session.Count + 1, t)
							send(player, { Type = "Progress", Count = session.Count, Goal = def.Posts })
						end
					elseif (rt.Root.Position - session.Station.Position).Magnitude > 45 then
						session.State = "Failed"
						session.Reason = "You left the training area."
					end
					if session.State == "Running" then
						TrainingCore.tick(session, t)
					end
					if session.State ~= "Running" then
						finish(player, rt, session)
					end
				end
			end
		end
	end)
end

return TrainingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder
	Builds the whole world procedurally at server start from Config/World.luau, using only
	terrain, parts, materials, lights and particles (no external assets):
	  lighting & atmosphere, terrain, the Tower of the Fallen, the Fallen Sanctuary hub and its
	  NPCs, Ember Shrines, Training Grounds, Ashen Pit (PvP), Mistveil Forest, Ruins of Ashford,
	  Hallowed Rest Cemetery, The Hollow Deep (caves), Broken Gate Fortress, The Hollow Vale,
	  treasure chests and leaderboards. BuildArena() creates instanced boss arenas.

	Layout is deterministic (seeded Rng) so every server looks the same.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Config.World)
local Bosses = require(Shared.Config.Bosses)
local Rng = require(Shared.Util.Rng)
local Net = require(Shared.Net)
local EntityModels = require(script.Parent.EntityModels)

local WorldBuilder = {}
local map: Folder
local rng = Rng.new(20241009)

local STONE = Color3.fromRGB(96, 92, 88)
local DARK_STONE = Color3.fromRGB(62, 60, 58)
local WOOD = Color3.fromRGB(70, 52, 38)

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function part(parent: Instance, props): BasePart
	local p = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = props.Size or Vector3.new(4, 4, 4)
	p.CFrame = props.CFrame or CFrame.new(props.Position or Vector3.zero)
	p.Color = props.Color or STONE
	p.Material = props.Material or Enum.Material.Slate
	if props.Shape and p:IsA("Part") then
		(p :: Part).Shape = props.Shape
	end
	p.Transparency = props.Transparency or 0
	p.CanCollide = props.CanCollide ~= false
	p.CastShadow = props.CastShadow ~= false
	p.Name = props.Name or "Part"
	p.Parent = parent
	return p
end

local function cylinderUp(parent, center: Vector3, diameter: number, height: number, props)
	props = props or {}
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	return part(parent, props)
end

local function light(parentPart: Instance, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = parentPart
	return l
end

local function fire(parentPart: Instance, color: Color3?, size: number?)
	local f = Instance.new("Fire")
	f.Color = color or Color3.fromRGB(255, 140, 60)
	f.SecondaryColor = Color3.fromRGB(255, 60, 20)
	f.Size = size or 5
	f.Heat = 8
	f.Parent = parentPart
	return f
end

local function folder(name: string, parent: Instance?): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent or map
	return f
end

local function label(parentPart: Instance, text: string, sub: string?, maxDist: number?)
	local b = Instance.new("BillboardGui")
	b.Size = UDim2.fromOffset(240, 50)
	b.StudsOffset = Vector3.new(0, 4.5, 0)
	b.MaxDistance = maxDist or 60
	b.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, 0, 0.6, 0)
	t.Font = Enum.Font.Garamond
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(240, 220, 170)
	t.TextStrokeTransparency = 0.3
	t.Text = text
	t.Parent = b
	if sub then
		local s2 = t:Clone()
		s2.Position = UDim2.new(0, 0, 0.6, 0)
		s2.Size = UDim2.new(1, 0, 0.4, 0)
		s2.TextColor3 = Color3.fromRGB(190, 180, 160)
		s2.Text = sub
		s2.Parent = b
	end
	b.Parent = parentPart
	return b
end

-- ===================================================================== lighting
local function buildLighting()
	-- NOTE: Lighting.Technology cannot be set by scripts (Roblox-only security); it is set in
	-- default.project.json instead.
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.28
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(200, 195, 200)
	atmo.Decay = Color3.fromRGB(90, 70, 80)
	atmo.Glare = 0.2
	atmo.Haze = 1.2
	atmo.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "Grade"
	cc.Brightness = 0.04
	cc.Contrast = 0.08
	cc.Saturation = -0.1
	cc.TintColor = Color3.fromRGB(240, 232, 225)
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

-- ===================================================================== terrain
local function buildTerrain()
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(2100, 8, 2100), Enum.Material.Ground)
	for _, r in World.Regions do
		local mat = Enum.Material[r.Material] or Enum.Material.Grass
		local c = v3(r.Center)
		terrain:FillCylinder(CFrame.new(c.X, -1, c.Z), 2, r.Radius, mat)
	end
	-- wide grass between regions
	terrain:FillCylinder(CFrame.new(0, -1.5, 0), 1, 300, Enum.Material.Grass)
	-- surrounding hills (world boundary feel)
	for i = 1, 28 do
		local ang = (i / 28) * math.pi * 2
		local d = 1000 + rng:NextInteger(-20, 40)
		terrain:FillBall(Vector3.new(math.cos(ang) * d, -10, math.sin(ang) * d), rng:NextInteger(110, 170), Enum.Material.Rock)
	end
	-- roads from the hub
	local hub = v3(World.Regions[1].Center)
	for _, r in World.Regions do
		if r.Id ~= "sanctuary" then
			local c = v3(r.Center)
			local mid = (hub + c) / 2
			local len = (c - hub).Magnitude
			terrain:FillBlock(CFrame.lookAt(Vector3.new(mid.X, -1.2, mid.Z), Vector3.new(c.X, -1.2, c.Z)), Vector3.new(10, 1.6, len), Enum.Material.Pavement)
		end
	end
	-- the Hollow Deep: carve a cave out of a rock mass
	terrain:FillBlock(CFrame.new(-700, 22, -170), Vector3.new(220, 46, 180), Enum.Material.Rock)
	terrain:FillBlock(CFrame.new(-700, 18, -170), Vector3.new(200, 36, 160), Enum.Material.Air)
	terrain:FillBlock(CFrame.new(-592, 10, -170), Vector3.new(24, 20, 22), Enum.Material.Air)
	-- vale basin with water
	terrain:FillCylinder(CFrame.new(60, -2, -800), 4, 40, Enum.Material.Water)
end

-- ===================================================================== tower
local function buildTower()
	local tower = Instance.new("Model")
	tower.Name = "TowerOfTheFallen"
	local c = v3(World.Tower.Center)
	local fh = World.Tower.FloorHeight
	local baseR = World.Tower.Radius
	for floor = 1, 20 do
		local r = baseR * (1 - floor * 0.012)
		local y = c.Y + (floor - 0.5) * fh
		cylinderUp(tower, Vector3.new(c.X, y, c.Z), r * 2, fh, { Color = if floor % 2 == 0 then STONE else DARK_STONE, Material = Enum.Material.Slate, Name = "Floor" .. floor })
		local ring = cylinderUp(tower, Vector3.new(c.X, y + fh / 2 - 1.5, c.Z), r * 2 + 1.2, 1.2, {
			Color = Color3.fromRGB(70, 60, 60), Material = Enum.Material.Neon, Name = "FloorRing", CanCollide = false, CastShadow = false,
		})
		ring:SetAttribute("Floor", floor)
		-- windows
		for k = 0, 3 do
			local ang = k * math.pi / 2 + floor * 0.4
			local w = part(tower, {
				Size = Vector3.new(3, 8, 1), Color = Color3.fromRGB(255, 150, 80), Material = Enum.Material.Neon, CanCollide = false,
				CFrame = CFrame.new(c.X + math.cos(ang) * r, y, c.Z + math.sin(ang) * r) * CFrame.Angles(0, -ang + math.pi / 2, 0), Name = "Window",
			})
			w.Transparency = if (floor + k) % 3 == 0 then 0.2 else 0.85
		end
	end
	-- buttresses
	for k = 0, 7 do
		local ang = k * math.pi / 4
		local h = 180
		part(tower, {
			Class = "WedgePart", Size = Vector3.new(10, h, 34), Color = DARK_STONE,
			CFrame = CFrame.new(c.X + math.cos(ang) * (baseR + 14), h / 2, c.Z + math.sin(ang) * (baseR + 14)) * CFrame.Angles(0, -ang - math.pi / 2, 0),
			Name = "Buttress",
		})
	end
	-- crown
	local topY = c.Y + 20 * fh
	for k = 0, 11 do
		local ang = k * math.pi / 6
		part(tower, { Size = Vector3.new(5, 30 + (k % 3) * 12, 5), Color = DARK_STONE, Position = Vector3.new(c.X + math.cos(ang) * 40, topY + 15, c.Z + math.sin(ang) * 40), Name = "Spike" })
	end
	local beacon = part(tower, { Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), Color = Color3.fromRGB(255, 50, 40), Material = Enum.Material.Neon, Position = Vector3.new(c.X, topY + 30, c.Z), CanCollide = false, Name = "Beacon" })
	light(beacon, Color3.fromRGB(255, 60, 40), 60, 4)
	-- gate
	local g = v3(World.Tower.GatePosition)
	for side = -1, 1, 2 do
		part(tower, { Size = Vector3.new(8, 50, 8), Color = STONE, Position = g + Vector3.new(side * 16, 25, 0), Name = "GatePillar" })
		local brazier = part(tower, { Size = Vector3.new(4, 2, 4), Color = DARK_STONE, Position = g + Vector3.new(side * 24, 6, 6), Name = "Brazier" })
		fire(brazier)
		light(brazier, Color3.fromRGB(255, 140, 70), 30, 2)
	end
	part(tower, { Size = Vector3.new(44, 8, 10), Color = STONE, Position = g + Vector3.new(0, 52, 0), Name = "Lintel" })
	local portal = part(tower, {
		Size = Vector3.new(24, 40, 1), Color = Color3.fromRGB(255, 110, 60), Material = Enum.Material.Neon, Transparency = 0.35,
		Position = g + Vector3.new(0, 20, -1), CanCollide = true, Name = "TowerGate",
	})
	light(portal, Color3.fromRGB(255, 110, 60), 40, 3)
	label(portal, "Tower of the Fallen", "Twenty guardians await", 120)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Enter the Tower"
	prompt.ObjectText = "Tower Gate"
	prompt.MaxActivationDistance = 20
	prompt.RequiresLineOfSight = false
	prompt.Parent = portal
	prompt.Triggered:Connect(function(player)
		Net.event("OpenUI"):FireClient(player, { Menu = "Tower" })
	end)
	tower.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	tower.Parent = map
end

-- ===================================================================== hub
local function npcModel(parent: Instance, npc)
	local styles = {
		Shop = { Style = "Humanoid", Color = Color3.fromRGB(110, 90, 70) },
		Blacksmith = { Style = "Brute", Color = Color3.fromRGB(90, 70, 60), Weapon = "Hammer" },
		Quest = { Style = "Caster", Color = Color3.fromRGB(80, 70, 100), Glow = Color3.fromRGB(255, 220, 140), Hood = true },
		Wardrobe = { Style = "Caster", Color = Color3.fromRGB(60, 60, 80), Glow = Color3.fromRGB(180, 160, 255) },
		Party = { Style = "Humanoid", Color = Color3.fromRGB(70, 90, 70) },
		Tutorial = { Style = "Humanoid", Color = Color3.fromRGB(120, 110, 90), Hood = true },
	}
	local style = table.clone(styles[npc.Role] or styles.Shop)
	style.Scale = 1
	local model, root, humanoid = EntityModels.build(npc.Name, style, "NPC")
	local pos = v3(npc.Position)
	model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0), Vector3.new(0, pos.Y + humanoid.HipHeight + root.Size.Y / 2, 260)))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model:SetAttribute("NpcId", npc.Id)
	model:SetAttribute("Role", npc.Role)
	model.Parent = parent
	label(root, npc.Name, npc.Role == "Shop" and "Merchant" or npc.Role, 50)
	CollectionService:AddTag(model, "NPC")
	return model
end

local function shrine(parent: Instance, cp)
	local pos = v3(cp.Position)
	local m = Instance.new("Model")
	m.Name = "Shrine_" .. cp.Id
	local base = cylinderUp(m, pos + Vector3.new(0, 0.6, 0), 9, 1.2, { Color = DARK_STONE, Name = "Base" })
	cylinderUp(m, pos + Vector3.new(0, 1.6, 0), 6, 0.8, { Color = STONE, Name = "Step" })
	local sword = part(m, { Size = Vector3.new(0.4, 6, 1.1), Color = Color3.fromRGB(80, 80, 85), Material = Enum.Material.Metal, CFrame = CFrame.new(pos + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, 0, math.rad(10)), Name = "Sword" })
	local embers = part(m, { Size = Vector3.new(2, 1, 2), Color = Color3.fromRGB(40, 30, 25), Position = pos + Vector3.new(0, 2.4, 0), CanCollide = false, Name = "Embers" })
	fire(embers, nil, 4)
	light(embers, Color3.fromRGB(255, 150, 70), 26, 2)
	base:SetAttribute("ShrineId", cp.Id)
	CollectionService:AddTag(base, "Shrine")
	label(sword, cp.Name, "Ember Shrine", 70)
	m.Parent = parent
end

local function bench(parent, cf: CFrame)
	part(parent, { Size = Vector3.new(8, 0.8, 2.4), Color = WOOD, Material = Enum.Material.Wood, CFrame = cf * CFrame.new(0, 2, 0), Name = "Bench" })
	for side = -1, 1, 2 do
		part(parent, { Size = Vector3.new(0.8, 2, 2), Color = DARK_STONE, CFrame = cf * CFrame.new(side * 3.2, 1, 0), Name = "BenchLeg" })
	end
end

local function brazierAt(parent, pos: Vector3, color: Color3?)
	local stand = cylinderUp(parent, pos + Vector3.new(0, 2.5, 0), 1.2, 5, { Color = DARK_STONE, Material = Enum.Material.Metal, Name = "BrazierStand" })
	local bowl = cylinderUp(parent, pos + Vector3.new(0, 5.3, 0), 3, 0.8, { Color = Color3.fromRGB(50, 45, 40), Material = Enum.Material.Metal, Name = "Bowl" })
	fire(bowl, color, 3)
	light(bowl, color or Color3.fromRGB(255, 140, 70), 22, 1.6)
	return stand
end

local function statue(parent, pos: Vector3, facing: Vector3)
	local m = Instance.new("Model")
	m.Name = "Statue"
	local cf = CFrame.lookAt(pos, Vector3.new(facing.X, pos.Y, facing.Z))
	part(m, { Size = Vector3.new(6, 3, 6), Color = DARK_STONE, CFrame = cf * CFrame.new(0, 1.5, 0) })
	part(m, { Size = Vector3.new(3.4, 7, 2), Color = STONE, Material = Enum.Material.Marble, CFrame = cf * CFrame.new(0, 6.5, 0) })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Color = STONE, Material = Enum.Material.Marble, CFrame = cf * CFrame.new(0, 11, 0) })
	part(m, { Size = Vector3.new(0.5, 9, 0.9), Color = STONE, Material = Enum.Material.Marble, CFrame = cf * CFrame.new(1.8, 7, -1) * CFrame.Angles(0, 0, math.rad(-8)) })
	m.Parent = parent
end

local function leaderboard(parent, pos: Vector3, facing: Vector3)
	local board = part(parent, { Size = Vector3.new(14, 12, 1), Color = WOOD, Material = Enum.Material.Wood, CFrame = CFrame.lookAt(pos + Vector3.new(0, 7, 0), facing + Vector3.new(0, 7, 0)), Name = "Leaderboard" })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(700, 600)
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Garamond
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(240, 210, 140)
	title.Text = "Highest Climbers"
	title.Parent = gui
	local rows = Instance.new("TextLabel")
	rows.Name = "Rows"
	rows.Position = UDim2.new(0.05, 0, 0.18, 0)
	rows.Size = UDim2.new(0.9, 0, 0.8, 0)
	rows.BackgroundTransparency = 1
	rows.Font = Enum.Font.Garamond
	rows.TextSize = 30
	rows.TextXAlignment = Enum.TextXAlignment.Left
	rows.TextYAlignment = Enum.TextYAlignment.Top
	rows.TextColor3 = Color3.fromRGB(230, 220, 200)
	rows.Text = "Gathering records..."
	rows.Parent = gui
	gui.Parent = board
	CollectionService:AddTag(board, "Leaderboard")
end

local function buildHub()
	local hub = folder("FallenSanctuary")
	local c = v3(World.Regions[1].Center)
	-- ruined wall ring with gaps
	for i = 0, 35 do
		if i % 9 ~= 0 and i % 9 ~= 1 then
			local ang = (i / 36) * math.pi * 2
			local h = 10 + rng:NextInteger(0, 14)
			part(hub, {
				Size = Vector3.new(19, h, 4), Color = if i % 2 == 0 then STONE else DARK_STONE,
				CFrame = CFrame.new(c.X + math.cos(ang) * 115, h / 2, c.Z + math.sin(ang) * 115) * CFrame.Angles(0, -ang + math.pi / 2, math.rad(rng:NextInteger(-3, 3))),
				Name = "RuinWall",
			})
		end
	end
	-- columns
	for i = 0, 11 do
		local ang = (i / 12) * math.pi * 2
		local h = if i % 3 == 0 then 8 else 26
		cylinderUp(hub, Vector3.new(c.X + math.cos(ang) * 78, h / 2, c.Z + math.sin(ang) * 78), 5, h, { Color = STONE, Material = Enum.Material.Marble, Name = "Column" })
	end
	-- benches & braziers around the bonfire
	for i = 0, 5 do
		local ang = (i / 6) * math.pi * 2
		local p = Vector3.new(0, 0, 262) + Vector3.new(math.cos(ang) * 16, 0, math.sin(ang) * 16)
		bench(hub, CFrame.lookAt(p, Vector3.new(0, 0, 262)))
	end
	for _, off in { Vector3.new(-35, 0, -35), Vector3.new(35, 0, -35), Vector3.new(-35, 0, 35), Vector3.new(35, 0, 35), Vector3.new(-70, 0, 0), Vector3.new(70, 0, 0) } do
		brazierAt(hub, c + off)
	end
	-- market stalls
	for _, npc in World.NPCs do
		if npc.Role == "Shop" or npc.Role == "Blacksmith" then
			local p = v3(npc.Position)
			local back = p + Vector3.new(if p.X < 0 then -6 else 6, 0, 0)
			part(hub, { Size = Vector3.new(2, 8, 12), Color = WOOD, Material = Enum.Material.Wood, Position = back + Vector3.new(0, 4, 0), Name = "StallBack" })
			part(hub, { Size = Vector3.new(10, 0.6, 14), Color = Color3.fromRGB(110, 40, 36), Material = Enum.Material.Fabric, CFrame = CFrame.new(back + Vector3.new(if p.X < 0 then 3 else -3, 9, 0)) * CFrame.Angles(0, 0, math.rad(if p.X < 0 then -12 else 12)), Name = "Awning" })
			part(hub, { Size = Vector3.new(3, 3, 8), Color = WOOD, Material = Enum.Material.WoodPlanks, Position = p + Vector3.new(if p.X < 0 then 3 else -3, 1.5, 0), Name = "Counter" })
			if npc.Role == "Blacksmith" then
				local forge = part(hub, { Size = Vector3.new(6, 4, 6), Color = DARK_STONE, Position = p + Vector3.new(-4, 2, 8), Name = "Forge" })
				fire(forge, Color3.fromRGB(255, 120, 40), 6)
				light(forge, Color3.fromRGB(255, 120, 40), 26, 2.5)
				part(hub, { Size = Vector3.new(3, 2, 1.5), Color = Color3.fromRGB(60, 60, 64), Material = Enum.Material.Metal, Position = p + Vector3.new(3, 3, 6), Name = "Anvil" })
			end
		end
	end
	statue(hub, c + Vector3.new(-25, 0, -60), c)
	statue(hub, c + Vector3.new(25, 0, -60), c)
	leaderboard(hub, c + Vector3.new(60, 0, 60), c)
	-- wardrobe mirror (cosmetic display)
	local wardrobePos = Vector3.new(-30, 0, 340)
	for _, npc in World.NPCs do
		if npc.Role == "Wardrobe" then
			wardrobePos = v3(npc.Position)
		end
	end
	local mirror = part(hub, { Size = Vector3.new(6, 10, 0.5), Color = Color3.fromRGB(180, 190, 210), Material = Enum.Material.Glass, Transparency = 0.2, Position = wardrobePos + Vector3.new(0, 5, 6), Name = "Mirror" })
	light(mirror, Color3.fromRGB(180, 170, 255), 14, 1)
	-- party board
	part(hub, { Size = Vector3.new(8, 6, 0.6), Color = WOOD, Material = Enum.Material.Wood, Position = Vector3.new(30, 4, 286), Name = "FellowshipBoard" })
	for _, npc in World.NPCs do
		npcModel(hub, npc)
	end
end

-- ===================================================================== shrines, chests
local function buildShrines()
	local f = folder("Shrines")
	for _, cp in World.Checkpoints do
		shrine(f, cp)
	end
end

local function buildChests()
	local f = folder("Chests")
	for _, ch in World.Chests do
		local pos = v3(ch.Position)
		local m = Instance.new("Model")
		m.Name = ch.Id
		local box = part(m, { Size = Vector3.new(4, 2.4, 2.6), Color = WOOD, Material = Enum.Material.WoodPlanks, Position = pos + Vector3.new(0, 1.2, 0), Name = "Box" })
		part(m, { Size = Vector3.new(4.2, 0.9, 2.8), Color = Color3.fromRGB(90, 70, 40), Material = Enum.Material.Wood, Position = pos + Vector3.new(0, 2.8, 0), Name = "Lid" })
		part(m, { Size = Vector3.new(0.6, 0.8, 0.2), Color = Color3.fromRGB(200, 170, 80), Material = Enum.Material.Foil, Position = pos + Vector3.new(0, 2.2, -1.4), Name = "Lock" })
		light(box, Color3.fromRGB(255, 210, 120), 10, 0.8)
		box:SetAttribute("ChestId", ch.Id)
		CollectionService:AddTag(box, "Chest")
		m.Parent = f
	end
end

-- ===================================================================== training grounds
local function buildTraining()
	local f = folder("TrainingGrounds")
	local c = v3(World.Regions[2].Center)
	-- fence
	for i = 0, 23 do
		local ang = (i / 24) * math.pi * 2
		part(f, { Size = Vector3.new(1, 4, 15), Color = WOOD, Material = Enum.Material.Wood,
			CFrame = CFrame.new(c.X + math.cos(ang) * 68, 2, c.Z + math.sin(ang) * 68) * CFrame.Angles(0, -ang, 0), Name = "Fence" })
	end
	for _, st in World.TrainingStations do
		local pos = v3(st.Position)
		local marker = cylinderUp(f, pos + Vector3.new(0, 0.3, 0), 8, 0.6, { Color = Color3.fromRGB(150, 120, 70), Material = Enum.Material.Sand, Name = "Station_" .. st.Id })
		marker:SetAttribute("Challenge", st.Challenge)
		CollectionService:AddTag(marker, "TrainingStation")
		label(marker, ({ weights = "Weightlifting", dummies = "Weapon Practice", dodge = "Dodge Drill", parry = "Parry Drill", endurance = "Endurance Run", sparring = "Sparring Ring" })[st.Id] or st.Id, "Training", 50)
		if st.Id == "weights" then
			part(f, { Size = Vector3.new(6, 0.6, 2), Color = WOOD, Position = pos + Vector3.new(0, 1.6, 4), Name = "WeightBench" })
			cylinderUp(f, pos + Vector3.new(-3.5, 3, 4), 2.4, 0.6, { Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal })
			cylinderUp(f, pos + Vector3.new(3.5, 3, 4), 2.4, 0.6, { Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal })
			part(f, { Size = Vector3.new(8, 0.3, 0.3), Color = Color3.fromRGB(120, 120, 125), Material = Enum.Material.Metal, Position = pos + Vector3.new(0, 3, 4) })
		elseif st.Id == "dummies" then
			for k = -1, 1 do
				local dm = Instance.new("Model")
				dm.Name = "TrainingDummy"
				local root = part(dm, { Size = Vector3.new(2, 5, 1.5), Color = Color3.fromRGB(160, 130, 80), Material = Enum.Material.Fabric, Position = pos + Vector3.new(k * 7, 4.5, -8), Name = "HumanoidRootPart" })
				part(dm, { Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Color = Color3.fromRGB(170, 140, 90), Material = Enum.Material.Fabric, Position = pos + Vector3.new(k * 7, 8, -8), Name = "Head" })
				cylinderUp(dm, pos + Vector3.new(k * 7, 1, -8), 1, 2, { Color = WOOD, Material = Enum.Material.Wood })
				dm.PrimaryPart = root
				dm:SetAttribute("Height", 8)
				dm.Parent = f
				CollectionService:AddTag(dm, "TrainingDummy")
			end
		elseif st.Id == "endurance" then
			for k = 1, 6 do
				local ang = (k / 6) * math.pi * 2
				local post = cylinderUp(f, c + Vector3.new(math.cos(ang) * 52, 4, math.sin(ang) * 52), 1.6, 8, { Color = Color3.fromRGB(230, 200, 120), Material = Enum.Material.Neon, Name = "Post" .. k, CanCollide = false })
				post:SetAttribute("Index", k)
				CollectionService:AddTag(post, "TrainingPost")
				label(post, "Post " .. k, nil, 80)
			end
		end
	end
end

-- ===================================================================== wild regions
local function tree(parent, pos: Vector3, scale: number, dead: boolean?)
	local h = 18 * scale
	cylinderUp(parent, pos + Vector3.new(0, h / 2, 0), 2.2 * scale, h, { Color = Color3.fromRGB(58, 46, 38), Material = Enum.Material.Wood, Name = "Trunk" })
	if not dead then
		for k = 1, 2 do
			part(parent, {
				Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12) * scale * (1.2 - k * 0.2),
				Color = Color3.fromRGB(40 + rng:NextInteger(0, 15), 58 + rng:NextInteger(0, 15), 38),
				Material = Enum.Material.Grass, CanCollide = false,
				Position = pos + Vector3.new(rng:NextInteger(-2, 2), h - 2 + k * 4 * scale, rng:NextInteger(-2, 2)), Name = "Leaves",
			})
		end
	else
		part(parent, { Size = Vector3.new(1, 8 * scale, 1), Color = Color3.fromRGB(58, 46, 38), Material = Enum.Material.Wood,
			CFrame = CFrame.new(pos + Vector3.new(2, h * 0.75, 0)) * CFrame.Angles(0, 0, math.rad(-40)), Name = "Branch" })
	end
end

local function scatter(region, count: number, minR: number, fn)
	local c = v3(region.Center)
	for _ = 1, count do
		local ang = rng:NextNumber() * math.pi * 2
		local r = minR + rng:NextNumber() * (region.Radius - minR)
		fn(c + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r))
	end
end

local function regionById(id)
	for _, r in World.Regions do
		if r.Id == id then
			return r
		end
	end
	return nil
end

local function ruinedHouse(parent, pos: Vector3, rot: number)
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	local w, d, h = 18, 14, 10
	part(parent, { Size = Vector3.new(w, h, 1.5), Color = STONE, Material = Enum.Material.Brick, CFrame = cf * CFrame.new(0, h / 2, -d / 2) })
	part(parent, { Size = Vector3.new(1.5, h * 0.7, d), Color = STONE, Material = Enum.Material.Brick, CFrame = cf * CFrame.new(-w / 2, h * 0.35, 0) })
	part(parent, { Size = Vector3.new(1.5, h, d), Color = STONE, Material = Enum.Material.Brick, CFrame = cf * CFrame.new(w / 2, h / 2, 0) })
	part(parent, { Size = Vector3.new(w * 0.4, h * 0.5, 1.5), Color = STONE, Material = Enum.Material.Brick, CFrame = cf * CFrame.new(-w * 0.3, h * 0.25, d / 2) })
	part(parent, { Class = "WedgePart", Size = Vector3.new(w * 0.6, 5, d / 2), Color = Color3.fromRGB(70, 50, 40), Material = Enum.Material.WoodPlanks, CFrame = cf * CFrame.new(w * 0.2, h + 2.5, -d / 4) })
end

local function buildRegions()
	-- Mistveil Forest
	local forest = folder("MistveilForest")
	scatter(regionById("forest"), 130, 10, function(p)
		tree(forest, p, 0.8 + rng:NextNumber() * 0.7, rng:NextNumber() < 0.15)
	end)
	-- hidden grotto
	local g = Vector3.new(-600, 0, 280)
	for k = 0, 7 do
		local ang = (k / 8) * math.pi * 2
		if k ~= 2 then
			part(forest, { Size = Vector3.new(12, 14, 6), Color = Color3.fromRGB(80, 80, 76), Material = Enum.Material.Rock, CFrame = CFrame.new(g + Vector3.new(math.cos(ang) * 14, 7, math.sin(ang) * 14)) * CFrame.Angles(0, -ang, 0), Name = "GrottoRock" })
		end
	end
	part(forest, { Size = Vector3.new(34, 3, 34), Color = Color3.fromRGB(70, 70, 66), Material = Enum.Material.Rock, Position = g + Vector3.new(0, 15, 0), Name = "GrottoRoof" })
	local glow = part(forest, { Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Color = Color3.fromRGB(120, 255, 200), Material = Enum.Material.Neon, Position = g + Vector3.new(0, 10, 0), CanCollide = false })
	light(glow, Color3.fromRGB(120, 255, 200), 20, 1.5)

	-- Ruins of Ashford
	local village = folder("RuinsOfAshford")
	local vc = v3(regionById("village").Center)
	for k = 0, 8 do
		local ang = (k / 9) * math.pi * 2
		ruinedHouse(village, vc + Vector3.new(math.cos(ang) * 70, 0, math.sin(ang) * 70), -ang)
	end
	-- collapsed chapel (secret)
	local ch = Vector3.new(500, 0, 140)
	part(village, { Size = Vector3.new(24, 16, 2), Color = STONE, Material = Enum.Material.Brick, Position = ch + Vector3.new(0, 8, -10) })
	part(village, { Size = Vector3.new(2, 12, 20), Color = STONE, Material = Enum.Material.Brick, Position = ch + Vector3.new(-12, 6, 0) })
	part(village, { Size = Vector3.new(8, 2, 3), Color = DARK_STONE, Position = ch + Vector3.new(0, 1, -6), Name = "Altar" })
	local well = cylinderUp(village, vc + Vector3.new(0, 1.5, 0), 6, 3, { Color = STONE, Name = "Well" })
	light(well, Color3.fromRGB(255, 160, 90), 16, 1)

	-- Hallowed Rest Cemetery
	local cem = folder("HallowedRest")
	scatter(regionById("cemetery"), 90, 8, function(p)
		part(cem, { Size = Vector3.new(2.4, 3.2 + rng:NextNumber() * 2, 0.6), Color = Color3.fromRGB(110, 110, 112), Material = Enum.Material.Slate,
			CFrame = CFrame.new(p + Vector3.new(0, 1.6, 0)) * CFrame.Angles(math.rad(rng:NextInteger(-8, 8)), rng:NextNumber() * 0.4, math.rad(rng:NextInteger(-8, 8))), Name = "Grave" })
	end)
	scatter(regionById("cemetery"), 14, 30, function(p)
		tree(cem, p, 0.9, true)
	end)
	local crypt = Vector3.new(-430, 0, -400)
	part(cem, { Size = Vector3.new(20, 12, 16), Color = DARK_STONE, Material = Enum.Material.Marble, Position = crypt + Vector3.new(0, 6, -10), Name = "Crypt" })
	part(cem, { Size = Vector3.new(8, 10, 2), Color = Color3.fromRGB(30, 30, 34), Position = crypt + Vector3.new(0, 5, -1.5), CanCollide = false, Name = "CryptDoor" })
	local ghost = part(cem, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.5, 1.5), Color = Color3.fromRGB(150, 200, 255), Material = Enum.Material.Neon, Position = crypt + Vector3.new(0, 4, 2), CanCollide = false })
	light(ghost, Color3.fromRGB(150, 200, 255), 18, 1.2)

	-- The Hollow Deep (cave interior lights & stalagmites)
	local caves = folder("HollowDeep")
	scatter(regionById("caves"), 26, 6, function(p)
		if math.abs(p.X + 700) < 95 and math.abs(p.Z + 170) < 75 then
			part(caves, { Class = "WedgePart", Size = Vector3.new(3, 6 + rng:NextNumber() * 6, 3), Color = Color3.fromRGB(90, 86, 80), Material = Enum.Material.Rock, Position = p + Vector3.new(0, 4, 0), Name = "Stalagmite" })
		end
	end)
	for k = 1, 6 do
		local crystal = part(caves, { Size = Vector3.new(1.4, 4, 1.4), Color = Color3.fromRGB(120, 180, 255), Material = Enum.Material.Neon,
			CFrame = CFrame.new(-760 + k * 22, 2, -170 + (k % 2 == 0 and 50 or -50)) * CFrame.Angles(0.3, k, 0.2), CanCollide = false, Name = "Crystal" })
		light(crystal, Color3.fromRGB(120, 180, 255), 22, 1.2)
	end

	-- Broken Gate Fortress
	local fort = folder("BrokenGateFortress")
	local fc = v3(regionById("fortress").Center)
	local half = 70
	for side = 0, 3 do
		local ang = side * math.pi / 2
		local dirv = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local perp = Vector3.new(-dirv.Z, 0, dirv.X)
		for seg = -2, 2 do
			if not (side == 2 and seg == 0) then -- gate gap facing the hub road
				part(fort, { Size = Vector3.new(28, 18, 4), Color = STONE, Material = Enum.Material.Cobblestone,
					CFrame = CFrame.lookAt(fc + dirv * half + perp * seg * 28 + Vector3.new(0, 9, 0), fc + Vector3.new(0, 9, 0)), Name = "FortWall" })
			end
		end
		local corner = fc + (dirv + perp) * half
		cylinderUp(fort, corner + Vector3.new(0, 14, 0), 14, 28, { Color = DARK_STONE, Material = Enum.Material.Cobblestone, Name = "FortTower" })
	end
	-- ramparts (secret)
	part(fort, { Size = Vector3.new(30, 2, 14), Color = STONE, Material = Enum.Material.Cobblestone, Position = Vector3.new(500, 17, -460), Name = "Rampart" })
	for k = 0, 7 do
		part(fort, { Size = Vector3.new(6, 2, 3), Color = STONE, Material = Enum.Material.Cobblestone, Position = Vector3.new(480 - k * 0.1, 1 + k * 2, -440 - k * 2.6), Name = "Stair" })
	end
	for k = 0, 3 do
		local b = part(fort, { Size = Vector3.new(2, 1, 2), Color = DARK_STONE, Position = fc + Vector3.new(-40 + k * 26, 6, 10), Name = "FortBrazier" })
		fire(b, nil, 3)
		light(b, Color3.fromRGB(255, 130, 60), 20, 1.4)
	end

	-- The Hollow Vale (hidden region) and its seal
	local vale = folder("HollowVale")
	scatter(regionById("vale"), 60, 15, function(p)
		local crystal = part(vale, { Size = Vector3.new(2, 6 + rng:NextNumber() * 8, 2), Color = Color3.fromRGB(80, 255, 200), Material = Enum.Material.Neon,
			CFrame = CFrame.new(p + Vector3.new(0, 4, 0)) * CFrame.Angles(rng:NextNumber() * 0.4, rng:NextNumber() * 3, rng:NextNumber() * 0.4), CanCollide = false, Name = "ValeCrystal" })
		if rng:NextNumber() < 0.2 then
			light(crystal, Color3.fromRGB(80, 255, 200), 18, 1)
		end
	end)
	scatter(regionById("vale"), 40, 20, function(p)
		tree(vale, p, 1.2, false)
	end)
	local seal = part(vale, { Size = Vector3.new(60, 40, 2), Color = Color3.fromRGB(80, 255, 200), Material = Enum.Material.ForceField, Transparency = 0.3, Position = Vector3.new(0, 20, -585), CanCollide = false, Name = "ValeSeal" })
	label(seal, "The Hollow Vale", "Sealed until the tenth guardian falls", 120)

	-- Ashen Pit (PvP)
	local pit = folder("AshenPit")
	local pc = v3(regionById("pvp").Center)
	for k = 0, 15 do
		local ang = (k / 16) * math.pi * 2
		part(pit, { Size = Vector3.new(10, 5, 3), Color = DARK_STONE, CFrame = CFrame.new(pc + Vector3.new(math.cos(ang) * 42, 2.5, math.sin(ang) * 42)) * CFrame.Angles(0, -ang + math.pi / 2, 0), Name = "PitWall" })
	end
	local sign = part(pit, { Size = Vector3.new(10, 6, 1), Color = WOOD, Material = Enum.Material.Wood, Position = pc + Vector3.new(0, 3, 50), Name = "PitSign" })
	label(sign, "The Ashen Pit", "Opt-in duels: no embers lost", 80)
end

-- ===================================================================== arenas
local PROPS = {
	Pillars = function(m, o, r, def)
		for k = 0, 7 do
			local ang = (k / 8) * math.pi * 2
			cylinderUp(m, o + Vector3.new(math.cos(ang) * r * 0.82, 14, math.sin(ang) * r * 0.82), 6, 28, { Color = def.Arena.Color, Material = Enum.Material.Marble })
		end
	end,
	Graves = function(m, o, r)
		for k = 0, 15 do
			local ang = (k / 16) * math.pi * 2
			part(m, { Size = Vector3.new(3, 4, 0.8), Color = Color3.fromRGB(110, 110, 115), Position = o + Vector3.new(math.cos(ang) * r * 0.86, 2, math.sin(ang) * r * 0.86) })
		end
	end,
	Roots = function(m, o, r)
		for k = 0, 9 do
			local ang = (k / 10) * math.pi * 2
			part(m, { Size = Vector3.new(3, 3, 26), Color = Color3.fromRGB(60, 50, 34), Material = Enum.Material.Wood, CanCollide = false,
				CFrame = CFrame.new(o + Vector3.new(math.cos(ang) * r * 0.85, 1.5, math.sin(ang) * r * 0.85)) * CFrame.Angles(0, -ang, 0.3) })
		end
	end,
	Braziers = function(m, o, r, def)
		for k = 0, 5 do
			local ang = (k / 6) * math.pi * 2
			brazierAt(m, o + Vector3.new(math.cos(ang) * r * 0.85, 0, math.sin(ang) * r * 0.85), def.Arena.Light)
		end
	end,
	Pools = function(m, o, r, def)
		for k = 0, 4 do
			local ang = (k / 5) * math.pi * 2
			cylinderUp(m, o + Vector3.new(math.cos(ang) * r * 0.8, 0.12, math.sin(ang) * r * 0.8), 14, 0.2, { Color = def.Arena.Light, Material = Enum.Material.Glass, Transparency = 0.5, CanCollide = false })
		end
	end,
	Statues = function(m, o, r)
		for k = 0, 5 do
			local ang = (k / 6) * math.pi * 2
			statue(m, o + Vector3.new(math.cos(ang) * r * 0.85, 0, math.sin(ang) * r * 0.85), o)
		end
	end,
}
PROPS.Throne = function(m, o, r, def)
	local back = o + Vector3.new(0, 0, -r * 0.85)
	part(m, { Size = Vector3.new(14, 4, 10), Color = DARK_STONE, Position = back + Vector3.new(0, 2, 0) })
	part(m, { Size = Vector3.new(10, 22, 2), Color = def.Arena.Color, Material = Enum.Material.Marble, Position = back + Vector3.new(0, 13, -4) })
	PROPS.Pillars(m, o, r, def)
end
for _, alias in { "Hooks", "Gallows", "Shelves", "Banners", "Rubble", "Ruins", "Vats", "Moons" } do
	PROPS[alias] = function(m, o, r, def)
		for k = 0, 9 do
			local ang = (k / 10) * math.pi * 2
			local p = o + Vector3.new(math.cos(ang) * r * 0.86, 0, math.sin(ang) * r * 0.86)
			if alias == "Moons" then
				local moon = part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6), Color = def.Arena.Light, Material = Enum.Material.Neon, Position = p + Vector3.new(0, 30, 0), CanCollide = false })
				light(moon, def.Arena.Light, 30, 1)
			elseif alias == "Banners" or alias == "Hooks" or alias == "Gallows" then
				part(m, { Size = Vector3.new(1, 18, 1), Color = WOOD, Material = Enum.Material.Wood, Position = p + Vector3.new(0, 9, 0) })
				part(m, { Size = Vector3.new(5, 8, 0.3), Color = def.Arena.Light, Material = Enum.Material.Fabric, CanCollide = false, Position = p + Vector3.new(0, 13, 0) })
			elseif alias == "Shelves" then
				part(m, { Size = Vector3.new(10, 16, 3), Color = WOOD, Material = Enum.Material.WoodPlanks, CFrame = CFrame.lookAt(p + Vector3.new(0, 8, 0), o + Vector3.new(0, 8, 0)) })
			elseif alias == "Vats" then
				local vat = cylinderUp(m, p + Vector3.new(0, 3, 0), 7, 6, { Color = Color3.fromRGB(60, 70, 40), Material = Enum.Material.Metal })
				light(vat, def.Arena.Light, 16, 1)
			else
				part(m, { Size = Vector3.new(6 + rng:NextNumber() * 6, 3 + rng:NextNumber() * 5, 6), Color = def.Arena.Color, Material = Enum.Material.Rock, Position = p + Vector3.new(0, 2, 0) })
			end
		end
	end
end

function WorldBuilder.BuildArena(def, origin: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "Arena_Floor" .. def.Floor
	local r = def.Arena.Size / 2
	local material = Enum.Material[def.Arena.Material] or Enum.Material.Slate
	cylinderUp(m, origin - Vector3.new(0, 2, 0), r * 2 + 24, 4, { Color = def.Arena.Color, Material = material, Name = "ArenaFloor" })
	-- walls
	local segs = 36
	for k = 0, segs - 1 do
		local ang = (k / segs) * math.pi * 2
		local w = 2 * math.pi * (r + 4) / segs + 1
		part(m, { Size = Vector3.new(w, 46, 4), Color = Color3.new(def.Arena.Color.R * 0.6, def.Arena.Color.G * 0.6, def.Arena.Color.B * 0.6),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(ang) * (r + 4), 21, math.sin(ang) * (r + 4))) * CFrame.Angles(0, -ang + math.pi / 2, 0), Name = "ArenaWall" })
	end
	-- invisible ceiling keeps everyone inside
	cylinderUp(m, origin + Vector3.new(0, 80, 0), r * 2 + 24, 2, { Transparency = 1, Name = "Ceiling", CastShadow = false })
	local builder = PROPS[def.Arena.Props] or PROPS.Pillars
	builder(m, origin, r, def)
	-- lighting rig
	for k = 0, 3 do
		local ang = (k / 4) * math.pi * 2 + math.pi / 4
		local l = part(m, { Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, Position = origin + Vector3.new(math.cos(ang) * r * 0.5, 30, math.sin(ang) * r * 0.5), Name = "Light" })
		light(l, def.Arena.Light, r * 1.4, 1.2)
	end
	-- floor number sigil
	local sigil = cylinderUp(m, origin + Vector3.new(0, 0.06, 0), 18, 0.12, { Color = def.Arena.Light, Material = Enum.Material.Neon, Transparency = 0.7, CanCollide = false, Name = "Sigil" })
	sigil.CastShadow = false
	m:SetAttribute("Floor", def.Floor)
	return m
end

-- ===================================================================== init
function WorldBuilder.Init(_services)
	map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	-- Each step is isolated: a failure in decoration must never leave the world without ground.
	-- Terrain is built first because everything stands on it.
	local steps = {
		{ "terrain", buildTerrain },
		{ "lighting", buildLighting },
		{ "tower", buildTower },
		{ "hub", buildHub },
		{ "shrines", buildShrines },
		{ "chests", buildChests },
		{ "training", buildTraining },
		{ "regions", buildRegions },
	}
	for _, step in steps do
		local ok, err = pcall(step[2])
		if not ok then
			warn(("[WorldBuilder] building %s failed: %s"):format(step[1], tostring(err)))
		end
	end
	-- spawn location in the hub
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Position = v3(World.SpawnPoint) - Vector3.new(0, 3.5, 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = map
	assert(#Bosses.List == 20, "expected 20 bosses")
end

function WorldBuilder.Start() end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="81">
        <Properties>
          <string name="Name">TestRunner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	TestRunner
	Runs the automated spec suite inside Roblox Studio. To use: select Workspace, add a boolean
	attribute RunTests = true, then press Play (or Run). Results print to the Output window and
	are reported through TestService. The same specs run offline via tools/run_tests.sh.
]]

local ServerStorage = game:GetService("ServerStorage")
local TestService = game:GetService("TestService")

if workspace:GetAttribute("RunTests") ~= true then
	return
end

local tests = ServerStorage:WaitForChild("Tests")
local TestKit = require(tests:WaitForChild("TestKit"))
local ok = TestKit.runAll(tests, require, nil)
local result = TestKit.LastResult
if ok then
	TestService:Message(("All %d tests passed"):format(result.Total))
else
	for _, f in result.Failures do
		TestService:Error(f)
	end
end
]]></string>
        </Properties>
      </Item>
